type DIR = external
type DIR_ENTRY = external

proc open_dir(anon name: [^]u8) -> ^DIR = external "libc__open_dir"

proc close_dir(anon dir: ^DIR) -> i32 = external "libc__close_dir"

proc read_dir(anon dir: ^DIR) -> ^DIR_ENTRY = external "libc__read_dir"

proc get_dir_entry_name(anon entry: ^DIR_ENTRY) -> [^]u8 = external "libc__get_dir_entry_name"
