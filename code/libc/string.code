proc memcmp(a: ^Any, b: ^Any, size: usize) -> i32 = external

proc memcpy(destination: ^Any, source: ^Any, size: usize) -> ^Any = external

proc memset(destination: ^Any, value: i32, size: usize) -> ^Any = external

proc strlen(s: [^]u8) -> usize = external

proc ([^]u8).to_str(self) -> str {
    let string = String(data: self, length: strlen(self))
    return (^string).as(^str).^
}
