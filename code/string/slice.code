// Slicing is not yet supported in Code, so we fake pointer arithmetic by
// reinterpreting a ^Any field as usize to advance it, then reading it back.

type Pointer_Wrapper = struct {
    value: ^Any
}

type Address_Wrapper = struct {
    value: usize
}

proc (str).slice(self, anon start_index: usize, anon stop_index: usize) -> str {
    let slice_pointer = Pointer_Wrapper(value: self.data().as(^Any))
    let slice_offset = (^slice_pointer).as(^Address_Wrapper)
    slice_offset.value = slice_offset.value + start_index
    let slice = String(
        data: slice_pointer.value.as([^]u8)
        length: stop_index - start_index
    )
    return (^slice).as(^str).^
}
