import compiler.source
import string

type Lexer = struct {
    source: source.Source
    source_content: [^]u8
    source_content_length: usize
    scan_position: usize
    scan_line: u32
    scan_column: u32
}

proc lex(source: source.Source) -> ^Token {
    let lexer = Lexer(
        source: source
        source_content: source.content.data()
        source_content_length: source.content.length
        scan_position: 0
        scan_line: 1
        scan_column: 1
    )

    let first: ^Token = null
    let last: ^Token = null
    loop {
        let scan_position = lexer.scan_position
        let space_before = 0u32
        while lexer.source_content[scan_position] == ' ' {
            scan_position = scan_position + 1
            space_before = space_before + 1
        }
        lexer.scan_column = lexer.scan_column + space_before

        let token = lexer.scan_token(scan_position)
        token.space_before = space_before

        lexer.scan_position = scan_position + token.lexeme.length
        if token.kind == .End_Of_Line {
            lexer.scan_line = lexer.scan_line + 1
            lexer.scan_column = 1
        } else {
            lexer.scan_column = lexer.scan_column + token.lexeme.length.as(u32)
        }

        if first == null {
            first = token
        } else {
            last.next = token
        }
        last = token

        if token.kind == .End_Of_File {
            token.next = token // null safety
            break
        }
    }

    return first
}

proc (^Lexer).scan_location(self) -> source.Source_Location {
    return source.Source_Location(source: self.source, line: self.scan_line, column: self.scan_column)
}


proc (^Lexer).scan_token(self, source_position: usize) -> ^Token {
    let next_char = self.source_content[source_position]
    if next_char.is_identifier_start() {
        return self.scan_identifier(source_position)
    }
    if next_char.is_digit() {
        return self.scan_integer(source_position)
    }
    if next_char == '\'' {
        return self.scan_character(source_position)
    }
    if next_char == '"' {
        return self.scan_string(source_position)
    }
    if next_char == '/' {
        return self.scan_comment(source_position)
    }
    if next_char == '\n' {
        return new_end_of_line(lexeme: self.source.content.slice(source_position, source_position + 1), location: self.scan_location())
    }
    if source_position >= self.source_content_length {
        return new_end_of_file(lexeme: "", location: self.scan_location())
    }
    return new_other(lexeme: self.source.content.slice(source_position, source_position + 1), location: self.scan_location())
}

proc (^Lexer).scan_character(self, source_position: usize) -> ^Token {
    let position = source_position + 1
    let body_char = self.source_content[position]
    if body_char < ' ' or body_char == '\'' {
        return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
    }
    position = position + 1
    let char_value = body_char
    if body_char == '\\' {
        let escape_char = self.source_content[position]
        if not escape_char.is_escape_char() {
            return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
        }
        position = position + 1
        char_value = escape_char.escape_char_value()
    }
    if self.source_content[position] != '\'' {
        return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
    }
    position = position + 1
    return new_character(lexeme: self.source.content.slice(source_position, position), location: self.scan_location(), value: char_value)
}

proc (^Lexer).scan_comment(self, source_position: usize) -> ^Token {
    let position = source_position + 1
    if self.source_content[position] == '/' {
        position = position + 1
        while position < self.source_content_length and self.source_content[position] != '\n' {
            position = position + 1
        }
        return new_comment(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
    }
    return new_other(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
}

proc (^Lexer).scan_identifier(self, source_position: usize) -> ^Identifier {
    let position = source_position + 1
    while self.source_content[position].is_identifier_char() {
        position = position + 1
    }
    return new_identifier(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
}

proc (^Lexer).scan_integer(self, source_position: usize) -> ^Integer {
    let value = 0u64
    let base = 10
    let position = source_position
    if self.source_content[position] == '0' {
        position = position + 1
        if self.source_content[position] == 'x' {
            base = 16
            position = position + 1
            loop {
                let hex_char = self.source_content[position]
                if hex_char.is_digit() {
                    value = value * 16 + (hex_char - '0').as(u64)
                    position = position + 1
                } else if hex_char >= 'a' and hex_char <= 'f' {
                    value = value * 16 + (hex_char - 'a' + 10).as(u64)
                    position = position + 1
                } else if hex_char >= 'A' and hex_char <= 'F' {
                    value = value * 16 + (hex_char - 'A' + 10).as(u64)
                    position = position + 1
                } else if hex_char == '_' {
                    position = position + 1
                } else {
                    break
                }
            }
        }
    } else {
        loop {
            let digit = self.source_content[position]
            if not digit.is_digit() {
                break
            }
            value = value * 10 + (digit - '0').as(u64)
            position = position + 1
        }
    }
    return new_integer(lexeme: self.source.content.slice(source_position, position), location: self.scan_location(), value: value, base: base)
}

proc (^Lexer).scan_string(self, source_position: usize) -> ^Token {
    let position = source_position + 1
    let value = string.new_builder()
    loop {
        if position >= self.source_content_length {
            return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
        }
        let next_char = self.source_content[position]
        if next_char == '"' {
            break
        }
        if next_char < ' ' {
            return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
        }
        if next_char == '\\' {
            position = position + 1
            let escape_char = self.source_content[position]
            if not escape_char.is_escape_char() {
                return new_error(lexeme: self.source.content.slice(source_position, position), location: self.scan_location())
            }
            value.append_char(escape_char.escape_char_value())
        } else {
            value.append_char(next_char)
        }
        position = position + 1
    }
    position = position + 1
    return new_string(lexeme: self.source.content.slice(source_position, position), location: self.scan_location(), value: value.build())
}

proc (u8).escape_char_value(self) -> u8 {
    if self == 'n' {
        return '\n'
    }
    if self == 't' {
        return '\t'
    }
    if self == '0' {
        return '\0'
    }
    if self == 'e' {
        return '\e'
    }
    return self
}

proc (u8).is_escape_char(self) -> bool {
    return self == 'n' or self == '"' or self == '\'' or self == '\\' or self == 't' or self == '0' or self == 'e'
}

proc (u8).is_identifier_start(self) -> bool {
    return (self >= 'a' and self <= 'z') or (self >= 'A' and self <= 'Z') or (self == '_')
}

proc (u8).is_identifier_char(self) -> bool {
    return self.is_identifier_start() or self.is_digit()
}

proc (u8).is_digit(self) -> bool {
    return self >= '0' and self <= '9'
}
