import allocator
import compiler.source
import string

type Token_Kind = enum {
    Character
    Comment
    End_Of_File
    End_Of_Line
    Error
    Identifier
    Integer
    Other
    Space
    String
}

type Token = struct {
    kind: Token_Kind
    lexeme: str
    location: source.Source_Location
}

type Character = struct {
    super: Token
    value: u8
}

proc new_character(lexeme: str, location: source.Source_Location, value: u8) -> ^Character {
    let result = allocator.alloc(size: type_size(Character), alignment: type_alignment(Character)).as(^Character)
    result.^ = Character(
        super: Token(kind: .Character, lexeme: lexeme, location: location)
        value: value
    )
    return result
}

type Comment = struct {
    super: Token
}

proc new_comment(lexeme: str, location: source.Source_Location) -> ^Comment {
    let result = allocator.alloc(size: type_size(Comment), alignment: type_alignment(Comment)).as(^Comment)
    result.^ = Comment(
        super: Token(kind: .Comment, lexeme: lexeme, location: location)
    )
    return result
}

type End_Of_File = struct {
    super: Token
}

proc new_end_of_file(lexeme: str, location: source.Source_Location) -> ^End_Of_File {
    let result = allocator.alloc(size: type_size(End_Of_File), alignment: type_alignment(End_Of_File)).as(^End_Of_File)
    result.^ = End_Of_File(
        super: Token(kind: .End_Of_File, lexeme: lexeme, location: location)
    )
    return result
}

type End_Of_Line = struct {
    super: Token
}

proc new_end_of_line(lexeme: str, location: source.Source_Location) -> ^End_Of_Line {
    let result = allocator.alloc(size: type_size(End_Of_Line), alignment: type_alignment(End_Of_Line)).as(^End_Of_Line)
    result.^ = End_Of_Line(
        super: Token(kind: .End_Of_Line, lexeme: lexeme, location: location)
    )
    return result
}

type Error = struct {
    super: Token
}

proc new_error(lexeme: str, location: source.Source_Location) -> ^Error {
    let result = allocator.alloc(size: type_size(Error), alignment: type_alignment(Error)).as(^Error)
    result.^ = Error(
        super: Token(kind: .Error, lexeme: lexeme, location: location)
    )
    return result
}

type Identifier = struct {
    super: Token
}

proc new_identifier(lexeme: str, location: source.Source_Location) -> ^Identifier {
    let result = allocator.alloc(size: type_size(Identifier), alignment: type_alignment(Identifier)).as(^Identifier)
    result.^ = Identifier(
        super: Token(kind: .Identifier, lexeme: lexeme, location: location)
    )
    return result
}

type Integer = struct {
    super: Token
    value: u64
    base: i32
}

proc new_integer(lexeme: str, location: source.Source_Location, value: u64, base: i32) -> ^Integer {
    let result = allocator.alloc(size: type_size(Integer), alignment: type_alignment(Integer)).as(^Integer)
    result.^ = Integer(
        super: Token(kind: .Integer, lexeme: lexeme, location: location)
        value: value
        base: base
    )
    return result
}

type Other = struct {
    super: Token
}

proc new_other(lexeme: str, location: source.Source_Location) -> ^Other {
    let result = allocator.alloc(size: type_size(Other), alignment: type_alignment(Other)).as(^Other)
    result.^ = Other(
        super: Token(kind: .Other, lexeme: lexeme, location: location)
    )
    return result
}

type Space = struct {
    super: Token
    count: i32
}

proc new_space(lexeme: str, location: source.Source_Location, count: i32) -> ^Space {
    let result = allocator.alloc(size: type_size(Space), alignment: type_alignment(Space)).as(^Space)
    result.^ = Space(
        super: Token(kind: .Space, lexeme: lexeme, location: location)
        count: count
    )
    return result
