import allocator
import compiler.source
import string

type Token_Kind = enum {
    Character
    Comment
    End_Of_File
    End_Of_Line
    Error
    Identifier
    Integer
    Other
    String
}

type Token = struct {
    kind: Token_Kind
    lexeme: str
    location: source.Source_Location
    next: ^Token
    space_before: u32
}

type Character = struct {
    super: Token
    value: u8
}

proc new_character(lexeme: str, location: source.Source_Location, value: u8) -> ^Character {
    return allocator.new(Character(
        super: Token(kind: .Character, lexeme: lexeme, location: location, next: null, space_before: 0)
        value: value
    ))
}

type Comment = struct {
    super: Token
}

proc new_comment(lexeme: str, location: source.Source_Location) -> ^Comment {
    return allocator.new(Comment(
        super: Token(kind: .Comment, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type End_Of_File = struct {
    super: Token
}

proc new_end_of_file(lexeme: str, location: source.Source_Location) -> ^End_Of_File {
    return allocator.new(End_Of_File(
        super: Token(kind: .End_Of_File, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type End_Of_Line = struct {
    super: Token
}

proc new_end_of_line(lexeme: str, location: source.Source_Location) -> ^End_Of_Line {
    return allocator.new(End_Of_Line(
        super: Token(kind: .End_Of_Line, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type Error = struct {
    super: Token
}

proc new_error(lexeme: str, location: source.Source_Location) -> ^Error {
    return allocator.new(Error(
        super: Token(kind: .Error, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type Identifier = struct {
    super: Token
}

proc new_identifier(lexeme: str, location: source.Source_Location) -> ^Identifier {
    return allocator.new(Identifier(
        super: Token(kind: .Identifier, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type Integer = struct {
    super: Token
    value: u64
    base: i32
}

proc new_integer(lexeme: str, location: source.Source_Location, value: u64, base: i32) -> ^Integer {
    return allocator.new(Integer(
        super: Token(kind: .Integer, lexeme: lexeme, location: location, next: null, space_before: 0)
        value: value
        base: base
    ))
}

type Other = struct {
    super: Token
}

proc new_other(lexeme: str, location: source.Source_Location) -> ^Other {
    return allocator.new(Other(
        super: Token(kind: .Other, lexeme: lexeme, location: location, next: null, space_before: 0)
    ))
}

type String = struct {
    super: Token
    value: str
}

proc new_string(lexeme: str, location: source.Source_Location, value: str) -> ^String {
    return allocator.new(String(
        super: Token(kind: .String, lexeme: lexeme, location: location, next: null, space_before: 0)
        value: value
    ))
}

proc (^Identifier).merge_with(self, separator: ^Other, another: ^Identifier) -> ^Identifier {
    // Make sure separator follows self, and another follows separator
    if self.lexeme.address() + self.lexeme.length != separator.lexeme.address() {
        panic "Cannot merge identifier with separator"
    }
    if separator.lexeme.address() + separator.lexeme.length != another.lexeme.address() {
        panic "Cannot merge separator with another"
    }

    // Merge by extending self's lexeme
    let merged = new_identifier(
        lexeme: self.lexeme.slice(0, self.lexeme.length + separator.lexeme.length + another.lexeme.length)
        location: self.location
    )
    merged.space_before = self.space_before
    return merged
}

proc (^Other).merge_with(self, another: ^Other) -> ^Other {
    // Make sure another follows self
    if self.lexeme.address() + self.lexeme.length != another.lexeme.address() {
        panic "Cannot merge other with another"
    }

    // Merge by extending self's lexeme
    let merged = new_other(
        lexeme: self.lexeme.slice(0, self.lexeme.length + another.lexeme.length)
        location: self.location
    )
    merged.space_before = self.space_before
    return merged
}
