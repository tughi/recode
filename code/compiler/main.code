import compiler.lexer
// import compiler.lowerer
// import compiler.parser
// import compiler.printer
import compiler.source
import libc
import string

proc main(argc: i32, argv: [^][^]u8) -> i32 {
    let arg = 1
    let output_dir = ""
    let binary_name: str = ""
    while arg < argc and argv[arg][0] == '-' {
        let option = argv[arg].to_str()
        if option.equals("-h") or option.equals("--help") {
            libc.stderr.write("Usage: \e[1mReCode\e[0m [OPTIONS] <SOURCE-DIR> [PACKAGE]").end_line()
            libc.stderr.end_line()
            libc.stderr.write("Arguments:").end_line()
            libc.stderr.write("  \e[1m<SOURCE-DIR>\e[0m                Path to the source directory").end_line()
            libc.stderr.write("  \e[1m[PACKAGE]\e[0m                   The specific package name to build (optional)").end_line()
            libc.stderr.end_line()
            libc.stderr.write("Options:").end_line()
            libc.stderr.write("  \e[1m-o\e[0m, \e[1m--output\e[0m <DIR>          Output directory [default: ./build]").end_line()
            libc.stderr.write("  \e[1m-n\e[0m, \e[1m--name\e[0m <NAME>           Name of the resulting executable [default: PACKAGE or app]").end_line()
            libc.stderr.write("  \e[1m-h\e[0m, \e[1m--help\e[0m                  Show this help message").end_line()
            return 0
        } else if option.equals("-o") or option.equals("--output") {
            arg = arg + 1
            if arg >= argc {
                libc.stderr.write("Expected <DIR> after ").write(option).end_line()
                return 1
            }
            output_dir = argv[arg].to_str()
            arg = arg + 1
        } else if option.equals("-n") or option.equals("--name") {
            arg = arg + 1
            if arg >= argc {
                libc.stderr.write("Expected <NAME> after ").write(option).end_line()
                return 1
            }
            binary_name = argv[arg].to_str()
            arg = arg + 1
        } else {
            libc.stderr.write("Unknown option: ").write(option).end_line()
            return 1
        }
    }

    if arg >= argc {
        libc.stderr.write("Missing <SOURCE-DIR>").end_line()
        return 1
    }

    let source_dir = argv[arg].to_str()
    arg = arg + 1

    let package_name: str = ""
    if arg < argc {
        package_name = argv[arg].to_str()
        arg = arg + 1
    }

    if arg < argc {
        libc.stderr.write("Too many arguments").end_line()
        return 1
    }

    if binary_name.equals("") {
        binary_name = "app"
    }

    let result = source.load(source_dir)
    if not result.error.equals("") {
        return 1
    }

    let source_lexer = lexer.create(result.source)

    loop {
        let token = source_lexer.peek_token()
        if token.kind == .End_Of_File {
            libc.stdout.write(token.kind.name).end_line()
            break
        } else if token.kind == .End_Of_Line {
            libc.stdout.write(token.kind.name).end_line()
        } else if token.kind == .Space {
            libc.stdout.write(token.kind.name).write(".count: ").write_i64(token.as(^lexer.Space).count.as(i64)).end_line()
        } else {
            libc.stdout.write(token.kind.name).write(": ").write(token.lexeme).end_line()
        }
        source_lexer.consume_token()
    }


    // let main_package = try parser.parse(source_dir: source_dir, package_name: package_name, binary_name: binary_name) else {
    //     libc.stderr.write(parser_error: error).write(": Error: ").write(error.message).end_line()
    //     return 1
    // }

    // let builtin_package = try parser.parse(source_dir: "code", package_name: "builtin", binary_name: nil) else {
    //     libc.stderr.write(parser_error: error).write(": Error: ").write(error.message).end_line()
    //     return 1
    // }

    // let checked_package = try checker.check(builtin_package: builtin_package, main_package: main_package) else {
    //     libc.stderr.write(parser_error: error).write(": Error: ").write(error.message).end_line()
    //     return 1
    // }

    // let ir_program = lowerer.lower(checked_package)

    // let path_builder = string.new_builder()
    // path_builder.append(output_dir)
    // if output_dir.length > 0 and output_dir.char_at(output_dir.length - 1) != '/' {
    //     path_builder.append_char('/')
    // }
    // if binary_name is str as name {
    //     path_builder.append(name)
    // }
    // path_builder.append(".ir")
    // let path = path_builder.build()

    // let file = libc.fopen(path.data(), "w".data())
    // if file == null {
    //     libc.stderr.write("Cannot open file: ").write(path).end_line()
    //     return 1
    // }
    // defer libc.fclose(file)

    // printer.print(program: ir_program, file: file)

    return 0
}
