import allocator
import compiler.parser
import compiler.parser.dump
import compiler.source
import libc

proc main(anon argc: i32, anon argv: [^][^]u8) -> i32 {
    try allocator.default_allocator.reserve(size: 64 * 1024 * 1024) else {
        libc.stderr.write("Error: ").write(error.message).end_line()
        return 1
    }

    if argc < 2 {
        libc.stderr.write("Usage: ReCode <source.code>").end_line()
        return 1
    }

    let source = try source.load(argv[1].to_str()) else {
        libc.stderr.write("Error: ").write(error).end_line()
        return 1
    }

    let statements = try parser.parse(source) else {
        libc.stderr.write(parser_error: error).write(": Error: ").write(error.message).end_line()
        return 1
    }

    statements.dump()

    return 0
}
