import compiler.parser
import compiler.source
import libc

proc main() -> i32 {
    let source = try source.load("tests/01__basics/001__first_procedure/test.code") else {
        libc.stderr.write("Error: ").write(error).end_line()
        return 1
    }

    libc.stdout.write(source.content)

    try parser.parse(source) else {
        libc.stderr.write(parser_error: error).write(": Error: ").write(error.message).end_line()
    }

    return 0
}
