import allocator
import libc

type Source = struct {
    path: str
    content: str
}

proc load(file_path: str) -> Source {
    let file = libc.fopen(file_path.data(), "r".data())
    if file == null {
        panic "Failed to open file"
    }

    if libc.fseek(file, 0, libc.SEEK_END) != 0 {
        libc.fclose(file)
        panic "Failed to seek to end of file"
    }
    let file_size = libc.ftell(file).as(usize)
    if libc.fseek(file, 0, libc.SEEK_SET) != 0 {
        libc.fclose(file)
        panic "Failed to seek to start of file"
    }

    let content = allocator.alloc(size: file_size + 1, alignment: 1).as([^]u8)
    let read_size = libc.fread(content, 1, file_size, file)
    if read_size != file_size {
        libc.fclose(file)
        panic "Failed to read file to memory"
    }
    content[file_size] = 0

    libc.fclose(file)

    let result = String(data: content, length: file_size)

    return Source(
        path: file_path
        content: (^result).as(^str).^
    )
}
