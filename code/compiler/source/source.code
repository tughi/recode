import libc
import string

type Source = struct {
    path: str
    content: str
}

proc load(anon file_path: str) -> Source !> str {
    let file = libc.fopen(file_path.data(), "r".data())
    if file == null {
        raise "Failed to open the file"
    }

    if libc.fseek(file, 0, libc.SEEK_END) != 0 {
        libc.fclose(file)
        raise "Failed to seek to end of file"
    }
    let file_size = libc.ftell(file)
    if libc.fseek(file, 0, libc.SEEK_SET) != 0 {
        libc.fclose(file)
        raise "Failed to seek to start of file"
    }

    let content = libc.malloc((file_size + 1).as(usize)).as([^]u8)
    if content == null {
        libc.fclose(file)
        raise "Failed to allocate memory"
    }
    let read_size = libc.fread(content, 1, file_size, file)
    if read_size != file_size {
        libc.free(content.as(^Any))
        libc.fclose(file)
        raise "Failed to read file to memory"
    }
    content[file_size] = 0

    libc.fclose(file)

    let result = String(data: content, length: file_size.as(usize))

    return Source(
        path: file_path
        content: (^result).as(^str).^
    )
}

proc (^libc.FILE).write_source_location(file, anon source: Source, anon source_position: usize) -> ^libc.FILE {
    file.write(source.path).write_char(':')

    let column = 1i64

    let index = source_position
    let source_content = source.content.data()
    while index > 0 and source_content[index] != '\n' {
        column = column + 1
        index = index - 1
    }

    let line = 1i64
    while index > 0 {
        if source_content[index] == '\n' {
            line = line + 1
        }
        index = index - 1
    }

    return file.write_integer(line).write_char(':').write_integer(column)
}
