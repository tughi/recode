import compiler.ir
import libc

proc print(program: ^ir.Program, file: ^libc.FILE) {
    let procedure = program.first_procedure
    let first = true
    while procedure != null {
        if not first {
            file.end_line()
        }
        first = false
        print_procedure(procedure, file: file)
        procedure = procedure.next
    }
}

proc print_procedure(procedure: ^ir.Procedure, file: ^libc.FILE) {
    file.write_char(char: '$').write(procedure.name).write_char(char: '(')
    let parameter = procedure.first_parameter
    let first = true
    while parameter != null {
        if not first {
            file.write(", ")
        }
        first = false
        print_value_definition(parameter, file: file)
        parameter = parameter.next
    }
    file.write_char(char: ')')
    if procedure.return_type.kind != .Nothing {
        file.write(": ")
        print_type(procedure.return_type, file: file)
    }
    file.write(" {").end_line()

    let block = procedure.first_block
    while block != null {
        print_block(block, file: file)
        block = block.next
    }

    file.write_char(char: '}').end_line()
}

proc print_block(block: ^ir.Block, file: ^libc.FILE) {
    file.write_char(char: '@').write_u64(value: block.label.as(u64)).write_char(char: ':').end_line()
    let instruction = block.first_instruction
    while instruction != null {
        file.write("  ")
        print_instruction(instruction, file: file)
        file.end_line()
        instruction = instruction.next
    }
}

proc print_instruction(instruction: ^ir.Instruction, file: ^libc.FILE) {
    if instruction.kind == .Add {
        print_binary_instruction(instruction.as(^ir.Binary_Instruction), "add", file: file)
    } else if instruction.kind == .Alloc {
        let alloc_instruction = instruction.as(^ir.Alloc_Instruction)
        print_value_definition(^alloc_instruction.result, file: file)
        file.write(" = alloc ")
        print_type(alloc_instruction.type, file: file)
    } else if instruction.kind == .Call {
        let call_instruction = instruction.as(^ir.Call_Instruction)
        if call_instruction.result.type.kind != .Nothing {
            print_value_definition(^call_instruction.result, file: file)
            file.write(" = ")
        }
        file.write("call $").write(call_instruction.callee.name)
        let argument = call_instruction.first_argument
        while argument != null {
            file.write_char(char: ' ')
            print_value_reference(argument.value, file: file)
            argument = argument.next
        }
    } else if instruction.kind == .Const {
        let const_instruction = instruction.as(^ir.Const_Instruction)
        print_value_definition(^const_instruction.result, file: file)
        file.write(" = const ").write_u64(value: const_instruction.literal.value)
    } else if instruction.kind == .Divide {
        print_binary_instruction(instruction.as(^ir.Binary_Instruction), "div", file: file)
    } else if instruction.kind == .Load {
        let load_instruction = instruction.as(^ir.Load_Instruction)
        print_value_definition(^load_instruction.result, file: file)
        file.write(" = load ")
        print_value_reference(load_instruction.pointer, file: file)
    } else if instruction.kind == .Modulo {
        print_binary_instruction(instruction.as(^ir.Binary_Instruction), "mod", file: file)
    } else if instruction.kind == .Multiply {
        print_binary_instruction(instruction.as(^ir.Binary_Instruction), "mul", file: file)
    } else if instruction.kind == .Ret {
        let ret_instruction = instruction.as(^ir.Ret_Instruction)
        file.write("ret")
        if ret_instruction.value != null {
            file.write_char(char: ' ')
            print_value_reference(ret_instruction.value, file: file)
        }
    } else if instruction.kind == .Store {
        let store_instruction = instruction.as(^ir.Store_Instruction)
        file.write("store ")
        print_value_reference(store_instruction.pointer, file: file)
        file.write_char(char: ' ')
        print_value_reference(store_instruction.value, file: file)
    } else if instruction.kind == .Subtract {
        print_binary_instruction(instruction.as(^ir.Binary_Instruction), "sub", file: file)
    }
}

proc print_binary_instruction(instruction: ^ir.Binary_Instruction, operation: str, file: ^libc.FILE) {
    print_value_definition(^instruction.result, file: file)
    file.write(" = ").write(operation).write_char(char: ' ')
    print_value_reference(instruction.left, file: file)
    file.write_char(char: ' ')
    print_value_reference(instruction.right, file: file)
}

proc print_value_definition(value: ^ir.Value, file: ^libc.FILE) {
    print_value_reference(value, file: file)
    file.write(": ")
    print_type(value.type, file: file)
}

proc print_value_reference(value: ^ir.Value, file: ^libc.FILE) {
    file.write_char(char: '%').write(value.name)
}

proc print_type(type: ^ir.Type, file: ^libc.FILE) {
    if type.kind == .Nothing {
        panic
    } else if type.kind == .Pointer {
        file.write_char(char: '[')
        print_type(type.as(^ir.Pointer_Type).pointee, file: file)
        file.write_char(char: ']')
    } else if type.kind == .Primitive {
        file.write(type.as(^ir.Primitive_Type).name)
    }
}
