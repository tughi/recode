import compiler.checker.checked
import compiler.parser.parsed
import compiler.source
import libc
import string

type Checker = struct {
    builtin_symbols: ^checked.Symbols
    global_symbols: ^checked.Symbols
    current_scope: ^checked.Symbols
    return_type: ^checked.Type
    bool_type: ^checked.Type
    i32_type: ^checked.Type
    null_type: ^checked.Type
}

proc check(builtin_package: ^parsed.Package, main_package: ^parsed.Package) -> ^checked.Package {
    let checker = Checker(
        builtin_symbols: checked.new_symbols(null)
        global_symbols: null
        current_scope: null
        return_type: null
        bool_type: null
        i32_type: null
        null_type: checked.new_null_type()
    )

    checker.check_builtin_package(builtin_package)

    return checker.check_package(main_package)
}

proc (^Checker).check_builtin_package(self, parsed_package: ^parsed.Package) {
    let module = parsed_package.first_module
    while module != null {
        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Type {
                self.check_builtin_type_statement(statement.as(^parsed.Type_Statement))
            } else {
                panic "Not supported yet: builtin statement"
            }
            statement = statement.next
        }
        module = module.next_module
    }
}

proc (^Checker).check_builtin_type_statement(self, type_statement: ^parsed.Type_Statement) {
    if type_statement.specifier.kind != .Builtin {
        return
    }
    let name = type_statement.name.lexeme
    let kind = self.builtin_type_kind(name)
    let type = checked.new_named_type(kind: kind, name: name).as(^checked.Type)
    let symbol = checked.new_type_symbol(name: name, type: type).as(^checked.Symbol)
    self.builtin_symbols.append(name: name, symbol: symbol)
    if kind == .bool {
        self.bool_type = type
    } else if kind == .i32 {
        self.i32_type = type
    }
}

proc (^Checker).builtin_type_kind(self, name: str) -> checked.Type_Kind {
    if name.equals("Any") {
        return .Any
    } else if name.equals("bool") {
        return .bool
    } else if name.equals("i8") {
        return .i8
    } else if name.equals("i16") {
        return .i16
    } else if name.equals("i32") {
        return .i32
    } else if name.equals("i64") {
        return .i64
    } else if name.equals("isize") {
        return .isize
    } else if name.equals("str") {
        return .str
    } else if name.equals("u8") {
        return .u8
    } else if name.equals("u16") {
        return .u16
    } else if name.equals("u32") {
        return .u32
    } else if name.equals("u64") {
        return .u64
    } else if name.equals("usize") {
        return .usize
    }
    panic "Unknown builtin type"
}

proc (^Checker).check_package(self, parsed_package: ^parsed.Package) -> ^checked.Package {
    let global_symbols = checked.new_symbols(null)
    self.global_symbols = global_symbols

    let checked_package = checked.new_package(name: parsed_package.name, symbols: global_symbols)

    // Declare all procedure signatures first, so bodies can reference any procedure.
    let module = parsed_package.first_module
    let last_checked_module: ^checked.Module = null
    while module != null {
        let checked_module = checked.new_module(source: module.source)
        if last_checked_module == null {
            checked_package.first_module = checked_module
        } else {
            last_checked_module.next_module = checked_module
        }
        last_checked_module = checked_module

        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Procedure {
                self.check_procedure_signature(statement.as(^parsed.Procedure_Statement))
            } else if statement.kind == .Type {
                self.check_global_type_statement(statement.as(^parsed.Type_Statement))
            } else if statement.kind == .Variable {
                self.check_global_variable_statement(statement.as(^parsed.Variable_Statement))
            } else {
                panic "Not supported yet: package statement"
            }
            statement = statement.next
        }
        module = module.next_module
    }

    // Check all procedure bodies.
    module = parsed_package.first_module
    while module != null {
        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Procedure {
                self.check_procedure_body(statement.as(^parsed.Procedure_Statement))
            }
            statement = statement.next
        }
        module = module.next_module
    }

    return checked_package
}

proc (^Checker).check_global_variable_statement(self, variable_statement: ^parsed.Variable_Statement) {
    let variable_type: ^checked.Type = null
    if variable_statement.variable_type != null {
        variable_type = self.resolve_type(variable_statement.variable_type)
    }
    if variable_type == null {
        self.error(variable_statement.location, "Missing type")
    }
    let name = variable_statement.name.lexeme
    let external_name = ""
    if variable_statement.external_name != null {
        external_name = variable_statement.external_name.value
    }
    let variable_symbol = checked.new_variable_symbol(name: name, type: variable_type, is_global: true, is_external: variable_statement.is_external, external_name: external_name)
    self.global_symbols.append(name: name, symbol: variable_symbol.as(^checked.Symbol))
}

proc (^Checker).check_global_type_statement(self, type_statement: ^parsed.Type_Statement) {
    let name = type_statement.name.lexeme
    if type_statement.specifier.kind == .External {
        let type = checked.new_named_type(kind: .External, name: name).as(^checked.Type)
        let symbol = checked.new_type_symbol(name: name, type: type).as(^checked.Symbol)
        self.global_symbols.append(name: name, symbol: symbol)
    } else {
        panic "Not supported yet: type specifier"
    }
}

proc (^Checker).check_procedure_signature(self, procedure_statement: ^parsed.Procedure_Statement) {
    let name = procedure_statement.name.lexeme

    let return_type: ^checked.Type = null
    if procedure_statement.return_type != null {
        return_type = self.resolve_type(procedure_statement.return_type)
        if return_type.kind == .External {
            self.error(procedure_statement.return_type.location, "Cannot use external type as return type")
        }
    }

    let first_parameter: ^checked.Procedure_Parameter = null
    let last_parameter: ^checked.Procedure_Parameter = null
    let parsed_parameter = procedure_statement.first_parameter
    while parsed_parameter != null {
        let parameter_type = self.resolve_type(parsed_parameter.parameter_type)
        if parameter_type.kind == .External {
            self.error(parsed_parameter.parameter_type.location, "Cannot use external types as procedure parameters")
        }
        let parameter = checked.new_procedure_parameter(name: parsed_parameter.name.lexeme, parameter_type: parameter_type)
        if last_parameter == null {
            first_parameter = parameter
        } else {
            last_parameter.next = parameter
        }
        last_parameter = parameter
        parsed_parameter = parsed_parameter.next
    }

    let procedure_type = checked.new_procedure_type(first_parameter: first_parameter, return_type: return_type)
    let symbol = checked.new_procedure_symbol(name: name, procedure_type: procedure_type, body: null, is_external: procedure_statement.is_external).as(^checked.Symbol)
    self.global_symbols.append(name: name, symbol: symbol)
}

proc (^Checker).check_procedure_body(self, procedure_statement: ^parsed.Procedure_Statement) {
    if procedure_statement.is_external or procedure_statement.body == null {
        return
    }

    let name = procedure_statement.name.lexeme
    let procedure_symbol = self.global_symbols.find(name).as(^checked.Procedure_Symbol)

    let scope = checked.new_symbols(self.global_symbols)
    let parameter = procedure_symbol.procedure_type.first_parameter
    while parameter != null {
        let parameter_symbol = checked.new_parameter_symbol(name: parameter.name, type: parameter.parameter_type).as(^checked.Symbol)
        scope.append(name: parameter.name, symbol: parameter_symbol)
        parameter = parameter.next
    }
    self.current_scope = scope

    self.return_type = procedure_symbol.procedure_type.return_type
    if procedure_statement.body.kind == .Block {
        procedure_symbol.body = self.check_block_statement(procedure_statement.body.as(^parsed.Block_Statement))
    } else {
        panic "Not supported yet: procedure body"
    }
}

proc (^Checker).check_statement(self, parsed_statement: ^parsed.Statement) -> ^checked.Statement {
    if parsed_statement.kind == .Assignment {
        return self.check_assignment_statement(parsed_statement.as(^parsed.Assignment_Statement))
    } else if parsed_statement.kind == .Block {
        return self.check_block_statement(parsed_statement.as(^parsed.Block_Statement))
    } else if parsed_statement.kind == .Break {
        return self.check_break_statement(parsed_statement.as(^parsed.Break_Statement))
    } else if parsed_statement.kind == .Expression {
        return self.check_expression_statement(parsed_statement.as(^parsed.Expression_Statement))
    } else if parsed_statement.kind == .If {
        return self.check_if_statement(parsed_statement.as(^parsed.If_Statement))
    } else if parsed_statement.kind == .Loop {
        return self.check_loop_statement(parsed_statement.as(^parsed.Loop_Statement))
    } else if parsed_statement.kind == .Return {
        return self.check_return_statement(parsed_statement.as(^parsed.Return_Statement))
    } else if parsed_statement.kind == .Variable {
        return self.check_variable_statement(parsed_statement.as(^parsed.Variable_Statement))
    } else if parsed_statement.kind == .While {
        return self.check_while_statement(parsed_statement.as(^parsed.While_Statement))
    }
    panic "Not supported yet: statement"
}

proc (^Checker).check_assignment_statement(self, assignment_statement: ^parsed.Assignment_Statement) -> ^checked.Statement {
    let object = self.check_expression(assignment_statement.object, expected_type: null)
    if not object.is_mutable() {
        self.error(assignment_statement.object.location, "Cannot assign to immutable expression")
    }
    let value = self.check_expression(assignment_statement.value, expected_type: object.type)
    return checked.new_assignment_statement(object: object, value: value).as(^checked.Statement)
}

proc (^Checker).check_block_statement(self, parsed_block: ^parsed.Block_Statement) -> ^checked.Statement {
    let first_statement: ^checked.Statement = null
    let last_statement: ^checked.Statement = null
    let statement = parsed_block.first_statement
    while statement != null {
        let checked_statement = self.check_statement(statement)
        if checked_statement != null {
            if last_statement == null {
                first_statement = checked_statement
            } else {
                last_statement.next = checked_statement
            }
            last_statement = checked_statement
        }
        statement = statement.next
    }
    return checked.new_block_statement(first_statement: first_statement).as(^checked.Statement)
}

proc (^Checker).check_break_statement(self, break_statement: ^parsed.Break_Statement) -> ^checked.Statement {
    return checked.new_break_statement().as(^checked.Statement)
}

proc (^Checker).check_expression_statement(self, expression_statement: ^parsed.Expression_Statement) -> ^checked.Statement {
    let expression = self.check_expression(expression_statement.expression, expected_type: null)
    return checked.new_expression_statement(expression).as(^checked.Statement)
}

proc (^Checker).check_if_statement(self, if_statement: ^parsed.If_Statement) -> ^checked.Statement {
    let scope = checked.new_symbols(self.current_scope)
    self.current_scope = scope
    let condition = self.check_expression(if_statement.condition, expected_type: self.bool_type)
    let true_block = self.check_statement(if_statement.true_block)
    self.current_scope = scope.parent
    let false_statement: ^checked.Statement = null
    if if_statement.false_statement != null {
        false_statement = self.check_statement(if_statement.false_statement)
    }
    return checked.new_if_statement(condition: condition, true_block: true_block, false_statement: false_statement).as(^checked.Statement)
}

proc (^Checker).check_loop_statement(self, loop_statement: ^parsed.Loop_Statement) -> ^checked.Statement {
    let body = self.check_statement(loop_statement.body)
    return checked.new_loop_statement(body: body).as(^checked.Statement)
}

proc (^Checker).check_return_statement(self, return_statement: ^parsed.Return_Statement) -> ^checked.Statement {
    let expression: ^checked.Expression = null
    if return_statement.expression != null {
        expression = self.check_expression(return_statement.expression, expected_type: self.return_type)
        if self.return_type != null {
            self.require_same_type(self.return_type, expression.type, return_statement.expression.location)
        }
    } else if self.return_type != null {
        self.error(return_statement.location, "Missing return expression")
    }
    return checked.new_return_statement(expression: expression).as(^checked.Statement)
}

proc (^Checker).require_same_type(self, expected_type: ^checked.Type, actual_type: ^checked.Type, location: source.Source_Location) {
    if actual_type.kind == .Null {
        if expected_type.kind == .Pointer or expected_type.kind == .Procedure {
            return
        }
    }
    if not expected_type.equals(actual_type) {
        let message = string.new_builder()
        message.append("Expected type ").append(expected_type.name()).append(" but got ").append(actual_type.name())
        self.error(location, message.build())
    }
}

proc (^Checker).check_variable_statement(self, variable_statement: ^parsed.Variable_Statement) -> ^checked.Statement {
    let variable_type: ^checked.Type = null
    if variable_statement.variable_type != null {
        variable_type = self.resolve_type(variable_statement.variable_type)
    }

    let expression: ^checked.Expression = null
    if variable_statement.expression != null {
        expression = self.check_expression(variable_statement.expression, expected_type: variable_type)
        if variable_type == null {
            if expression.type.kind == .Null {
                self.error(variable_statement.expression.location, "Cannot infer type from null expression")
            }
            variable_type = expression.type
        }
    }

    if variable_type == null {
        self.error(variable_statement.location, "Missing type")
    }

    let name = variable_statement.name.lexeme
    let variable_symbol = checked.new_variable_symbol(name: name, type: variable_type, is_global: false, is_external: false, external_name: "")
    self.current_scope.append(name: name, symbol: variable_symbol.as(^checked.Symbol))
    return checked.new_variable_statement(symbol: variable_symbol, expression: expression).as(^checked.Statement)
}

proc (^Checker).check_while_statement(self, while_statement: ^parsed.While_Statement) -> ^checked.Statement {
    let scope = checked.new_symbols(self.current_scope)
    self.current_scope = scope
    let condition = self.check_expression(while_statement.condition, expected_type: self.bool_type)
    let body = self.check_statement(while_statement.body)
    self.current_scope = scope.parent
    return checked.new_while_statement(condition: condition, body: body).as(^checked.Statement)
}

proc (^Checker).check_expression(self, parsed_expression: ^parsed.Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    if parsed_expression.kind == .Add {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Add, expected_type: expected_type)
    } else if parsed_expression.kind == .Address_Of {
        return self.check_address_of_expression(parsed_expression.as(^parsed.Unary_Expression))
    } else if parsed_expression.kind == .Bool {
        return self.check_bool_expression(parsed_expression.as(^parsed.Bool_Expression))
    } else if parsed_expression.kind == .Call {
        return self.check_call_expression(parsed_expression.as(^parsed.Call_Expression))
    } else if parsed_expression.kind == .Cast {
        return self.check_cast_expression(parsed_expression.as(^parsed.Cast_Expression))
    } else if parsed_expression.kind == .Dereference {
        return self.check_dereference_expression(parsed_expression.as(^parsed.Unary_Expression))
    } else if parsed_expression.kind == .Divide {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Divide, expected_type: expected_type)
    } else if parsed_expression.kind == .Equals {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Equals)
    } else if parsed_expression.kind == .Greater {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Greater)
    } else if parsed_expression.kind == .Greater_Or_Equals {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Greater_Or_Equals)
    } else if parsed_expression.kind == .Identifier {
        return self.check_identifier_expression(parsed_expression.as(^parsed.Identifier_Expression))
    } else if parsed_expression.kind == .Integer {
        return self.check_integer_expression(parsed_expression.as(^parsed.Integer_Expression), expected_type: expected_type)
    } else if parsed_expression.kind == .Less {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Less)
    } else if parsed_expression.kind == .Less_Or_Equals {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Less_Or_Equals)
    } else if parsed_expression.kind == .Logic_And {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Logic_And, expected_type: self.bool_type)
    } else if parsed_expression.kind == .Logic_Or {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Logic_Or, expected_type: self.bool_type)
    } else if parsed_expression.kind == .Modulo {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Modulo, expected_type: expected_type)
    } else if parsed_expression.kind == .Multiply {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Multiply, expected_type: expected_type)
    } else if parsed_expression.kind == .Negate {
        return self.check_negate_expression(parsed_expression.as(^parsed.Unary_Expression), expected_type: expected_type)
    } else if parsed_expression.kind == .Not {
        return self.check_not_expression(parsed_expression.as(^parsed.Unary_Expression))
    } else if parsed_expression.kind == .Not_Equals {
        return self.check_comparison_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Not_Equals)
    } else if parsed_expression.kind == .Null {
        return self.check_null_expression(parsed_expression.as(^parsed.Null_Expression), expected_type: expected_type)
    } else if parsed_expression.kind == .Subtract {
        return self.check_binary_expression(parsed_expression.as(^parsed.Binary_Expression), kind: .Subtract, expected_type: expected_type)
    }
    panic "Not supported yet: expression"
}

proc (^Checker).check_address_of_expression(self, unary_expression: ^parsed.Unary_Expression) -> ^checked.Expression {
    let operand = self.check_expression(unary_expression.operand, expected_type: null)
    if not operand.is_mutable() {
        self.error(unary_expression.location, "Cannot take address of this expression")
    }
    let pointer_type = checked.new_pointer_type(pointee: operand.type).as(^checked.Type)
    return checked.new_address_of_expression(operand: operand, type: pointer_type).as(^checked.Expression)
}

proc (^Checker).check_binary_expression(self, binary_expression: ^parsed.Binary_Expression, kind: checked.Expression_Kind, expected_type: ^checked.Type) -> ^checked.Expression {
    let left = self.check_expression(binary_expression.left, expected_type: expected_type)
    let right = self.check_expression(binary_expression.right, expected_type: left.type)
    return checked.new_binary_expression(kind: kind, left: left, right: right, type: left.type).as(^checked.Expression)
}

proc (^Checker).check_bool_expression(self, bool_expression: ^parsed.Bool_Expression) -> ^checked.Expression {
    return checked.new_bool_expression(value: bool_expression.value, type: self.bool_type).as(^checked.Expression)
}

proc (^Checker).check_call_expression(self, call_expression: ^parsed.Call_Expression) -> ^checked.Expression {
    let callee = self.check_expression(call_expression.operand, expected_type: null)
    if callee.type.kind != .Procedure {
        self.error(call_expression.operand.location, "Not a procedure")
    }
    let procedure_type = callee.type.as(^checked.Procedure_Type)

    let first_argument: ^checked.Call_Argument = null
    let last_argument: ^checked.Call_Argument = null
    let parameter = procedure_type.first_parameter
    let parsed_argument = call_expression.first_argument
    while parameter != null {
        if parsed_argument == null {
            self.error(call_expression.location, "Too few arguments")
        }
        if parsed_argument.label != null {
            if parameter.name.length == 0 {
                self.error(parsed_argument.label.location, "Unexpected argument name: a procedure pointer has no parameter names")
            }
            if not parsed_argument.label.lexeme.equals(parameter.name) {
                let message = string.new_builder()
                self.error(parsed_argument.label.location, message.append("Expected argument name: ").append(parameter.name).build())
            }
        }
        let argument_expression = self.check_expression(parsed_argument.expression, expected_type: parameter.parameter_type)
        let argument = checked.new_call_argument(argument_expression)
        if last_argument == null {
            first_argument = argument
        } else {
            last_argument.next = argument
        }
        last_argument = argument
        parameter = parameter.next
        parsed_argument = parsed_argument.next
    }
    if parsed_argument != null {
        self.error(parsed_argument.expression.location, "Too many arguments")
    }

    return checked.new_call_expression(callee: callee, type: procedure_type.return_type, first_argument: first_argument).as(^checked.Expression)
}

proc (^Checker).check_cast_expression(self, cast_expression: ^parsed.Cast_Expression) -> ^checked.Expression {
    let target_type = self.resolve_type(cast_expression.target_type)
    let operand = self.check_expression(cast_expression.operand, expected_type: null)
    return checked.new_cast_expression(operand: operand, type: target_type).as(^checked.Expression)
}

proc (^Checker).check_comparison_expression(self, binary_expression: ^parsed.Binary_Expression, kind: checked.Expression_Kind) -> ^checked.Expression {
    let left = self.check_expression(binary_expression.left, expected_type: null)
    let right = self.check_expression(binary_expression.right, expected_type: left.type)
    return checked.new_binary_expression(kind: kind, left: left, right: right, type: self.bool_type).as(^checked.Expression)
}

proc (^Checker).check_dereference_expression(self, unary_expression: ^parsed.Unary_Expression) -> ^checked.Expression {
    let operand = self.check_expression(unary_expression.operand, expected_type: null)
    if operand.type.kind != .Pointer {
        self.error(unary_expression.location, "Not a pointer")
    }
    let pointee_type = operand.type.as(^checked.Pointer_Type).pointee
    return checked.new_dereference_expression(operand: operand, type: pointee_type).as(^checked.Expression)
}

proc (^Checker).check_identifier_expression(self, identifier_expression: ^parsed.Identifier_Expression) -> ^checked.Expression {
    let name = identifier_expression.name.lexeme
    let symbol = self.current_scope.find(name)
    if symbol == null {
        let message = string.new_builder()
        self.error(identifier_expression.location, message.append("Undefined symbol: ").append(name).build())
    }
    if symbol.kind == .Parameter {
        return checked.new_symbol_expression(symbol: symbol, type: symbol.as(^checked.Parameter_Symbol).type).as(^checked.Expression)
    } else if symbol.kind == .Procedure {
        return checked.new_symbol_expression(symbol: symbol, type: symbol.as(^checked.Procedure_Symbol).procedure_type.as(^checked.Type)).as(^checked.Expression)
    } else if symbol.kind == .Variable {
        return checked.new_symbol_expression(symbol: symbol, type: symbol.as(^checked.Variable_Symbol).type).as(^checked.Expression)
    }
    panic "Not supported yet: identifier symbol"
}

proc (^Checker).check_integer_expression(self, integer_expression: ^parsed.Integer_Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    let expression_type: ^checked.Type = null
    if integer_expression.type != null {
        expression_type = self.resolve_type(integer_expression.type)
    } else if expected_type != null {
        expression_type = expected_type
    }
    if expression_type == null {
        expression_type = self.i32_type
    }
    if expression_type == null {
        self.error(integer_expression.location, "Cannot infer type of integer literal")
    }
    return checked.new_integer_expression(token: integer_expression.token, type: expression_type).as(^checked.Expression)
}

proc (^Checker).check_negate_expression(self, unary_expression: ^parsed.Unary_Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    let operand = self.check_expression(unary_expression.operand, expected_type: expected_type)
    return checked.new_negate_expression(operand: operand, type: operand.type).as(^checked.Expression)
}

proc (^Checker).check_not_expression(self, unary_expression: ^parsed.Unary_Expression) -> ^checked.Expression {
    let operand = self.check_expression(unary_expression.operand, expected_type: self.bool_type)
    return checked.new_not_expression(operand: operand, type: operand.type).as(^checked.Expression)
}

proc (^Checker).check_null_expression(self, null_expression: ^parsed.Null_Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    let expression_type = expected_type
    if expression_type == null {
        expression_type = self.null_type
    } else if expression_type.kind != .Procedure {
        let message = string.new_builder()
        message.append("\"null\" cannot be used with non-pointer type: ")
        message.append(expression_type.name())
        self.error(null_expression.location, message.build())
    }
    return checked.new_null_expression(type: expression_type).as(^checked.Expression)
}

proc (^Checker).resolve_type(self, parsed_type: ^parsed.Type) -> ^checked.Type {
    if parsed_type.kind == .Named {
        let named_type = parsed_type.as(^parsed.Named_Type)
        let name = named_type.name.lexeme
        let symbol = self.global_symbols.find(name)
        if symbol == null {
            symbol = self.builtin_symbols.find(name)
        }
        if symbol == null {
            self.error(named_type.location, "Unknown type")
        }
        if symbol.kind == .Type {
            return symbol.as(^checked.Type_Symbol).type
        }
        self.error(named_type.location, "Symbol is not a type")
    } else if parsed_type.kind == .Pointer {
        let pointer_type = parsed_type.as(^parsed.Pointer_Type)
        let pointee = self.resolve_type(pointer_type.pointee)
        return checked.new_pointer_type(pointee: pointee).as(^checked.Type)
    } else if parsed_type.kind == .Procedure {
        let procedure_type = parsed_type.as(^parsed.Procedure_Type)
        let return_type: ^checked.Type = null
        if procedure_type.return_type != null {
            return_type = self.resolve_type(procedure_type.return_type)
        }
        let first_parameter: ^checked.Procedure_Parameter = null
        let last_parameter: ^checked.Procedure_Parameter = null
        let parsed_parameter = procedure_type.first_parameter
        while parsed_parameter != null {
            let parameter_type = self.resolve_type(parsed_parameter.parameter_type)
            let parameter = checked.new_procedure_parameter(name: "", parameter_type: parameter_type)
            if last_parameter == null {
                first_parameter = parameter
            } else {
                last_parameter.next = parameter
            }
            last_parameter = parameter
            parsed_parameter = parsed_parameter.next
        }
        return checked.new_procedure_type(first_parameter: first_parameter, return_type: return_type).as(^checked.Type)
    }
    panic "Not supported yet: type"
}

proc (^Checker).error(self, location: source.Source_Location, message: str) {
    libc.stderr.write(location.source.path).write_char(char: ':').write_u64(value: location.line.as(u64)).write_char(char: ':').write_u64(value: location.column.as(u64)).write(": ").write(message).end_line()
    panic
}
