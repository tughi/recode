import compiler.checker.checked
import compiler.parser.parsed
import compiler.source
import libc
import string

type Checker = struct {
    builtin_symbols: ^checked.Symbols
    global_symbols: ^checked.Symbols
    current_scope: ^checked.Symbols
    return_type: ^checked.Type
    current_location: source.Source_Location
}

proc check(builtin_package: ^parsed.Package, main_package: ^parsed.Package) -> ^checked.Package {
    let checker = Checker(
        builtin_symbols: checked.new_symbols(null)
        global_symbols: null
        current_scope: null
        return_type: null
        current_location: source.Source_Location(source: builtin_package.first_module.source, line: 0, column: 0)
    )

    checker.check_builtin_package(builtin_package)

    return checker.check_package(main_package)
}

proc (^Checker).check_builtin_package(self, parsed_package: ^parsed.Package) {
    let module = parsed_package.first_module
    while module != null {
        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Type {
                self.check_builtin_type_statement(statement.as(^parsed.Type_Statement))
            } else {
                panic "Not supported yet: builtin statement"
            }
            statement = statement.next
        }
        module = module.next_module
    }
}

proc (^Checker).check_builtin_type_statement(self, type_statement: ^parsed.Type_Statement) {
    self.current_location = type_statement.location
    if type_statement.specifier.kind != .Builtin {
        return
    }
    let name = type_statement.name.lexeme
    let type = checked.new_builtin_type(name: name).as(^checked.Type)
    let symbol = checked.new_type_symbol(name: name, type: type).as(^checked.Symbol)
    self.builtin_symbols.append(name: name, symbol: symbol)
}

proc (^Checker).check_package(self, parsed_package: ^parsed.Package) -> ^checked.Package {
    let global_symbols = checked.new_symbols(null)
    self.global_symbols = global_symbols

    let checked_package = checked.new_package(name: parsed_package.name, symbols: global_symbols)

    // Declare all procedure signatures first, so bodies can reference any procedure.
    let module = parsed_package.first_module
    let last_checked_module: ^checked.Module = null
    while module != null {
        let checked_module = checked.new_module(source: module.source)
        if last_checked_module == null {
            checked_package.first_module = checked_module
        } else {
            last_checked_module.next_module = checked_module
        }
        last_checked_module = checked_module

        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Procedure {
                self.check_procedure_signature(statement.as(^parsed.Procedure_Statement))
            } else {
                panic "Not supported yet: package statement"
            }
            statement = statement.next
        }
        module = module.next_module
    }

    // Check all procedure bodies.
    module = parsed_package.first_module
    while module != null {
        let statement = module.first_statement
        while statement != null {
            if statement.kind == .Procedure {
                self.check_procedure_body(statement.as(^parsed.Procedure_Statement))
            }
            statement = statement.next
        }
        module = module.next_module
    }

    return checked_package
}

proc (^Checker).check_procedure_signature(self, procedure_statement: ^parsed.Procedure_Statement) {
    self.current_location = procedure_statement.location
    let name = procedure_statement.name.lexeme

    let return_type: ^checked.Type = null
    if procedure_statement.return_type != null {
        return_type = self.resolve_type(procedure_statement.return_type)
    }

    let first_parameter: ^checked.Procedure_Parameter = null
    let last_parameter: ^checked.Procedure_Parameter = null
    let parsed_parameter = procedure_statement.first_parameter
    while parsed_parameter != null {
        let parameter_type = self.resolve_type(parsed_parameter.parameter_type)
        let parameter = checked.new_procedure_parameter(name: parsed_parameter.name.lexeme, parameter_type: parameter_type)
        if last_parameter == null {
            first_parameter = parameter
        } else {
            last_parameter.next = parameter
        }
        last_parameter = parameter
        parsed_parameter = parsed_parameter.next
    }

    let procedure_type = checked.new_procedure_type(first_parameter: first_parameter, return_type: return_type)
    let symbol = checked.new_procedure_symbol(name: name, procedure_type: procedure_type, body: null).as(^checked.Symbol)
    self.global_symbols.append(name: name, symbol: symbol)
}

proc (^Checker).check_procedure_body(self, procedure_statement: ^parsed.Procedure_Statement) {
    if procedure_statement.is_external or procedure_statement.body == null {
        return
    }

    let name = procedure_statement.name.lexeme
    let procedure_symbol = self.global_symbols.find(name).as(^checked.Procedure_Symbol)

    let scope = checked.new_symbols(self.global_symbols)
    let parameter = procedure_symbol.procedure_type.first_parameter
    while parameter != null {
        let parameter_symbol = checked.new_parameter_symbol(name: parameter.name, type: parameter.parameter_type).as(^checked.Symbol)
        scope.append(name: parameter.name, symbol: parameter_symbol)
        parameter = parameter.next
    }
    self.current_scope = scope

    self.return_type = procedure_symbol.procedure_type.return_type
    self.current_location = procedure_statement.location
    if procedure_statement.body.kind == .Block {
        procedure_symbol.body = self.check_block_statement(procedure_statement.body.as(^parsed.Block_Statement))
    } else {
        panic "Not supported yet: procedure body"
    }
}

proc (^Checker).check_block_statement(self, parsed_block: ^parsed.Block_Statement) -> ^checked.Statement {
    let first_statement: ^checked.Statement = null
    let last_statement: ^checked.Statement = null
    let statement = parsed_block.first_statement
    while statement != null {
        let checked_statement = self.check_statement(statement)
        if checked_statement != null {
            if last_statement == null {
                first_statement = checked_statement
            } else {
                last_statement.next = checked_statement
            }
            last_statement = checked_statement
        }
        statement = statement.next
    }
    return checked.new_block_statement(first_statement: first_statement).as(^checked.Statement)
}

proc (^Checker).check_statement(self, parsed_statement: ^parsed.Statement) -> ^checked.Statement {
    if parsed_statement.kind == .Block {
        return self.check_block_statement(parsed_statement.as(^parsed.Block_Statement))
    } else if parsed_statement.kind == .Expression {
        return self.check_expression_statement(parsed_statement.as(^parsed.Expression_Statement))
    } else if parsed_statement.kind == .Return {
        return self.check_return_statement(parsed_statement.as(^parsed.Return_Statement))
    }
    panic "Not supported yet: statement"
}

proc (^Checker).check_expression_statement(self, expression_statement: ^parsed.Expression_Statement) -> ^checked.Statement {
    self.current_location = expression_statement.location
    let expression = self.check_expression(expression_statement.expression, expected_type: null)
    return checked.new_expression_statement(expression).as(^checked.Statement)
}

proc (^Checker).check_return_statement(self, return_statement: ^parsed.Return_Statement) -> ^checked.Statement {
    self.current_location = return_statement.location
    let expression: ^checked.Expression = null
    if return_statement.expression != null {
        expression = self.check_expression(return_statement.expression, expected_type: self.return_type)
    } else if self.return_type != null {
        self.error("Missing return expression")
    }
    return checked.new_return_statement(expression: expression).as(^checked.Statement)
}

proc (^Checker).check_expression(self, parsed_expression: ^parsed.Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    if parsed_expression.kind == .Call {
        return self.check_call_expression(parsed_expression.as(^parsed.Call_Expression))
    } else if parsed_expression.kind == .Identifier {
        return self.check_identifier_expression(parsed_expression.as(^parsed.Identifier_Expression))
    } else if parsed_expression.kind == .Integer {
        return self.check_integer_expression(parsed_expression.as(^parsed.Integer_Expression), expected_type: expected_type)
    }
    panic "Not supported yet: expression"
}

proc (^Checker).check_identifier_expression(self, identifier_expression: ^parsed.Identifier_Expression) -> ^checked.Expression {
    self.current_location = identifier_expression.location
    let name = identifier_expression.name.lexeme
    let symbol = self.current_scope.find(name)
    if symbol == null {
        let message = string.new_builder()
        self.error(message.append("Undefined symbol: ").append(name).build())
    }
    if symbol.kind == .Parameter {
        return checked.new_symbol_expression(symbol: symbol, type: symbol.as(^checked.Parameter_Symbol).type).as(^checked.Expression)
    }
    panic "Not supported yet: identifier symbol"
}

proc (^Checker).check_call_expression(self, call_expression: ^parsed.Call_Expression) -> ^checked.Expression {
    self.current_location = call_expression.location
    if call_expression.operand.kind != .Identifier {
        self.error("Unsupported callee expression")
    }
    let operand = call_expression.operand.as(^parsed.Identifier_Expression)
    let name = operand.name.lexeme
    let symbol = self.global_symbols.find(name)
    if symbol == null {
        self.current_location = operand.location
        let message = string.new_builder()
        self.error(message.append("Undefined symbol: ").append(name).build())
    }
    if symbol.kind != .Procedure {
        self.error("Not a procedure")
    }
    let procedure_symbol = symbol.as(^checked.Procedure_Symbol)

    let first_argument: ^checked.Call_Argument = null
    let last_argument: ^checked.Call_Argument = null
    let parameter = procedure_symbol.procedure_type.first_parameter
    let parsed_argument = call_expression.first_argument
    while parameter != null {
        if parsed_argument == null {
            self.error("Too few arguments")
        }
        if parsed_argument.label != null {
            if not parsed_argument.label.lexeme.equals(parameter.name) {
                self.current_location = parsed_argument.label.location
                let message = string.new_builder()
                self.error(message.append("Expected argument name: ").append(parameter.name).build())
            }
        }
        let argument_expression = self.check_expression(parsed_argument.expression, expected_type: parameter.parameter_type)
        let argument = checked.new_call_argument(argument_expression)
        if last_argument == null {
            first_argument = argument
        } else {
            last_argument.next = argument
        }
        last_argument = argument
        parameter = parameter.next
        parsed_argument = parsed_argument.next
    }
    if parsed_argument != null {
        self.current_location = parsed_argument.expression.location
        self.error("Too many arguments")
    }

    return checked.new_call_expression(callee: procedure_symbol, type: procedure_symbol.procedure_type.return_type, first_argument: first_argument).as(^checked.Expression)
}

proc (^Checker).check_integer_expression(self, integer_expression: ^parsed.Integer_Expression, expected_type: ^checked.Type) -> ^checked.Expression {
    self.current_location = integer_expression.location
    let expression_type = expected_type
    if expression_type == null {
        let i32_symbol = self.builtin_symbols.find("i32")
        if i32_symbol != null {
            if i32_symbol.kind == .Type {
                expression_type = i32_symbol.as(^checked.Type_Symbol).type
            }
        }
    }
    if expression_type == null {
        self.error("Cannot infer type of integer literal")
    }
    return checked.new_integer_expression(token: integer_expression.token, type: expression_type).as(^checked.Expression)
}

proc (^Checker).resolve_type(self, parsed_type: ^parsed.Type) -> ^checked.Type {
    if parsed_type.kind == .Named {
        let named_type = parsed_type.as(^parsed.Named_Type)
        self.current_location = named_type.location
        let name = named_type.name.lexeme
        let symbol = self.global_symbols.find(name)
        if symbol == null {
            symbol = self.builtin_symbols.find(name)
        }
        if symbol == null {
            self.error("Unknown type")
        }
        if symbol.kind == .Type {
            return symbol.as(^checked.Type_Symbol).type
        }
        self.error("Symbol is not a type")
    }
    panic "Not supported yet: type"
}

proc (^Checker).error(self, message: str) {
    libc.stderr.write(self.current_location.source.path).write_char(char: ':').write_u64(value: self.current_location.line.as(u64)).write_char(char: ':').write_u64(value: self.current_location.column.as(u64)).write(": ").write(message).end_line()
    panic
}
