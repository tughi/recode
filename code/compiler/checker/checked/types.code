import allocator
import string.builder

type Type_Kind = enum {
    Any
    bool
    External
    i16
    i32
    i64
    i8
    isize
    Multi_Pointer
    Null
    Pointer
    Procedure
    str
    Struct
    u16
    u32
    u64
    u8
    usize
}

type Type = struct {
    kind: Type_Kind
}

type Multi_Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_multi_pointer_type(pointee: ^Type) -> ^Multi_Pointer_Type {
    let result = allocator.alloc(size: type_size(Multi_Pointer_Type), alignment: type_alignment(Multi_Pointer_Type)).as(^Multi_Pointer_Type)
    result.^ = Multi_Pointer_Type(
        super: Type(kind: .Multi_Pointer)
        pointee: pointee
    )
    return result
}

type Named_Type = struct {
    super: Type
    name: str
    package_name: str
}

proc (^Type).append_name(self, message: ^builder.Builder) {
    if self.kind == .Multi_Pointer {
        message.append("[^]")
        self.as(^Multi_Pointer_Type).pointee.append_name(message)
    } else if self.kind == .Null {
        message.append("null")
    } else if self.kind == .Pointer {
        message.append_char('^')
        self.as(^Pointer_Type).pointee.append_name(message)
    } else if self.kind == .Procedure {
        let procedure_type = self.as(^Procedure_Type)
        message.append("proc (")
        let parameter = procedure_type.first_parameter
        while parameter != null {
            parameter.parameter_type.append_name(message)
            parameter = parameter.next
            if parameter != null {
                message.append(", ")
            }
        }
        if procedure_type.return_type != null {
            message.append(") -> ")
            procedure_type.return_type.append_name(message)
        } else {
            message.append_char(')')
        }
    } else {
        let named_type = self.as(^Named_Type)
        if named_type.package_name.length > 0 {
            message.append(named_type.package_name).append_char('.')
        }
        message.append(named_type.name)
    }
}

proc (^Type).name(self) -> str {
    return self.as(^Named_Type).name
}

proc (^Type).equals(self, other: ^Type) -> bool {
    if self.kind != other.kind {
        return false
    }
    if self.kind == .External {
        return self.name().equals(other.name())
    }
    if self.kind == .Multi_Pointer {
        return self.as(^Multi_Pointer_Type).pointee.equals(other.as(^Multi_Pointer_Type).pointee)
    }
    if self.kind == .Pointer {
        return self.as(^Pointer_Type).pointee.equals(other.as(^Pointer_Type).pointee)
    }
    if self.kind == .Struct {
        return self.name().equals(other.name())
    }
    return true
}

proc new_named_type(kind: Type_Kind, name: str, package_name: str) -> ^Named_Type {
    let result = allocator.alloc(size: type_size(Named_Type), alignment: type_alignment(Named_Type)).as(^Named_Type)
    result.^ = Named_Type(
        super: Type(kind: kind)
        name: name
        package_name: package_name
    )
    return result
}

proc new_null_type() -> ^Type {
    let result = allocator.alloc(size: type_size(Type), alignment: type_alignment(Type)).as(^Type)
    result.^ = Type(kind: .Null)
    return result
}

type Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_pointer_type(pointee: ^Type) -> ^Pointer_Type {
    let result = allocator.alloc(size: type_size(Pointer_Type), alignment: type_alignment(Pointer_Type)).as(^Pointer_Type)
    result.^ = Pointer_Type(
        super: Type(kind: .Pointer)
        pointee: pointee
    )
    return result
}

type Procedure_Parameter = struct {
    name: str
    parameter_type: ^Type
    next: ^Procedure_Parameter
}

proc new_procedure_parameter(name: str, parameter_type: ^Type) -> ^Procedure_Parameter {
    let result = allocator.alloc(size: type_size(Procedure_Parameter), alignment: type_alignment(Procedure_Parameter)).as(^Procedure_Parameter)
    result.^ = Procedure_Parameter(name: name, parameter_type: parameter_type, next: null)
    return result
}

type Procedure_Type = struct {
    super: Type
    first_parameter: ^Procedure_Parameter
    return_type: ^Type
}

proc new_procedure_type(first_parameter: ^Procedure_Parameter, return_type: ^Type) -> ^Procedure_Type {
    let result = allocator.alloc(size: type_size(Procedure_Type), alignment: type_alignment(Procedure_Type)).as(^Procedure_Type)
    result.^ = Procedure_Type(
        super: Type(kind: .Procedure)
        first_parameter: first_parameter
        return_type: return_type
    )
    return result
}

type Struct_Member = struct {
    name: str
    type: ^Type
    next: ^Struct_Member
}

proc new_struct_member(name: str, type: ^Type) -> ^Struct_Member {
    let result = allocator.alloc(size: type_size(Struct_Member), alignment: type_alignment(Struct_Member)).as(^Struct_Member)
    result.^ = Struct_Member(name: name, type: type, next: null)
    return result
}

type Struct_Type = struct {
    super: Named_Type
    first_member: ^Struct_Member
    last_member: ^Struct_Member
}

proc new_struct_type(name: str, package_name: str) -> ^Struct_Type {
    let result = allocator.alloc(size: type_size(Struct_Type), alignment: type_alignment(Struct_Type)).as(^Struct_Type)
    result.^ = Struct_Type(
        super: Named_Type(super: Type(kind: .Struct), name: name, package_name: package_name)
        first_member: null
        last_member: null
    )
    return result
}

proc (^Struct_Type).find_member(self, name: str) -> ^Struct_Member {
    let member = self.first_member
    while member != null {
        if member.name.equals(name) {
            return member
        }
        member = member.next
    }
    return null
}

proc (^Struct_Type).append_member(self, member: ^Struct_Member) {
    if self.first_member == null {
        self.first_member = member
    } else {
        self.last_member.next = member
    }
    self.last_member = member
}
