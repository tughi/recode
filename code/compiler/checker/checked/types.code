import allocator
import collections
import libc

type Type_Kind = enum {
    Any
    Array
    bool
    Enum
    External
    i16
    i32
    i64
    i8
    isize
    Module
    Multi_Pointer
    Null
    Placeholder
    Pointer
    Procedure
    str
    Struct
    u16
    u32
    u64
    u8
    usize
}

type Type = struct {
    kind: Type_Kind
    hash: u64
}

proc (^Type).hash(self) -> u64 {
    return self.hash
}

proc combine_type_hash(hash: u64, value: u64) -> u64 {
    return (hash ^ value) * 1099511628211
}

proc type_kind_hash(kind: Type_Kind) -> u64 {
    return combine_type_hash(14695981039346656037u64, kind.value.as(u64))
}

proc named_type_hash(kind: Type_Kind, name: str) -> u64 {
    // The package is excluded: external types unify by name across packages.
    return combine_type_hash(type_kind_hash(kind), name.hash())
}

type Array_Type = struct {
    super: Type
    item_type: ^Type
    size: u64
}

proc array_type_hash(item_type: ^Type, size: u64) -> u64 {
    return combine_type_hash(combine_type_hash(type_kind_hash(.Array), item_type.hash()), size)
}

proc new_array_type(item_type: ^Type, size: u64) -> ^Array_Type {
    return allocator.new(Array_Type(
        super: Type(kind: .Array, hash: array_type_hash(item_type: item_type, size: size))
        item_type: item_type
        size: size
    ))
}

type Enum_Member = struct {
    name: str
    value: u64
}

proc new_enum_member(name: str, value: u64) -> ^Enum_Member {
    return allocator.new(Enum_Member(name: name, value: value))
}

type Enum_Type = struct {
    super: Named_Type
    members: collections.Map<str, ^Enum_Member>
}

proc enum_type_hash(name: str, package_name: str) -> u64 {
    return combine_type_hash(named_type_hash(kind: .Enum, name: name), package_name.hash())
}

proc new_enum_type(name: str, package_name: str) -> ^Enum_Type {
    return allocator.new(Enum_Type(
        super: Named_Type(
            super: Type(kind: .Enum, hash: enum_type_hash(name: name, package_name: package_name))
            name: name
            package_name: package_name
        )
        members: collections.empty_map<str, ^Enum_Member>()
    ))
}

proc (^Enum_Type).find_member(self, name: str) -> ^Enum_Member {
    return self.members.get(name)
}

proc (^Enum_Type).append_member(self, member: ^Enum_Member) {
    self.members.put(member.name, member)
}

type Multi_Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc multi_pointer_type_hash(pointee: ^Type) -> u64 {
    return combine_type_hash(type_kind_hash(.Multi_Pointer), pointee.hash())
}

proc new_multi_pointer_type(pointee: ^Type) -> ^Multi_Pointer_Type {
    return allocator.new(Multi_Pointer_Type(
        super: Type(kind: .Multi_Pointer, hash: multi_pointer_type_hash(pointee))
        pointee: pointee
    ))
}

type Named_Type = struct {
    super: Type
    name: str
    package_name: str
}

proc (^libc.FILE).write_checked_type(file, type: ^Type) -> ^libc.FILE {
    switch type.kind {
        case .Array {
            let array_type = type.as(^Array_Type)
            return file.write_char(char: '[').write_u64(value: array_type.size).write_char(char: ']').write_checked_type(array_type.item_type)
        }
        case .Multi_Pointer {
            return file.write("[^]").write_checked_type(type.as(^Multi_Pointer_Type).pointee)
        }
        case .Null {
            return file.write("null")
        }
        case .Placeholder {
            return file.write(type.as(^Placeholder_Type).name)
        }
        case .Pointer {
            return file.write_char(char: '^').write_checked_type(type.as(^Pointer_Type).pointee)
        }
        case .Procedure {
            let procedure_type = type.as(^Procedure_Type)
            file.write("proc (")
            let parameter = procedure_type.first_parameter
            while parameter != null {
                file.write_checked_type(parameter.parameter_type)
                parameter = parameter.next
                if parameter != null {
                    file.write(", ")
                }
            }
            if procedure_type.return_type != null {
                return file.write(") -> ").write_checked_type(procedure_type.return_type)
            }
            return file.write_char(char: ')')
        }
        else {
            let named_type = type.as(^Named_Type)
            if named_type.package_name.length > 0 {
                file.write(named_type.package_name).write_char(char: '.')
            }
            file.write(named_type.name)
            if type.kind == .Struct {
                let type_argument = type.as(^Struct_Type).first_type_argument
                if type_argument != null {
                    file.write_char(char: '<')
                    loop {
                        file.write_checked_type(type_argument.type)
                        type_argument = type_argument.next
                        if type_argument == null {
                            break
                        }
                        file.write(", ")
                    }
                    file.write_char(char: '>')
                }
            }
            return file
        }
    }
}

proc (^Type).name(self) -> str {
    return self.as(^Named_Type).name
}

proc (^Type).equals(self, other: ^Type) -> bool {
    if self == other {
        return true
    }
    if self.kind != other.kind {
        return false
    }
    switch self.kind {
        case .Procedure {
            // Procedure types are not interned: their parameters carry names the body checker relies on.
            let self_procedure = self.as(^Procedure_Type)
            let other_procedure = other.as(^Procedure_Type)
            let self_parameter = self_procedure.first_parameter
            let other_parameter = other_procedure.first_parameter
            while self_parameter != null and other_parameter != null {
                if not self_parameter.parameter_type.equals(other_parameter.parameter_type) {
                    return false
                }
                self_parameter = self_parameter.next
                other_parameter = other_parameter.next
            }
            if self_parameter != null or other_parameter != null {
                return false
            }
            if self_procedure.return_type == null or other_procedure.return_type == null {
                return self_procedure.return_type == other_procedure.return_type
            }
            return self_procedure.return_type.equals(other_procedure.return_type)
        }
        case .Struct {
            // Transient generic instances (unresolved type arguments) are never memoized.
            let self_struct = self.as(^Struct_Type)
            let other_struct = other.as(^Struct_Type)
            if self_struct.generic_symbol == null or self_struct.generic_symbol != other_struct.generic_symbol {
                return false
            }
            let self_type_argument = self_struct.first_type_argument
            let other_type_argument = other_struct.first_type_argument
            while self_type_argument != null {
                if not self_type_argument.type.equals(other_type_argument.type) {
                    return false
                }
                self_type_argument = self_type_argument.next
                other_type_argument = other_type_argument.next
            }
            return true
        }
        else {
            return false
        }
    }
}

proc new_named_type(kind: Type_Kind, name: str, package_name: str) -> ^Named_Type {
    return allocator.new(Named_Type(
        super: Type(kind: kind, hash: named_type_hash(kind: kind, name: name))
        name: name
        package_name: package_name
    ))
}

proc null_type_hash() -> u64 {
    return type_kind_hash(.Null)
}

proc new_null_type() -> ^Type {
    return allocator.new(Type(kind: .Null, hash: null_type_hash()))
}

type Placeholder_Type = struct {
    super: Type
    name: str
    resolved: ^Type
}

proc placeholder_type_hash(name: str, discriminator: u64) -> u64 {
    // The discriminator keeps same-named placeholders of different inferences distinct.
    return combine_type_hash(named_type_hash(kind: .Placeholder, name: name), discriminator)
}

proc new_placeholder_type(name: str, discriminator: u64) -> ^Placeholder_Type {
    return allocator.new(Placeholder_Type(
        super: Type(kind: .Placeholder, hash: placeholder_type_hash(name: name, discriminator: discriminator))
        name: name
        resolved: null
    ))
}

type Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc pointer_type_hash(pointee: ^Type) -> u64 {
    return combine_type_hash(type_kind_hash(.Pointer), pointee.hash())
}

proc new_pointer_type(pointee: ^Type) -> ^Pointer_Type {
    return allocator.new(Pointer_Type(
        super: Type(kind: .Pointer, hash: pointer_type_hash(pointee))
        pointee: pointee
    ))
}

type Procedure_Parameter = struct {
    name: str
    parameter_type: ^Type
    next: ^Procedure_Parameter
}

proc new_procedure_parameter(name: str, parameter_type: ^Type) -> ^Procedure_Parameter {
    return allocator.new(Procedure_Parameter(name: name, parameter_type: parameter_type, next: null))
}

type Procedure_Type = struct {
    super: Type
    first_parameter: ^Procedure_Parameter
    return_type: ^Type
}

proc procedure_type_hash(first_parameter: ^Procedure_Parameter, return_type: ^Type) -> u64 {
    let hash = type_kind_hash(.Procedure)
    let parameter = first_parameter
    while parameter != null {
        hash = combine_type_hash(hash, parameter.parameter_type.hash())
        parameter = parameter.next
    }
    if return_type != null {
        hash = combine_type_hash(hash, return_type.hash())
    }
    return hash
}

proc new_procedure_type(first_parameter: ^Procedure_Parameter, return_type: ^Type) -> ^Procedure_Type {
    return allocator.new(Procedure_Type(
        super: Type(kind: .Procedure, hash: procedure_type_hash(first_parameter: first_parameter, return_type: return_type))
        first_parameter: first_parameter
        return_type: return_type
    ))
}

type Struct_Member = struct {
    name: str
    type: ^Type
    struct_type: ^Struct_Type
    next: ^Struct_Member
}

proc new_struct_member(name: str, type: ^Type) -> ^Struct_Member {
    return allocator.new(Struct_Member(name: name, type: type, struct_type: null, next: null))
}

type Struct_Type = struct {
    super: Named_Type
    generic_symbol: ^Generic_Struct_Symbol
    first_type_argument: ^Type_Argument
    first_member: ^Struct_Member
    last_member: ^Struct_Member
}

proc struct_type_hash(name: str, package_name: str) -> u64 {
    return combine_type_hash(named_type_hash(kind: .Struct, name: name), package_name.hash())
}

proc new_struct_type(name: str, package_name: str) -> ^Struct_Type {
    return allocator.new(Struct_Type(
        super: Named_Type(super: Type(kind: .Struct, hash: struct_type_hash(name: name, package_name: package_name)), name: name, package_name: package_name)
        generic_symbol: null
        first_type_argument: null
        first_member: null
        last_member: null
    ))
}

proc (^Struct_Type).find_member(self, name: str) -> ^Struct_Member {
    let member = self.first_member
    while member != null {
        if member.name.equals(name) {
            return member
        }
        member = member.next
    }
    if self.first_member != null and self.first_member.name.equals("super") {
        return self.first_member.type.as(^Struct_Type).find_member(name)
    }
    return null
}

proc (^Struct_Type).append_member(self, member: ^Struct_Member) {
    member.struct_type = self
    if self.first_member == null {
        self.first_member = member
    } else {
        self.last_member.next = member
    }
    self.last_member = member
}
