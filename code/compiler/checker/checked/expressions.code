    next: ^Make_Struct_Argument
}

proc new_make_struct_argument(member: ^Struct_Member, expression: ^Expression) -> ^Make_Struct_Argument {
    let result = allocator.alloc(size: type_size(Make_Struct_Argument), alignment: type_alignment(Make_Struct_Argument)).as(^Make_Struct_Argument)
    result.^ = Make_Struct_Argument(member: member, expression: expression, next: null)
    return result
}

