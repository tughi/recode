import allocator
import compiler.lexer

type Expression_Kind = enum {
    Integer
}

type Expression = struct {
    kind: Expression_Kind
    type: ^Type
}

type Integer_Expression = struct {
    super: Expression
    token: ^lexer.Integer
}

proc new_integer_expression(token: ^lexer.Integer, type: ^Type) -> ^Integer_Expression {
    let result = allocator.alloc(size: type_size(Integer_Expression), alignment: type_alignment(Integer_Expression)).as(^Integer_Expression)
    result.^ = Integer_Expression(
        super: Expression(kind: .Integer, type: type)
        token: token
    )
    return result
}
