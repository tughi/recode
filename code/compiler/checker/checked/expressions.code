    let result = allocator.alloc(size: type_size(Make_Struct_Expression), alignment: type_alignment(Make_Struct_Expression)).as(^Make_Struct_Expression)
    result.^ = Make_Struct_Expression(
        super: Expression(kind: .Make_Struct, type: struct_type.as(^Type))
