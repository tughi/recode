import allocator
import compiler.lexer

type Expression_Kind = enum {
    Add
    Address_Of
    Alloc
    Array_Access
    Bool
    Call
    Cast
    Character
    Dereference
    Divide
    Equals
    Greater
    Greater_Or_Equals
    Group
    Integer
    Less
    Less_Or_Equals
    Logic_And
    Logic_Or
    Make_Struct
    Member_Access
    Modulo
    Multiply
    Negate
    Not
    Not_Equals
    Null
    String
    String_Length
    Subtract
    Symbol
    Type_Alignment
    Type_Size
}

type Expression = struct {
    kind: Expression_Kind
    type: ^Type
}

proc (^Expression).is_mutable(self) -> bool {
    if self.kind == .Array_Access {
        return true
    } else if self.kind == .Dereference {
        return true
    } else if self.kind == .Member_Access {
        let member_access = self.as(^Member_Access_Expression)
        if member_access.operand.type.kind == .Pointer {
            return true
        }
        return member_access.operand.is_mutable()
    } else if self.kind == .Symbol {
        return self.as(^Symbol_Expression).symbol.kind == .Variable
    }
    return false
}

type Address_Of_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_address_of_expression(operand: ^Expression, type: ^Type) -> ^Address_Of_Expression {
    let result = allocator.alloc(size: type_size(Address_Of_Expression), alignment: type_alignment(Address_Of_Expression)).as(^Address_Of_Expression)
    result.^ = Address_Of_Expression(
        super: Expression(kind: .Address_Of, type: type)
        operand: operand
    )
    return result
}

type Alloc_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_alloc_expression(operand: ^Expression, type: ^Type) -> ^Alloc_Expression {
    let result = allocator.alloc(size: type_size(Alloc_Expression), alignment: type_alignment(Alloc_Expression)).as(^Alloc_Expression)
    result.^ = Alloc_Expression(
        super: Expression(kind: .Alloc, type: type)
        operand: operand
    )
    return result
}

type Array_Access_Expression = struct {
    super: Expression
    operand: ^Expression
    index: ^Expression
}

proc new_array_access_expression(operand: ^Expression, index: ^Expression, type: ^Type) -> ^Array_Access_Expression {
    let result = allocator.alloc(size: type_size(Array_Access_Expression), alignment: type_alignment(Array_Access_Expression)).as(^Array_Access_Expression)
    result.^ = Array_Access_Expression(
