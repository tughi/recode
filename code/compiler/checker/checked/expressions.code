import allocator
import compiler.lexer

type Expression_Kind = enum {
    Add
    Bool
    Call
    Divide
    Integer
    Logic_And
    Logic_Or
    Modulo
    Multiply
    Not
    Null
    Subtract
    Symbol
}

type Expression = struct {
    kind: Expression_Kind
    type: ^Type
}

proc (^Expression).is_mutable(self) -> bool {
    if self.kind == .Symbol {
        return self.as(^Symbol_Expression).symbol.kind == .Variable
    }
    return false
}

type Binary_Expression = struct {
    super: Expression
    left: ^Expression
    right: ^Expression
}

proc new_binary_expression(kind: Expression_Kind, left: ^Expression, right: ^Expression, type: ^Type) -> ^Binary_Expression {
    let result = allocator.alloc(size: type_size(Binary_Expression), alignment: type_alignment(Binary_Expression)).as(^Binary_Expression)
    result.^ = Binary_Expression(
        super: Expression(kind: kind, type: type)
        left: left
        right: right
    )
    return result
}

type Bool_Expression = struct {
    super: Expression
    value: bool
}

proc new_bool_expression(value: bool, type: ^Type) -> ^Bool_Expression {
    let result = allocator.alloc(size: type_size(Bool_Expression), alignment: type_alignment(Bool_Expression)).as(^Bool_Expression)
    result.^ = Bool_Expression(
        super: Expression(kind: .Bool, type: type)
        value: value
    )
    return result
}

type Call_Argument = struct {
    expression: ^Expression
    next: ^Call_Argument
}

proc new_call_argument(expression: ^Expression) -> ^Call_Argument {
    let result = allocator.alloc(size: type_size(Call_Argument), alignment: type_alignment(Call_Argument)).as(^Call_Argument)
    result.^ = Call_Argument(expression: expression, next: null)
    return result
}

type Call_Expression = struct {
    super: Expression
    callee: ^Procedure_Symbol
    first_argument: ^Call_Argument
}

proc new_call_expression(callee: ^Procedure_Symbol, type: ^Type, first_argument: ^Call_Argument) -> ^Call_Expression {
    let result = allocator.alloc(size: type_size(Call_Expression), alignment: type_alignment(Call_Expression)).as(^Call_Expression)
    result.^ = Call_Expression(
        super: Expression(kind: .Call, type: type)
        callee: callee
        first_argument: first_argument
    )
    return result
}

type Integer_Expression = struct {
    super: Expression
    token: ^lexer.Integer
}

proc new_integer_expression(token: ^lexer.Integer, type: ^Type) -> ^Integer_Expression {
    let result = allocator.alloc(size: type_size(Integer_Expression), alignment: type_alignment(Integer_Expression)).as(^Integer_Expression)
    result.^ = Integer_Expression(
        super: Expression(kind: .Integer, type: type)
        token: token
    )
    return result
}

type Not_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_not_expression(operand: ^Expression, type: ^Type) -> ^Not_Expression {
    let result = allocator.alloc(size: type_size(Not_Expression), alignment: type_alignment(Not_Expression)).as(^Not_Expression)
    result.^ = Not_Expression(
        super: Expression(kind: .Not, type: type)
        operand: operand
    )
    return result
}

type Null_Expression = struct {
    super: Expression
}

proc new_null_expression(type: ^Type) -> ^Null_Expression {
    let result = allocator.alloc(size: type_size(Null_Expression), alignment: type_alignment(Null_Expression)).as(^Null_Expression)
    result.^ = Null_Expression(
        super: Expression(kind: .Null, type: type)
    )
    return result
}

type Symbol_Expression = struct {
    super: Expression
    symbol: ^Symbol
}

proc new_symbol_expression(symbol: ^Symbol, type: ^Type) -> ^Symbol_Expression {
    let result = allocator.alloc(size: type_size(Symbol_Expression), alignment: type_alignment(Symbol_Expression)).as(^Symbol_Expression)
    result.^ = Symbol_Expression(
        super: Expression(kind: .Symbol, type: type)
        symbol: symbol
    )
    return result
}
