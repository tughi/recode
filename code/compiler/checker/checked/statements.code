import allocator
import compiler.lexer
import compiler.source

type Statement_Kind = enum {
    Assignment
    Block
    Break
    Continue
    Expression
    If
    Loop
    Panic
    Return
    Switch
    Variable
    While
}

type Statement = struct {
    kind: Statement_Kind
    location: source.Source_Location
    next: ^Statement
}

type Assignment_Statement = struct {
    super: Statement
    object: ^Expression
    value: ^Expression
}

proc new_assignment_statement(location: source.Source_Location, object: ^Expression, value: ^Expression) -> ^Assignment_Statement {
    return allocator.new(Assignment_Statement(
        super: Statement(kind: .Assignment, location: location, next: null)
        object: object
        value: value
    ))
}

type Block_Statement = struct {
    super: Statement
    first_statement: ^Statement
}

proc new_block_statement(location: source.Source_Location, first_statement: ^Statement) -> ^Block_Statement {
    return allocator.new(Block_Statement(
        super: Statement(kind: .Block, location: location, next: null)
        first_statement: first_statement
    ))
}

type Break_Statement = struct {
    super: Statement
}

proc new_break_statement(location: source.Source_Location) -> ^Break_Statement {
    return allocator.new(Break_Statement(
        super: Statement(kind: .Break, location: location, next: null)
    ))
}

type Continue_Statement = struct {
    super: Statement
}

proc new_continue_statement(location: source.Source_Location) -> ^Continue_Statement {
    return allocator.new(Continue_Statement(
        super: Statement(kind: .Continue, location: location, next: null)
    ))
}

type Expression_Statement = struct {
    super: Statement
    expression: ^Expression
}

proc new_expression_statement(location: source.Source_Location, expression: ^Expression) -> ^Expression_Statement {
    return allocator.new(Expression_Statement(
        super: Statement(kind: .Expression, location: location, next: null)
        expression: expression
    ))
}

type If_Statement = struct {
    super: Statement
    condition: ^Expression
    true_block: ^Statement
    false_statement: ^Statement
}

proc new_if_statement(location: source.Source_Location, condition: ^Expression, true_block: ^Statement, false_statement: ^Statement) -> ^If_Statement {
    return allocator.new(If_Statement(
        super: Statement(kind: .If, location: location, next: null)
        condition: condition
        true_block: true_block
        false_statement: false_statement
    ))
}

type Loop_Statement = struct {
    super: Statement
    body: ^Statement
}

proc new_loop_statement(location: source.Source_Location, body: ^Statement) -> ^Loop_Statement {
    return allocator.new(Loop_Statement(
        super: Statement(kind: .Loop, location: location, next: null)
        body: body
    ))
}

type Panic_Statement = struct {
    super: Statement
    message: ^lexer.String
}

proc new_panic_statement(location: source.Source_Location, message: ^lexer.String) -> ^Panic_Statement {
    return allocator.new(Panic_Statement(
        super: Statement(kind: .Panic, location: location, next: null)
        message: message
    ))
}

type Return_Statement = struct {
    super: Statement
    expression: ^Expression
}

proc new_return_statement(location: source.Source_Location, expression: ^Expression) -> ^Return_Statement {
    return allocator.new(Return_Statement(
        super: Statement(kind: .Return, location: location, next: null)
        expression: expression
    ))
}

type Switch_Case_Value = struct {
    expression: ^Expression
    next: ^Switch_Case_Value
}

proc new_switch_case_value(expression: ^Expression) -> ^Switch_Case_Value {
    return allocator.new(Switch_Case_Value(expression: expression, next: null))
}

type Switch_Case = struct {
    first_value: ^Switch_Case_Value
    block: ^Statement
    next: ^Switch_Case
}

proc new_switch_case(first_value: ^Switch_Case_Value, block: ^Statement) -> ^Switch_Case {
    return allocator.new(Switch_Case(first_value: first_value, block: block, next: null))
}

type Switch_Statement = struct {
    super: Statement
    operand: ^Expression
    first_case: ^Switch_Case
    else_block: ^Statement
}

proc new_switch_statement(location: source.Source_Location, operand: ^Expression, first_case: ^Switch_Case, else_block: ^Statement) -> ^Switch_Statement {
    return allocator.new(Switch_Statement(
        super: Statement(kind: .Switch, location: location, next: null)
        operand: operand
        first_case: first_case
        else_block: else_block
    ))
}

type Variable_Statement = struct {
    super: Statement
    symbol: ^Variable_Symbol
    expression: ^Expression
}

proc new_variable_statement(location: source.Source_Location, symbol: ^Variable_Symbol, expression: ^Expression) -> ^Variable_Statement {
    return allocator.new(Variable_Statement(
        super: Statement(kind: .Variable, location: location, next: null)
        symbol: symbol
        expression: expression
    ))
}

type While_Statement = struct {
    super: Statement
    condition: ^Expression
    body: ^Statement
}

proc new_while_statement(location: source.Source_Location, condition: ^Expression, body: ^Statement) -> ^While_Statement {
    return allocator.new(While_Statement(
        super: Statement(kind: .While, location: location, next: null)
        condition: condition
        body: body
    ))
}
