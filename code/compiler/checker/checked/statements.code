proc new_if_statement(location: source.Source_Location, condition: ^Expression, true_block: ^Statement, false_statement: ^Statement) -> ^If_Statement {
    let result = allocator.alloc(size: type_size(If_Statement), alignment: type_alignment(If_Statement)).as(^If_Statement)
    result.^ = If_Statement(
        super: Statement(kind: .If, location: location, next: null)
        condition: condition
        true_block: true_block
        false_statement: false_statement
    )
    return result
}

