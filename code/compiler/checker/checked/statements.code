import allocator
import compiler.lexer
import compiler.source

type Statement_Kind = enum {
    Assignment
    Block
    Break
    Continue
    Expression
    If
    Loop
    Panic
    Return
    Variable
    While
}

type Statement = struct {
    kind: Statement_Kind
    location: source.Source_Location
    next: ^Statement
}

type Assignment_Statement = struct {
    super: Statement
    object: ^Expression
    value: ^Expression
}

proc new_assignment_statement(location: source.Source_Location, object: ^Expression, value: ^Expression) -> ^Assignment_Statement {
    let result = allocator.alloc(size: type_size(Assignment_Statement), alignment: type_alignment(Assignment_Statement)).as(^Assignment_Statement)
    result.^ = Assignment_Statement(
        super: Statement(kind: .Assignment, location: location, next: null)
        object: object
        value: value
    )
    return result
}

type Block_Statement = struct {
    super: Statement
    first_statement: ^Statement
}

proc new_block_statement(location: source.Source_Location, first_statement: ^Statement) -> ^Block_Statement {
    let result = allocator.alloc(size: type_size(Block_Statement), alignment: type_alignment(Block_Statement)).as(^Block_Statement)
    result.^ = Block_Statement(
        super: Statement(kind: .Block, location: location, next: null)
        first_statement: first_statement
    )
    return result
}

type Break_Statement = struct {
    super: Statement
}

proc new_break_statement(location: source.Source_Location) -> ^Break_Statement {
    let result = allocator.alloc(size: type_size(Break_Statement), alignment: type_alignment(Break_Statement)).as(^Break_Statement)
    result.^ = Break_Statement(
        super: Statement(kind: .Break, location: location, next: null)
    )
    return result
}

type Continue_Statement = struct {
    super: Statement
}

proc new_continue_statement(location: source.Source_Location) -> ^Continue_Statement {
    let result = allocator.alloc(size: type_size(Continue_Statement), alignment: type_alignment(Continue_Statement)).as(^Continue_Statement)
    result.^ = Continue_Statement(
