import allocator
import compiler.checker.checked

type Program = struct {
    first_procedure: ^Procedure
    last_procedure: ^Procedure
}

proc new_program() -> ^Program {
    let result = allocator.alloc(size: type_size(Program), alignment: type_alignment(Program)).as(^Program)
    result.^ = Program(first_procedure: null, last_procedure: null)
    return result
}

proc (^Program).append_procedure(self, procedure: ^Procedure) {
    if self.first_procedure == null {
        self.first_procedure = procedure
    } else {
        self.last_procedure.next = procedure
    }
    self.last_procedure = procedure
}

proc (^Program).find_procedure(self, name: str) -> ^Procedure {
    let procedure = self.first_procedure
    while procedure != null {
        if procedure.name.equals(name) {
            return procedure
        }
        procedure = procedure.next
    }
    return null
}

type Procedure = struct {
    name: str
    first_parameter: ^Value
    last_parameter: ^Value
    return_type: ^Type
    first_block: ^Block
    last_block: ^Block
    next: ^Procedure
}

proc new_procedure(name: str, return_type: ^Type) -> ^Procedure {
    let result = allocator.alloc(size: type_size(Procedure), alignment: type_alignment(Procedure)).as(^Procedure)
    result.^ = Procedure(
        name: name
        first_parameter: null
        last_parameter: null
        return_type: return_type
        first_block: null
        last_block: null
        next: null
    )
    return result
}

proc (^Procedure).append_parameter(self, value: ^Value) {
    if self.first_parameter == null {
        self.first_parameter = value
    } else {
        self.last_parameter.next = value
    }
    self.last_parameter = value
}

proc (^Procedure).append_block(self, block: ^Block) {
    if self.first_block == null {
        self.first_block = block
    } else {
        self.last_block.next = block
    }
    self.last_block = block
}

type Block = struct {
    label: usize
    first_instruction: ^Instruction
    last_instruction: ^Instruction
    next: ^Block
}

proc new_block(label: usize) -> ^Block {
    let result = allocator.alloc(size: type_size(Block), alignment: type_alignment(Block)).as(^Block)
    result.^ = Block(label: label, first_instruction: null, last_instruction: null, next: null)
    return result
}

type Type_Kind = enum {
    Nothing
    Pointer
    Primitive
}

type Type = struct {
    kind: Type_Kind
}

type Nothing_Type = struct {
    super: Type
}

proc new_nothing_type() -> ^Nothing_Type {
    let result = allocator.alloc(size: type_size(Nothing_Type), alignment: type_alignment(Nothing_Type)).as(^Nothing_Type)
    result.^ = Nothing_Type(super: Type(kind: .Nothing))
    return result
}

type Primitive_Type = struct {
    super: Type
    name: str
}

proc new_primitive_type(name: str) -> ^Primitive_Type {
    let result = allocator.alloc(size: type_size(Primitive_Type), alignment: type_alignment(Primitive_Type)).as(^Primitive_Type)
    result.^ = Primitive_Type(super: Type(kind: .Primitive), name: name)
    return result
}

type Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_pointer_type(pointee: ^Type) -> ^Pointer_Type {
    let result = allocator.alloc(size: type_size(Pointer_Type), alignment: type_alignment(Pointer_Type)).as(^Pointer_Type)
    result.^ = Pointer_Type(super: Type(kind: .Pointer), pointee: pointee)
    return result
}

type Value_Kind = enum {
    Global
    Instruction_Result
    Parameter
    Procedure
}

type Value = struct {
    kind: Value_Kind
    name: str
    type: ^Type
    variable: ^Variable
    next: ^Value
}

proc new_value(kind: Value_Kind, name: str, type: ^Type) -> ^Value {
    let result = allocator.alloc(size: type_size(Value), alignment: type_alignment(Value)).as(^Value)
    result.^ = Value(kind: kind, name: name, type: type, variable: null, next: null)
    return result
}

type Symbol = struct {
    super: Value
}

type Variable = struct {
    super: Symbol
    symbol: ^checked.Symbol
    version: usize
}

proc new_variable(name: str, type: ^Type, symbol: ^checked.Symbol) -> ^Variable {
    let result = allocator.alloc(size: type_size(Variable), alignment: type_alignment(Variable)).as(^Variable)
    result.^ = Variable(
        super: Symbol(super: Value(kind: .Instruction_Result, name: name, type: type, variable: null, next: null))
        symbol: symbol
        version: 0
    )
    return result
}
