import allocator
import collections
import compiler.checker.checked
import string

type Program = struct {
    first_source_file: ^Source_File
    last_source_file: ^Source_File
    named_types: collections.Map<str, ^Named_Type>
    first_global: ^Global
    last_global: ^Global
    first_procedure: ^Procedure
    last_procedure: ^Procedure
}

proc new_program() -> ^Program {
    return allocator.new(Program(
        first_source_file: null
        last_source_file: null
        named_types: collections.empty_map<str, ^Named_Type>()
        first_global: null
        last_global: null
        first_procedure: null
        last_procedure: null
    ))
}

proc (^Program).append_type(self, type: ^Named_Type) {
    self.named_types.put(type.name, type)
}

proc (^Program).append_global(self, global: ^Global) {
    if self.first_global == null {
        self.first_global = global
    } else {
        self.last_global.next_global = global
    }
    self.last_global = global
}

proc (^Program).append_procedure(self, procedure: ^Procedure) {
    if self.first_procedure == null {
        self.first_procedure = procedure
    } else {
        self.last_procedure.next = procedure
    }
    self.last_procedure = procedure
}

proc (^Program).find_procedure(self, name: str) -> ^Procedure {
    let procedure = self.first_procedure
    while procedure != null {
        if procedure.name.equals(name) {
            return procedure
        }
        procedure = procedure.next
    }
    return null
}

type Source_File = struct {
    index: usize
    path: str
    ir_path: str
    next: ^Source_File
}

proc (^Program).append_source_file(self, path: str, ir_path: str) -> ^Source_File {
    let index = 1usize
    if self.last_source_file != null {
        index = self.last_source_file.index + 1
    }
    let source_file = allocator.new(Source_File(index: index, path: path, ir_path: ir_path, next: null))
    if self.first_source_file == null {
        self.first_source_file = source_file
    } else {
        self.last_source_file.next = source_file
    }
    self.last_source_file = source_file
    return source_file
}

proc (^Program).find_source_file(self, path: str) -> ^Source_File {
    let source_file = self.first_source_file
    while source_file != null {
        if source_file.path.equals(path) {
            return source_file
        }
        source_file = source_file.next
    }
    return null
}

type Procedure = struct {
    name: str
    is_method: bool
    first_parameter: ^Value
    last_parameter: ^Value
    return_type: ^Type
    first_block: ^Block
    last_block: ^Block
    next: ^Procedure
}

proc new_procedure(name: str, return_type: ^Type) -> ^Procedure {
    return allocator.new(Procedure(
        name: name
        is_method: false
        first_parameter: null
        last_parameter: null
        return_type: return_type
        first_block: null
        last_block: null
        next: null
    ))
}

proc (^Procedure).append_parameter(self, value: ^Value) {
    if self.first_parameter == null {
        self.first_parameter = value
    } else {
        self.last_parameter.next = value
    }
    self.last_parameter = value
}

proc (^Procedure).append_block(self, block: ^Block) {
    if self.first_block == null {
        self.first_block = block
    } else {
        self.last_block.next = block
    }
    self.last_block = block
}

type Block = struct {
    label: usize
    first_instruction: ^Instruction
    last_instruction: ^Instruction
    next: ^Block
}

proc new_block(label: usize) -> ^Block {
    return allocator.new(Block(label: label, first_instruction: null, last_instruction: null, next: null))
}

type Type_Kind = enum {
    Any
    Array
    bool
    i16
    i32
    i64
    i8
    isize
    Multi_Pointer
    Nothing
    Opaque
    Pointer
    Procedure
    Struct
    u16
    u32
    u64
    u8
    usize
}

type Type = struct {
    kind: Type_Kind
}

proc new_primitive_type(kind: Type_Kind) -> ^Type {
    return allocator.new(Type(kind: kind))
}

proc (^Type).name_string(self) -> str {
    switch self.kind {
        case .Any {
            return "Any"
        }
        case .Array {
            let array_type = self.as(^Array_Type)
            let builder = string.new_builder()
            return builder.append_char('[').append_decimal(array_type.size.as(usize)).append_char(']').append(array_type.item_type.name_string()).build()
        }
        case .bool {
            return "bool"
        }
        case .i16 {
            return "i16"
        }
        case .i32 {
            return "i32"
        }
        case .i64 {
            return "i64"
        }
        case .i8 {
            return "i8"
        }
        case .isize {
            return "isize"
        }
        case .Multi_Pointer {
            let builder = string.new_builder()
            return builder.append("[*]").append(self.as(^Multi_Pointer_Type).pointee.name_string()).build()
        }
        case .Opaque {
            return self.as(^Named_Type).name
        }
        case .Pointer {
            let builder = string.new_builder()
            return builder.append_char('[').append(self.as(^Pointer_Type).pointee.name_string()).append_char(']').build()
        }
        case .Struct {
            return self.as(^Named_Type).name
        }
        case .u16 {
            return "u16"
        }
        case .u32 {
            return "u32"
        }
        case .u64 {
            return "u64"
        }
        case .u8 {
            return "u8"
        }
        case .usize {
            return "usize"
        }
        else {
            panic "Not supported yet: type name"
        }
    }
}

proc align_up(size: usize, alignment: usize) -> usize {
    return (size + alignment - 1) / alignment * alignment
}

proc (^Type).alignment(self) -> usize {
    if self.kind == .Array {
        return self.as(^Array_Type).item_type.alignment()
    }
    if self.kind == .Struct {
        let alignment = 1usize
        let member = self.as(^Struct_Type).first_member
        while member != null {
            let member_alignment = member.type.alignment()
            if member_alignment > alignment {
                alignment = member_alignment
            }
            member = member.next
        }
        return alignment
    }
    let size = self.size()
    if size >= 8 {
        return 8
    }
    return size
}

proc (^Type).size(self) -> usize {
    switch self.kind {
        case .Array {
            let array_type = self.as(^Array_Type)
            return array_type.size.as(usize) * array_type.item_type.size()
        }
        case .bool {
            return 1
        }
        case .i16 {
            return 2
        }
        case .i32 {
            return 4
        }
        case .i64 {
            return 8
        }
        case .i8 {
            return 1
        }
        case .isize {
            return 8
        }
        case .Multi_Pointer {
            return 8
        }
        case .Pointer {
            return 8
        }
        case .Procedure {
            return 8
        }
        case .Struct {
            let size = 0usize
            let alignment = 1usize
            let member = self.as(^Struct_Type).first_member
            while member != null {
                let member_alignment = member.type.alignment()
                size = align_up(size, member_alignment)
                size = size + member.type.size()
                if member_alignment > alignment {
                    alignment = member_alignment
                }
                member = member.next
            }
            return align_up(size, alignment)
        }
        case .u16 {
            return 2
        }
        case .u32 {
            return 4
        }
        case .u64 {
            return 8
        }
        case .u8 {
            return 1
        }
        case .usize {
            return 8
        }
        else {
            panic "Lowering not supported yet: size of type"
        }
    }
}

type Array_Type = struct {
    super: Type
    item_type: ^Type
    size: u64
}

proc new_array_type(item_type: ^Type, size: u64) -> ^Array_Type {
    return allocator.new(Array_Type(super: Type(kind: .Array), item_type: item_type, size: size))
}

type Multi_Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_multi_pointer_type(pointee: ^Type) -> ^Multi_Pointer_Type {
    return allocator.new(Multi_Pointer_Type(super: Type(kind: .Multi_Pointer), pointee: pointee))
}

type Nothing_Type = struct {
    super: Type
}

proc new_nothing_type() -> ^Nothing_Type {
    return allocator.new(Nothing_Type(super: Type(kind: .Nothing)))
}

type Named_Type = struct {
    super: Type
    name: str
    next_type: ^Named_Type
}

type Opaque_Type = struct {
    super: Named_Type
}

proc new_opaque_type(name: str) -> ^Opaque_Type {
    return allocator.new(Opaque_Type(super: Named_Type(super: Type(kind: .Opaque), name: name, next_type: null)))
}

type Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_pointer_type(pointee: ^Type) -> ^Pointer_Type {
    return allocator.new(Pointer_Type(super: Type(kind: .Pointer), pointee: pointee))
}

type Procedure_Type_Parameter = struct {
    type: ^Type
    next: ^Procedure_Type_Parameter
}

proc new_procedure_type_parameter(type: ^Type) -> ^Procedure_Type_Parameter {
    return allocator.new(Procedure_Type_Parameter(type: type, next: null))
}

type Procedure_Type = struct {
    super: Type
    first_parameter: ^Procedure_Type_Parameter
    last_parameter: ^Procedure_Type_Parameter
    return_type: ^Type
}

proc new_procedure_type(return_type: ^Type) -> ^Procedure_Type {
    return allocator.new(Procedure_Type(super: Type(kind: .Procedure), first_parameter: null, last_parameter: null, return_type: return_type))
}

proc (^Procedure_Type).append_parameter(self, type: ^Type) {
    let parameter = new_procedure_type_parameter(type)
    if self.first_parameter == null {
        self.first_parameter = parameter
    } else {
        self.last_parameter.next = parameter
    }
    self.last_parameter = parameter
}

type Struct_Member = struct {
    name: str
    type: ^Type
    next: ^Struct_Member
}

type Struct_Type = struct {
    super: Named_Type
    first_member: ^Struct_Member
    last_member: ^Struct_Member
}

proc new_struct_type(name: str) -> ^Struct_Type {
    return allocator.new(Struct_Type(
        super: Named_Type(super: Type(kind: .Struct), name: name, next_type: null)
        first_member: null
        last_member: null
    ))
}

proc (^Struct_Type).append_member(self, name: str, type: ^Type) {
    let member = allocator.new(Struct_Member(name: name, type: type, next: null))
    if self.first_member == null {
        self.first_member = member
    } else {
        self.last_member.next = member
    }
    self.last_member = member
}

type Value_Kind = enum {
    Global
    Instruction_Result
    Parameter
    Procedure
}

type Value = struct {
    kind: Value_Kind
    name: str
    type: ^Type
    variable: ^Variable
    next: ^Value
}

proc new_value(kind: Value_Kind, name: str, type: ^Type) -> ^Value {
    return allocator.new(Value(kind: kind, name: name, type: type, variable: null, next: null))
}

type Symbol = struct {
    super: Value
}

type Const_Payload = struct {
    value: u64
    lexeme: str
}

proc new_const_payload(value: u64, lexeme: str) -> ^Const_Payload {
    return allocator.new(Const_Payload(value: value, lexeme: lexeme))
}

type Global = struct {
    super: Symbol
    literal: str
    constant: ^Const_Payload
    is_external: bool
    next_global: ^Global
}

proc new_global(name: str, type: ^Type) -> ^Global {
    return allocator.new(Global(
        super: Symbol(super: Value(kind: .Global, name: name, type: type, variable: null, next: null))
        literal: ""
        constant: null
        is_external: false
        next_global: null
    ))
}

proc new_constant_global(name: str, type: ^Type, constant: ^Const_Payload) -> ^Global {
    let result = new_global(name: name, type: type)
    result.constant = constant
    return result
}

proc new_external_global(name: str, type: ^Type) -> ^Global {
    let result = new_global(name: name, type: type)
    result.is_external = true
    return result
}

proc new_string_global(name: str, type: ^Type, literal: str) -> ^Global {
    let result = new_global(name: name, type: type)
    result.literal = literal
    return result
}

type Variable = struct {
    super: Symbol
    symbol: ^checked.Symbol
    version: usize
}

proc new_variable(name: str, type: ^Type, symbol: ^checked.Symbol) -> ^Variable {
    return allocator.new(Variable(
        super: Symbol(super: Value(kind: .Instruction_Result, name: name, type: type, variable: null, next: null))
        symbol: symbol
        version: 0
    ))
}
