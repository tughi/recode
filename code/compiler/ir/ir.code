import allocator
import compiler.checker.checked

type Program = struct {
    first_type: ^Named_Type
    last_type: ^Named_Type
    first_global: ^Global
    last_global: ^Global
    first_procedure: ^Procedure
    last_procedure: ^Procedure
}

proc new_program() -> ^Program {
    let result = allocator.alloc(size: type_size(Program), alignment: type_alignment(Program)).as(^Program)
    result.^ = Program(first_type: null, last_type: null, first_global: null, last_global: null, first_procedure: null, last_procedure: null)
    return result
}

proc (^Program).append_type(self, type: ^Named_Type) {
    if self.first_type == null {
        self.first_type = type
    } else {
        self.last_type.next_type = type
    }
    self.last_type = type
}

proc (^Program).append_global(self, global: ^Global) {
    if self.first_global == null {
        self.first_global = global
    } else {
        self.last_global.next_global = global
    }
    self.last_global = global
}

proc (^Program).append_procedure(self, procedure: ^Procedure) {
    if self.first_procedure == null {
        self.first_procedure = procedure
    } else {
        self.last_procedure.next = procedure
    }
    self.last_procedure = procedure
}

proc (^Program).find_procedure(self, name: str) -> ^Procedure {
    let procedure = self.first_procedure
    while procedure != null {
        if procedure.name.equals(name) {
            return procedure
        }
        procedure = procedure.next
    }
    return null
}

type Procedure = struct {
    name: str
    first_parameter: ^Value
    last_parameter: ^Value
    return_type: ^Type
    first_block: ^Block
    last_block: ^Block
    next: ^Procedure
}

proc new_procedure(name: str, return_type: ^Type) -> ^Procedure {
    let result = allocator.alloc(size: type_size(Procedure), alignment: type_alignment(Procedure)).as(^Procedure)
    result.^ = Procedure(
        name: name
        first_parameter: null
        last_parameter: null
        return_type: return_type
        first_block: null
        last_block: null
        next: null
    )
    return result
}

proc (^Procedure).append_parameter(self, value: ^Value) {
    if self.first_parameter == null {
        self.first_parameter = value
    } else {
        self.last_parameter.next = value
    }
    self.last_parameter = value
}

proc (^Procedure).append_block(self, block: ^Block) {
    if self.first_block == null {
        self.first_block = block
    } else {
        self.last_block.next = block
    }
    self.last_block = block
}

type Block = struct {
    label: usize
    first_instruction: ^Instruction
    last_instruction: ^Instruction
    next: ^Block
}

proc new_block(label: usize) -> ^Block {
    let result = allocator.alloc(size: type_size(Block), alignment: type_alignment(Block)).as(^Block)
    result.^ = Block(label: label, first_instruction: null, last_instruction: null, next: null)
    return result
}

type Type_Kind = enum {
    Any
    bool
    i16
    i32
    i64
    i8
    isize
    Multi_Pointer
    Nothing
    Opaque
    Pointer
    Procedure
    str
    u16
    u32
    u64
    u8
    usize
}

type Type = struct {
    kind: Type_Kind
}

proc new_primitive_type(kind: Type_Kind) -> ^Type {
    let result = allocator.alloc(size: type_size(Type), alignment: type_alignment(Type)).as(^Type)
    result.^ = Type(kind: kind)
    return result
}

proc (^Type).alignment(self) -> usize {
    let size = self.size()
    if size >= 8 {
        return 8
    }
    return size
}

proc (^Type).size(self) -> usize {
    if self.kind == .bool {
        return 1
    } else if self.kind == .i16 {
        return 2
    } else if self.kind == .i32 {
        return 4
    } else if self.kind == .i64 {
        return 8
    } else if self.kind == .i8 {
        return 1
    } else if self.kind == .isize {
        return 8
    } else if self.kind == .Multi_Pointer {
        return 8
    } else if self.kind == .Pointer {
        return 8
    } else if self.kind == .Procedure {
        return 8
    } else if self.kind == .u16 {
        return 2
    } else if self.kind == .u32 {
        return 4
    } else if self.kind == .u64 {
        return 8
    } else if self.kind == .u8 {
        return 1
    } else if self.kind == .usize {
        return 8
    }
    panic "Lowering not supported yet: size of type"
}

type Multi_Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_multi_pointer_type(pointee: ^Type) -> ^Multi_Pointer_Type {
    let result = allocator.alloc(size: type_size(Multi_Pointer_Type), alignment: type_alignment(Multi_Pointer_Type)).as(^Multi_Pointer_Type)
    result.^ = Multi_Pointer_Type(super: Type(kind: .Multi_Pointer), pointee: pointee)
    return result
}

type Nothing_Type = struct {
    super: Type
}

proc new_nothing_type() -> ^Nothing_Type {
    let result = allocator.alloc(size: type_size(Nothing_Type), alignment: type_alignment(Nothing_Type)).as(^Nothing_Type)
    result.^ = Nothing_Type(super: Type(kind: .Nothing))
    return result
}

type Named_Type = struct {
    super: Type
    name: str
    next_type: ^Named_Type
}

type Opaque_Type = struct {
    super: Named_Type
}

proc new_opaque_type(name: str) -> ^Opaque_Type {
    let result = allocator.alloc(size: type_size(Opaque_Type), alignment: type_alignment(Opaque_Type)).as(^Opaque_Type)
    result.^ = Opaque_Type(super: Named_Type(super: Type(kind: .Opaque), name: name, next_type: null))
    return result
}

type Pointer_Type = struct {
    super: Type
    pointee: ^Type
}

proc new_pointer_type(pointee: ^Type) -> ^Pointer_Type {
    let result = allocator.alloc(size: type_size(Pointer_Type), alignment: type_alignment(Pointer_Type)).as(^Pointer_Type)
    result.^ = Pointer_Type(super: Type(kind: .Pointer), pointee: pointee)
    return result
}

type Procedure_Type_Parameter = struct {
    type: ^Type
    next: ^Procedure_Type_Parameter
}

proc new_procedure_type_parameter(type: ^Type) -> ^Procedure_Type_Parameter {
    let result = allocator.alloc(size: type_size(Procedure_Type_Parameter), alignment: type_alignment(Procedure_Type_Parameter)).as(^Procedure_Type_Parameter)
    result.^ = Procedure_Type_Parameter(type: type, next: null)
    return result
}

type Procedure_Type = struct {
    super: Type
    first_parameter: ^Procedure_Type_Parameter
    last_parameter: ^Procedure_Type_Parameter
    return_type: ^Type
}

proc new_procedure_type(return_type: ^Type) -> ^Procedure_Type {
    let result = allocator.alloc(size: type_size(Procedure_Type), alignment: type_alignment(Procedure_Type)).as(^Procedure_Type)
    result.^ = Procedure_Type(super: Type(kind: .Procedure), first_parameter: null, last_parameter: null, return_type: return_type)
    return result
}

proc (^Procedure_Type).append_parameter(self, type: ^Type) {
    let parameter = new_procedure_type_parameter(type)
    if self.first_parameter == null {
        self.first_parameter = parameter
    } else {
        self.last_parameter.next = parameter
    }
    self.last_parameter = parameter
}

type Value_Kind = enum {
    Global
    Instruction_Result
    Parameter
    Procedure
}

type Value = struct {
    kind: Value_Kind
    name: str
    type: ^Type
    variable: ^Variable
    next: ^Value
}

proc new_value(kind: Value_Kind, name: str, type: ^Type) -> ^Value {
    let result = allocator.alloc(size: type_size(Value), alignment: type_alignment(Value)).as(^Value)
    result.^ = Value(kind: kind, name: name, type: type, variable: null, next: null)
    return result
}

type Symbol = struct {
    super: Value
}

type Global = struct {
    super: Symbol
    is_external: bool
    next_global: ^Global
}

proc new_external_global(name: str, type: ^Type) -> ^Global {
    let result = allocator.alloc(size: type_size(Global), alignment: type_alignment(Global)).as(^Global)
    result.^ = Global(
        super: Symbol(super: Value(kind: .Global, name: name, type: type, variable: null, next: null))
        is_external: true
        next_global: null
    )
    return result
}

type Variable = struct {
    super: Symbol
    symbol: ^checked.Symbol
    version: usize
}

proc new_variable(name: str, type: ^Type, symbol: ^checked.Symbol) -> ^Variable {
    let result = allocator.alloc(size: type_size(Variable), alignment: type_alignment(Variable)).as(^Variable)
    result.^ = Variable(
        super: Symbol(super: Value(kind: .Instruction_Result, name: name, type: type, variable: null, next: null))
        symbol: symbol
        version: 0
    )
    return result
}
