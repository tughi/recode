import allocator
import collections
import string

type Instruction_Kind = enum {
    Add
    Alloc
    Bind
    Bitwise_And
    Bitwise_Or
    Bitwise_Xor
    Br
    Brx
    Call
    Cast
    Compare_Equal
    Compare_Greater
    Compare_Greater_Or_Equal
    Compare_Less
    Compare_Less_Or_Equal
    Compare_Not_Equal
    Const
    Divide
    Jmp
    Line
    Load
    Modulo
    Multiply
    Neg
    Not
    Offset
    Phi
    Ret
    Shift_Left
    Shift_Right
    Store
    Struct
    Struct_Offset
    Subtract
}

type Instruction = struct {
    super: Value
    kind: Instruction_Kind
    operands: collections.List<^Value>
    next_instruction: ^Instruction
}

proc (^Block).append_instruction(self, instruction: ^Instruction) {
    if self.first_instruction == null {
        self.first_instruction = instruction
    } else {
        self.last_instruction.next_instruction = instruction
    }
    self.last_instruction = instruction

    let operand_iterator = instruction.operands.iterator()
    while operand_iterator.has_next() {
        let operand = operand_iterator.next()
        if operand != null {
            operand.uses.append(instruction)
        }
    }

    switch instruction.kind {
        case .Br {
            let br_instruction = instruction.as(^Br_Instruction)
            br_instruction.true_block.predecessors.append(self)
            br_instruction.false_block.predecessors.append(self)
        }
        case .Brx {
            let brx_instruction = instruction.as(^Brx_Instruction)
            let target = brx_instruction.first_target
            while target != null {
                target.block.predecessors.append(self)
                target = target.next
            }
            brx_instruction.default_block.predecessors.append(self)
        }
        case .Jmp {
            instruction.as(^Jmp_Instruction).block.predecessors.append(self)
        }
        else {
            // ignored
        }
    }
}

proc (^Block).is_terminated(self) -> bool {
    if self.last_instruction == null {
        return false
    }
    let kind = self.last_instruction.kind
    return kind == .Br or kind == .Brx or kind == .Jmp or kind == .Ret
}

proc (^Block).is_jump_only(self) -> bool {
    if self.first_instruction == null {
        return false
    }
    return self.first_instruction == self.last_instruction and self.first_instruction.kind == .Jmp
}

type Alloc_Instruction = struct {
    super: Instruction
    allocated_type: ^Type
}

proc new_alloc_instruction(variable: ^Variable) -> ^Alloc_Instruction {
    let name_builder = string.new_builder()
    let result_name = name_builder.append(variable.name).append(".ptr").build()
    return allocator.new(Alloc_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: result_name
                type: new_pointer_type(variable.type).as(^Type)
                variable: variable
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: .Alloc
            operands: collections.empty_list<^Value>()
            next_instruction: null
        )
        allocated_type: variable.type
    ))
}

type Binary_Instruction = struct {
    super: Instruction
}

proc new_binary_instruction(kind: Instruction_Kind, name: str, type: ^Type, left: ^Value, right: ^Value) -> ^Binary_Instruction {
    return allocator.new(Binary_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: name
                type: type
                variable: null
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: kind
            operands: collections.list_of_two(left, right)
            next_instruction: null
        )
    ))
}

proc (^Binary_Instruction).left(self) -> ^Value {
    return self.operands.first_item.value
}

proc (^Binary_Instruction).right(self) -> ^Value {
    return self.operands.first_item.next_item.value
}

type Bind_Instruction = struct {
    super: Instruction
    name: str
    indirect: bool
}

proc new_bind_instruction(name: str, indirect: bool, value: ^Value) -> ^Bind_Instruction {
    return allocator.new(Bind_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: ""
                type: null
                variable: null
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: .Bind
            operands: collections.list_of_one(value)
            next_instruction: null
        )
        name: name
        indirect: indirect
    ))
}

proc (^Bind_Instruction).value(self) -> ^Value {
    return self.operands.first_item.value
}

type Br_Instruction = struct {
    super: Instruction
    true_block: ^Block
    false_block: ^Block
}

proc new_br_instruction(condition: ^Value, true_block: ^Block, false_block: ^Block) -> ^Br_Instruction {
    return allocator.new(Br_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: ""
                type: null
                variable: null
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: .Br
            operands: collections.list_of_one(condition)
            next_instruction: null
        )
        true_block: true_block
        false_block: false_block
    ))
}

proc (^Br_Instruction).condition(self) -> ^Value {
    return self.operands.first_item.value
}

type Brx_Target = struct {
    block: ^Block
    next: ^Brx_Target
}

proc new_brx_target(block: ^Block) -> ^Brx_Target {
    return allocator.new(Brx_Target(block: block, next: null))
}

type Brx_Instruction = struct {
    super: Instruction
    first_target: ^Brx_Target
    last_target: ^Brx_Target
    default_block: ^Block
}

proc new_brx_instruction(value: ^Value, default_block: ^Block) -> ^Brx_Instruction {
    return allocator.new(Brx_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: ""
                type: null
                variable: null
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: .Brx
            operands: collections.list_of_one(value)
            next_instruction: null
        )
        first_target: null
        last_target: null
        default_block: default_block
    ))
}

proc (^Brx_Instruction).value(self) -> ^Value {
    return self.operands.first_item.value
}

proc (^Brx_Instruction).append_target(self, target: ^Brx_Target) {
    if self.first_target == null {
        self.first_target = target
    } else {
        self.last_target.next = target
    }
    self.last_target = target
}

type Call_Instruction = struct {
    super: Instruction
}

proc new_call_instruction(name: str, type: ^Type, callee: ^Value) -> ^Call_Instruction {
    return allocator.new(Call_Instruction(
        super: Instruction(
            super: Value(
                kind: .Instruction_Result
                name: name
                type: type
                variable: null
                next: null
                uses: collections.empty_list<^Instruction>()
            )
            kind: .Call
            operands: collections.list_of_one(callee)
            next_instruction: null
        )
    ))
}

proc (^Call_Instruction).append_argument(self, value: ^Value) {
    self.operands.append(value)
}

proc (^Call_Instruction).callee(self) -> ^Value {
    return self.operands.first_item.value
}

proc (^Call_Instruction).arguments_iterator(self) -> collections.List_Iterator<^Value> {
    let iterator = self.operands.iterator()
    iterator.next() // skip callee
    return iterator
}

