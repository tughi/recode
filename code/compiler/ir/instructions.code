import collections
import compiler.lexer

type Instruction = variant {
    Call_Instruction
    Const_Instruction
    Ret_Instruction
}

type Call_Instruction = struct {
    result: ^Value
    callee: ^Procedure
}

type Const_Instruction = struct {
    result: ^Value
    literal: lexer.Integer
}

type Ret_Instruction = struct {
    value: ^Value
}
