import compiler.lexer

type Match_Kind = enum {
    Character
    Comment
    End_Of_File
    End_Of_Line
    Identifier
    Integer
    Integer_Type
    Keyword
    Other
    Space
    String
}

type Match = struct {
    kind: Match_Kind
    keyword: str
    other: u8
    required: bool
}

let character: Match
let comment: Match
let end_of_file: Match
let end_of_line: Match
let identifier: Match
let integer: Match
let integer_type: Match
let optional_space: Match
let required_space: Match

proc init() {
    character = Match(kind: .Character, keyword: "", other: 0, required: false)
    comment = Match(kind: .Comment, keyword: "", other: 0, required: false)
    end_of_file = Match(kind: .End_Of_File, keyword: "", other: 0, required: false)
    end_of_line = Match(kind: .End_Of_Line, keyword: "", other: 0, required: false)
    identifier = Match(kind: .Identifier, keyword: "", other: 0, required: false)
    integer = Match(kind: .Integer, keyword: "", other: 0, required: false)
    integer_type = Match(kind: .Integer_Type, keyword: "", other: 0, required: false)
    required_space = Match(kind: .Space, keyword: "", other: 0, required: true)
    optional_space = Match(kind: .Space, keyword: "", other: 0, required: false)
}


proc keyword(lexeme: str) -> Match {
    return Match(kind: .Keyword, keyword: lexeme, other: 0, required: false)
}

proc other(lexeme: u8) -> Match {
    return Match(kind: .Other, keyword: "", other: lexeme, required: false)
}


proc string_literal() -> Match {
    return Match(kind: .String, keyword: "", other: 0, required: false)
}

type Check_Result = enum {
    No_Match
    Optional
    Match
}

proc (^Match).check(self, token: ^lexer.Token) -> Check_Result {
    switch self.kind {
        case .Character {
            if token.kind == .Character {
                return .Match
            }
        }
        case .Comment {
            if token.kind == .Comment {
                return .Match
            }
        }
        case .End_Of_File {
            if token.kind == .End_Of_File {
                return .Match
            }
        }
        case .End_Of_Line {
            if token.kind == .End_Of_Line or token.kind == .End_Of_File {
                return .Match
            }
        }
        case .Identifier {
            if token.kind == .Identifier {
                return .Match
            }
        }
        case .Integer {
            if token.kind == .Integer {
                return .Match
            }
        }
        case .Integer_Type {
            if token.kind == .Identifier {
                let lexeme = token.lexeme
                if lexeme.char_at(0) == 'i' and (lexeme.equals("i8") or lexeme.equals("i16") or lexeme.equals("i32") or lexeme.equals("i64") or lexeme.equals("isize")) {
                    return .Match
                }
                if lexeme.char_at(0) == 'u' and (lexeme.equals("u8") or lexeme.equals("u16") or lexeme.equals("u32") or lexeme.equals("u64") or lexeme.equals("usize")) {
                    return .Match
                }
            }
        }
        case .Keyword {
            if token.kind == .Identifier {
                if token.lexeme.equals(self.keyword) {
                    return .Match
                }
            }
        }
        case .Other {
            if token.kind == .Other {
                if token.lexeme.char_at(0) == self.other {
                    return .Match
                }
            }
        }
        case .Space {
            if not self.required {
                if token.kind == .Space {
                    return .Match
                }
                return .Optional
            } else if token.kind == .Space {
                return .Match
            }
        }
        case .String {
            if token.kind == .String {
                return .Match
            }
        }
    }
    return .No_Match
}
