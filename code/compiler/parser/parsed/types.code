import collections
import compiler.lexer

type Type = variant {
    Multi_Pointer_Type
    Named_Type
    Pointer_Type
    Procedure_Type
}

type Multi_Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Named_Type = struct {
    source_position: usize
    name: lexer.Identifier
}

type Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Procedure_Type = struct {
    source_position: usize
    parameters: collections.List<Procedure_Parameter>
    return_type: ^Type
    raise_type: ^Type
}
