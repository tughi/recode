import collections
import compiler.lexer

type Type = variant {
    Multi_Pointer_Type
    Named_Type
    Pointer_Type
    Procedure_Type
    Receiver_Type
}

type Multi_Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Named_Type = struct {
    source_position: usize
    name: lexer.Identifier
}

type Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Procedure_Type = struct {
    source_position: usize
    parameters: collections.List<Procedure_Parameter>
    return_type: ^Type
    raise_type: ^Type
}

// TODO: Determine if this type is exclusively used for trait method receivers and rename accordingly
type Receiver_Type = struct {
    source_position: usize
}
