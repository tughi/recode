import collections
import compiler.lexer

type Type = variant {
    Multi_Pointer_Type
    Named_Type
    Optional_Type
    Pointer_Type
    Procedure_Type
    Trait_Receiver_Type
}

type Multi_Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Type_Argument = struct {
    argument_type: ^Type
}

type Named_Type = struct {
    source_position: usize
    module: ?lexer.Identifier
    name: lexer.Identifier
    type_arguments: collections.List<Type_Argument>
}

type Optional_Type = struct {
    source_position: usize
    inner_type: ^Type
}

type Pointer_Type = struct {
    source_position: usize
    pointee: ^Type
}

type Procedure_Type = struct {
    source_position: usize
    parameters: collections.List<Procedure_Parameter>
    return_type: ^Type
    raise_type: ^Type
}

type Trait_Receiver_Type = struct {
    source_position: usize
}
