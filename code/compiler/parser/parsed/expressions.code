import allocator
import compiler.lexer
import compiler.source

type Expression_Kind = enum {
    Add
    Address_Of
    Alloc
    Array_Access
    Bool
    Call
    Cast
    Character
    Dereference
    Divide
    Equals
    Greater
    Greater_Or_Equals
    Identifier
    Integer
    Less
    Less_Or_Equals
    Logic_And
    Logic_Or
    Member_Access
    Modulo
    Multiply
    Negate
    Not
    Not_Equals
    Null
    String
    Subtract
    Symbol
    Type_Alignment
    Type_Size
}

type Expression = struct {
    kind: Expression_Kind
    location: source.Source_Location
}

type Binary_Expression = struct {
    super: Expression
    left: ^Expression
    right: ^Expression
}

proc new_binary_expression(kind: Expression_Kind, location: source.Source_Location, left: ^Expression, right: ^Expression) -> ^Expression {
    let result = allocator.alloc(size: type_size(Binary_Expression), alignment: type_alignment(Binary_Expression)).as(^Binary_Expression)
    result.^ = Binary_Expression(
        super: Expression(kind: kind, location: location)
        left: left
        right: right
    )
    return result.as(^Expression)
}

type Unary_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_unary_expression(kind: Expression_Kind, location: source.Source_Location, operand: ^Expression) -> ^Expression {
    let result = allocator.alloc(size: type_size(Unary_Expression), alignment: type_alignment(Unary_Expression)).as(^Unary_Expression)
    result.^ = Unary_Expression(
        super: Expression(kind: kind, location: location)
        operand: operand
    )
    return result.as(^Expression)
}

type Array_Access_Expression = struct {
    super: Expression
    operand: ^Expression
    index: ^Expression
}

proc new_array_access_expression(location: source.Source_Location, operand: ^Expression, index: ^Expression) -> ^Expression {
    let result = allocator.alloc(size: type_size(Array_Access_Expression), alignment: type_alignment(Array_Access_Expression)).as(^Array_Access_Expression)
    result.^ = Array_Access_Expression(
        super: Expression(kind: .Array_Access, location: location)
        operand: operand
        index: index
    )
    return result.as(^Expression)
}

type Bool_Expression = struct {
    super: Expression
    value: bool
}

proc new_bool_expression(location: source.Source_Location, value: bool) -> ^Expression {
    let result = allocator.alloc(size: type_size(Bool_Expression), alignment: type_alignment(Bool_Expression)).as(^Bool_Expression)
    result.^ = Bool_Expression(
        super: Expression(kind: .Bool, location: location)
        value: value
    )
    return result.as(^Expression)
}

type Call_Argument = struct {
    label: ^lexer.Identifier
    expression: ^Expression
    next: ^Call_Argument
}

proc new_call_argument(label: ^lexer.Identifier, expression: ^Expression) -> ^Call_Argument {
    let result = allocator.alloc(size: type_size(Call_Argument), alignment: type_alignment(Call_Argument)).as(^Call_Argument)
    result.^ = Call_Argument(
        label: label
        expression: expression
        next: null
    )
    return result
}

type Call_Expression = struct {
    super: Expression
    operand: ^Expression
    first_argument: ^Call_Argument
}

proc new_call_expression(location: source.Source_Location, operand: ^Expression, first_argument: ^Call_Argument) -> ^Expression {
    let result = allocator.alloc(size: type_size(Call_Expression), alignment: type_alignment(Call_Expression)).as(^Call_Expression)
    result.^ = Call_Expression(
        super: Expression(kind: .Call, location: location)
        operand: operand
        first_argument: first_argument
    )
    return result.as(^Expression)
}

