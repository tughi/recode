import allocator
import compiler.lexer
import compiler.source

type Expression_Kind = enum {
    Add
    Address_Of
    Array_Access
    Bool
    Call
    Cast
    Character
    Dereference
    Divide
    Equals
    Greater
    Greater_Or_Equals
    Group
    Identifier
    Instantiation
    Integer
    Less
    Less_Or_Equals
    Logic_And
    Logic_Or
    Member_Access
    Modulo
    Multiply
    Negate
    Not
    Not_Equals
    Null
    String
    Subtract
    Symbol
    Type
    Type_Alignment
    Type_Size
}

type Expression = struct {
    kind: Expression_Kind
    location: source.Source_Location
}

type Binary_Expression = struct {
    super: Expression
    left: ^Expression
    right: ^Expression
}

proc new_binary_expression(kind: Expression_Kind, location: source.Source_Location, left: ^Expression, right: ^Expression) -> ^Expression {
    let result = allocator.new(Binary_Expression(
        super: Expression(kind: kind, location: location)
        left: left
        right: right
    ))
    return result.as(^Expression)
}

type Unary_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_unary_expression(kind: Expression_Kind, location: source.Source_Location, operand: ^Expression) -> ^Expression {
    let result = allocator.new(Unary_Expression(
        super: Expression(kind: kind, location: location)
        operand: operand
    ))
    return result.as(^Expression)
}

type Array_Access_Expression = struct {
    super: Expression
    operand: ^Expression
    index: ^Expression
}

proc new_array_access_expression(location: source.Source_Location, operand: ^Expression, index: ^Expression) -> ^Expression {
    let result = allocator.new(Array_Access_Expression(
        super: Expression(kind: .Array_Access, location: location)
        operand: operand
        index: index
    ))
    return result.as(^Expression)
}

type Bool_Expression = struct {
    super: Expression
    value: bool
}

proc new_bool_expression(location: source.Source_Location, value: bool) -> ^Expression {
    let result = allocator.new(Bool_Expression(
        super: Expression(kind: .Bool, location: location)
        value: value
    ))
    return result.as(^Expression)
}

type Call_Argument = struct {
    label: ^lexer.Identifier
    expression: ^Expression
    next: ^Call_Argument
}

proc new_call_argument(label: ^lexer.Identifier, expression: ^Expression) -> ^Call_Argument {
    return allocator.new(Call_Argument(
        label: label
        expression: expression
        next: null
    ))
}

type Call_Expression = struct {
    super: Expression
    operand: ^Expression
    first_argument: ^Call_Argument
}

proc new_call_expression(location: source.Source_Location, operand: ^Expression, first_argument: ^Call_Argument) -> ^Expression {
    let result = allocator.new(Call_Expression(
        super: Expression(kind: .Call, location: location)
        operand: operand
        first_argument: first_argument
    ))
    return result.as(^Expression)
}

type Cast_Expression = struct {
    super: Expression
    operand: ^Expression
    target_type: ^Type
}

proc new_cast_expression(location: source.Source_Location, operand: ^Expression, target_type: ^Type) -> ^Expression {
    let result = allocator.new(Cast_Expression(
        super: Expression(kind: .Cast, location: location)
        operand: operand
        target_type: target_type
    ))
    return result.as(^Expression)
}

type Character_Expression = struct {
    super: Expression
    token: ^lexer.Character
}

proc new_character_expression(token: ^lexer.Character) -> ^Expression {
    let result = allocator.new(Character_Expression(
        super: Expression(kind: .Character, location: token.location)
        token: token
    ))
    return result.as(^Expression)
}

type Identifier_Expression = struct {
    super: Expression
    name: ^lexer.Identifier
}

proc new_identifier_expression(name: ^lexer.Identifier) -> ^Expression {
    let result = allocator.new(Identifier_Expression(
        super: Expression(kind: .Identifier, location: name.location)
        name: name
    ))
    return result.as(^Expression)
}

type Instantiation_Expression = struct {
    super: Expression
    operand: ^Expression
    first_type_argument: ^Type_Argument
}

proc new_instantiation_expression(location: source.Source_Location, operand: ^Expression, first_type_argument: ^Type_Argument) -> ^Expression {
    let result = allocator.new(Instantiation_Expression(
        super: Expression(kind: .Instantiation, location: location)
        operand: operand
        first_type_argument: first_type_argument
    ))
    return result.as(^Expression)
}

type Integer_Expression = struct {
    super: Expression
    token: ^lexer.Integer
    type: ^Type
}

proc new_integer_expression(token: ^lexer.Integer, type: ^Type) -> ^Expression {
    let result = allocator.new(Integer_Expression(
        super: Expression(kind: .Integer, location: token.location)
        token: token
        type: type
    ))
    return result.as(^Expression)
}

type Member_Access_Expression = struct {
    super: Expression
    operand: ^Expression
    member: ^lexer.Identifier
}

proc new_member_access_expression(location: source.Source_Location, operand: ^Expression, member: ^lexer.Identifier) -> ^Expression {
    let result = allocator.new(Member_Access_Expression(
        super: Expression(kind: .Member_Access, location: location)
        operand: operand
        member: member
    ))
    return result.as(^Expression)
}

type Null_Expression = struct {
    super: Expression
    token: ^lexer.Identifier
}

proc new_null_expression(token: ^lexer.Identifier) -> ^Expression {
    let result = allocator.new(Null_Expression(
        super: Expression(kind: .Null, location: token.location)
        token: token
    ))
    return result.as(^Expression)
}

type String_Expression = struct {
    super: Expression
    token: ^lexer.String
}

proc new_string_expression(token: ^lexer.String) -> ^Expression {
    let result = allocator.new(String_Expression(
        super: Expression(kind: .String, location: token.location)
        token: token
    ))
    return result.as(^Expression)
}

type Symbol_Expression = struct {
    super: Expression
    name: ^lexer.Identifier
}

proc new_symbol_expression(location: source.Source_Location, name: ^lexer.Identifier) -> ^Expression {
    let result = allocator.new(Symbol_Expression(
        super: Expression(kind: .Symbol, location: location)
        name: name
    ))
    return result.as(^Expression)
}

type Type_Alignment_Expression = struct {
    super: Expression
    target_type: ^Type
}

proc new_type_alignment_expression(location: source.Source_Location, target_type: ^Type) -> ^Expression {
    let result = allocator.new(Type_Alignment_Expression(
        super: Expression(kind: .Type_Alignment, location: location)
        target_type: target_type
    ))
    return result.as(^Expression)
}

type Type_Argument = struct {
    type: ^Type
    next: ^Type_Argument
}

proc new_type_argument(type: ^Type) -> ^Type_Argument {
    return allocator.new(Type_Argument(
        type: type
        next: null
    ))
}

type Type_Expression = struct {
    super: Expression
    type: ^Type
}

proc new_type_expression(location: source.Source_Location, type: ^Type) -> ^Expression {
    let result = allocator.new(Type_Expression(
        super: Expression(kind: .Type, location: location)
        type: type
    ))
    return result.as(^Expression)
}

type Type_Size_Expression = struct {
    super: Expression
    target_type: ^Type
}

proc new_type_size_expression(location: source.Source_Location, target_type: ^Type) -> ^Expression {
    let result = allocator.new(Type_Size_Expression(
        super: Expression(kind: .Type_Size, location: location)
        target_type: target_type
    ))
    return result.as(^Expression)
}
