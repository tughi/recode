        expression: expression
    )
    return result.as(^Statement)
}

type Expression_Statement = struct {
    super: Statement
    expression: ^Expression
}

proc new_expression_statement(source_position: usize, expression: ^Expression) -> ^Statement {
    let result = allocator.alloc(size: type_size(Expression_Statement), alignment: type_alignment(Expression_Statement)).as(^Expression_Statement)
    result.^ = Expression_Statement(
        super: Statement(kind: .Expression, source_position: source_position, next: null)
        expression: expression
    )
