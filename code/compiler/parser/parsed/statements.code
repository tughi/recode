type Procedure_Parameter = struct {
    label: ^lexer.Identifier
    name: ^lexer.Identifier
    parameter_type: ^Type
    next: ^Procedure_Parameter
}

proc new_procedure_parameter(label: ^lexer.Identifier, name: ^lexer.Identifier, parameter_type: ^Type) -> ^Procedure_Parameter {
    let result = allocator.alloc(size: type_size(Procedure_Parameter), alignment: type_alignment(Procedure_Parameter)).as(^Procedure_Parameter)
    result.^ = Procedure_Parameter(
        label: label
        name: name
        parameter_type: parameter_type
        next: null
    )
    return result
}

type Procedure_Statement = struct {
    super: Statement
    receiver: ^Type
    name: ^lexer.Identifier
    first_parameter: ^Procedure_Parameter
    return_type: ^Type
    is_external: bool
    external_name: ^lexer.String
    body: ^Statement
}

proc new_procedure_statement(source_position: usize, receiver: ^Type, name: ^lexer.Identifier, first_parameter: ^Procedure_Parameter, return_type: ^Type, is_external: bool, external_name: ^lexer.String, body: ^Statement) -> ^Statement {
    let result = allocator.alloc(size: type_size(Procedure_Statement), alignment: type_alignment(Procedure_Statement)).as(^Procedure_Statement)
    result.^ = Procedure_Statement(
        super: Statement(kind: .Procedure, source_position: source_position, next: null)
        receiver: receiver
        name: name
        first_parameter: first_parameter
        return_type: return_type
        is_external: is_external
        external_name: external_name
        body: body
    )
    return result.as(^Statement)
}

type Panic_Statement = struct {
    super: Statement
    message: ^lexer.String
