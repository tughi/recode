proc new_loop_statement(source_position: usize, body: ^Statement) -> ^Statement {
    let result = allocator.alloc(size: type_size(Loop_Statement), alignment: type_alignment(Loop_Statement)).as(^Loop_Statement)
    result.^ = Loop_Statement(
        super: Statement(kind: .Loop, source_position: source_position, next: null)
        body: body
