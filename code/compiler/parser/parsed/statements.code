    super: Statement
    package: ^Package
    alias: ^lexer.Identifier
}

proc new_import_statement(source_position: usize, package: ^Package, alias: ^lexer.Identifier) -> ^Statement {
    let result = allocator.alloc(size: type_size(Import_Statement), alignment: type_alignment(Import_Statement)).as(^Import_Statement)
    result.^ = Import_Statement(
        super: Statement(kind: .Import, source_position: source_position, next: null)
        package: package
        alias: alias
