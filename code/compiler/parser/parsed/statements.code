}

proc new_type_statement(source_position: usize, name: ^lexer.Identifier, specifier: ^Type_Specifier) -> ^Statement {
    let result = allocator.alloc(size: type_size(Type_Statement), alignment: type_alignment(Type_Statement)).as(^Type_Statement)
