import collections
import compiler.lexer

type Statement_Base = struct {
    source_position: usize
}

type Statement = variant {
    Assignment_Statement
    Block_Statement
    Break_Statement
    Expression_Statement
    If_Statement
    Loop_Statement
    Procedure_Statement
    Return_Statement
    Switch_Statement
    Type_Statement
    Variable_Statement
    While_Statement
}

type Block_Statement = struct {
    super: Statement_Base
    statements: collections.List<^Statement>
}

type Break_Statement = struct {
    super: Statement_Base
}

type Loop_Statement = struct {
    super: Statement_Base
    body: ^Statement
}

type While_Statement = struct {
    super: Statement_Base
    condition: ^Expression
    body: ^Statement
}

type If_Statement = struct {
    super: Statement_Base
    condition: ^Expression
    true_block: ^Statement
    false_statement: ^Statement
}

type Variable_Statement = struct {
    super: Statement_Base
    name: lexer.Identifier
    variable_type: ^Type
    is_external: bool
    expression: ^Expression
    external_name: lexer.Optional_String
}

type Return_Statement = struct {
    super: Statement_Base
    expression: ^Expression
}

type Expression_Statement = struct {
    super: Statement_Base
    expression: ^Expression
}

type Assignment_Statement = struct {
    super: Statement_Base
    object: ^Expression
    value: ^Expression
}

type Switch_Case = variant {
    Switch_Else
    Switch_Expression
    Switch_Variant
}

type Switch_Else = struct {
    source_position: usize
    body: ^Statement
}

type Switch_Expression = struct {
    source_position: usize
    expression: ^Expression
    body: ^Statement
}

type Switch_Variant = struct {
    source_position: usize
    variant_type: ^Type
    alias: lexer.Optional_Identifier
    body: ^Statement
}

type Switch_Statement = struct {
    super: Statement_Base
    expression: ^Expression
    cases: collections.List<Switch_Case>
}

type Procedure_Parameter = struct {
    label: lexer.Optional_Identifier
    name: lexer.Identifier
    parameter_type: ^Type
}

type Procedure_Statement = struct {
    super: Statement_Base
    receiver: ^Type
    name: lexer.Identifier
    parameters: collections.List<Procedure_Parameter>
    return_type: ^Type
    is_external: bool
    body: ^Statement
}

type Type_Statement = struct {
    super: Statement_Base
    name: lexer.Identifier
    specifier: ^Type_Specifier
}

type Type_Specifier = variant {
    External_Type_Specifier
    Struct_Type_Specifier
    Trait_Type_Specifier
    Variant_Type_Specifier
}

type External_Type_Specifier = struct {
    source_position: usize
}

type Struct_Member = struct {
    name: lexer.Identifier
    member_type: ^Type
}

type Struct_Type_Specifier = struct {
    source_position: usize
    members: collections.List<Struct_Member>
}

type Trait_Method = struct {
    source_position: usize
    name: lexer.Identifier
    parameters: collections.List<Procedure_Parameter>
    return_type: ^Type
    raise_type: ^Type
}

type Trait_Type_Specifier = struct {
    source_position: usize
    methods: collections.List<Trait_Method>
}

type Variant_Case = struct {
    variant_type: ^Type
}

type Variant_Type_Specifier = struct {
    source_position: usize
    cases: collections.List<Variant_Case>
}
