}

type If_Statement = struct {
    super: Statement
    condition: ^Expression
    true_block: ^Statement
    false_statement: ^Statement
}

proc new_if_statement(source_position: usize, condition: ^Expression, true_block: ^Statement, false_statement: ^Statement) -> ^Statement {
    let result = allocator.alloc(size: type_size(If_Statement), alignment: type_alignment(If_Statement)).as(^If_Statement)
    result.^ = If_Statement(
        super: Statement(kind: .If, source_position: source_position, next: null)
        condition: condition
        true_block: true_block
        false_statement: false_statement
    )
    return result.as(^Statement)
}

