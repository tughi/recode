type Type_Specifier_Kind = enum {
    Builtin
    Enum
    External
    Struct
}

type Type_Specifier = struct {
    kind: Type_Specifier_Kind
    source_position: usize
}

type Builtin_Type_Specifier = struct {
    super: Type_Specifier
}

proc new_builtin_type_specifier(source_position: usize) -> ^Type_Specifier {
    let result = allocator.alloc(size: type_size(Builtin_Type_Specifier), alignment: type_alignment(Builtin_Type_Specifier)).as(^Builtin_Type_Specifier)
    result.^ = Builtin_Type_Specifier(
        super: Type_Specifier(kind: .Builtin, source_position: source_position)
    )
    return result.as(^Type_Specifier)
}

type External_Type_Specifier = struct {
    super: Type_Specifier
}

proc new_external_type_specifier(source_position: usize) -> ^Type_Specifier {
    let result = allocator.alloc(size: type_size(External_Type_Specifier), alignment: type_alignment(External_Type_Specifier)).as(^External_Type_Specifier)
    result.^ = External_Type_Specifier(
        super: Type_Specifier(kind: .External, source_position: source_position)
    )
    return result.as(^Type_Specifier)
}

