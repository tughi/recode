import allocator
import collections
import compiler.error
import compiler.lexer
import compiler.lexer.match
import compiler.parser.parsed
import compiler.source

type Parser = struct {
    lexer: lexer.Lexer
    alignment: i32
}

proc parse(anon source: source.Source) !> error.Error {
    let parser = Parser(
        lexer: lexer.create(source)
    )

    loop {
        if parser.lexer.matches(match.end_of_file) {
            break
        } else if parser.lexer.matches(match.space, match.comment) or parser.lexer.matches(match.space, match.end_of_line) {
            parser.lexer.consume_empty_line(parser.alignment)
        } else if parser.lexer.matches(match.keyword("type")) {
            parser.parse_type_statement()
            parser.lexer.consume_end_of_line()
        } else if parser.lexer.matches(match.keyword("let")) {
            parser.parse_variable_declaration_statement()
            parser.lexer.consume_end_of_line()
        } else {
            parser.parse_procedure_statement()
            parser.lexer.consume_end_of_line()
        }
    }

    return
}

proc (^Parser).alloc(self, statement: parsed.Statement) -> ^parsed.Statement !> error.Error {
    let result = self.allocate(size: type_size(parsed.Statement), alignment: type_alignment(parsed.Statement)).as(^parsed.Statement)
    result.^ = statement
    return result
}

proc (^Parser).alloc(self, type: parsed.Type) -> ^parsed.Type !> error.Error {
    let result = self.allocate(size: type_size(parsed.Type), alignment: type_alignment(parsed.Type)).as(^parsed.Type)
    result.^ = type
    return result
}

proc (^Parser).alloc(self, type_specifier: parsed.Type_Specifier) -> ^parsed.Type_Specifier !> error.Error {
    let result = self.allocate(size: type_size(parsed.Type_Specifier), alignment: type_alignment(parsed.Type_Specifier)).as(^parsed.Type_Specifier)
    result.^ = type_specifier
    return result
}

proc (^Parser).parse_block_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_other('{')
    self.lexer.consume_end_of_line()
    self.increase_alignment()
    let statements = collections.List<^parsed.Statement>()
    while not self.lexer.matches(match.space, match.other('}')) {
        self.lexer.consume_space(self.alignment)
        let statement = self.parse_statement()
        self.lexer.consume_end_of_line()
        statements.append(value: statement)
    }
    self.decrease_alignment()
    self.lexer.consume_space(self.alignment)
    self.lexer.consume_other('}')
    return self.alloc(statement: parsed.Block_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        statements: statements
    ))
}

proc (^Parser).parse_procedure_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("proc")
    self.lexer.consume_space(1)
    let procedure_name = self.lexer.consume_identifier()
    self.lexer.consume_space(0)
    self.lexer.consume_other('(')
    self.parse_procedure_parameters()
    self.lexer.consume_other(')')
    self.lexer.consume_space(1)
    let return_type: ^parsed.Type = null
    if self.lexer.matches(match.other('-'), match.other('>')) {
        self.lexer.consume_other('-', '>')
        self.lexer.consume_space(1)
        return_type = self.parse_type()
        self.lexer.consume_space(1)
    }
    let is_external = false
    let body: ^parsed.Statement = null
    if self.lexer.matches(match.other('=')) {
        self.lexer.consume_other('=')
        self.lexer.consume_space(1)
        self.lexer.consume_keyword("external")
        is_external = true
    } else {
        body = self.parse_block_statement()
    }
    return self.alloc(statement: parsed.Procedure_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        name: procedure_name
        return_type: return_type
        is_external: is_external
        body: body
    ))
}

proc (^Parser).parse_procedure_parameters(self) !> error.Error {
    if not self.lexer.matches(match.space, match.other(')')) {
        self.lexer.consume_space(0)
        loop {
            if self.lexer.matches(match.identifier, match.space, match.identifier) {
                self.lexer.consume_identifier()
                self.lexer.consume_space(1)
            }
            self.lexer.consume_identifier()
            self.lexer.consume_space(0)
            self.lexer.consume_other(':')
            self.lexer.consume_space(1)
            self.parse_type()
            self.lexer.consume_space(0)
            if self.lexer.matches(match.other(')')) {
                break
            }
            self.lexer.consume_other(',')
            self.lexer.consume_space(1)
        }
    }
    return
}

proc (^Parser).parse_statement(self) -> ^parsed.Statement !> error.Error {
    if self.lexer.matches(match.keyword("break")) {
        return self.parse_break_statement()
    } else if self.lexer.matches(match.keyword("loop")) {
        return self.parse_loop_statement()
    } else if self.lexer.matches(match.keyword("while")) {
        return self.parse_while_statement()
    } else if self.lexer.matches(match.keyword("if")) {
        return self.parse_if_statement()
    } else if self.lexer.matches(match.keyword("let")) {
        return self.parse_variable_declaration_statement()
    } else if self.lexer.matches(match.keyword("return")) {
        return self.parse_return_statement()
    } else {
        let source_position = self.lexer.source_position
        let expression = self.parse_expression()
        if self.lexer.matches(match.space, match.other('=')) and not self.lexer.matches(match.space, match.other('='), match.other('=')) {
            self.lexer.consume_space(1)
            self.lexer.consume_other('=')
            self.lexer.consume_space(1)
            let value = self.parse_expression()
            return self.alloc(statement: parsed.Assignment_Statement(
                super: parsed.Statement_Base(source_position: source_position)
                object: expression
                value: value
            ))
        }
        return self.alloc(statement: parsed.Expression_Statement(
            super: parsed.Statement_Base(source_position: source_position)
            expression: expression
        ))
    }
}

proc (^Parser).parse_break_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("break")
    return self.alloc(statement: parsed.Break_Statement(
        super: parsed.Statement_Base(source_position: source_position)
    ))
}

proc (^Parser).parse_loop_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("loop")
    self.lexer.consume_space(1)
    let body = self.parse_block_statement()
    return self.alloc(statement: parsed.Loop_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        body: body
    ))
}

proc (^Parser).parse_while_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("while")
    self.lexer.consume_space(1)
    let condition = self.parse_expression()
    self.lexer.consume_space(1)
    let body = self.parse_block_statement()
    return self.alloc(statement: parsed.While_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        condition: condition
        body: body
    ))
}

proc (^Parser).parse_if_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("if")
    self.lexer.consume_space(1)
    let condition = self.parse_expression()
    self.lexer.consume_space(1)
    let true_block = self.parse_block_statement()
    let false_statement: ^parsed.Statement = null
    if self.lexer.matches(match.space, match.keyword("else")) {
        self.lexer.consume_space(1)
        self.lexer.consume_keyword("else")
        self.lexer.consume_space(1)
        if self.lexer.matches(match.keyword("if")) {
            false_statement = self.parse_if_statement()
        } else {
            false_statement = self.parse_block_statement()
        }
    }
    return self.alloc(statement: parsed.If_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        condition: condition
        true_block: true_block
        false_statement: false_statement
    ))
}

proc (^Parser).parse_variable_declaration_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("let")
    self.lexer.consume_space(1)
    let name = self.lexer.consume_identifier()
    let variable_type: ^parsed.Type = null
    if self.lexer.matches(match.space, match.other(':')) {
        self.lexer.consume_space(0)
        self.lexer.consume_other(':')
        self.lexer.consume_space(1)
        variable_type = self.parse_type()
    }
    let is_external = false
    let expression: ^parsed.Expression = null
    let external_name: lexer.Optional_String = nil
    if self.lexer.matches(match.space, match.other('=')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('=')
        self.lexer.consume_space(1)
        if self.lexer.matches(match.keyword("external")) {
            self.lexer.consume_keyword("external")
            is_external = true
            if self.lexer.matches(match.space, match.String()) {
                self.lexer.consume_space(1)
                external_name = self.lexer.consume_string()
            }
        } else {
            expression = self.parse_expression()
        }
    }
    return self.alloc(statement: parsed.Variable_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        name: name
        variable_type: variable_type
        is_external: is_external
        expression: expression
        external_name: external_name
    ))
}

proc (^Parser).parse_return_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("return")
    self.lexer.consume_space(1)
    let expression = self.parse_expression()
    return self.alloc(statement: parsed.Return_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        expression: expression
    ))
}

proc (^Parser).parse_expression(self) -> ^parsed.Expression !> error.Error {
    return self.parse_logic_or_expression()
}

proc (^Parser).parse_logic_or_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_logic_and_expression()
    while self.lexer.matches(match.space, match.keyword("or")) {
        self.lexer.consume_space(1)
        self.lexer.consume_keyword("or")
        self.lexer.consume_space(1)
        self.parse_logic_and_expression()
    }
    return expression
}

proc (^Parser).parse_logic_and_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_equality_expression()
    while self.lexer.matches(match.space, match.keyword("and")) {
        self.lexer.consume_space(1)
        self.lexer.consume_keyword("and")
        self.lexer.consume_space(1)
        self.parse_equality_expression()
    }
    return expression
}

proc (^Parser).parse_equality_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_comparison_expression()
    if self.lexer.matches(match.space, match.other('='), match.other('=')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('=', '=')
        self.lexer.consume_space(1)
        self.parse_comparison_expression()
    } else if self.lexer.matches(match.space, match.other('!'), match.other('=')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('!', '=')
        self.lexer.consume_space(1)
        self.parse_comparison_expression()
    }
    return expression
}

proc (^Parser).parse_comparison_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_additive_expression()
    if self.lexer.matches(match.space, match.other('<'), match.other('=')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('<', '=')
        self.lexer.consume_space(1)
        self.parse_additive_expression()
    } else if self.lexer.matches(match.space, match.other('<')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('<')
        self.lexer.consume_space(1)
        self.parse_additive_expression()
    } else if self.lexer.matches(match.space, match.other('>'), match.other('=')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('>', '=')
        self.lexer.consume_space(1)
        self.parse_additive_expression()
    } else if self.lexer.matches(match.space, match.other('>')) {
        self.lexer.consume_space(1)
        self.lexer.consume_other('>')
        self.lexer.consume_space(1)
        self.parse_additive_expression()
    }
    return expression
}

proc (^Parser).parse_additive_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_multiplicative_expression()
    while self.lexer.matches(match.space, match.other('+')) or self.lexer.matches(match.space, match.other('-')) {
        self.lexer.consume_space(1)
        if self.lexer.matches(match.other('+')) {
            self.lexer.consume_other('+')
        } else {
            self.lexer.consume_other('-')
        }
        self.lexer.consume_space(1)
        self.parse_multiplicative_expression()
    }
    return expression
}

proc (^Parser).parse_multiplicative_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_unary_expression()
    while self.lexer.matches(match.space, match.other('*')) or self.lexer.matches(match.space, match.other('%')) or self.lexer.matches(match.space, match.other('/')) {
        self.lexer.consume_space(1)
        if self.lexer.matches(match.other('*')) {
            self.lexer.consume_other('*')
        } else if self.lexer.matches(match.other('%')) {
            self.lexer.consume_other('%')
        } else {
            self.lexer.consume_other('/')
        }
        self.lexer.consume_space(1)
        self.parse_unary_expression()
    }
    return expression
}

proc (^Parser).parse_unary_expression(self) -> ^parsed.Expression !> error.Error {
    if self.lexer.matches(match.keyword("type_size")) {
        self.lexer.consume_keyword("type_size")
        self.lexer.consume_space(0)
        self.lexer.consume_other('(')
        self.lexer.consume_space(0)
        self.parse_type()
        self.lexer.consume_space(0)
        self.lexer.consume_other(')')
        return null
    } else if self.lexer.matches(match.keyword("type_alignment")) {
        self.lexer.consume_keyword("type_alignment")
        self.lexer.consume_space(0)
        self.lexer.consume_other('(')
        self.lexer.consume_space(0)
        self.parse_type()
        self.lexer.consume_space(0)
        self.lexer.consume_other(')')
        return null
    } else if self.lexer.matches(match.other('^')) {
        self.lexer.consume_other('^')
        self.lexer.consume_space(0)
        self.parse_unary_expression()
        return null
    } else if self.lexer.matches(match.other('-')) {
        self.lexer.consume_other('-')
        self.lexer.consume_space(0)
        self.parse_unary_expression()
        return null
    } else if self.lexer.matches(match.keyword("not")) {
        self.lexer.consume_keyword("not")
        self.lexer.consume_space(1)
        self.parse_unary_expression()
        return null
    } else {
        return self.parse_access_expression()
    }
}

proc (^Parser).parse_access_expression(self) -> ^parsed.Expression !> error.Error {
    let expression = self.parse_primary_expression()
    loop {
        if self.lexer.matches(match.space, match.other('.')) {
            self.lexer.consume_space(0)
            self.lexer.consume_other('.')
            self.lexer.consume_space(0)
            if self.lexer.matches(match.other('^')) {
                self.lexer.consume_other('^')
            } else if self.lexer.matches(match.keyword("as")) {
                self.lexer.consume_keyword("as")
                self.lexer.consume_space(0)
                self.lexer.consume_other('(')
                self.lexer.consume_space(0)
                self.parse_type()
                self.lexer.consume_space(0)
                self.lexer.consume_other(')')
            } else {
                self.lexer.consume_identifier()
            }
        } else if self.lexer.matches(match.other('(')) {
            self.parse_call_arguments()
        } else {
            break
        }
    }
    return expression
}

proc (^Parser).parse_primary_expression(self) -> ^parsed.Expression !> error.Error {
    if self.lexer.matches(match.identifier) {
        self.lexer.consume_identifier()
        return null
    } else if self.lexer.matches(match.other('(')) {
        self.lexer.consume_other('(')
        self.lexer.consume_space(0)
        let expression = self.parse_expression()
        self.lexer.consume_space(0)
        self.lexer.consume_other(')')
        return expression
    } else {
        let integer_token = self.lexer.consume_integer()
        let result = self.allocate(size: type_size(parsed.Expression), alignment: type_alignment(parsed.Expression)).as(^parsed.Expression)
        result.^ = parsed.Integer_Expression(
            source_position: integer_token.super.source_position
            token: integer_token
        )
        return result
    }
}

proc (^Parser).parse_call_arguments(self) !> error.Error {
    self.lexer.consume_other('(')

    let multiline = false

    if self.lexer.matches(match.end_of_line) {
        self.lexer.consume_end_of_line()
        multiline = true
        self.increase_alignment()
        while self.lexer.matches(match.space, match.comment) or self.lexer.matches(match.space, match.end_of_line) {
            self.lexer.consume_empty_line(self.alignment)
        }
    }

    while not self.lexer.matches(match.space, match.other(')')) {
        let space_before_argument = 0
        if multiline {
            space_before_argument = self.alignment
        }
        self.lexer.consume_space(space_before_argument)

        self.parse_call_argument()

        while self.lexer.matches(match.space, match.other(',')) {
            self.lexer.consume_space(0)
            self.lexer.consume_other(',')
            self.lexer.consume_space(1)
            self.parse_call_argument()
        }

        if self.lexer.matches(match.space, match.comment) or self.lexer.matches(match.space, match.end_of_line) {
            self.lexer.consume_end_of_line()
            if not multiline {
                multiline = true
                self.increase_alignment()
            }
            while self.lexer.matches(match.space, match.comment) or self.lexer.matches(match.space, match.end_of_line) {
                self.lexer.consume_empty_line(self.alignment)
            }
        }
    }

    if multiline {
        self.decrease_alignment()
        self.lexer.consume_space(self.alignment)
    } else {
        self.lexer.consume_space(0)
    }

    self.lexer.consume_other(')')
    return
}

proc (^Parser).parse_call_argument(self) !> error.Error {
    if self.lexer.matches(match.identifier, match.space, match.other(':')) {
        self.lexer.consume_identifier()
        self.lexer.consume_space(0)
        self.lexer.consume_other(':')
        self.lexer.consume_space(1)
    }
    self.parse_expression()
    return
}

proc (^Parser).parse_type(self) -> ^parsed.Type !> error.Error {
    let source_position = self.lexer.source_position
    if self.lexer.matches(match.other('^')) {
        self.lexer.consume_other('^')
        self.lexer.consume_space(0)
        let pointee = self.parse_type()
        return self.alloc(type: parsed.Pointer_Type(source_position: source_position, pointee: pointee))
    }
    if self.lexer.matches(match.keyword("proc")) {
        self.lexer.consume_keyword("proc")
        self.lexer.consume_space(1)
        self.lexer.consume_other('(')
        self.parse_procedure_parameters()
        self.lexer.consume_other(')')
        let return_type: ^parsed.Type = null
        if self.lexer.matches(match.space, match.other('-'), match.other('>')) {
            self.lexer.consume_space(1)
            self.lexer.consume_other('-', '>')
            self.lexer.consume_space(1)
            return_type = self.parse_type()
        }
        let raise_type: ^parsed.Type = null
        if self.lexer.matches(match.space, match.other('!'), match.other('>')) {
            self.lexer.consume_space(1)
            self.lexer.consume_other('!', '>')
            self.lexer.consume_space(1)
            raise_type = self.parse_type()
        }
        return self.alloc(type: parsed.Procedure_Type(
            source_position: source_position
            return_type: return_type
            raise_type: raise_type
        ))
    }
    let name_token = self.lexer.consume_identifier()
    return self.alloc(type: parsed.Named_Type(source_position: name_token.super.source_position, name: name_token))
}

proc (^Parser).parse_type_specifier(self) -> ^parsed.Type_Specifier !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("external")
    return self.alloc(type_specifier: parsed.External_Type_Specifier(source_position: source_position))
}

proc (^Parser).parse_type_statement(self) -> ^parsed.Statement !> error.Error {
    let source_position = self.lexer.source_position
    self.lexer.consume_keyword("type")
    self.lexer.consume_space(1)
    let name = self.lexer.consume_identifier()
    self.lexer.consume_space(1)
    self.lexer.consume_other('=')
    self.lexer.consume_space(1)
    let specifier = self.parse_type_specifier()
    return self.alloc(statement: parsed.Type_Statement(
        super: parsed.Statement_Base(source_position: source_position)
        name: name
        specifier: specifier
    ))
}

proc (^Parser).allocate(self, size: usize, alignment: usize) -> ^Any !> error.Error {
    return try allocator.alloc(size: size, alignment: alignment) else {
        raise self.lexer.error(error.message)
    }
}

proc (^Parser).increase_alignment(self) {
    self.alignment = self.alignment + 4
}

proc (^Parser).decrease_alignment(self) {
    self.alignment = self.alignment - 4
}
