import compiler.source
import libc

type Parser = struct {
    source: source.Source
    source_position: usize
    alignment: i32
}

proc parse(anon source: source.Source) !> Error {
    let parser = Parser(
        source: source
        source_position: 0
    )

    parser.parse_procedure_statement()

    return
}

proc (^Parser).parse_block_statement(self) !> Error {
    self.consume("{")
    self.consume_end_of_line()
    self.increase_alignment()
    while not self.matches(first: Space(), second: "}") {
        self.consume_space(self.alignment)
        self.parse_statement()
        self.consume_end_of_line()
    }
    self.decrease_alignment()
    self.consume("}")
    return
}

proc (^Parser).parse_procedure_statement(self) !> Error {
    self.consume("proc")
    self.consume_space(1)
    let procedure_name = self.consume_identifier()
    self.consume("(")
    self.consume(")")
    self.consume_space(1)
    self.consume("->")
    self.consume_space(1)
    let procedure_return_type = self.parse_type()
    self.consume_space(1)
    self.parse_block_statement()
    return
}

proc (^Parser).parse_statement(self) !> Error {
    let peek_end = try self.matches(Identifier_Match(), from: self.source_position) else {
        return
    }
    let peek = self.source.content.slice(self.source_position, peek_end)
    if peek.equals("return") {
        self.parse_return_statement()
    } else {
        raise self.error("Unsupported statement")
    }
    return
}

proc (^Parser).parse_return_statement(self) !> Error {
    self.consume("return")
    self.consume_space(1)
    self.parse_expression()
    return
}

proc (^Parser).parse_expression(self) !> Error {
    self.consume_integer_literal()
    return
}

type Parsed_Type = struct {
    name: Identifier
}

proc (^Parser).parse_type(self) -> Parsed_Type !> Error {
    let type_name = self.consume_identifier()
    return Parsed_Type(name: type_name)
}

proc (^Parser).increase_alignment(self) {
    self.alignment = self.alignment + 4
}

proc (^Parser).decrease_alignment(self) {
    self.alignment = self.alignment - 4
}
