import compiler.source
import libc

type Parser = struct {
    source: source.Source
    source_position: usize
    alignment: i32
}

proc parse(anon source: source.Source) !> Error {
    let parser = Parser(
        source: source
        source_position: 0
    )

    loop {
        if parser.matches(first: End_Of_File()) {
            break
        } else if parser.matches(first: Space(), second: Comment()) or parser.matches(first: Space(), second: End_Of_Line()) {
            parser.consume_empty_line()
        } else if parser.matches(first: "type") {
            parser.parse_type_statement()
            parser.consume_end_of_line()
        } else if parser.matches(first: "let") {
            parser.parse_variable_declaration_statement()
            parser.consume_end_of_line()
        } else {
            parser.parse_procedure_statement()
            parser.consume_end_of_line()
        }
    }

    return
}

proc (^Parser).parse_block_statement(self) !> Error {
    self.consume("{")
    self.consume_end_of_line()
    self.increase_alignment()
    while not self.matches(first: Space(), second: "}") {
        self.consume_space(self.alignment)
        self.parse_statement()
        self.consume_end_of_line()
    }
    self.decrease_alignment()
    self.consume_space(self.alignment)
    self.consume("}")
    return
}

proc (^Parser).parse_procedure_statement(self) !> Error {
    self.consume("proc")
    self.consume_space(1)
    let procedure_name = self.consume_identifier()
    self.consume_space(0)
    self.consume("(")
    self.parse_procedure_parameters()
    self.consume(")")
    self.consume_space(1)
    if self.matches(first: "->") {
        self.consume("->")
        self.consume_space(1)
        let procedure_return_type = self.parse_type()
        self.consume_space(1)
    }
    if self.matches(first: "=") {
        self.consume("=")
        self.consume_space(1)
        self.consume("external")
    } else {
        self.parse_block_statement()
    }
    return
}

proc (^Parser).parse_procedure_parameters(self) !> Error {
    if not self.matches(first: Space(), second: ")") {
        self.consume_space(0)
        loop {
            if self.matches(first: Identifier_Match(), second: Space(), third: Identifier_Match()) {
                let parameter_label = self.consume_identifier()
                self.consume_space(1)
            }
            let parameter_name = self.consume_identifier()
            self.consume_space(0)
            self.consume(":")
            self.consume_space(1)
            self.parse_type()
            self.consume_space(0)
            if self.matches(first: ")") {
                break
            }
            self.consume(",")
            self.consume_space(1)
        }
    }
    return
}

proc (^Parser).parse_statement(self) !> Error {
    let peek_end = try self.matches(Identifier_Match(), from: self.source_position) else {
        return
    }
    let peek = self.source.content.slice(self.source_position, peek_end)
    if peek.equals("break") {
        self.parse_break_statement()
    } else if peek.equals("loop") {
        self.parse_loop_statement()
    } else if peek.equals("while") {
        self.parse_while_statement()
    } else if peek.equals("if") {
        self.parse_if_statement()
    } else if peek.equals("let") {
        self.parse_variable_declaration_statement()
    } else if peek.equals("return") {
        self.parse_return_statement()
    } else {
        self.parse_expression()
        if self.matches(first: Space(), second: "=") and not self.matches(first: Space(), second: "==") {
            self.consume_space(1)
            self.consume("=")
            self.consume_space(1)
            self.parse_expression()
        }
    }
    return
}

proc (^Parser).parse_loop_statement(self) !> Error {
    self.consume("loop")
    self.consume_space(1)
    self.parse_block_statement()
    return
}

proc (^Parser).parse_break_statement(self) !> Error {
    self.consume("break")
    return
}

proc (^Parser).parse_while_statement(self) !> Error {
    self.consume("while")
    self.consume_space(1)
    self.parse_expression()
    self.consume_space(1)
    self.parse_block_statement()
    return
}

proc (^Parser).parse_if_statement(self) !> Error {
    self.consume("if")
    self.consume_space(1)
    self.parse_expression()
    self.consume_space(1)
    self.parse_block_statement()
    if self.matches(first: Space(), second: "else", third: Space()) {
        self.consume_space(1)
        self.consume("else")
        self.consume_space(1)
        if self.matches(first: "if") {
            self.parse_if_statement()
        } else {
            self.parse_block_statement()
        }
    }
    return
}

proc (^Parser).parse_variable_declaration_statement(self) !> Error {
    self.consume("let")
    self.consume_space(1)
    self.consume_identifier()
    if self.matches(first: Space(), second: ":") {
        self.consume_space(0)
        self.consume(":")
        self.consume_space(1)
        self.parse_type()
    }
    if self.matches(first: Space(), second: "=") {
        self.consume_space(1)
        self.consume("=")
        self.consume_space(1)
        if self.matches(first: "external") {
            self.consume("external")
            self.consume_space(0)
            if self.source.content.char_at(self.source_position) == '"' {
                self.consume_string_literal()
            }
        } else {
            self.parse_expression()
        }
    }
    return
}

proc (^Parser).parse_return_statement(self) !> Error {
    self.consume("return")
    self.consume_space(1)
    self.parse_expression()
    return
}

proc (^Parser).parse_expression(self) !> Error {
    self.parse_logic_or_expression()
    return
}

proc (^Parser).parse_logic_or_expression(self) !> Error {
    self.parse_logic_and_expression()
    while self.matches(first: Space(), second: "or") {
        self.consume_space(1)
        self.consume("or")
        self.consume_space(1)
        self.parse_logic_and_expression()
    }
    return
}

proc (^Parser).parse_logic_and_expression(self) !> Error {
    self.parse_equality_expression()
    while self.matches(first: Space(), second: "and") {
        self.consume_space(1)
        self.consume("and")
        self.consume_space(1)
        self.parse_equality_expression()
    }
    return
}

proc (^Parser).parse_equality_expression(self) !> Error {
    self.parse_comparison_expression()
    if self.matches(first: Space(), second: "==") {
        self.consume_space(1)
        self.consume("==")
        self.consume_space(1)
        self.parse_comparison_expression()
    } else if self.matches(first: Space(), second: "!=") {
        self.consume_space(1)
        self.consume("!=")
        self.consume_space(1)
        self.parse_comparison_expression()
    }
    return
}

proc (^Parser).parse_comparison_expression(self) !> Error {
    self.parse_additive_expression()
    if self.matches(first: Space(), second: "<=") {
        self.consume_space(1)
        self.consume("<=")
        self.consume_space(1)
        self.parse_additive_expression()
    } else if self.matches(first: Space(), second: "<") {
        self.consume_space(1)
        self.consume("<")
        self.consume_space(1)
        self.parse_additive_expression()
    } else if self.matches(first: Space(), second: ">=") {
        self.consume_space(1)
        self.consume(">=")
        self.consume_space(1)
        self.parse_additive_expression()
    } else if self.matches(first: Space(), second: ">") {
        self.consume_space(1)
        self.consume(">")
        self.consume_space(1)
        self.parse_additive_expression()
    }
    return
}

proc (^Parser).parse_additive_expression(self) !> Error {
    self.parse_multiplicative_expression()
    while self.matches(first: Space(), second: "+") or self.matches(first: Space(), second: "-") {
        self.consume_space(1)
        if self.matches(first: "+") {
            self.consume("+")
        } else {
            self.consume("-")
        }
        self.consume_space(1)
        self.parse_multiplicative_expression()
    }
    return
}

proc (^Parser).parse_multiplicative_expression(self) !> Error {
    self.parse_unary_expression()
    while self.matches(first: Space(), second: "*") or self.matches(first: Space(), second: "%") or (self.matches(first: Space(), second: "/") and not self.matches(first: Space(), second: Comment())) {
        self.consume_space(1)
        if self.matches(first: "*") {
            self.consume("*")
        } else if self.matches(first: "%") {
            self.consume("%")
        } else {
            self.consume("/")
        }
        self.consume_space(1)
        self.parse_unary_expression()
    }
    return
}

proc (^Parser).parse_unary_expression(self) !> Error {
    if self.matches(first: "^") {
        self.consume("^")
        self.consume_space(0)
        self.parse_unary_expression()
    } else if self.matches(first: "-") {
        self.consume("-")
        self.consume_space(0)
        self.parse_unary_expression()
    } else if self.matches(first: "not") {
        self.consume("not")
        self.consume_space(1)
        self.parse_unary_expression()
    } else {
        self.parse_access_expression()
    }
    return
}

proc (^Parser).parse_access_expression(self) !> Error {
    self.parse_primary_expression()
    loop {
        if self.matches(first: Space(), second: ".") {
            self.consume_space(0)
            self.consume(".")
            self.consume_space(0)
            if self.matches(first: "^") {
                self.consume("^")
            } else if self.matches(first: "as") {
                self.consume("as")
                self.consume_space(0)
                self.consume("(")
                self.consume_space(0)
                self.parse_type()
                self.consume_space(0)
                self.consume(")")
            } else {
                self.consume_identifier()
            }
        } else if self.matches(first: "(") {
            self.parse_call_arguments()
        } else {
            break
        }
    }
    return
}

proc (^Parser).parse_primary_expression(self) !> Error {
    if self.matches(first: Identifier_Match()) {
        self.consume_identifier()
    } else if self.matches(first: "(") {
        self.consume("(")
        self.consume_space(0)
        self.parse_expression()
        self.consume_space(0)
        self.consume(")")
    } else {
        self.consume_integer_literal()
    }
    return
}

proc (^Parser).parse_call_arguments(self) !> Error {
    self.consume("(")

    let multiline = false

    if self.matches(first: End_Of_Line()) {
        self.consume_end_of_line()
        multiline = true
        self.increase_alignment()
        while self.matches(first: Space(), second: Comment()) or self.matches(first: Space(), second: End_Of_Line()) {
            self.consume_empty_line()
        }
    }

    while not self.matches(first: Space(), second: ")") {
        let space_before_argument = 0
        if multiline {
            space_before_argument = self.alignment
        }
        self.consume_space(space_before_argument)

        self.parse_call_argument()

        while self.matches(first: Space(), second: ",") {
            self.consume_space(0)
            self.consume(",")
            self.consume_space(1)
            self.parse_call_argument()
        }

        if self.matches(first: Space(), second: Comment()) or self.matches(first: Space(), second: End_Of_Line()) {
            self.consume_end_of_line()
            if not multiline {
                multiline = true
                self.increase_alignment()
            }
            while self.matches(first: Space(), second: Comment()) or self.matches(first: Space(), second: End_Of_Line()) {
                self.consume_empty_line()
            }
        }
    }

    if multiline {
        self.decrease_alignment()
        self.consume_space(self.alignment)
    } else {
        self.consume_space(0)
    }

    self.consume(")")
    return
}

proc (^Parser).parse_call_argument(self) !> Error {
    if self.matches(first: Identifier_Match(), second: Space(), third: ":") {
        let argument_name = self.consume_identifier()
        self.consume_space(0)
        self.consume(":")
        self.consume_space(1)
    }
    self.parse_expression()
    return
}

type Parsed_Type = struct {
    name: Identifier
}

proc (^Parser).parse_type(self) -> Parsed_Type !> Error {
    if self.matches(first: "^") {
        self.consume("^")
        self.consume_space(0)
        return self.parse_type()
    }
    if self.matches(first: "proc") {
        self.consume("proc")
        self.consume_space(1)
        self.consume("(")
        self.parse_procedure_parameters()
        self.consume(")")
        if self.matches(first: Space(), second: "->") {
            self.consume_space(1)
            self.consume("->")
            self.consume_space(1)
            self.parse_type()
        }
        if self.matches(first: Space(), second: "!>") {
            self.consume_space(1)
            self.consume("!>")
            self.consume_space(1)
            self.parse_type()
        }
        return Parsed_Type(name: Identifier(lexeme: "proc", source_position: self.source_position))
    }
    let type_name = self.consume_identifier()
    return Parsed_Type(name: type_name)
}

proc (^Parser).parse_type_specifier(self) !> Error {
    self.consume("external")
    return
}

proc (^Parser).parse_type_statement(self) !> Error {
    self.consume("type")
    self.consume_space(1)
    self.consume_identifier()
    self.consume_space(1)
    self.consume("=")
    self.consume_space(1)
    self.parse_type_specifier()
    return
}

proc (^Parser).increase_alignment(self) {
    self.alignment = self.alignment + 4
}

proc (^Parser).decrease_alignment(self) {
    self.alignment = self.alignment - 4
}
