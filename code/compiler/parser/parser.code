import compiler.source
import libc

type Parser = struct {
    source: source.Source
    source_position: usize
    alignment: i32
}

proc parse(anon source: source.Source) !> Error {
    let parser = Parser(
        source: source
        source_position: 0
    )

    parser.parse_procedure_statement()

    return
}

proc (^Parser).matches_two(self, first: proc (parser: ^Parser, from: usize) -> usize !> Error, second: proc (parser: ^Parser, from: usize) -> usize !> Error) -> bool {
    let index = try first(parser: self, from: self.source_position) else {
        return false
    }
    index = try second(parser: self, from: index) else {
        return false
    }
    return true
}

proc matches_closing_brace(parser: ^Parser, from index: usize) -> usize !> Error {
    if parser.source.content.char_at(index) == '}' {
        return index + 1
    }
    raise parser.error("")
}

proc matches_space(parser: ^Parser, from index: usize) -> usize !> Error {
    let source_position = index
    while parser.source.content.char_at(source_position) == ' ' {
        source_position = source_position + 1
    }
    return source_position
}

proc (^Parser).parse_block_statement(self) !> Error {
    self.consume("{")
    self.consume_end_of_line()
    self.increase_alignment()
    while not self.matches_two(first: matches_space, second: matches_closing_brace) {
        self.consume_space(self.alignment)
        self.parse_statement()
        self.consume_end_of_line()
    }
    self.decrease_alignment()
    self.consume("}")
    return
}

proc (^Parser).parse_procedure_statement(self) !> Error {
    self.consume("proc")
    self.consume_space(1)
    let procedure_name = self.consume_identifier()
    self.consume("(")
    self.consume(")")
    self.consume_space(1)
    self.consume("->")
    self.consume_space(1)
    let procedure_return_type = self.parse_type()
    self.consume_space(1)
    self.parse_block_statement()
    return
}

proc (^Parser).parse_statement(self) !> Error {
    if self.matches_identifier(from: self.source_position) > 0 {
        let saved_source_position = self.source_position
        let identifier = self.consume_identifier()
        if identifier.lexeme.equals("return") {
            self.parse_return_statement(keyword: identifier)
        } else {
            self.source_position = saved_source_position
            raise self.error("Unsupported statement")
        }
    }
    return
}

proc (^Parser).parse_return_statement(self, keyword: Identifier) !> Error {
    self.consume_space(1)
    self.parse_expression()
    return
}

proc (^Parser).parse_expression(self) !> Error {
    self.consume_integer_literal()
    return
}

type Parsed_Type = struct {
    name: Identifier
}

proc (^Parser).parse_type(self) -> Parsed_Type !> Error {
    let type_name = self.consume_identifier()
    return Parsed_Type(name: type_name)
}

proc (^Parser).increase_alignment(self) {
    self.alignment = self.alignment + 4
}

proc (^Parser).decrease_alignment(self) {
    self.alignment = self.alignment - 4
}
