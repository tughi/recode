import compiler.error
import libc

proc (^libc.FILE).write(file, parser_error: error.Error) -> ^libc.FILE {
    file.write(parser_error.source.path).write(":")

    let line = 1i64
    let column = 1i64
    let index = 0usize
    let source_content = parser_error.source.content.data()
    let end = parser_error.source_position
    if end > parser_error.source.content.length {
        end = parser_error.source.content.length
    }
    while index < end {
        if source_content[index] == '\n' {
            line = line + 1
            column = 1
        } else {
            column = column + 1
        }
        index = index + 1
    }

    return file.write(i64: line).write(":").write(i64: column)
}
