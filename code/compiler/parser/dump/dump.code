import collections
import compiler.lexer
import compiler.parser.parsed
import libc

proc (^collections.List<^parsed.Statement>).dump(self) {
    let item = self.first
    while item != null {
        item.value.dump(depth: 0)
        libc.stdout.end_line()
        item = item.next
        if item != null {
            libc.stdout.end_line()
        }
    }
}

proc (^libc.FILE).indent(stream, anon depth: i32) -> ^libc.FILE {
    let i = 0
    while i < depth {
        stream.write("    ")
        i = i + 1
    }
    return stream
}

proc (^parsed.Statement).dump(self, depth: i32) {
    if self == null {
        return
    }
    switch self {
        is parsed.Assignment_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Block_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Break_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Const_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Defer_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Expression_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.If_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Import_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Loop_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Procedure_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Raise_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Return_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Switch_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Type_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Variable_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.While_Statement as s {
            s.dump(depth: depth)
        }
        is parsed.Yield_Statement as s {
            s.dump(depth: depth)
        }
        is nil {
        }
    }
}

proc (^parsed.Assignment_Statement).dump(self, depth: i32) {
    self.object.dump()
    libc.stdout.write(" = ")
    self.value.dump()
}

proc (^parsed.Block_Statement).dump(self, depth: i32) {
    libc.stdout.write("{").end_line()
    let item = self.statements.first
    while item != null {
        libc.stdout.indent(depth + 1)
        item.value.dump(depth: depth + 1)
        libc.stdout.end_line()
        item = item.next
    }
    libc.stdout.indent(depth).write("}")
}

proc (^parsed.Break_Statement).dump(self, depth: i32) {
    libc.stdout.write("break")
}

proc (^parsed.Const_Statement).dump(self, depth: i32) {
    libc.stdout.write("const ").write(self.name.lexeme).write(" = ")
    self.expression.dump(depth: depth)
}

proc (^parsed.Defer_Statement).dump(self, depth: i32) {
    libc.stdout.write("defer ")
    self.statement.dump(depth: depth)
}

proc (^parsed.Expression_Statement).dump(self, depth: i32) {
    self.expression.dump(depth: depth)
}

proc (^parsed.Import_Statement).dump(self, depth: i32) {
    libc.stdout.write("import ")
    let item = self.path.first
    while item != null {
        libc.stdout.write(item.value.lexeme)
        item = item.next
        if item != null {
            libc.stdout.write(".")
        }
    }
    switch self.alias {
        is lexer.Identifier as alias {
            libc.stdout.write(" as ").write(alias.lexeme)
        }
        is nil {
        }
    }
}

proc (^parsed.If_Statement).dump(self, depth: i32) {
    libc.stdout.write("if ")
    self.condition.dump()
    switch self.alias {
        is lexer.Identifier as alias {
            libc.stdout.write(" as ").write(alias.lexeme)
        }
        is nil {
        }
    }
    libc.stdout.write(" ")
    self.true_block.dump(depth: depth)
    if self.false_statement != null {
        libc.stdout.write(" else ")
        self.false_statement.dump(depth: depth)
    }
}

proc (^parsed.Loop_Statement).dump(self, depth: i32) {
    libc.stdout.write("loop ")
    self.body.dump(depth: depth)
}

proc (^parsed.Procedure_Statement).dump(self, depth: i32) {
    libc.stdout.write("proc ")
    if self.receiver != null {
        libc.stdout.write("(")
        self.receiver.dump()
        libc.stdout.write(").")
    }
    libc.stdout.write(self.name.lexeme)
    if self.type_parameters.length > 0 {
        libc.stdout.write("<")
        let tp_item = self.type_parameters.first
        while tp_item != null {
            libc.stdout.write(tp_item.value.name.lexeme)
            tp_item = tp_item.next
            if tp_item != null {
                libc.stdout.write(", ")
            }
        }
        libc.stdout.write(">")
    }
    libc.stdout.write("(")
    let item = self.parameters.first
    if self.receiver != null and item != null {
        libc.stdout.write(item.value.name.lexeme)
        item = item.next
        if item != null {
            libc.stdout.write(", ")
        }
    }
    while item != null {
        switch item.value.label {
            is lexer.Identifier as label {
                libc.stdout.write(label.lexeme).write(" ")
            }
            is nil {
            }
        }
        libc.stdout.write(item.value.name.lexeme).write(": ")
        item.value.parameter_type.dump()
        item = item.next
        if item != null {
            libc.stdout.write(", ")
        }
    }
    libc.stdout.write(")")
    if self.return_type != null {
        libc.stdout.write(" -> ")
        self.return_type.dump()
    }
    if self.raise_type != null {
        libc.stdout.write(" !> ")
        self.raise_type.dump()
    }
    if self.is_external {
        libc.stdout.write(" = external")
    } else {
        libc.stdout.write(" ")
        self.body.dump(depth: depth)
    }
}

proc (^parsed.Raise_Statement).dump(self, depth: i32) {
    libc.stdout.write("raise ")
    self.expression.dump(depth: depth)
}

proc (^parsed.Yield_Statement).dump(self, depth: i32) {
    libc.stdout.write("yield ")
    self.expression.dump(depth: depth)
}

proc (^parsed.Return_Statement).dump(self, depth: i32) {
    libc.stdout.write("return")
    if self.expression != null {
        libc.stdout.write(" ")
        self.expression.dump(depth: depth)
    }
}

proc (^parsed.Type_Statement).dump(self, depth: i32) {
    libc.stdout.write("type ").write(self.name.lexeme)
    if self.type_parameters.length > 0 {
        libc.stdout.write("<")
        let item = self.type_parameters.first
        while item != null {
            libc.stdout.write(item.value.name.lexeme)
            item = item.next
            if item != null {
                libc.stdout.write(", ")
            }
        }
        libc.stdout.write(">")
    }
    libc.stdout.write(" = ")
    self.specifier.dump(depth: depth)
}

proc (^parsed.Variable_Statement).dump(self, depth: i32) {
    libc.stdout.write("let ").write(self.name.lexeme)
    if self.variable_type != null {
        libc.stdout.write(": ")
        self.variable_type.dump()
    }
    if self.is_external {
        libc.stdout.write(" = external")
        switch self.external_name {
            is lexer.String as external_name {
                libc.stdout.write(" \"").write(external_name.value).write("\"")
            }
            is nil {
            }
        }
    } else if self.expression != null {
        libc.stdout.write(" = ")
        self.expression.dump(depth: depth)
    }
}

proc (^parsed.While_Statement).dump(self, depth: i32) {
    libc.stdout.write("while ")
    self.condition.dump()
    libc.stdout.write(" ")
    self.body.dump(depth: depth)
}

proc (^parsed.Switch_Statement).dump(self, depth: i32) {
    libc.stdout.write("switch ")
    self.expression.dump()
    libc.stdout.write(" {").end_line()
    let item = self.cases.first
    while item != null {
        libc.stdout.indent(depth + 1)
        switch item.value {
            is parsed.Switch_Expression as c {
                libc.stdout.write("case ")
                c.expression.dump()
                libc.stdout.write(" ")
                c.body.dump(depth: depth + 1)
            }
            is parsed.Switch_Variant as c {
                libc.stdout.write("is ")
                c.variant_type.dump()
                switch c.alias {
                    is lexer.Identifier as alias {
                        libc.stdout.write(" as ").write(alias.lexeme)
                    }
                    is nil {
                    }
                }
                libc.stdout.write(" ")
                c.body.dump(depth: depth + 1)
            }
            is parsed.Switch_Else as c {
                libc.stdout.write("else ")
                c.body.dump(depth: depth + 1)
            }
            is nil {
            }
        }
        libc.stdout.end_line()
        item = item.next
    }
    libc.stdout.indent(depth).write("}")
}

proc (^parsed.Expression).dump(self) {
    self.dump(depth: 0)
}

proc (^parsed.Expression).dump(self, depth: i32) {
    if self == null {
        return
    }
    switch self {
        is parsed.Add_Expression as e {
            e.dump()
        }
        is parsed.Address_Of_Expression as e {
            e.dump()
        }
        is parsed.Alloc_Expression as e {
            e.dump()
        }
        is parsed.Array_Access_Expression as e {
            e.dump()
        }
        is parsed.Call_Expression as e {
            e.dump()
        }
        is parsed.Character_Expression as e {
            e.dump()
        }
        is parsed.Dereference_Expression as e {
            e.dump()
        }
        is parsed.Divide_Expression as e {
            e.dump()
        }
        is parsed.Equals_Expression as e {
            e.dump()
        }
        is parsed.Greater_Expression as e {
            e.dump()
        }
        is parsed.Greater_Or_Equals_Expression as e {
            e.dump()
        }
        is parsed.Identifier_Expression as e {
            e.dump()
        }
        is parsed.Integer_Expression as e {
            e.dump()
        }
        is parsed.Is_Expression as e {
            e.dump()
        }
        is parsed.Less_Expression as e {
            e.dump()
        }
        is parsed.Less_Or_Equals_Expression as e {
            e.dump()
        }
        is parsed.Logic_And_Expression as e {
            e.dump()
        }
        is parsed.Logic_Or_Expression as e {
            e.dump()
        }
        is parsed.Member_Access_Expression as e {
            e.dump()
        }
        is parsed.Modulo_Expression as e {
            e.dump()
        }
        is parsed.Multiply_Expression as e {
            e.dump()
        }
        is parsed.Negate_Expression as e {
            e.dump()
        }
        is parsed.Not_Expression as e {
            e.dump()
        }
        is parsed.Not_Equals_Expression as e {
            e.dump()
        }
        is parsed.Subtract_Expression as e {
            e.dump()
        }
        is parsed.Block_Expression as e {
            e.dump(depth: depth)
        }
        is parsed.String_Expression as e {
            e.dump()
        }
        is parsed.Try_Expression as e {
            e.dump(depth: depth)
        }
        is parsed.Type_Alignment_Expression as e {
            e.dump()
        }
        is parsed.Type_Size_Expression as e {
            e.dump()
        }
        is parsed.Type_Specialization_Expression as e {
            e.dump()
        }
        is nil {
        }
    }
}

proc (^parsed.Add_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" + ")
    self.super.right.dump()
}

proc (^parsed.Array_Access_Expression).dump(self) {
    self.expression.dump()
    libc.stdout.write("[")
    self.index.dump()
    libc.stdout.write("]")
}

proc (^parsed.Character_Expression).dump(self) {
    libc.stdout.write(self.token.lexeme)
}

proc (^parsed.Alloc_Expression).dump(self) {
    libc.stdout.write("alloc ")
    self.super.expression.dump()
}

proc (^parsed.Address_Of_Expression).dump(self) {
    libc.stdout.write("^")
    self.super.expression.dump()
}

proc (^parsed.Dereference_Expression).dump(self) {
    self.super.expression.dump()
    libc.stdout.write(".^")
}

proc (^parsed.Negate_Expression).dump(self) {
    libc.stdout.write("-")
    self.super.expression.dump()
}

proc (^parsed.Not_Expression).dump(self) {
    libc.stdout.write("not ")
    self.super.expression.dump()
}

proc (^parsed.Divide_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" / ")
    self.super.right.dump()
}

proc (^parsed.Equals_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" == ")
    self.super.right.dump()
}

proc (^parsed.Greater_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" > ")
    self.super.right.dump()
}

proc (^parsed.Greater_Or_Equals_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" >= ")
    self.super.right.dump()
}

proc (^parsed.Less_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" < ")
    self.super.right.dump()
}

proc (^parsed.Less_Or_Equals_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" <= ")
    self.super.right.dump()
}

proc (^parsed.Logic_And_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" and ")
    self.super.right.dump()
}

proc (^parsed.Logic_Or_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" or ")
    self.super.right.dump()
}

proc (^parsed.Member_Access_Expression).dump(self) {
    self.expression.dump()
    libc.stdout.write(".").write(self.member.lexeme)
}

proc (^parsed.Modulo_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" % ")
    self.super.right.dump()
}

proc (^parsed.Multiply_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" * ")
    self.super.right.dump()
}

proc (^parsed.Not_Equals_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" != ")
    self.super.right.dump()
}

proc (^parsed.Type_Alignment_Expression).dump(self) {
    libc.stdout.write("type_alignment(")
    self.type.dump()
    libc.stdout.write(")")
}

proc (^parsed.Block_Expression).dump(self) {
    self.dump(depth: 0)
}

proc (^parsed.Block_Expression).dump(self, depth: i32) {
    self.body.dump(depth: depth)
}

proc (^parsed.Try_Expression).dump(self) {
    self.dump(depth: 0)
}

proc (^parsed.Try_Expression).dump(self, depth: i32) {
    libc.stdout.write("try ")
    self.expression.dump()
    libc.stdout.write(" else ")
    self.else_expression.dump(depth: depth)
}

proc (^parsed.Type_Size_Expression).dump(self) {
    libc.stdout.write("type_size(")
    self.type.dump()
    libc.stdout.write(")")
}

proc (^parsed.Type_Specialization_Expression).dump(self) {
    self.expression.dump()
    libc.stdout.write("<")
    let item = self.type_arguments.first
    while item != null {
        item.value.argument_type.dump()
        item = item.next
        if item != null {
            libc.stdout.write(", ")
        }
    }
    libc.stdout.write(">")
}

proc (^parsed.Subtract_Expression).dump(self) {
    self.super.left.dump()
    libc.stdout.write(" - ")
    self.super.right.dump()
}

proc (^parsed.Call_Expression).dump(self) {
    self.expression.dump()
    libc.stdout.write("(")
    let item = self.arguments.first
    while item != null {
        switch item.value.label {
            is lexer.Identifier as label {
                libc.stdout.write(label.lexeme).write(": ")
            }
            is nil {
            }
        }
        item.value.expression.dump()
        item = item.next
        if item != null {
            libc.stdout.write(", ")
        }
    }
    libc.stdout.write(")")
}

proc (^parsed.Identifier_Expression).dump(self) {
    libc.stdout.write(self.name.lexeme)
}

proc (^parsed.Integer_Expression).dump(self) {
    libc.stdout.write(u64: self.token.value)
}

proc (^parsed.Is_Expression).dump(self) {
    self.expression.dump()
    if self.is_not {
        libc.stdout.write(" is not ")
    } else {
        libc.stdout.write(" is ")
    }
    self.type.dump()
}

proc (^parsed.String_Expression).dump(self) {
    libc.stdout.write(self.token.lexeme)
}

proc (^parsed.Type).dump(self) {
    if self == null {
        return
    }
    switch self {
        is parsed.Multi_Pointer_Type as t {
            t.dump()
        }
        is parsed.Named_Type as t {
            t.dump()
        }
        is parsed.Pointer_Type as t {
            t.dump()
        }
        is parsed.Procedure_Type as t {
            t.dump()
        }
        is parsed.Receiver_Type as t {
            t.dump()
        }
        is nil {
        }
    }
}

proc (^parsed.Receiver_Type).dump(self) {
}

proc (^parsed.Multi_Pointer_Type).dump(self) {
    libc.stdout.write("[^]")
    self.pointee.dump()
}

proc (^parsed.Named_Type).dump(self) {
    switch self.module {
        is lexer.Identifier as module {
            libc.stdout.write(module.lexeme).write(".")
        }
        is nil {
        }
    }
    libc.stdout.write(self.name.lexeme)
    if self.type_arguments.length > 0 {
        libc.stdout.write("<")
        let item = self.type_arguments.first
        while item != null {
            item.value.argument_type.dump()
            item = item.next
            if item != null {
                libc.stdout.write(", ")
            }
        }
        libc.stdout.write(">")
    }
}

proc (^parsed.Pointer_Type).dump(self) {
    libc.stdout.write("^")
    self.pointee.dump()
}

proc (^parsed.Procedure_Type).dump(self) {
    libc.stdout.write("proc (")
    let item = self.parameters.first
    while item != null {
        switch item.value.label {
            is lexer.Identifier as label {
                libc.stdout.write(label.lexeme).write(" ")
            }
            is nil {
            }
        }
        libc.stdout.write(item.value.name.lexeme).write(": ")
        item.value.parameter_type.dump()
        item = item.next
        if item != null {
            libc.stdout.write(", ")
        }
    }
    libc.stdout.write(")")
    if self.return_type != null {
        libc.stdout.write(" -> ")
        self.return_type.dump()
    }
    if self.raise_type != null {
        libc.stdout.write(" !> ")
        self.raise_type.dump()
    }
}

proc (^parsed.Type_Specifier).dump(self, depth: i32) {
    if self == null {
        return
    }
    switch self {
        is parsed.External_Type_Specifier as s {
            s.dump()
        }
        is parsed.Struct_Type_Specifier as s {
            s.dump(depth: depth)
        }
        is parsed.Trait_Type_Specifier as s {
            s.dump(depth: depth)
        }
        is parsed.Variant_Type_Specifier as s {
            s.dump(depth: depth)
        }
        is nil {
        }
    }
}

proc (^parsed.External_Type_Specifier).dump(self) {
    libc.stdout.write("external")
}

proc (^parsed.Trait_Type_Specifier).dump(self, depth: i32) {
    libc.stdout.write("trait {").end_line()
    let item = self.methods.first
    while item != null {
        libc.stdout.indent(depth + 1).write("proc ")
        let method = item.value
        libc.stdout.write(method.name.lexeme).write("(")
        let param = method.parameters.first
        if param != null {
            libc.stdout.write(param.value.name.lexeme)
            param = param.next
        }
        while param != null {
            libc.stdout.write(", ")
            switch param.value.label {
                is lexer.Identifier as label {
                    libc.stdout.write(label.lexeme).write(" ")
                }
                is nil {
                }
            }
            libc.stdout.write(param.value.name.lexeme).write(": ")
            param.value.parameter_type.dump()
            param = param.next
        }
        libc.stdout.write(")")
        if method.return_type != null {
            libc.stdout.write(" -> ")
            method.return_type.dump()
        }
        if method.raise_type != null {
            libc.stdout.write(" !> ")
            method.raise_type.dump()
        }
        libc.stdout.end_line()
        item = item.next
    }
    libc.stdout.indent(depth).write("}")
}

proc (^parsed.Variant_Type_Specifier).dump(self, depth: i32) {
    libc.stdout.write("variant {").end_line()
    let item = self.cases.first
    while item != null {
        libc.stdout.indent(depth + 1)
        item.value.variant_type.dump()
        libc.stdout.end_line()
        item = item.next
    }
    libc.stdout.indent(depth).write("}")
}

proc (^parsed.Struct_Type_Specifier).dump(self, depth: i32) {
    libc.stdout.write("struct {").end_line()
    let item = self.members.first
    while item != null {
        libc.stdout.indent(depth + 1)
        libc.stdout.write(item.value.name.lexeme).write(": ")
        item.value.member_type.dump()
        libc.stdout.end_line()
        item = item.next
    }
    libc.stdout.indent(depth).write("}")
}
