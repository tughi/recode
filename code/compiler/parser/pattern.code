type Match = variant {
    End_Of_File
    End_Of_Line
    Identifier_Match
    Space
    str
}

type End_Of_Line = struct {
    _: bool // TODO: Add support for empty structs
}

type End_Of_File = struct {
    _: bool // TODO: Add support for empty structs
}

type Identifier_Match = struct {
    _: bool // TODO: Add support for empty structs
}

type Space = struct {
    required: bool
}

type No_Match = struct {
    _: bool // TODO: Add support for empty structs
}

proc (^Parser).matches(self, first: Match) -> bool {
    let index = self.source_position
    index = try self.matches(first, from: index) else {
        return false
    }
    return true
}

proc (^Parser).matches(self, first: Match, second: Match) -> bool {
    let index = self.source_position
    index = try self.matches(first, from: index) else {
        return false
    }
    index = try self.matches(second, from: index) else {
        return false
    }
    return true
}

proc (^Parser).matches(self, first: Match, second: Match, third: Match) -> bool {
    let index = self.source_position
    index = try self.matches(first, from: index) else {
        return false
    }
    index = try self.matches(second, from: index) else {
        return false
    }
    index = try self.matches(third, from: index) else {
        return false
    }
    return true
}

proc (^Parser).matches(self, anon match: Match, from start_index: usize) -> usize !> No_Match {
    switch match {
        is str as lexeme {
            if not self.source.content.starts_with(lexeme, from: start_index) {
                raise No_Match()
            }
            return start_index + lexeme.length
        }
        is Space as space {
            let index = start_index
            while self.source.content.char_at(index) == ' ' {
                index = index + 1
            }
            if space.required and index == start_index {
                raise No_Match()
            }
            return index
        }
        is Identifier_Match {
            let index = start_index
            if not self.source.content.char_at(index).is_identifier_start() {
                raise No_Match()
            }
            index = index + 1
            while self.source.content.char_at(index).is_identifier_char() {
                index = index + 1
            }
            return index
        }
        is End_Of_Line {
            if start_index >= self.source.content.length or self.source.content.char_at(start_index) == '\n' {
                return start_index
            }
            raise No_Match()
        }
        is End_Of_File {
            if start_index < self.source.content.length {
                raise No_Match()
            }
            return start_index
        }
        is nil {
            // Ignored
        }
    }
    raise No_Match()
}
