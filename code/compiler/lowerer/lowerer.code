import allocator
import compiler.checker.checked
import compiler.ir
import compiler.source
import string

type Scope_Entry = struct {
    value: ^ir.Value
    next: ^Scope_Entry
}

proc new_scope_entry(value: ^ir.Value, next: ^Scope_Entry) -> ^Scope_Entry {
    return allocator.new(Scope_Entry(value: value, next: next))
}

type Enum_Name_Entry = struct {
    enum_type: ^checked.Enum_Type
    next: ^Enum_Name_Entry
}

proc new_enum_name_entry(enum_type: ^checked.Enum_Type) -> ^Enum_Name_Entry {
    return allocator.new(Enum_Name_Entry(enum_type: enum_type, next: null))
}

type Lowerer = struct {
    program: ^ir.Program
    debug_info: bool
    output_dir: str
    current_procedure: ^ir.Procedure
    current_block: ^ir.Block
    break_block: ^ir.Block
    continue_block: ^ir.Block
    scope: ^Scope_Entry
    first_enum_name: ^Enum_Name_Entry
    last_enum_name: ^Enum_Name_Entry
    string_type: ^checked.Struct_Type
    string_counter: usize
    next_value_id: usize
    block_counter: usize
}

proc lower(checked_package: ^checked.Package, debug_info: bool, output_dir: str) -> ^ir.Program {
    let lowerer = Lowerer(
        program: ir.new_program()
        debug_info: debug_info
        output_dir: output_dir
        current_procedure: null
        current_block: null
        break_block: null
        continue_block: null
        scope: null
        first_enum_name: null
        last_enum_name: null
        string_type: null
        string_counter: 0
        next_value_id: 0
        block_counter: 0
    )

    let symbols = checked_package.symbols
    while symbols != null {
        let symbol_entry = symbols.first
        while symbol_entry != null {
            if symbol_entry.symbol.kind == .Type {
                let type = symbol_entry.symbol.as(^checked.Type_Symbol).type
                if type.kind == .Struct and type.name().equals("String") {
                    lowerer.string_type = type.as(^checked.Struct_Type)
                }
            }
            symbol_entry = symbol_entry.next
        }
        symbols = symbols.parent
    }

    // Declare all procedures first, so calls can reference any procedure.
    let package = checked_package
    while package != null {
        let entry = package.symbols.first
        while entry != null {
            if entry.symbol.kind == .Generic_Procedure {
                let procedure_instance = entry.symbol.as(^checked.Generic_Procedure_Symbol).first_instance
                while procedure_instance != null {
                    lowerer.declare_procedure(procedure_instance.symbol)
                    procedure_instance = procedure_instance.next
                }
            } else if entry.symbol.kind == .Procedure {
                lowerer.declare_procedure(entry.symbol.as(^checked.Procedure_Symbol))
            } else if entry.symbol.kind == .Variable {
                let variable_symbol = entry.symbol.as(^checked.Variable_Symbol)
                if variable_symbol.is_external {
                    lowerer.declare_external_variable(variable_symbol)
                } else {
                    lowerer.declare_global_variable(variable_symbol)
                }
            }
            entry = entry.next
        }
        package = package.next_package
    }

    let main_procedure: ^ir.Procedure = null
    package = checked_package
    while package != null {
        let entry = package.symbols.first
        while entry != null {
            if entry.symbol.kind == .Generic_Procedure {
                let procedure_instance = entry.symbol.as(^checked.Generic_Procedure_Symbol).first_instance
                while procedure_instance != null {
                    lowerer.define_procedure(procedure_instance.symbol)
                    procedure_instance = procedure_instance.next
                }
            } else if entry.symbol.kind == .Procedure {
                let procedure_symbol = entry.symbol.as(^checked.Procedure_Symbol)
                let procedure = lowerer.define_procedure(procedure_symbol)
                if package == checked_package and procedure_symbol.receiver_type == null and procedure_symbol.name.equals("main") {
                    main_procedure = procedure
                }
            }
            entry = entry.next
        }
        package = package.next_package
    }

    // Fill in the bodies of the `<Enum>.name` helpers declared on demand above.
    let enum_name_entry = lowerer.first_enum_name
    while enum_name_entry != null {
        lowerer.define_enum_name_procedure(enum_name_entry.enum_type)
        enum_name_entry = enum_name_entry.next
    }

    if main_procedure != null {
        lowerer.lower_main_wrapper(main_procedure)
    }

    return lowerer.program
}

proc (^Lowerer).procedure_name(self, procedure_symbol: ^checked.Procedure_Symbol) -> str {
    if procedure_symbol.is_external {
        if procedure_symbol.external_name.length > 0 {
            return procedure_symbol.external_name
        }
        return procedure_symbol.name
    }
    let builder = string.new_builder()
    if procedure_symbol.receiver_type != null {
        builder.append_char('(').append(self.lower_type(procedure_symbol.receiver_type).name_string()).append(").").append(procedure_symbol.name)
    } else {
        builder.append(procedure_symbol.package.name).append_char('.').append(procedure_symbol.name)
    }
    let type_argument = procedure_symbol.first_type_argument
    if type_argument != null {
        builder.append_char('<')
        loop {
            builder.append(self.lower_type(type_argument.type).name_string())
            type_argument = type_argument.next
            if type_argument == null {
                break
            }
            builder.append(", ")
        }
        builder.append_char('>')
    }
    return builder.build()
}

proc (^Lowerer).declare_procedure(self, procedure_symbol: ^checked.Procedure_Symbol) {
    if procedure_symbol.is_external {
        self.declare_external_procedure(procedure_symbol)
        return
    }
    let procedure = ir.new_procedure(
        name: self.procedure_name(procedure_symbol)
        return_type: self.lower_type(procedure_symbol.procedure_type.return_type)
    )
    procedure.is_method = procedure_symbol.receiver_type != null
    let parameter = procedure_symbol.procedure_type.first_parameter
    while parameter != null {
        procedure.append_parameter(ir.new_value(kind: .Parameter, name: parameter.name, type: self.lower_type(parameter.parameter_type)))
        parameter = parameter.next
    }
    self.program.append_procedure(procedure)
}

proc (^Lowerer).declare_external_procedure(self, procedure_symbol: ^checked.Procedure_Symbol) {
    let procedure_type = self.lower_procedure_type(procedure_symbol.procedure_type)
    let pointer_type = ir.new_pointer_type(procedure_type.as(^ir.Type)).as(^ir.Type)
    let global = ir.new_external_global(name: self.procedure_name(procedure_symbol), type: pointer_type)
    self.program.append_global(global)
}

proc (^Lowerer).lower_procedure_type(self, checked_procedure_type: ^checked.Procedure_Type) -> ^ir.Procedure_Type {
    let procedure_type = ir.new_procedure_type(return_type: self.lower_type(checked_procedure_type.return_type))
    let parameter = checked_procedure_type.first_parameter
    while parameter != null {
        procedure_type.append_parameter(self.lower_type(parameter.parameter_type))
        parameter = parameter.next
    }
    return procedure_type
}

proc (^Lowerer).declare_external_variable(self, variable_symbol: ^checked.Variable_Symbol) {
    let pointer_type = ir.new_pointer_type(self.lower_type(variable_symbol.type)).as(^ir.Type)
    let global = ir.new_external_global(name: self.variable_name(variable_symbol), type: pointer_type)
    self.program.append_global(global)
}

proc (^Lowerer).lower_constant(self, expression: ^checked.Expression) -> ^ir.Const_Payload {
    switch expression.kind {
        case .Bool {
            if expression.as(^checked.Bool_Expression).value {
                return ir.new_const_payload(value: 1u64, lexeme: "")
            }
            return ir.new_const_payload(value: 0u64, lexeme: "")
        }
        case .Character {
            let token = expression.as(^checked.Character_Expression).token
            return ir.new_const_payload(value: token.value.as(u64), lexeme: token.lexeme)
        }
        case .Integer {
            let token = expression.as(^checked.Integer_Expression).token
            return ir.new_const_payload(value: token.value, lexeme: token.lexeme)
        }
        case .Null {
            return ir.new_const_payload(value: 0u64, lexeme: "")
        }
        else {
            panic "Lowering not supported yet: non-constant global initializer"
        }
    }
}

proc (^Lowerer).declare_global_variable(self, variable_symbol: ^checked.Variable_Symbol) {
    let pointer_type = ir.new_pointer_type(self.lower_type(variable_symbol.type)).as(^ir.Type)
    let global: ^ir.Global = null
    if variable_symbol.expression == null {
        global = ir.new_global(name: self.variable_name(variable_symbol), type: pointer_type)
    } else {
        global = ir.new_constant_global(name: self.variable_name(variable_symbol), type: pointer_type, constant: self.lower_constant(variable_symbol.expression))
    }
    self.program.append_global(global)
}

proc (^Lowerer).variable_name(self, variable_symbol: ^checked.Variable_Symbol) -> str {
    if variable_symbol.is_external {
        if variable_symbol.external_name.length > 0 {
            return variable_symbol.external_name
        }
        return variable_symbol.name
    }
    let builder = string.new_builder()
    return builder.append(variable_symbol.package.name).append_char('.').append(variable_symbol.name).build()
}

proc (^Lowerer).define_procedure(self, procedure_symbol: ^checked.Procedure_Symbol) -> ^ir.Procedure {
    let procedure = self.program.find_procedure(self.procedure_name(procedure_symbol))
    self.current_procedure = procedure

    if procedure_symbol.body == null {
        return procedure
    }

    self.next_value_id = 0
    self.block_counter = 0
    self.scope = null
    let parameter = procedure.first_parameter
    while parameter != null {
        self.push_scope(parameter)
        parameter = parameter.next
    }
    let block = self.create_block()
    procedure.append_block(block)
    self.current_block = block

    if self.debug_info {
        parameter = procedure.first_parameter
        while parameter != null {
            self.current_block.append_instruction(ir.new_bind_instruction(name: parameter.name, indirect: false, value: parameter).as(^ir.Instruction))
            parameter = parameter.next
        }
    }

    self.lower_statement(procedure_symbol.body)

    if procedure.return_type.kind == .Nothing and not self.current_block.is_terminated() {
        self.current_block.append_instruction(ir.new_ret_instruction(value: null).as(^ir.Instruction))
    }

    return procedure
}

proc (^Lowerer).enum_name_procedure_name(self, enum_type: ^checked.Enum_Type) -> str {
    let builder = string.new_builder()
    return builder.append(self.type_name(enum_type.as(^checked.Named_Type))).append(".name").build()
}

proc (^Lowerer).enum_name_procedure(self, enum_type: ^checked.Enum_Type) -> ^ir.Procedure {
    let name = self.enum_name_procedure_name(enum_type)
    let procedure = self.program.find_procedure(name)
    if procedure != null {
        return procedure
    }
    procedure = ir.new_procedure(name: name, return_type: self.lower_type(self.string_type.as(^checked.Type)))
    procedure.append_parameter(ir.new_value(kind: .Parameter, name: "value", type: ir.new_primitive_type(.i32)))
    self.program.append_procedure(procedure)

    // Remember this enum so its body gets generated once all bodies are lowered.
    let entry = new_enum_name_entry(enum_type)
    if self.first_enum_name == null {
        self.first_enum_name = entry
    } else {
        self.last_enum_name.next = entry
    }
    self.last_enum_name = entry

    return procedure
}

proc (^Lowerer).define_enum_name_procedure(self, enum_type: ^checked.Enum_Type) {
    let procedure = self.program.find_procedure(self.enum_name_procedure_name(enum_type))
    let parameter = procedure.first_parameter

    self.current_procedure = procedure
    self.next_value_id = 0
    self.block_counter = 0
    self.break_block = null
    self.continue_block = null
    let block = self.create_block()
    procedure.append_block(block)
    self.current_block = block

    let member_iterator = enum_type.members.iterator()
    while member_iterator.has_next() {
        let member = member_iterator.next()
        let member_value = ir.new_const_instruction(
            name: self.fresh_name()
            type: ir.new_primitive_type(.i32)
            value: member.value
            lexeme: ""
        )
        self.current_block.append_instruction(member_value.as(^ir.Instruction))
        let matches = ir.new_binary_instruction(
            kind: .Compare_Equal
            name: self.fresh_name()
            type: ir.new_primitive_type(.bool)
            left: parameter
            right: member_value.as(^ir.Value)
        )
        self.current_block.append_instruction(matches.as(^ir.Instruction))

        let match_block = self.create_block()
        let next_block = self.create_block()
        self.current_block.append_instruction(ir.new_br_instruction(condition: matches.as(^ir.Value), true_block: match_block, false_block: next_block).as(^ir.Instruction))

        self.current_procedure.append_block(match_block)
        self.current_block = match_block
        let name_value = self.lower_string_struct(member.name)
        self.current_block.append_instruction(ir.new_ret_instruction(value: name_value).as(^ir.Instruction))

        self.current_procedure.append_block(next_block)
        self.current_block = next_block
    }
    // No member matched: return an empty string.
    let empty_value = self.lower_string_struct("")
    self.current_block.append_instruction(ir.new_ret_instruction(value: empty_value).as(^ir.Instruction))
}

proc (^Lowerer).lower_panic_statement(self, panic_statement: ^checked.Panic_Statement) {
    let message = string.new_builder()
    message.append(panic_statement.location.source.path)
    message.append_char(':').append_decimal(panic_statement.location.line.as(usize))
    message.append(": Panic!")
    if panic_statement.message != null {
        message.append_char(' ').append(panic_statement.message.value)
    }
    message.append_char('\n')
    let text = message.build()

    let buffer_instruction = ir.new_cast_instruction(
        name: self.fresh_name()
        type: ir.new_pointer_type(ir.new_primitive_type(.Any)).as(^ir.Type)
        value: self.string_global(text)
    )
    self.current_block.append_instruction(buffer_instruction.as(^ir.Instruction))
    let size_instruction = ir.new_const_instruction(
        name: self.fresh_name()
        type: ir.new_primitive_type(.usize)
        value: 1
        lexeme: ""
    )
    self.current_block.append_instruction(size_instruction.as(^ir.Instruction))
    let count_instruction = ir.new_const_instruction(
        name: self.fresh_name()
        type: ir.new_primitive_type(.usize)
        value: text.length.as(u64)
        lexeme: ""
    )
    self.current_block.append_instruction(count_instruction.as(^ir.Instruction))
    let stderr_global = self.find_global("stderr")
    let file_instruction = ir.new_load_instruction(
        name: self.fresh_name()
        type: stderr_global.type.as(^ir.Pointer_Type).pointee
        pointer: stderr_global
    )
    self.current_block.append_instruction(file_instruction.as(^ir.Instruction))

    let fwrite_callee = self.find_global("fwrite")
    let fwrite_return_type = fwrite_callee.type.as(^ir.Pointer_Type).pointee.as(^ir.Procedure_Type).return_type
    let fwrite_name = ""
    if fwrite_return_type.kind != .Nothing {
        fwrite_name = self.fresh_name()
    }
    let fwrite_call = ir.new_call_instruction(name: fwrite_name, type: fwrite_return_type, callee: fwrite_callee)
    let buffer_argument = ir.new_argument(buffer_instruction.as(^ir.Value))
    let size_argument = ir.new_argument(size_instruction.as(^ir.Value))
    let count_argument = ir.new_argument(count_instruction.as(^ir.Value))
    buffer_argument.next = size_argument
    size_argument.next = count_argument
    count_argument.next = ir.new_argument(file_instruction.as(^ir.Value))
    fwrite_call.first_argument = buffer_argument
    self.current_block.append_instruction(fwrite_call.as(^ir.Instruction))

    let status_instruction = ir.new_const_instruction(
        name: self.fresh_name()
        type: ir.new_primitive_type(.i32)
        value: 1
        lexeme: ""
    )
    self.current_block.append_instruction(status_instruction.as(^ir.Instruction))
    let exit_callee = self.find_global("exit")
    let exit_return_type = exit_callee.type.as(^ir.Pointer_Type).pointee.as(^ir.Procedure_Type).return_type
    let exit_name = ""
    if exit_return_type.kind != .Nothing {
        exit_name = self.fresh_name()
    }
    let exit_call = ir.new_call_instruction(name: exit_name, type: exit_return_type, callee: exit_callee)
    exit_call.first_argument = ir.new_argument(status_instruction.as(^ir.Value))
    self.current_block.append_instruction(exit_call.as(^ir.Instruction))
}

proc (^Lowerer).lower_main_wrapper(self, main_procedure: ^ir.Procedure) {
    let wrapper = ir.new_procedure(name: "main", return_type: main_procedure.return_type)
    self.program.append_procedure(wrapper)

    self.next_value_id = 0
    self.block_counter = 0
    let block = self.create_block()
    wrapper.append_block(block)
    self.current_block = block

    let first_argument: ^ir.Argument = null
    let last_argument: ^ir.Argument = null
    let main_parameter = main_procedure.first_parameter
    while main_parameter != null {
        let parameter = ir.new_value(kind: .Parameter, name: main_parameter.name, type: main_parameter.type)
        wrapper.append_parameter(parameter)
        let argument = ir.new_argument(parameter)
        if last_argument == null {
            first_argument = argument
        } else {
            last_argument.next = argument
        }
        last_argument = argument
        main_parameter = main_parameter.next
    }

    let callee = ir.new_value(kind: .Procedure, name: main_procedure.name, type: main_procedure.return_type)
    let call_instruction = ir.new_call_instruction(
        name: self.fresh_name()
        type: main_procedure.return_type
        callee: callee
    )
    call_instruction.first_argument = first_argument
    self.current_block.append_instruction(call_instruction.as(^ir.Instruction))

    let result: ^ir.Value = null
    if main_procedure.return_type.kind != .Nothing {
        result = call_instruction.as(^ir.Value)
    }
    self.current_block.append_instruction(ir.new_ret_instruction(value: result).as(^ir.Instruction))
}

proc (^Lowerer).lower_statement(self, statement: ^checked.Statement) {
    if statement.kind != .Block and statement.kind != .Loop and statement.kind != .While {
        self.emit_line_instruction(statement.location)
    }
    switch statement.kind {
        case .Assignment {
            self.lower_assignment_statement(statement.as(^checked.Assignment_Statement))
        }
        case .Block {
            let block_statement = statement.as(^checked.Block_Statement)
            let item = block_statement.first_statement
            while item != null {
                self.lower_statement(item)
                item = item.next
            }
        }
        case .Break {
            self.current_block.append_instruction(ir.new_jmp_instruction(block: self.break_block).as(^ir.Instruction))
        }
        case .Continue {
            self.current_block.append_instruction(ir.new_jmp_instruction(block: self.continue_block).as(^ir.Instruction))
        }
        case .Expression {
            let expression_statement = statement.as(^checked.Expression_Statement)
            self.lower_expression(expression_statement.expression)
        }
        case .If {
            self.lower_if_statement(statement.as(^checked.If_Statement))
        }
        case .Loop {
            self.lower_loop_statement(statement.as(^checked.Loop_Statement))
        }
        case .Panic {
            self.lower_panic_statement(statement.as(^checked.Panic_Statement))
        }
        case .Return {
            let return_statement = statement.as(^checked.Return_Statement)
            let value: ^ir.Value = null
            if return_statement.expression != null {
                value = self.lower_expression(return_statement.expression)
            }
            self.current_block.append_instruction(ir.new_ret_instruction(value: value).as(^ir.Instruction))
        }
        case .Switch {
            self.lower_switch_statement(statement.as(^checked.Switch_Statement))
        }
        case .Variable {
            self.lower_variable_statement(statement.as(^checked.Variable_Statement))
        }
        case .While {
            self.lower_while_statement(statement.as(^checked.While_Statement))
        }
    }
}

proc (^Lowerer).lower_assignment_statement(self, assignment_statement: ^checked.Assignment_Statement) {
    let object = assignment_statement.object
    let pointer: ^ir.Value = null
    switch object.kind {
        case .Array_Access {
            pointer = self.lower_array_offset(object.as(^checked.Array_Access_Expression))
        }
        case .Dereference {
            pointer = self.lower_expression(object.as(^checked.Dereference_Expression).operand)
        }
        case .Member_Access {
            pointer = self.lower_struct_offset(object.as(^checked.Member_Access_Expression))
        }
        case .Symbol {
            let symbol = object.as(^checked.Symbol_Expression).symbol
            if symbol.kind == .Variable and symbol.as(^checked.Variable_Symbol).is_global {
                pointer = self.find_global(self.variable_name(symbol.as(^checked.Variable_Symbol)))
            } else {
                pointer = self.find_scope(symbol)
            }
        }
        else {
            panic "Lowering not supported yet: assignment object"
        }
    }
    let value = self.lower_expression(assignment_statement.value)
    self.current_block.append_instruction(ir.new_store_instruction(pointer: pointer, value: value).as(^ir.Instruction))
}

proc (^Lowerer).lower_if_statement(self, if_statement: ^checked.If_Statement) {
    let condition = self.lower_expression(if_statement.condition)
    let true_block = self.create_block()
    let false_block: ^ir.Block = null
    if if_statement.false_statement != null {
        false_block = self.create_block()
    }
    let end_block = self.create_block()
    let branch_false_block = end_block
    if false_block != null {
        branch_false_block = false_block
    }
    self.current_block.append_instruction(ir.new_br_instruction(condition: condition, true_block: true_block, false_block: branch_false_block).as(^ir.Instruction))
    self.current_procedure.append_block(true_block)
    self.current_block = true_block
    self.lower_statement(if_statement.true_block)
    if not self.current_block.is_terminated() {
        self.current_block.append_instruction(ir.new_jmp_instruction(block: end_block).as(^ir.Instruction))
    }
    if false_block != null {
        self.current_procedure.append_block(false_block)
        self.current_block = false_block
        self.lower_statement(if_statement.false_statement)
        if not self.current_block.is_terminated() {
            self.current_block.append_instruction(ir.new_jmp_instruction(block: end_block).as(^ir.Instruction))
        }
    }
    self.current_procedure.append_block(end_block)
    self.current_block = end_block
}

proc (^Lowerer).lower_loop_statement(self, loop_statement: ^checked.Loop_Statement) {
    let body_block = self.create_block()
    let end_block = self.create_block()
    self.current_block.append_instruction(ir.new_jmp_instruction(block: body_block).as(^ir.Instruction))
    self.current_procedure.append_block(body_block)
    self.current_block = body_block
    self.emit_line_instruction(loop_statement.location)
    let outer_break_block = self.break_block
    let outer_continue_block = self.continue_block
    self.break_block = end_block
    self.continue_block = body_block
    self.lower_statement(loop_statement.body)
    self.break_block = outer_break_block
    self.continue_block = outer_continue_block
    if not self.current_block.is_terminated() {
        self.current_block.append_instruction(ir.new_jmp_instruction(block: body_block).as(^ir.Instruction))
    }
    self.current_procedure.append_block(end_block)
    self.current_block = end_block
}

proc (^Lowerer).lower_switch_statement(self, switch_statement: ^checked.Switch_Statement) {
    let operand = self.lower_expression(switch_statement.operand)
    let end_block = self.create_block()
    let else_block = end_block
    if switch_statement.else_block != null {
        else_block = self.create_block()
    }

    let brx_instruction = ir.new_brx_instruction(value: operand, default_block: else_block)
    let member_count = switch_statement.operand.type.as(^checked.Enum_Type).members.size
    let member_index = 0usize
    while member_index < member_count {
        brx_instruction.append_target(ir.new_brx_target(block: null))
        member_index = member_index + 1
    }
    self.current_block.append_instruction(brx_instruction.as(^ir.Instruction))

    let switch_case = switch_statement.first_case
    while switch_case != null {
        let case_block = self.create_block()
        let value = switch_case.first_value
        while value != null {
            let member_value = value.expression.as(^checked.Enum_Member_Expression).member.value
            let target = brx_instruction.first_target
            while member_value > 0 {
                target = target.next
                member_value = member_value - 1
            }
            target.block = case_block
            value = value.next
        }
        self.current_procedure.append_block(case_block)
        self.current_block = case_block
        self.lower_statement(switch_case.block)
        if not self.current_block.is_terminated() {
            self.current_block.append_instruction(ir.new_jmp_instruction(block: end_block).as(^ir.Instruction))
        }
        switch_case = switch_case.next
    }

    let target = brx_instruction.first_target
    while target != null {
        if target.block == null {
            target.block = else_block
        }
        target = target.next
    }

    if switch_statement.else_block != null {
        self.current_procedure.append_block(else_block)
        self.current_block = else_block
        self.lower_statement(switch_statement.else_block)
        if not self.current_block.is_terminated() {
            self.current_block.append_instruction(ir.new_jmp_instruction(block: end_block).as(^ir.Instruction))
        }
    }
    self.current_procedure.append_block(end_block)
    self.current_block = end_block
}

proc (^Lowerer).lower_variable_statement(self, variable_statement: ^checked.Variable_Statement) {
    let pointee_type = self.lower_type(variable_statement.symbol.type)
    let variable = self.declare_variable(symbol: variable_statement.symbol.as(^checked.Symbol), type: pointee_type)
    let alloc_instruction = ir.new_alloc_instruction(variable)
    self.current_block.append_instruction(alloc_instruction.as(^ir.Instruction))
    if self.debug_info {
        self.current_block.append_instruction(ir.new_bind_instruction(name: variable_statement.symbol.name, indirect: true, value: alloc_instruction.as(^ir.Value)).as(^ir.Instruction))
    }
    self.push_scope(alloc_instruction.as(^ir.Value))
    if variable_statement.expression != null {
        let value = self.lower_expression(variable_statement.expression)
        self.current_block.append_instruction(ir.new_store_instruction(pointer: alloc_instruction.as(^ir.Value), value: value).as(^ir.Instruction))
    }
}

proc (^Lowerer).lower_while_statement(self, while_statement: ^checked.While_Statement) {
    let condition_block = self.create_block()
    let body_block = self.create_block()
    let end_block = self.create_block()
    self.current_block.append_instruction(ir.new_jmp_instruction(block: condition_block).as(^ir.Instruction))
    self.current_procedure.append_block(condition_block)
    self.current_block = condition_block
    self.emit_line_instruction(while_statement.location)
    let condition = self.lower_expression(while_statement.condition)
    self.current_block.append_instruction(ir.new_br_instruction(condition: condition, true_block: body_block, false_block: end_block).as(^ir.Instruction))
    self.current_procedure.append_block(body_block)
    self.current_block = body_block
    let outer_break_block = self.break_block
    let outer_continue_block = self.continue_block
    self.break_block = end_block
    self.continue_block = condition_block
    self.lower_statement(while_statement.body)
    self.break_block = outer_break_block
    self.continue_block = outer_continue_block
    if not self.current_block.is_terminated() {
        self.current_block.append_instruction(ir.new_jmp_instruction(block: condition_block).as(^ir.Instruction))
    }
    self.current_procedure.append_block(end_block)
    self.current_block = end_block
}

proc (^Lowerer).lower_expression(self, expression: ^checked.Expression) -> ^ir.Value {
    switch expression.kind {
        case .Add {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Add)
        }
        case .Address_Of {
            return self.lower_address_of_expression(expression.as(^checked.Address_Of_Expression))
        }
        case .Array_Access {
            let pointer = self.lower_array_offset(expression.as(^checked.Array_Access_Expression))
            let load_instruction = ir.new_load_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                pointer: pointer
            )
            self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
            return load_instruction.as(^ir.Value)
        }
        case .Bitwise_And {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Bitwise_And)
        }
        case .Bitwise_Or {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Bitwise_Or)
        }
        case .Bitwise_Xor {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Bitwise_Xor)
        }
        case .Bool {
            let bool_expression = expression.as(^checked.Bool_Expression)
            let value = 0u64
            if bool_expression.value {
                value = 1u64
            }
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(bool_expression.type)
                value: value
                lexeme: ""
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Call {
            let call_expression = expression.as(^checked.Call_Expression)

            let callee = self.lower_expression(call_expression.callee)

            let first_argument: ^ir.Argument = null
            let last_argument: ^ir.Argument = null
            let checked_argument = call_expression.first_argument
            while checked_argument != null {
                let argument_value = self.lower_expression(checked_argument.expression)
                let argument = ir.new_argument(argument_value)
                if last_argument == null {
                    first_argument = argument
                } else {
                    last_argument.next = argument
                }
                last_argument = argument
                checked_argument = checked_argument.next
            }

            let result_type = self.lower_type(expression.type)
            let result_name = ""
            if result_type.kind != .Nothing {
                result_name = self.fresh_name()
            }
            let call_instruction = ir.new_call_instruction(
                name: result_name
                type: result_type
                callee: callee
            )
            call_instruction.first_argument = first_argument
            self.current_block.append_instruction(call_instruction.as(^ir.Instruction))
            return call_instruction.as(^ir.Value)
        }
        case .Cast {
            return self.lower_cast_expression(expression.as(^checked.Cast_Expression))
        }
        case .Character {
            let character_expression = expression.as(^checked.Character_Expression)
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(character_expression.type)
                value: character_expression.token.value.as(u64)
                lexeme: character_expression.token.lexeme
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Dereference {
            return self.lower_dereference_expression(expression.as(^checked.Dereference_Expression))
        }
        case .Divide {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Divide)
        }
        case .Enum_Member {
            let enum_member_expression = expression.as(^checked.Enum_Member_Expression)
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                value: enum_member_expression.member.value
                lexeme: ""
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Enum_Name {
            let enum_name_expression = expression.as(^checked.Enum_Name_Expression)
            let enum_type = enum_name_expression.operand.type.as(^checked.Enum_Type)
            let value = self.lower_expression(enum_name_expression.operand)
            let procedure = self.enum_name_procedure(enum_type)
            let call_instruction = ir.new_call_instruction(
                name: self.fresh_name()
                type: procedure.return_type
                callee: ir.new_value(kind: .Procedure, name: procedure.name, type: procedure.return_type)
            )
            call_instruction.first_argument = ir.new_argument(value)
            self.current_block.append_instruction(call_instruction.as(^ir.Instruction))
            return call_instruction.as(^ir.Value)
        }
        case .Enum_Value {
            return self.lower_expression(expression.as(^checked.Enum_Value_Expression).operand)
        }
        case .Equals {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Equal)
        }
        case .Greater {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Greater)
        }
        case .Greater_Or_Equals {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Greater_Or_Equal)
        }
        case .Group {
            return self.lower_expression(expression.as(^checked.Group_Expression).operand)
        }
        case .Integer {
            let integer_expression = expression.as(^checked.Integer_Expression)
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(integer_expression.type)
                value: integer_expression.token.value
                lexeme: integer_expression.token.lexeme
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Less {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Less)
        }
        case .Less_Or_Equals {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Less_Or_Equal)
        }
        case .Logic_And or .Logic_Or {
            return self.lower_logic_expression(expression.as(^checked.Binary_Expression))
        }
        case .Make_Array {
            return self.lower_make_array_expression(expression.as(^checked.Make_Array_Expression))
        }
        case .Make_Struct {
            return self.lower_make_struct_expression(expression.as(^checked.Make_Struct_Expression))
        }
        case .Member_Access {
            let pointer = self.lower_struct_offset(expression.as(^checked.Member_Access_Expression))
            let load_instruction = ir.new_load_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                pointer: pointer
            )
            self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
            return load_instruction.as(^ir.Value)
        }
        case .Modulo {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Modulo)
        }
        case .Multiply {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Multiply)
        }
        case .Negate {
            return self.lower_negate_expression(expression.as(^checked.Negate_Expression))
        }
        case .Not {
            return self.lower_not_expression(expression.as(^checked.Not_Expression))
        }
        case .Not_Equals {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Compare_Not_Equal)
        }
        case .Null {
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                value: 0u64
                lexeme: ""
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Shift_Left {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Shift_Left)
        }
        case .Shift_Right {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Shift_Right)
        }
        case .String {
            return self.lower_string_struct(expression.as(^checked.String_Expression).token.value)
        }
        case .String_Length {
            let string_length_expression = expression.as(^checked.String_Length_Expression)
            let length_member = self.string_type.first_member.next
            let object_pointer = self.lower_object_pointer(string_length_expression.operand)
            let member_type = self.lower_type(expression.type)
            let offset_instruction = ir.new_struct_offset_instruction(
                name: self.fresh_name()
                type: ir.new_pointer_type(member_type).as(^ir.Type)
                pointer: object_pointer
                member: length_member.name
            )
            self.current_block.append_instruction(offset_instruction.as(^ir.Instruction))
            let load_instruction = ir.new_load_instruction(
                name: self.fresh_name()
                type: member_type
                pointer: offset_instruction.as(^ir.Value)
            )
            self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
            return load_instruction.as(^ir.Value)
        }
        case .Subtract {
            return self.lower_binary_expression(expression.as(^checked.Binary_Expression), .Subtract)
        }
        case .Symbol {
            let symbol_expression = expression.as(^checked.Symbol_Expression)
            let symbol = symbol_expression.symbol
            if symbol.kind == .Constant {
                return self.lower_expression(symbol.as(^checked.Constant_Symbol).expression)
            }
            if symbol.kind == .Variable {
                if symbol.as(^checked.Variable_Symbol).is_global {
                    let global_pointer = self.find_global(self.variable_name(symbol.as(^checked.Variable_Symbol)))
                    let load_instruction = ir.new_load_instruction(
                        name: self.fresh_name()
                        type: self.lower_type(symbol_expression.type)
                        pointer: global_pointer
                    )
                    self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
                    return load_instruction.as(^ir.Value)
                }
                let value_pointer = self.find_scope(symbol)
                let variable = value_pointer.variable
                variable.version = variable.version + 1
                let name_builder = string.new_builder()
                let result_name = name_builder.append(variable.name).append_char('.').append_decimal(variable.version).build()
                let load_instruction = ir.new_load_instruction(
                    name: result_name
                    type: variable.type
                    pointer: value_pointer
                )
                self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
                return load_instruction.as(^ir.Value)
            }
            if symbol.kind == .Procedure {
                let procedure_symbol = symbol.as(^checked.Procedure_Symbol)
                if procedure_symbol.is_external {
                    return self.find_global(self.procedure_name(procedure_symbol))
                }
                return ir.new_value(kind: .Procedure, name: self.procedure_name(procedure_symbol), type: self.lower_type(symbol_expression.type))
            }
            return self.find_scope(symbol)
        }
        case .Type_Alignment {
            let type_alignment_expression = expression.as(^checked.Type_Alignment_Expression)
            let aligned_type = type_alignment_expression.aligned_type
            if aligned_type.kind == .Multi_Pointer {
                aligned_type = aligned_type.as(^checked.Multi_Pointer_Type).pointee
            }
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                value: self.lower_type(aligned_type).alignment().as(u64)
                lexeme: ""
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
        case .Type_Size {
            let type_size_expression = expression.as(^checked.Type_Size_Expression)
            let const_instruction = ir.new_const_instruction(
                name: self.fresh_name()
                type: self.lower_type(expression.type)
                value: self.lower_type(type_size_expression.sized_type).size().as(u64)
                lexeme: ""
            )
            self.current_block.append_instruction(const_instruction.as(^ir.Instruction))
            return const_instruction.as(^ir.Value)
        }
    }
}

proc (^Lowerer).lower_address_of_expression(self, address_of_expression: ^checked.Address_Of_Expression) -> ^ir.Value {
    let operand = address_of_expression.operand
    if operand.kind == .Symbol {
        let symbol = operand.as(^checked.Symbol_Expression).symbol
        if symbol.kind == .Variable {
            let variable_symbol = symbol.as(^checked.Variable_Symbol)
            if variable_symbol.is_global {
                return self.find_global(self.variable_name(variable_symbol))
            }
            return self.find_scope(symbol)
        }
    }
    if operand.kind == .Array_Access {
        return self.lower_array_offset(operand.as(^checked.Array_Access_Expression))
    }
    if operand.kind == .Member_Access {
        return self.lower_struct_offset(operand.as(^checked.Member_Access_Expression))
    }
    return self.lower_temporary_pointer(operand)
}

proc (^Lowerer).lower_binary_expression(self, binary_expression: ^checked.Binary_Expression, kind: ir.Instruction_Kind) -> ^ir.Value {
    let left = self.lower_expression(binary_expression.left)
    let right = self.lower_expression(binary_expression.right)
    let binary_instruction = ir.new_binary_instruction(
        kind: kind
        name: self.fresh_name()
        type: self.lower_type(binary_expression.type)
        left: left
        right: right
    )
    self.current_block.append_instruction(binary_instruction.as(^ir.Instruction))
    return binary_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_array_offset(self, array_access_expression: ^checked.Array_Access_Expression) -> ^ir.Value {
    let array: ^ir.Value = null
    if array_access_expression.operand.type.kind == .Array {
        array = self.lower_object_pointer(array_access_expression.operand)
    } else {
        array = self.lower_expression(array_access_expression.operand)
    }
    let index = self.lower_expression(array_access_expression.index)
    let item_type = self.lower_type(array_access_expression.type)
    let offset_instruction = ir.new_offset_instruction(
        name: self.fresh_name()
        type: ir.new_pointer_type(item_type).as(^ir.Type)
        pointer: array
        index: index
    )
    self.current_block.append_instruction(offset_instruction.as(^ir.Instruction))
    return offset_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_cast_expression(self, cast_expression: ^checked.Cast_Expression) -> ^ir.Value {
    let value = self.lower_expression(cast_expression.operand)
    let cast_instruction = ir.new_cast_instruction(
        name: self.fresh_name()
        type: self.lower_type(cast_expression.type)
        value: value
    )
    self.current_block.append_instruction(cast_instruction.as(^ir.Instruction))
    return cast_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_dereference_expression(self, dereference_expression: ^checked.Dereference_Expression) -> ^ir.Value {
    let pointer = self.lower_expression(dereference_expression.operand)
    let load_instruction = ir.new_load_instruction(
        name: self.fresh_name()
        type: self.lower_type(dereference_expression.type)
        pointer: pointer
    )
    self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
    return load_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_logic_expression(self, binary_expression: ^checked.Binary_Expression) -> ^ir.Value {
    let left = self.lower_expression(binary_expression.left)
    let left_block = self.current_block
    let right_block = self.create_block()
    let end_block = self.create_block()
    let branch: ^ir.Br_Instruction = null
    if binary_expression.kind == .Logic_And {
        branch = ir.new_br_instruction(condition: left, true_block: right_block, false_block: end_block)
    } else {
        branch = ir.new_br_instruction(condition: left, true_block: end_block, false_block: right_block)
    }
    self.current_block.append_instruction(branch.as(^ir.Instruction))
    self.current_procedure.append_block(right_block)
    self.current_block = right_block
    let right = self.lower_expression(binary_expression.right)
    let right_end_block = self.current_block
    self.current_block.append_instruction(ir.new_jmp_instruction(block: end_block).as(^ir.Instruction))
    self.current_procedure.append_block(end_block)
    self.current_block = end_block
    let phi = ir.new_phi_instruction(name: self.fresh_name(), type: self.lower_type(binary_expression.type))
    phi.append_entry(block: left_block, value: left)
    phi.append_entry(block: right_end_block, value: right)
    self.current_block.append_instruction(phi.as(^ir.Instruction))
    return phi.as(^ir.Value)
}

proc (^Lowerer).lower_make_array_expression(self, make_array_expression: ^checked.Make_Array_Expression) -> ^ir.Value {
    let array_type = self.lower_type(make_array_expression.type)
    let item_type = array_type.as(^ir.Array_Type).item_type

    let variable = ir.new_variable(name: self.fresh_name(), type: array_type, symbol: null)
    let alloc_instruction = ir.new_alloc_instruction(variable)
    self.current_block.append_instruction(alloc_instruction.as(^ir.Instruction))

    let index = 0u64
    let argument = make_array_expression.first_argument
    while argument != null {
        let item = self.lower_expression(argument.expression)
        let index_instruction = ir.new_const_instruction(
            name: self.fresh_name()
            type: ir.new_primitive_type(.i32)
            value: index
            lexeme: ""
        )
        self.current_block.append_instruction(index_instruction.as(^ir.Instruction))
        let offset_instruction = ir.new_offset_instruction(
            name: self.fresh_name()
            type: ir.new_pointer_type(item_type).as(^ir.Type)
            pointer: alloc_instruction.as(^ir.Value)
            index: index_instruction.as(^ir.Value)
        )
        self.current_block.append_instruction(offset_instruction.as(^ir.Instruction))
        self.current_block.append_instruction(ir.new_store_instruction(pointer: offset_instruction.as(^ir.Value), value: item).as(^ir.Instruction))
        index = index + 1
        argument = argument.next
    }

    let load_instruction = ir.new_load_instruction(
        name: self.fresh_name()
        type: array_type
        pointer: alloc_instruction.as(^ir.Value)
    )
    self.current_block.append_instruction(load_instruction.as(^ir.Instruction))
    return load_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_make_struct_expression(self, make_struct_expression: ^checked.Make_Struct_Expression) -> ^ir.Value {
    // Lower the field values first, so the result is numbered after them.
    let first_field: ^ir.Struct_Instruction_Field = null
    let last_field: ^ir.Struct_Instruction_Field = null
    let argument = make_struct_expression.first_argument
    while argument != null {
        let field = ir.new_struct_instruction_field(name: argument.member.name, value: self.lower_expression(argument.expression))
        if last_field == null {
            first_field = field
        } else {
            last_field.next = field
        }
        last_field = field
        argument = argument.next
    }
    let struct_instruction = ir.new_struct_instruction(
        name: self.fresh_name()
        type: self.lower_type(make_struct_expression.type)
    )
    struct_instruction.first_field = first_field
    self.current_block.append_instruction(struct_instruction.as(^ir.Instruction))
    return struct_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_negate_expression(self, negate_expression: ^checked.Negate_Expression) -> ^ir.Value {
    let operand = self.lower_expression(negate_expression.operand)
    let neg_instruction = ir.new_neg_instruction(
        name: self.fresh_name()
        type: self.lower_type(negate_expression.type)
        operand: operand
    )
    self.current_block.append_instruction(neg_instruction.as(^ir.Instruction))
    return neg_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_not_expression(self, not_expression: ^checked.Not_Expression) -> ^ir.Value {
    let operand = self.lower_expression(not_expression.operand)
    let not_instruction = ir.new_not_instruction(
        name: self.fresh_name()
        type: self.lower_type(not_expression.type)
        operand: operand
    )
    self.current_block.append_instruction(not_instruction.as(^ir.Instruction))
    return not_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_object_pointer(self, expression: ^checked.Expression) -> ^ir.Value {
    if expression.type.kind == .Pointer {
        return self.lower_expression(expression)
    }
    if expression.kind == .Array_Access {
        return self.lower_array_offset(expression.as(^checked.Array_Access_Expression))
    }
    if expression.kind == .Member_Access {
        return self.lower_struct_offset(expression.as(^checked.Member_Access_Expression))
    }
    if expression.kind == .Symbol {
        let symbol = expression.as(^checked.Symbol_Expression).symbol
        if symbol.kind == .Variable {
            let variable_symbol = symbol.as(^checked.Variable_Symbol)
            if variable_symbol.is_global {
                return self.find_global(self.variable_name(variable_symbol))
            }
            return self.find_scope(symbol)
        }
    }
    return self.lower_temporary_pointer(expression)
}

proc (^Lowerer).lower_struct_offset(self, member_access_expression: ^checked.Member_Access_Expression) -> ^ir.Value {
    let object_pointer = self.lower_object_pointer(member_access_expression.operand)
    let member_type = self.lower_type(member_access_expression.type)
    let offset_instruction = ir.new_struct_offset_instruction(
        name: self.fresh_name()
        type: ir.new_pointer_type(member_type).as(^ir.Type)
        pointer: object_pointer
        member: member_access_expression.member.name
    )
    self.current_block.append_instruction(offset_instruction.as(^ir.Instruction))
    return offset_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_temporary_pointer(self, expression: ^checked.Expression) -> ^ir.Value {
    let value = self.lower_expression(expression)
    let variable = ir.new_variable(name: self.fresh_name(), type: self.lower_type(expression.type), symbol: null)
    let alloc_instruction = ir.new_alloc_instruction(variable)
    self.current_block.append_instruction(alloc_instruction.as(^ir.Instruction))
    self.current_block.append_instruction(ir.new_store_instruction(pointer: alloc_instruction.as(^ir.Value), value: value).as(^ir.Instruction))
    return alloc_instruction.as(^ir.Value)
}

proc (^Lowerer).lower_string_struct(self, value: str) -> ^ir.Value {
    let data_member = self.string_type.first_member
    let length_member = data_member.next
    let data: ^ir.Value = null
    if value.length == 0 {
        let null_instruction = ir.new_const_instruction(
            name: self.fresh_name()
            type: self.lower_type(data_member.type)
            value: 0u64
            lexeme: ""
        )
        self.current_block.append_instruction(null_instruction.as(^ir.Instruction))
        data = null_instruction.as(^ir.Value)
    } else {
        data = self.string_global(value)
    }
    let length_instruction = ir.new_const_instruction(
        name: self.fresh_name()
        type: self.lower_type(length_member.type)
        value: value.length.as(u64)
        lexeme: ""
    )
    self.current_block.append_instruction(length_instruction.as(^ir.Instruction))
    let struct_instruction = ir.new_struct_instruction(
        name: self.fresh_name()
        type: self.lower_type(self.string_type.as(^checked.Type))
    )
    let data_field = ir.new_struct_instruction_field(name: data_member.name, value: data)
    data_field.next = ir.new_struct_instruction_field(name: length_member.name, value: length_instruction.as(^ir.Value))
    struct_instruction.first_field = data_field
    self.current_block.append_instruction(struct_instruction.as(^ir.Instruction))
    return struct_instruction.as(^ir.Value)
}

proc (^Lowerer).string_global(self, value: str) -> ^ir.Value {
    let global = self.program.first_global
    while global != null {
        if global.literal.length > 0 and global.literal.equals(value) {
            return global.as(^ir.Value)
        }
        global = global.next_global
    }
    self.string_counter = self.string_counter + 1
    let name_builder = string.new_builder()
    let name = name_builder.append("str_").append_decimal(self.string_counter).build()
    let string_global = ir.new_string_global(name: name, type: ir.new_multi_pointer_type(ir.new_primitive_type(.u8)).as(^ir.Type), literal: value)
    self.program.append_global(string_global)
    return string_global.as(^ir.Value)
}

proc (^Lowerer).push_scope(self, value: ^ir.Value) {
    self.scope = new_scope_entry(value: value, next: self.scope)
}

proc (^Lowerer).emit_line_instruction(self, location: source.Source_Location) {
    if self.debug_info {
        self.current_block.append_instruction(ir.new_line_instruction(source_file: self.source_file(location.source.path), line: location.line, column: location.column).as(^ir.Instruction))
    }
}

proc (^Lowerer).source_file(self, path: str) -> ^ir.Source_File {
    let source_file = self.program.find_source_file(path)
    if source_file == null {
        source_file = self.program.append_source_file(path: path, ir_path: source.relative_path(from_dir: self.output_dir, to_path: path))
    }
    return source_file
}

proc (^Lowerer).find_global(self, name: str) -> ^ir.Value {
    let global = self.program.first_global
    while global != null {
        if global.name.equals(name) {
            return global.as(^ir.Value)
        }
        global = global.next_global
    }
    return null
}

proc (^Lowerer).find_scope(self, symbol: ^checked.Symbol) -> ^ir.Value {
    let entry = self.scope
    while entry != null {
        let value = entry.value
        if value.variable != null {
            if value.variable.symbol == symbol {
                return value
            }
        } else if value.name.equals(symbol.name) {
            return value
        }
        entry = entry.next
    }
    panic "Lowering: symbol not in scope"
}

proc (^Lowerer).declare_variable(self, symbol: ^checked.Symbol, type: ^ir.Type) -> ^ir.Variable {
    let count = 0usize
    let entry = self.scope
    while entry != null {
        let existing = entry.value.variable
        if existing != null {
            if existing.symbol.name.equals(symbol.name) {
                count = count + 1
            }
        }
        entry = entry.next
    }
    let display_name = symbol.name
    if count > 0 {
        let builder = string.new_builder()
        display_name = builder.append(symbol.name).append_char('.').append_decimal(count + 1).build()
    }
    return ir.new_variable(name: display_name, type: type, symbol: symbol)
}

proc (^Lowerer).lower_type(self, type: ^checked.Type) -> ^ir.Type {
    if type == null {
        return ir.new_nothing_type().as(^ir.Type)
    }
    switch type.kind {
        case .Any {
            return ir.new_primitive_type(.Any)
        }
        case .Array {
            let array_type = type.as(^checked.Array_Type)
            return ir.new_array_type(item_type: self.lower_type(array_type.item_type), size: array_type.size).as(^ir.Type)
        }
        case .bool {
            return ir.new_primitive_type(.bool)
        }
        case .Enum {
            return ir.new_primitive_type(.i32)
        }
        case .External {
            return self.lower_external_type(type.name())
        }
        case .i16 {
            return ir.new_primitive_type(.i16)
        }
        case .i32 {
            return ir.new_primitive_type(.i32)
        }
        case .i64 {
            return ir.new_primitive_type(.i64)
        }
        case .i8 {
            return ir.new_primitive_type(.i8)
        }
        case .isize {
            return ir.new_primitive_type(.isize)
        }
        case .Multi_Pointer {
            return ir.new_multi_pointer_type(self.lower_type(type.as(^checked.Multi_Pointer_Type).pointee)).as(^ir.Type)
        }
        case .Pointer {
            return ir.new_pointer_type(self.lower_type(type.as(^checked.Pointer_Type).pointee)).as(^ir.Type)
        }
        case .Procedure {
            return ir.new_pointer_type(self.lower_procedure_type(type.as(^checked.Procedure_Type)).as(^ir.Type)).as(^ir.Type)
        }
        case .str {
            return self.lower_type(self.string_type.as(^checked.Type))
        }
        case .Struct {
            return self.lower_struct_type(type.as(^checked.Struct_Type))
        }
        case .u16 {
            return ir.new_primitive_type(.u16)
        }
        case .u32 {
            return ir.new_primitive_type(.u32)
        }
        case .u64 {
            return ir.new_primitive_type(.u64)
        }
        case .u8 {
            return ir.new_primitive_type(.u8)
        }
        case .usize {
            return ir.new_primitive_type(.usize)
        }
        else {
            panic "Lowering not supported yet: type"
        }
    }
}

proc (^Lowerer).lower_external_type(self, name: str) -> ^ir.Type {
    let existing_type = self.program.first_type
    while existing_type != null {
        if existing_type.name.equals(name) {
            return existing_type.as(^ir.Type)
        }
        existing_type = existing_type.next_type
    }
    let opaque_type = ir.new_opaque_type(name)
    self.program.append_type(opaque_type.as(^ir.Named_Type))
    return opaque_type.as(^ir.Type)
}

proc (^Lowerer).type_name(self, named_type: ^checked.Named_Type) -> str {
    let first_type_argument: ^checked.Type_Argument = null
    if named_type.kind == .Struct {
        first_type_argument = named_type.as(^checked.Struct_Type).first_type_argument
    }
    if named_type.package_name.length == 0 and first_type_argument == null {
        return named_type.name
    }
    let builder = string.new_builder()
    if named_type.package_name.length > 0 {
        builder.append(named_type.package_name).append_char('.')
    }
    builder.append(named_type.name)
    let type_argument = first_type_argument
    if type_argument != null {
        builder.append_char('<')
        loop {
            builder.append(self.lower_type(type_argument.type).name_string())
            type_argument = type_argument.next
            if type_argument == null {
                break
            }
            builder.append(", ")
        }
        builder.append_char('>')
    }
    return builder.build()
}

proc (^Lowerer).lower_struct_type(self, checked_struct_type: ^checked.Struct_Type) -> ^ir.Type {
    let name = self.type_name(checked_struct_type.as(^checked.Named_Type))
    let existing_type = self.program.first_type
    while existing_type != null {
        if existing_type.name.equals(name) {
            return existing_type.as(^ir.Type)
        }
        existing_type = existing_type.next_type
    }
    let struct_type = ir.new_struct_type(name)
    self.program.append_type(struct_type.as(^ir.Named_Type))
    let member = checked_struct_type.first_member
    while member != null {
        struct_type.append_member(name: member.name, type: self.lower_type(member.type))
        member = member.next
    }
    return struct_type.as(^ir.Type)
}

proc (^Lowerer).create_block(self) -> ^ir.Block {
    self.block_counter = self.block_counter + 1
    return ir.new_block(label: self.block_counter)
}

proc (^Lowerer).fresh_name(self) -> str {
    self.next_value_id = self.next_value_id + 1
    let buffer = string.new_builder()
    buffer.append_decimal(self.next_value_id)
    return buffer.build()
}
