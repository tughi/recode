#!/usr/bin/env python3

import argparse
import concurrent.futures
import dataclasses
import difflib
import json
import logging
import os
import re
import shutil
import subprocess
import time
from typing import List, Optional

logging.basicConfig(format="[%(asctime)s,%(msecs)03d][%(levelname).1s] %(message)s", datefmt="%H:%M:%S")

logger = logging.getLogger("ReCode")
logger.setLevel(logging.DEBUG)

COLOR_DEBUG = "\x1b[2;37m"
COLOR_ERROR = "\x1b[0;91m"
COLOR_SUCCESS = "\x1b[0;92m"
COLOR_WARNING = "\x1b[0;93m"
COLOR_RESET = "\x1b[0m"


def clean():
    logger.info("Cleaning")
    run("rm -fr build")


def run(command, **kwargs):
    if isinstance(command, str):
        command = command.split(" ")
    logger.debug(f"{COLOR_DEBUG}{' '.join(command)}{COLOR_RESET}")
    try:
        subprocess.run(command, check=True, **kwargs)
    except subprocess.CalledProcessError as error:
        exit(error.returncode)


@dataclasses.dataclass
class TestData:
    compile_error: int
    compile_stderr: List[str]
    execute_args: List[str]
    execute_error: int
    execute_stderr: List[str]
    execute_stdout: List[str]

    def has_data(self) -> bool:
        if self.compile_error:
            return True
        if self.compile_stderr:
            return True
        if self.execute_args:
            return True
        if self.execute_error:
            return True
        if self.execute_stderr:
            return True
        if self.execute_stdout:
            return True
        return False


def load_test_data(test_dir: str) -> TestData:
    test_data = json.loads(open(f"{test_dir}/test.json").read()) if os.path.exists(f"{test_dir}/test.json") else {}
    return TestData(
        compile_error=test_data.get("compile", {}).get("error", 0),
        compile_stderr=test_data.get("compile", {}).get("stderr", []),
        execute_args=test_data.get("execute", {}).get("args", []),
        execute_error=test_data.get("execute", {}).get("error", 0),
        execute_stderr=test_data.get("execute", {}).get("stderr", []),
        execute_stdout=test_data.get("execute", {}).get("stdout", []),
    )


def save_test_data(test_dir: str, test_data: TestData) -> None:
    if not test_data.has_data():
        if os.path.exists(f"{test_dir}/test.json"):
            os.remove(f"{test_dir}/test.json")
    else:
        compile_data = {}
        execute_data = {}
        if test_data.compile_error:
            compile_data["error"] = test_data.compile_error
        else:
            if test_data.execute_args:
                execute_data["args"] = test_data.execute_args
            if test_data.execute_error:
                execute_data["error"] = test_data.execute_error
            if test_data.execute_stderr:
                execute_data["stderr"] = test_data.execute_stderr
            if test_data.execute_stdout:
                execute_data["stdout"] = test_data.execute_stdout
        if test_data.compile_stderr:
            compile_data["stderr"] = test_data.compile_stderr
        open(f"{test_dir}/test.json", "w").write(
            json.dumps(
                {
                    **({"compile": compile_data} if compile_data else {}),
                    **({"execute": execute_data} if execute_data else {}),
                },
                indent=4,
            )
        )


def clean_lines(text: str) -> List[str]:
    return [re.sub(r"\x1b\[[0-9;]+m", "", line) for line in text.splitlines()]


def collect_test_data(test_dir: str, compiler_ir: str, expect_test_data: TestData):
    build_dir = f"build/{test_dir}"
    os.makedirs(build_dir, exist_ok=True)

    build_ir_path = f"{build_dir}/test.ir"
    if os.path.exists(build_ir_path):
        os.remove(build_ir_path)

    actual_test_data = dataclasses.replace(expect_test_data)

    compiler_command = ["Runner", compiler_ir, "-o", build_dir, "-n", "test", test_dir]
    compiler_result = subprocess.run(compiler_command, capture_output=True, text=True)
    actual_test_data.compile_error = compiler_result.returncode
    actual_test_data.compile_stderr = clean_lines(compiler_result.stderr)
    compile_panic = None
    if actual_test_data.compile_stderr and re.match(r"^(code/)?compiler/.*:\d+: Panic!", actual_test_data.compile_stderr[-1]):
        compile_panic = actual_test_data.compile_stderr.pop()

    if compiler_result.returncode == 0:
        runner_command = ["Runner", build_ir_path, *expect_test_data.execute_args]
        test_result = subprocess.run(runner_command, capture_output=True, text=True)
        actual_test_data.execute_error = test_result.returncode
        actual_test_data.execute_stderr = clean_lines(test_result.stderr)
        actual_test_data.execute_stdout = clean_lines(test_result.stdout)

    return actual_test_data, compile_panic, build_ir_path


def check_test_data(test_dir: str, expect_test_data: TestData, actual_test_data: TestData, compile_panic: Optional[str], build_ir_path: str) -> Optional[str]:
    if actual_test_data.compile_error != 0:
        if actual_test_data != expect_test_data:
            failure = f"{COLOR_ERROR}Unexpected compiler message\n{COLOR_DEBUG}{compute_diff(actual_test_data.compile_stderr, expect_test_data.compile_stderr)}{COLOR_RESET}"
            if compile_panic:
                failure += f"\n{COLOR_ERROR}{compile_panic}{COLOR_RESET}"
            return failure
        return None

    if expect_test_data.compile_error != 0:
        return f"{COLOR_ERROR}Expected compiler error{COLOR_RESET}"

    if actual_test_data.compile_stderr != expect_test_data.compile_stderr:
        return f"{COLOR_ERROR}Unexpected compiler message\n{COLOR_DEBUG}{compute_diff(actual_test_data.compile_stderr, expect_test_data.compile_stderr)}{COLOR_RESET}"

    if actual_test_data.execute_error != expect_test_data.execute_error:
        failure = f"{COLOR_ERROR}Unexpected execute exit: {actual_test_data.execute_error}{COLOR_RESET}"
        if actual_test_data.execute_stderr:
            failure += f"\n{COLOR_DEBUG}" + "\n".join(actual_test_data.execute_stderr) + COLOR_RESET
        return failure

    if actual_test_data.execute_stderr != expect_test_data.execute_stderr:
        return f"{COLOR_ERROR}Unexpected execute stderr\n{COLOR_DEBUG}{compute_diff(actual_test_data.execute_stderr, expect_test_data.execute_stderr)}{COLOR_RESET}"

    if actual_test_data.execute_stdout != expect_test_data.execute_stdout:
        return f"{COLOR_ERROR}Unexpected execute stdout\n{COLOR_DEBUG}{compute_diff(actual_test_data.execute_stdout, expect_test_data.execute_stdout)}{COLOR_RESET}"

    return check_ir_file(test_dir, build_ir_path)


def check_ir_file(test_dir: str, build_ir_path: str) -> Optional[str]:
    result = subprocess.run(
        ["diff", "-N", build_ir_path, f"{test_dir}/test.ir"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return f"{COLOR_ERROR}Unexpected IR output\n{COLOR_DEBUG}{result.stdout}{COLOR_RESET}"
    return None


def test(paths, save=False):
    build()

    run_tests(paths, save=save)


def run_tests(paths, save=False, compiler_ir="build/compiler.ir"):
    dirs = sorted(test_dirs(paths))
    logger.info(f"Testing {len(dirs)} tests")

    start = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count()) as executor:
        futures = [executor.submit(run_test, test_dir, compiler_ir) for test_dir in dirs]

        failed = 0
        for test_dir, future in zip(dirs, futures):
            failure, duration, actual_test_data, build_ir_path = future.result()
            if failure is None:
                logger.info(f"{COLOR_SUCCESS}PASSED{COLOR_RESET} {test_dir} {COLOR_DEBUG}({duration * 1000:.0f}ms){COLOR_RESET}")
            elif save:
                save = False
                save_test_data(test_dir, actual_test_data)
                if actual_test_data.compile_error == 0:
                    shutil.copyfile(build_ir_path, f"{test_dir}/test.ir")
                logger.warning(f"{COLOR_WARNING}SAVED{COLOR_RESET} {test_dir} {COLOR_DEBUG}({duration * 1000:.0f}ms){COLOR_RESET}\n{failure}")
            else:
                failed += 1
                logger.error(f"{COLOR_ERROR}FAILED{COLOR_RESET} {test_dir} {COLOR_DEBUG}({duration * 1000:.0f}ms){COLOR_RESET}\n{failure}")
    elapsed = time.perf_counter() - start

    if failed:
        logger.error(f"{COLOR_ERROR}Failed {failed} of {len(dirs)} tests in {elapsed:.1f}s{COLOR_RESET}")
        exit(1)
    logger.info(f"Passed {len(dirs)} tests in {elapsed:.1f}s")


def run_test(test_dir: str, compiler_ir: str):
    start = time.perf_counter()
    expect_test_data = load_test_data(test_dir)
    actual_test_data, compile_panic, build_ir_path = collect_test_data(test_dir, compiler_ir, expect_test_data)
    failure = check_test_data(test_dir, expect_test_data, actual_test_data, compile_panic, build_ir_path)
    return failure, time.perf_counter() - start, actual_test_data, build_ir_path


def test_dirs(paths):
    for path in sorted(paths):
        if os.path.isdir(path):
            for root, dirs, files in os.walk(path):
                if "test.code" in files:
                    yield root
        else:
            logger.warning(f"{COLOR_WARNING}Not a folder path: {path}{COLOR_RESET}")


def compute_diff(actual_lines, expected_lines):
    return "\n".join(line for line in difflib.Differ().compare(expected_lines, actual_lines) if line.startswith((" ", "+", "-")))


def build():
    logger.info("Building self-hosted compiler")

    if not os.path.exists("bootstrap/compiler.ir"):
        logger.error(f"{COLOR_ERROR}Missing bootstrap/compiler.ir{COLOR_RESET}")
        exit(1)

    run("mkdir -p build")
    run(["Runner", "bootstrap/compiler.ir", "-g", "-o", "build", "-n", "compiler", "code", "compiler"])


def stage():
    build()

    logger.info("Staging")

    run("mkdir -p build/stage2 build/stage3 build/stage4")
    run(["Runner", "build/compiler.ir", "-g", "-o", "build/stage2", "-n", "compiler", "code", "compiler"])
    run(["Runner", "build/stage2/compiler.ir", "-g", "-o", "build/stage3", "-n", "compiler", "code", "compiler"])
    run("diff -q build/stage2/compiler.ir build/stage3/compiler.ir")

    run_tests(["tests"], compiler_ir="build/stage2/compiler.ir")

    run("rm -fr build/staging")
    run("mkdir -p build/staging/bootstrap")
    run("cp -R code build/staging/bootstrap/code")
    run("ln -s bootstrap/code build/staging/code")
    run(["Runner", "../stage2/compiler.ir", "-g", "-o", "bootstrap", "-n", "compiler", "bootstrap/code", "compiler"], cwd="build/staging")
    run(["Runner", "build/staging/bootstrap/compiler.ir", "-g", "-o", "build/stage4", "-n", "compiler", "code", "compiler"])
    run("diff -q build/stage3/compiler.ir build/stage4/compiler.ir")

    run("rm -fr bootstrap")
    run("mv build/staging/bootstrap bootstrap")
    run("rm -fr build/staging")


if __name__ == "__main__":
    args_parsers = argparse.ArgumentParser(prog="ReCode")
    args_command_parser = args_parsers.add_subparsers(dest="command")

    args_command_parser.add_parser("clean", help="clean the build directory")

    build_args_parser = args_command_parser.add_parser("build", help="build the compiler")
    build_args_parser.add_argument("--clean", action="store_true", help="clean before building")

    stage_args_parser = args_command_parser.add_parser("stage", help="stage the compiler")
    stage_args_parser.add_argument("--clean", action="store_true", help="clean before staging")

    test_args_parser = args_command_parser.add_parser("test", help="test the compiler")
    test_args_parser.add_argument("path", nargs="*", default=["tests"], help="path to the test file(s)")
    test_args_parser.add_argument("--clean", action="store_true", help="clean before testing")
    test_args_parser.add_argument("--save", action="store_true", help="save the first unexpected compiler output")

    args = args_parsers.parse_args()
    if args.command is None:
        args_parsers.print_help()
    elif args.command == "clean":
        clean()
    else:
        if args.clean:
            clean()
        if args.command == "build":
            build()
        elif args.command == "stage":
            stage()
        elif args.command == "test":
            test(args.path, save=args.save)
