let default_allocator: Arena

const DEFAULT_CAPACITY = 24usize * 1024 * 1024

proc alloc(size: usize, alignment: usize) -> ^Any {
    if default_allocator.capacity == 0 {
        default_allocator.reserve(DEFAULT_CAPACITY)
    }
    return default_allocator.alloc(size: size, alignment: alignment)
}

proc new<T>(value: T) -> ^T {
    let result = alloc(size: type_size(T), alignment: type_alignment(T)).as(^T)
    result.^ = value
    return result
}

proc new_array<T>(capacity: usize) -> [^]T {
    return alloc(type_size(T) * capacity, type_alignment(T)).as([^]T)
}
