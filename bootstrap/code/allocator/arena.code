import libc

type Arena = struct {
    buffer: [^]u8
    capacity: usize
    offset: usize
}

proc (^Arena).alloc(self, size: usize, alignment: usize) -> ^Any {
    // Calculate padding needed for alignment
    let padding = 0usize
    let remainder = self.offset % alignment
    if remainder != 0 {
        padding = alignment - remainder
    }

    // Compute the new offset
    let aligned_offset = self.offset + padding

    // Check for capacity
    if aligned_offset + size > self.capacity {
        panic "Out of memory"
    }

    // Update the offset
    self.offset = aligned_offset + size

    // Return a pointer to the allocated memory
    let pointer = ^self.buffer[aligned_offset]
    return pointer.as(^Any)
}

proc (^Arena).clear(self) {
    // Zero out the used memory
    libc.memset(self.buffer.as(^Any), 0, self.offset)

    // Reset offset
    self.offset = 0
}

proc (^Arena).reserve(self, size: usize) {
    if self.capacity != 0 {
        panic "Arena already reserved"
    }
    let buffer_size = size
    if buffer_size % 8 != 0 {
        buffer_size = buffer_size + 8 - buffer_size % 8
    }
    self.buffer = libc.calloc(buffer_size, 1).as([^]u8)
    if self.buffer == null {
        panic "Failed to allocate arena memory"
    }
    self.capacity = buffer_size
    self.offset = 0
}
