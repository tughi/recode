import allocator
import compiler.source

type Module = struct {
    source: source.Source
    first_statement: ^Statement
    next_module: ^Module
}

proc new_module(source: source.Source, first_statement: ^Statement) -> ^Module {
    return allocator.new(Module(
        source: source
        first_statement: first_statement
        next_module: null
    ))
}

type Package = struct {
    name: str
    is_root: bool
    import_location: source.Source_Location
    first_module: ^Module
    next_package: ^Package
}

proc new_package(name: str, is_root: bool) -> ^Package {
    return allocator.new(Package(
        name: name
        is_root: is_root
        import_location: source.Source_Location(source: source.Source(path: "", content: ""), line: 0, column: 0)
        first_module: null
        next_package: null
    ))
}
