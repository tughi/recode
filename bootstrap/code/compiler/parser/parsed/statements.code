type Switch_Case_Value = struct {
    expression: ^Expression
    next: ^Switch_Case_Value
}

proc new_switch_case_value(expression: ^Expression) -> ^Switch_Case_Value {
    let result = allocator.alloc(size: type_size(Switch_Case_Value), alignment: type_alignment(Switch_Case_Value)).as(^Switch_Case_Value)
    result.^ = Switch_Case_Value(expression: expression, next: null)
    return result
}

type Switch_Case = struct {
    first_value: ^Switch_Case_Value
    block: ^Statement
    next: ^Switch_Case
}

proc new_switch_case(first_value: ^Switch_Case_Value, block: ^Statement) -> ^Switch_Case {
    let result = allocator.alloc(size: type_size(Switch_Case), alignment: type_alignment(Switch_Case)).as(^Switch_Case)
    result.^ = Switch_Case(first_value: first_value, block: block, next: null)
    return result
}

