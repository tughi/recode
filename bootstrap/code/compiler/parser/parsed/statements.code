type Procedure_Statement = struct {
    super: Statement
    receiver: ^Type
    name: ^lexer.Identifier
    first_parameter: ^Procedure_Parameter
    return_type: ^Type
    is_external: bool
    external_name: ^lexer.String
    body: ^Statement
}

proc new_procedure_statement(location: source.Source_Location, receiver: ^Type, name: ^lexer.Identifier, first_parameter: ^Procedure_Parameter, return_type: ^Type, is_external: bool, external_name: ^lexer.String, body: ^Statement) -> ^Statement {
    let result = allocator.alloc(size: type_size(Procedure_Statement), alignment: type_alignment(Procedure_Statement)).as(^Procedure_Statement)
    result.^ = Procedure_Statement(
        super: Statement(kind: .Procedure, location: location, next: null)
        receiver: receiver
        name: name
        first_parameter: first_parameter
        return_type: return_type
        is_external: is_external
        external_name: external_name
        body: body
    )
    return result.as(^Statement)
}

