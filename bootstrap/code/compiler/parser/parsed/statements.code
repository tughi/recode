import allocator
import compiler.lexer
import compiler.source

type Statement_Kind = enum {
    Assignment
    Block
    Break
    Const
    Continue
    Expression
    If
    Import
    Loop
    Panic
    Procedure
    Return
    Switch
    Type
    Variable
    While
}

type Statement = struct {
    kind: Statement_Kind
    location: source.Source_Location
    next: ^Statement
}

type Assignment_Statement = struct {
    super: Statement
    object: ^Expression
    value: ^Expression
}

proc new_assignment_statement(location: source.Source_Location, object: ^Expression, value: ^Expression) -> ^Statement {
    let result = allocator.new(Assignment_Statement(
        super: Statement(kind: .Assignment, location: location, next: null)
        object: object
        value: value
    ))
    return result.as(^Statement)
}

type Block_Statement = struct {
    super: Statement
    first_statement: ^Statement
}

proc new_block_statement(location: source.Source_Location, first_statement: ^Statement) -> ^Statement {
    let result = allocator.new(Block_Statement(
        super: Statement(kind: .Block, location: location, next: null)
        first_statement: first_statement
    ))
    return result.as(^Statement)
}

type Break_Statement = struct {
    super: Statement
}

proc new_break_statement(location: source.Source_Location) -> ^Statement {
    let result = allocator.new(Break_Statement(
        super: Statement(kind: .Break, location: location, next: null)
    ))
    return result.as(^Statement)
}

type Const_Statement = struct {
    super: Statement
    name: ^lexer.Identifier
    expression: ^Expression
}

proc new_const_statement(location: source.Source_Location, name: ^lexer.Identifier, expression: ^Expression) -> ^Statement {
    let result = allocator.new(Const_Statement(
        super: Statement(kind: .Const, location: location, next: null)
        name: name
        expression: expression
    ))
    return result.as(^Statement)
}

type Continue_Statement = struct {
    super: Statement
}

proc new_continue_statement(location: source.Source_Location) -> ^Statement {
    let result = allocator.new(Continue_Statement(
        super: Statement(kind: .Continue, location: location, next: null)
    ))
    return result.as(^Statement)
}

type Expression_Statement = struct {
    super: Statement
    expression: ^Expression
}

proc new_expression_statement(location: source.Source_Location, expression: ^Expression) -> ^Statement {
    let result = allocator.new(Expression_Statement(
        super: Statement(kind: .Expression, location: location, next: null)
        expression: expression
    ))
    return result.as(^Statement)
}

type If_Statement = struct {
    super: Statement
    condition: ^Expression
    true_block: ^Statement
    false_statement: ^Statement
}

proc new_if_statement(location: source.Source_Location, condition: ^Expression, true_block: ^Statement, false_statement: ^Statement) -> ^Statement {
    let result = allocator.new(If_Statement(
        super: Statement(kind: .If, location: location, next: null)
        condition: condition
        true_block: true_block
        false_statement: false_statement
    ))
    return result.as(^Statement)
}

type Import_Statement = struct {
    super: Statement
    name: ^lexer.Identifier
    package: ^Package
    alias: ^lexer.Identifier
}

proc new_import_statement(location: source.Source_Location, name: ^lexer.Identifier, package: ^Package, alias: ^lexer.Identifier) -> ^Statement {
    let result = allocator.new(Import_Statement(
        super: Statement(kind: .Import, location: location, next: null)
        name: name
        package: package
        alias: alias
    ))
    return result.as(^Statement)
}

type Loop_Statement = struct {
    super: Statement
    body: ^Statement
}

proc new_loop_statement(location: source.Source_Location, body: ^Statement) -> ^Statement {
    let result = allocator.new(Loop_Statement(
        super: Statement(kind: .Loop, location: location, next: null)
        body: body
    ))
    return result.as(^Statement)
}

type Procedure_Parameter = struct {
    name: ^lexer.Identifier
    parameter_type: ^Type
    next: ^Procedure_Parameter
}

proc new_procedure_parameter(name: ^lexer.Identifier, parameter_type: ^Type) -> ^Procedure_Parameter {
    return allocator.new(Procedure_Parameter(
        name: name
        parameter_type: parameter_type
        next: null
    ))
}

type Procedure_Statement = struct {
    super: Statement
    receiver: ^Type
    name: ^lexer.Identifier
    first_type_parameter: ^Type_Parameter
    first_parameter: ^Procedure_Parameter
    return_type: ^Type
    is_external: bool
    external_name: ^lexer.String
    body: ^Statement
}

proc new_procedure_statement(location: source.Source_Location, receiver: ^Type, name: ^lexer.Identifier, first_type_parameter: ^Type_Parameter, first_parameter: ^Procedure_Parameter, return_type: ^Type, is_external: bool, external_name: ^lexer.String, body: ^Statement) -> ^Statement {
    let result = allocator.new(Procedure_Statement(
        super: Statement(kind: .Procedure, location: location, next: null)
        receiver: receiver
        name: name
        first_type_parameter: first_type_parameter
        first_parameter: first_parameter
        return_type: return_type
        is_external: is_external
        external_name: external_name
        body: body
    ))
    return result.as(^Statement)
}

type Panic_Statement = struct {
    super: Statement
    message: ^lexer.String
}

proc new_panic_statement(location: source.Source_Location, message: ^lexer.String) -> ^Statement {
    let result = allocator.new(Panic_Statement(
        super: Statement(kind: .Panic, location: location, next: null)
        message: message
    ))
    return result.as(^Statement)
}

type Return_Statement = struct {
    super: Statement
    expression: ^Expression
}

proc new_return_statement(location: source.Source_Location, expression: ^Expression) -> ^Statement {
    let result = allocator.new(Return_Statement(
        super: Statement(kind: .Return, location: location, next: null)
        expression: expression
    ))
    return result.as(^Statement)
}

type Switch_Case_Value = struct {
    expression: ^Expression
    next: ^Switch_Case_Value
}

proc new_switch_case_value(expression: ^Expression) -> ^Switch_Case_Value {
    return allocator.new(Switch_Case_Value(expression: expression, next: null))
}

type Switch_Case = struct {
    first_value: ^Switch_Case_Value
    block: ^Statement
    next: ^Switch_Case
}

proc new_switch_case(first_value: ^Switch_Case_Value, block: ^Statement) -> ^Switch_Case {
    return allocator.new(Switch_Case(first_value: first_value, block: block, next: null))
}

type Switch_Statement = struct {
    super: Statement
    operand: ^Expression
    first_case: ^Switch_Case
    else_block: ^Statement
}

proc new_switch_statement(location: source.Source_Location, operand: ^Expression, first_case: ^Switch_Case, else_block: ^Statement) -> ^Statement {
    let result = allocator.new(Switch_Statement(
        super: Statement(kind: .Switch, location: location, next: null)
        operand: operand
        first_case: first_case
        else_block: else_block
    ))
    return result.as(^Statement)
}

type Variable_Statement = struct {
    super: Statement
    name: ^lexer.Identifier
    variable_type: ^Type
    is_external: bool
    expression: ^Expression
    external_name: ^lexer.String
}

proc new_variable_statement(location: source.Source_Location, name: ^lexer.Identifier, variable_type: ^Type, is_external: bool, expression: ^Expression, external_name: ^lexer.String) -> ^Statement {
    let result = allocator.new(Variable_Statement(
        super: Statement(kind: .Variable, location: location, next: null)
        name: name
        variable_type: variable_type
        is_external: is_external
        expression: expression
        external_name: external_name
    ))
    return result.as(^Statement)
}

type While_Statement = struct {
    super: Statement
    condition: ^Expression
    body: ^Statement
}

proc new_while_statement(location: source.Source_Location, condition: ^Expression, body: ^Statement) -> ^Statement {
    let result = allocator.new(While_Statement(
        super: Statement(kind: .While, location: location, next: null)
        condition: condition
        body: body
    ))
    return result.as(^Statement)
}

type Type_Parameter = struct {
    name: ^lexer.Identifier
    next: ^Type_Parameter
}

proc new_type_parameter(name: ^lexer.Identifier) -> ^Type_Parameter {
    return allocator.new(Type_Parameter(
        name: name
        next: null
    ))
}

type Type_Statement = struct {
    super: Statement
    name: ^lexer.Identifier
    first_type_parameter: ^Type_Parameter
    specifier: ^Type_Specifier
}

proc new_type_statement(location: source.Source_Location, name: ^lexer.Identifier, first_type_parameter: ^Type_Parameter, specifier: ^Type_Specifier) -> ^Statement {
    let result = allocator.new(Type_Statement(
        super: Statement(kind: .Type, location: location, next: null)
        name: name
        first_type_parameter: first_type_parameter
        specifier: specifier
    ))
    return result.as(^Statement)
}

type Type_Specifier_Kind = enum {
    Builtin
    Enum
    External
    Struct
}

type Type_Specifier = struct {
    kind: Type_Specifier_Kind
    location: source.Source_Location
}

type Builtin_Type_Specifier = struct {
    super: Type_Specifier
}

proc new_builtin_type_specifier(location: source.Source_Location) -> ^Type_Specifier {
    let result = allocator.new(Builtin_Type_Specifier(
        super: Type_Specifier(kind: .Builtin, location: location)
    ))
    return result.as(^Type_Specifier)
}

type External_Type_Specifier = struct {
    super: Type_Specifier
}

proc new_external_type_specifier(location: source.Source_Location) -> ^Type_Specifier {
    let result = allocator.new(External_Type_Specifier(
        super: Type_Specifier(kind: .External, location: location)
    ))
    return result.as(^Type_Specifier)
}

type Struct_Member = struct {
    name: ^lexer.Identifier
    member_type: ^Type
    next: ^Struct_Member
}

proc new_struct_member(name: ^lexer.Identifier, member_type: ^Type) -> ^Struct_Member {
    return allocator.new(Struct_Member(
        name: name
        member_type: member_type
        next: null
    ))
}

type Struct_Type_Specifier = struct {
    super: Type_Specifier
    first_member: ^Struct_Member
}

proc new_struct_type_specifier(location: source.Source_Location, first_member: ^Struct_Member) -> ^Type_Specifier {
    let result = allocator.new(Struct_Type_Specifier(
        super: Type_Specifier(kind: .Struct, location: location)
        first_member: first_member
    ))
    return result.as(^Type_Specifier)
}

type Enum_Member = struct {
    name: ^lexer.Identifier
    next: ^Enum_Member
}

proc new_enum_member(name: ^lexer.Identifier) -> ^Enum_Member {
    return allocator.new(Enum_Member(
        name: name
        next: null
    ))
}

type Enum_Type_Specifier = struct {
    super: Type_Specifier
    first_member: ^Enum_Member
}

proc new_enum_type_specifier(location: source.Source_Location, first_member: ^Enum_Member) -> ^Type_Specifier {
    let result = allocator.new(Enum_Type_Specifier(
        super: Type_Specifier(kind: .Enum, location: location)
        first_member: first_member
    ))
    return result.as(^Type_Specifier)
}
