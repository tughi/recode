}

proc new_switch_statement(location: source.Source_Location, operand: ^Expression, first_case: ^Switch_Case, else_block: ^Statement) -> ^Statement {
    let result = allocator.alloc(size: type_size(Switch_Statement), alignment: type_alignment(Switch_Statement)).as(^Switch_Statement)
    result.^ = Switch_Statement(
        super: Statement(kind: .Switch, location: location, next: null)
        operand: operand
        first_case: first_case
        else_block: else_block
    )
    return result.as(^Statement)
}

