import compiler.ir
import libc

proc (^libc.FILE).write_binary_instruction(self, instruction: ^ir.Binary_Instruction, operation: str) -> ^libc.FILE {
    self.write_value_definition(instruction.as(^ir.Value))
    self.write(" = ").write(operation).write_char(char: ' ')
    self.write_value_reference(instruction.left)
    self.write_char(char: ' ')
    self.write_value_reference(instruction.right)
    return self
}

proc (^libc.FILE).write_block(self, block: ^ir.Block) -> ^libc.FILE {
    self.write_char(char: '@').write_u64(value: block.label.as(u64)).write_char(char: ':').end_line()
    let instruction = block.first_instruction
    while instruction != null {
        self.write("  ")
        self.write_instruction(instruction)
        self.end_line()
        instruction = instruction.next_instruction
    }
    return self
}

proc (^libc.FILE).write_const(self, value: u64, type: ^ir.Type, lexeme: str) -> ^libc.FILE {
    if type.kind == .bool {
        if value != 0 {
            return self.write("true")
        }
        return self.write("false")
    }
    if type.kind == .Multi_Pointer or type.kind == .Pointer {
        return self.write("null")
    }
    if lexeme.length > 0 {
        return self.write(lexeme)
    }
    return self.write_u64(value: value)
}

proc (^libc.FILE).write_instruction(self, instruction: ^ir.Instruction) -> ^libc.FILE {
    switch instruction.kind {
        case .Add {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "add")
        }
        case .Alloc {
            let alloc_instruction = instruction.as(^ir.Alloc_Instruction)
            self.write_value_definition(alloc_instruction.as(^ir.Value))
            self.write(" = alloc ")
            self.write_type(alloc_instruction.allocated_type)
        }
        case .Bind {
            let bind_instruction = instruction.as(^ir.Bind_Instruction)
            self.write(".bind ")
            if bind_instruction.indirect {
                self.write_char(char: '&')
            }
            self.write(bind_instruction.name).write_char(char: ' ')
            self.write_value_reference(bind_instruction.value)
        }
        case .Br {
            let br_instruction = instruction.as(^ir.Br_Instruction)
            self.write("br ")
            self.write_value_reference(br_instruction.condition)
            self.write(" @").write_u64(value: br_instruction.true_block.label.as(u64))
            self.write(" @").write_u64(value: br_instruction.false_block.label.as(u64))
        }
        case .Call {
            let call_instruction = instruction.as(^ir.Call_Instruction)
            if call_instruction.type.kind != .Nothing {
                self.write_value_definition(call_instruction.as(^ir.Value))
                self.write(" = ")
            }
            self.write("call ")
            self.write_value_reference(call_instruction.callee)
            let argument = call_instruction.first_argument
            while argument != null {
                self.write_char(char: ' ')
                self.write_value_reference(argument.value)
                argument = argument.next
            }
        }
        case .Cast {
            let cast_instruction = instruction.as(^ir.Cast_Instruction)
            self.write_value_definition(cast_instruction.as(^ir.Value))
            self.write(" = cast ")
            self.write_value_reference(cast_instruction.value)
        }
        case .Compare_Equal {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_eq")
        }
        case .Compare_Greater {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_gt")
        }
        case .Compare_Greater_Or_Equal {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_ge")
        }
        case .Compare_Less {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_lt")
        }
        case .Compare_Less_Or_Equal {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_le")
        }
        case .Compare_Not_Equal {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "cmp_ne")
        }
        case .Const {
            let const_instruction = instruction.as(^ir.Const_Instruction)
            self.write_value_definition(const_instruction.as(^ir.Value))
            self.write(" = const ").write_const(value: const_instruction.value, type: const_instruction.as(^ir.Value).type, lexeme: const_instruction.lexeme)
        }
        case .Divide {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "div")
        }
        case .Jmp {
            let jmp_instruction = instruction.as(^ir.Jmp_Instruction)
            self.write("jmp @").write_u64(value: jmp_instruction.block.label.as(u64))
        }
        case .Line {
            let line_instruction = instruction.as(^ir.Line_Instruction)
            self.write(".line ").write_u64(value: line_instruction.source_file.index.as(u64))
            self.write_char(char: ':').write_u64(value: line_instruction.line.as(u64))
            self.write_char(char: ':').write_u64(value: line_instruction.column.as(u64))
        }
        case .Load {
            let load_instruction = instruction.as(^ir.Load_Instruction)
            self.write_value_definition(load_instruction.as(^ir.Value))
            self.write(" = load ")
            self.write_value_reference(load_instruction.pointer)
        }
        case .Modulo {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "mod")
        }
        case .Multiply {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "mul")
        }
        case .Neg {
            let neg_instruction = instruction.as(^ir.Neg_Instruction)
            self.write_value_definition(neg_instruction.as(^ir.Value))
            self.write(" = neg ")
            self.write_value_reference(neg_instruction.operand)
        }
        case .Not {
            let not_instruction = instruction.as(^ir.Not_Instruction)
            self.write_value_definition(not_instruction.as(^ir.Value))
            self.write(" = not ")
            self.write_value_reference(not_instruction.operand)
        }
        case .Offset {
            let offset_instruction = instruction.as(^ir.Offset_Instruction)
            self.write_value_definition(offset_instruction.as(^ir.Value))
            self.write(" = offset ")
            self.write_value_reference(offset_instruction.pointer)
            self.write_char(char: ' ')
            self.write_value_reference(offset_instruction.index)
        }
        case .Phi {
            let phi_instruction = instruction.as(^ir.Phi_Instruction)
            self.write_value_definition(phi_instruction.as(^ir.Value))
            self.write(" = phi")
            let entry = phi_instruction.first_entry
            while entry != null {
                self.write(" @").write_u64(value: entry.block.label.as(u64)).write_char(char: ' ')
                self.write_value_reference(entry.value)
                entry = entry.next
            }
        }
        case .Ret {
            let ret_instruction = instruction.as(^ir.Ret_Instruction)
            self.write("ret")
            if ret_instruction.value != null {
                self.write_char(char: ' ')
                self.write_value_reference(ret_instruction.value)
            }
        }
        case .Store {
            let store_instruction = instruction.as(^ir.Store_Instruction)
            self.write("store ")
            self.write_value_reference(store_instruction.pointer)
            self.write_char(char: ' ')
            self.write_value_reference(store_instruction.value)
        }
        case .Struct {
            let struct_instruction = instruction.as(^ir.Struct_Instruction)
            self.write_value_definition(struct_instruction.as(^ir.Value))
            self.write(" = struct")
            let field = struct_instruction.first_field
            while field != null {
                self.write(" .").write(field.name).write_char(char: ' ')
                self.write_value_reference(field.value)
                field = field.next
            }
        }
        case .Struct_Offset {
            let offset_instruction = instruction.as(^ir.Struct_Offset_Instruction)
            self.write_value_definition(offset_instruction.as(^ir.Value))
            self.write(" = offset ")
            self.write_value_reference(offset_instruction.pointer)
            self.write(" .").write(offset_instruction.member)
        }
        case .Subtract {
            self.write_binary_instruction(instruction.as(^ir.Binary_Instruction), "sub")
        }
    }
    return self
}

proc (^libc.FILE).write_procedure(self, procedure: ^ir.Procedure) -> ^libc.FILE {
    self.write_char(char: '$').write(procedure.name).write_char(char: '(')
    let parameter = procedure.first_parameter
    let first = true
    while parameter != null {
        if not first {
            self.write(", ")
        }
        if first and procedure.is_method {
            self.write_value_reference(parameter)
        } else {
            self.write_value_definition(parameter)
        }
        first = false
        parameter = parameter.next
    }
    self.write_char(char: ')')
    if procedure.return_type.kind != .Nothing {
        self.write(": ")
        self.write_type(procedure.return_type)
    }
    self.write(" {").end_line()

    let block = procedure.first_block
    while block != null {
        self.write_block(block)
        block = block.next
    }

    self.write_char(char: '}').end_line()
    return self
}

proc (^libc.FILE).write_global(self, global: ^ir.Global) -> ^libc.FILE {
    self.write_value_definition(global.as(^ir.Value))
    if global.literal.length > 0 {
        self.write(" = \"")
        let index = 0usize
        while index < global.literal.length {
            let char = global.literal.char_at(index)
            if char == '\0' {
                self.write("\\0")
            } else if char == '\n' {
                self.write("\\n")
            } else if char == '\t' {
                self.write("\\t")
            } else if char == '\\' {
                self.write("\\\\")
            } else if char == '"' {
                self.write("\\\"")
            } else {
                self.write_char(char: char)
            }
            index = index + 1
        }
        self.write_char(char: '"')
    } else if global.constant != null {
        self.write(" = ")
        self.write_const(value: global.constant.value, type: global.type.as(^ir.Pointer_Type).pointee, lexeme: global.constant.lexeme)
    } else if global.is_external {
        self.write(" = external")
    }
    return self.end_line()
}

proc (^libc.FILE).write_program(self, program: ^ir.Program) -> ^libc.FILE {
    let source_file = program.first_source_file
    while source_file != null {
        self.write(".source ").write_u64(value: source_file.index.as(u64)).write(" \"").write(source_file.ir_path).write_char(char: '"').end_line()
        source_file = source_file.next
        if source_file == null {
            self.end_line()
        }
    }
    let named_type = program.first_type
    while named_type != null {
        self.write_type_declaration(named_type)
        self.end_line()
        named_type = named_type.next_type
    }
    let global = program.first_global
    while global != null {
        self.write_global(global)
        self.end_line()
        global = global.next_global
    }
    let procedure = program.first_procedure
    let first = true
    while procedure != null {
        if not first {
            self.end_line()
        }
        first = false
        self.write_procedure(procedure)
        procedure = procedure.next
    }
    return self
}

proc (^libc.FILE).write_type(self, type: ^ir.Type) -> ^libc.FILE {
    switch type.kind {
        case .Any {
            self.write("Any")
        }
        case .Array {
            let array_type = type.as(^ir.Array_Type)
            self.write_char(char: '[').write_u64(value: array_type.size).write_char(char: ']')
            self.write_type(array_type.item_type)
        }
        case .bool {
            self.write("bool")
        }
        case .i16 {
            self.write("i16")
        }
        case .i32 {
            self.write("i32")
        }
        case .i64 {
            self.write("i64")
        }
        case .i8 {
            self.write("i8")
        }
        case .isize {
            self.write("isize")
        }
        case .Multi_Pointer {
            self.write("[*]")
            self.write_type(type.as(^ir.Multi_Pointer_Type).pointee)
        }
        case .Nothing {
            panic
        }
        case .Opaque {
            self.write(type.as(^ir.Named_Type).name)
        }
        case .Pointer {
            self.write_char(char: '[')
            self.write_type(type.as(^ir.Pointer_Type).pointee)
            self.write_char(char: ']')
        }
        case .Procedure {
            let procedure_type = type.as(^ir.Procedure_Type)
            self.write("proc (")
            let parameter = procedure_type.first_parameter
            let first = true
            while parameter != null {
                if not first {
                    self.write(", ")
                }
                first = false
                self.write_type(parameter.type)
                parameter = parameter.next
            }
            self.write_char(char: ')')
            if procedure_type.return_type.kind != .Nothing {
                self.write(": ")
                self.write_type(procedure_type.return_type)
            }
        }
        case .Struct {
            self.write(type.as(^ir.Named_Type).name)
        }
        case .u16 {
            self.write("u16")
        }
        case .u32 {
            self.write("u32")
        }
        case .u64 {
            self.write("u64")
        }
        case .u8 {
            self.write("u8")
        }
        case .usize {
            self.write("usize")
        }
    }
    return self
}

proc (^libc.FILE).write_type_declaration(self, type: ^ir.Named_Type) -> ^libc.FILE {
    self.write("type ").write(type.name).write(" = ")
    if type.kind == .Struct {
        self.write("struct {").end_line()
        let member = type.as(^ir.Struct_Type).first_member
        while member != null {
            self.write("  ").write(member.name).write(": ")
            self.write_type(member.type)
            self.end_line()
            member = member.next
        }
        self.write_char(char: '}')
    } else {
        self.write("opaque")
    }
    return self.end_line()
}

proc (^libc.FILE).write_value_definition(self, value: ^ir.Value) -> ^libc.FILE {
    self.write_value_reference(value)
    self.write(": ")
    self.write_type(value.type)
    return self
}

proc (^libc.FILE).write_value_reference(self, value: ^ir.Value) -> ^libc.FILE {
    if value.kind == .Global or value.kind == .Procedure {
        self.write_char(char: '$')
    } else {
        self.write_char(char: '%')
    }
    return self.write(value.name)
}
