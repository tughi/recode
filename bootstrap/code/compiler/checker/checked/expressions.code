import allocator
import compiler.lexer

type Expression_Kind = enum {
    Add
    Address_Of
    Array_Access
    Bitwise_And
    Bitwise_Or
    Bitwise_Xor
    Bool
    Call
    Cast
    Character
    Dereference
    Divide
    Enum_Member
    Enum_Name
    Enum_Value
    Equals
    Greater
    Greater_Or_Equals
    Group
    Integer
    Less
    Less_Or_Equals
    Logic_And
    Logic_Or
    Make_Array
    Make_Struct
    Member_Access
    Modulo
    Multiply
    Negate
    Not
    Not_Equals
    Null
    Shift_Left
    Shift_Right
    String
    String_Length
    Subtract
    Symbol
    Type_Alignment
    Type_Size
}

type Expression = struct {
    kind: Expression_Kind
    type: ^Type
}

proc (^Expression).is_mutable(self) -> bool {
    switch self.kind {
        case .Array_Access or .Dereference {
            return true
        }
        case .Member_Access {
            let member_access = self.as(^Member_Access_Expression)
            if member_access.operand.type.kind == .Pointer {
                return true
            }
            return member_access.operand.is_mutable()
        }
        case .Symbol {
            return self.as(^Symbol_Expression).symbol.kind == .Variable
        }
        else {
            return false
        }
    }
}

type Address_Of_Expression = struct {
    super: Expression
    operand: ^Expression
}

proc new_address_of_expression(operand: ^Expression, type: ^Type) -> ^Address_Of_Expression {
    return allocator.new(Address_Of_Expression(
        super: Expression(kind: .Address_Of, type: type)
        operand: operand
    ))
}

type Array_Access_Expression = struct {
    super: Expression
    operand: ^Expression
    index: ^Expression
}

proc new_array_access_expression(operand: ^Expression, index: ^Expression, type: ^Type) -> ^Array_Access_Expression {
    return allocator.new(Array_Access_Expression(
        super: Expression(kind: .Array_Access, type: type)
        operand: operand
        index: index
    ))
}

type Binary_Expression = struct {
    super: Expression
    left: ^Expression
    right: ^Expression
}

proc new_binary_expression(kind: Expression_Kind, left: ^Expression, right: ^Expression, type: ^Type) -> ^Binary_Expression {
    return allocator.new(Binary_Expression(
        super: Expression(kind: kind, type: type)
        left: left
        right: right
    ))
}

type Bool_Expression = struct {
    super: Expression
    value: bool
}

proc new_bool_expression(value: bool, type: ^Type) -> ^Bool_Expression {
    return allocator.new(Bool_Expression(
        super: Expression(kind: .Bool, type: type)
        value: value
    ))
}

type Call_Argument = struct {
    expression: ^Expression
    next: ^Call_Argument
}

proc new_call_argument(expression: ^Expression) -> ^Call_Argument {
    return allocator.new(Call_Argument(expression: expression, next: null))
}

type Call_Expression = struct {
    super: Expression
    callee: ^Expression
    first_argument: ^Call_Argument
}

proc new_call_expression(callee: ^Expression, type: ^Type, first_argument: ^Call_Argument) -> ^Call_Expression {
    return allocator.new(Call_Expression(
        super: Expression(kind: .Call, type: type)
        callee: callee
        first_argument: first_argument
    ))
}

