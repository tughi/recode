type Make_Struct_Argument = struct {
    member: ^Struct_Member
    expression: ^Expression
    next: ^Make_Struct_Argument
}

proc new_make_struct_argument(member: ^Struct_Member, expression: ^Expression) -> ^Make_Struct_Argument {
    return allocator.new(Make_Struct_Argument(member: member, expression: expression, next: null))
}

