  %13: usize = load %12
  %14: [u8] = offset %11 %13
  %15: [Any] = cast %14
  %16: [*]u8 = cast %15
  %17: usize = const 0
  %18: [usize] = offset $string.builder.builder_arena .offset
  %19: usize = load %18
  %20: string.builder.Builder = struct .data %16 .length %17 .start %19
  ret %20
}

$main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = call $compiler.main %argc %argv
  ret %1
}
