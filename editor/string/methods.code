proc (^str).data(self) -> [^]u8 {
    return self.as(^String).data
}

proc (str).equals(self, anon other: str) -> bool {
    if self.length != other.length {
        return false
    }
    let index = 0usize
    let self_data = self.data()
    let other_data = other.data()
    while index < self.length {
        if self_data[index] != other_data[index] {
            return false
        }
        index = index + 1
    }
    return true
}

proc (str).hash(self) -> u64 {
    // TODO: Replace djb2 algorithm with FNV-1a once XOR is implemented
    let data = self.data()
    let hash = 5381u64
    let index = 0usize
    while index < self.length {
        hash = hash * 33 + data[index].as(u64)
        index = index + 1
    }
    return hash
}
