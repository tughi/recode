type Window = external
type Surface = external

type Event = struct {
    type: u32
    timestamp: u32
    window_id: u32
    _data_1: u64
    _data_2: u64
    _data_3: u64
    _data_4: u64
    _data_5: u64
    _data_6: u64
    _data_7: u64
}

proc init(anon flags: u32) -> i32 = external "SDL_Init"

proc quit() = external "SDL_Quit"

proc get_error() -> ^u8 = external "SDL_GetError"

proc delay(anon ms: u32) = external "SDL_Delay"

proc __create_window(anon title: [^]u8, anon x: i32, anon y: i32, anon w: i32, anon h: i32, anon flags: u32) -> ^Window = external "SDL_CreateWindow"

proc create_window(title: str, x: i32, y: i32, w: i32, h: i32, flags: u32) -> ^Window {
    let title_copy = title
    let title_data = (^title_copy).as(^String).data
    return __create_window(title_data, x, y, w, h, flags)
}

proc get_window_surface(anon window: ^Window) -> ^Surface = external "SDL_GetWindowSurface"

proc (^Window).get_surface(self) -> ^Surface {
    return get_window_surface(self)
}

proc update_window_surface(anon window: ^Window) -> i32 = external "SDL_UpdateWindowSurface"

proc (^Window).update_surface(self) -> i32 {
    return update_window_surface(self)
}

proc destroy_window(anon window: ^Window) = external "SDL_DestroyWindow"

proc poll_event(anon event: ^Event) -> i32 = external "SDL_PollEvent"

proc (^Window).destroy(self) {
    destroy_window(self)
}
