type Control = struct {
    super: Widget
    bounds: Rect
}

proc (^Control).on_handle_event(self, anon event: Event) {
    if event is Mouse_Motion_Event as mouse_motion_event {
        if self.bounds.contains(x: mouse_motion_event.x, y: mouse_motion_event.y) {
            mouse_motion_event.window.hovered_widget = ^self.super
        }
    }
}

proc (^Control).on_layout(self, anon bounds: Rect) {
    self.bounds = bounds
}
