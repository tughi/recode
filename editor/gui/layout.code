import collections
import errors

type Layout = struct {
    super: Widget
    children: collections.List<^Widget>
}

proc (^Layout).add_child(self, anon child: ^Widget) !> errors.Error {
    self.children.append(child)
    return
}

proc (^Layout).on_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event) {
    let index = 0usize
    while index < self.children.length {
        let child = self.children.items[index]
        if child.bounds.contains(x: event.x, y: event.y) {
            child.handle_mouse_button_down_event(event)
        }
        index = index + 1
    }
}

proc (^Layout).on_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event) {
    let index = 0usize
    while index < self.children.length {
        let child = self.children.items[index]
        if child.bounds.contains(x: event.x, y: event.y) {
            child.handle_mouse_button_up_event(event)
        }
        index = index + 1
    }
}

proc (^Layout).on_mouse_motion_event(self, anon event: Mouse_Motion_Event) {
    self.super.on_mouse_motion_event(event)

    let index = 0usize
    while index < self.children.length {
        let child = self.children.items[index]
        if child.bounds.contains(x: event.x, y: event.y) {
            child.handle_mouse_motion_event(event)
        }
        index = index + 1
    }
}

proc (^Layout).on_render(self, anon renderer: ^Renderer, anon window: ^Window) {
    let index = 0usize
    while index < self.children.length {
        let child = self.children.items[index]
        renderer.set_clip_rect(self.bounds)
        child.render(renderer, window)
        index = index + 1
    }
}
