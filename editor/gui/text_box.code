type Text_Box = struct {
    super: Widget
    content: str
}

proc create_text_box(content: str) -> ^Text_Box {
    let text_box = alloc Text_Box(content: content)
    text_box.behavior = Widget_Behavior(text_box)
    return text_box
}

proc (^Text_Box).on_render(self, anon renderer: ^Renderer, anon window: ^Window) {
    renderer.set_draw_color(Color(red: 0x0f, green: 0x0f, blue: 0x0f, alpha: 255))
    renderer.fill_rect(Rect(left: self.bounds.left + 1, top: self.bounds.top + 1, right: self.bounds.right - 1, bottom: self.bounds.bottom - 1))

    renderer.set_draw_color(Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_rect(self.bounds)

    renderer.set_draw_color(Color(red: 255, green: 255, blue: 255, alpha: 255))
    // renderer.draw_text(
    //     text: self.content
    //     x: self.bounds.left + 8
    //     y: self.bounds.top + 8
    //     max_width: self.bounds.right - self.bounds.left - 16
    // )
}
