import allocator
import font
import os

const BUTTON_PADDING = 8

proc (^Builder).button(gui, id: str, label: str) -> ^Widget !> allocator.Out_Of_Memory {
    let button = gui.widget(id: id)
    button.text = label
    button.text_size = font.fixed_size.measure_text(label)
    button.behavior = button.as(^Button)
    button.preferred_size = Size(
        width: button.text_size.width + BUTTON_PADDING * 2 - 1
        height: button.text_size.height + BUTTON_PADDING * 2 - 1
    )
    let min_width = font.fixed_size.height + BUTTON_PADDING * 2 - 1
    if button.preferred_size.width < min_width {
        button.preferred_size.width = min_width
    }
    return button
}

type Button = struct {
    super: Widget
}

