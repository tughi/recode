import gui
import os

proc (^gui.Button).draw(self, renderer: ^gui.Renderer) {
    renderer.set_draw_color(gui.Color(red: 255, green: 255, blue: 255, alpha: 255))
    renderer.draw_rect(self.bounds)
}

proc (^gui.Button).handle_event(self, anon event: ^gui.Event) {
    os.stdout.write("Button event").end_line()
}
