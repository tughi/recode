proc (^Button).on_render(self, anon renderer: ^Renderer, anon window: ^Window) {
    let button_font = font.fixed_size

    if self.is_pressed {
        renderer.set_draw_color(Color(red: 0x17, green: 0x17, blue: 0x17, alpha: 255))
    } else if self.is_hovered {
        renderer.set_draw_color(Color(red: 0x27, green: 0x27, blue: 0x27, alpha: 255))
    } else {
        renderer.set_draw_color(Color(red: 0x1f, green: 0x1f, blue: 0x1f, alpha: 255))
    }
    renderer.fill_rect(Rect(left: self.bounds.left + 1, top: self.bounds.top + 1, right: self.bounds.right - 1, bottom: self.bounds.bottom - 1))

    renderer.set_draw_color(Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_line(x1: self.bounds.left, y1: self.bounds.top, x2: self.bounds.right - 1, y2: self.bounds.top)
    renderer.draw_line(x1: self.bounds.left, y1: self.bounds.top + 1, x2: self.bounds.left, y2: self.bounds.bottom - 1)

    renderer.set_draw_color(Color(red: 0x07, green: 0x07, blue: 0x07, alpha: 255))
    renderer.draw_line(x1: self.bounds.left + 1, y1: self.bounds.bottom, x2: self.bounds.right, y2: self.bounds.bottom)
    renderer.draw_line(x1: self.bounds.right, y1: self.bounds.top + 1, x2: self.bounds.right, y2: self.bounds.bottom - 1)

    if self.is_pressed {
        renderer.set_draw_color(Color(red: 0xaf, green: 0xaf, blue: 0xaf, alpha: 255))
    } else {
        renderer.set_draw_color(Color(red: 0xcf, green: 0xcf, blue: 0xcf, alpha: 255))
    }
    renderer.draw_text(self.text, x: (self.bounds.left + self.bounds.right - self.text_size.width) / 2, y: self.bounds.top + (self.bounds.height() - button_font.height) / 2)
}
