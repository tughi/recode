import font
import os

proc create_button(label: str, click_listener: Button_Click_Listener) -> ^Button {
    let button = alloc Button(label: label)
    button.behavior = button
    button.click_listener = click_listener
    return button
}

type Button = struct {
    super: Widget
    label: str
    label_size: Size
    click_listener: Button_Click_Listener
}

type Button_Click_Listener = trait {
    proc on_click(self, button: ^Button)
}

proc (^Button).on_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event) {
    if event.button == 1 {
        event.window.pressed_widget = self
    }
}

proc (^Button).on_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event) {
    if event.button == 1 and event.window.pressed_widget == self {
        event.window.pressed_widget = null
        if event.window.hovered_widget == self {
            self.click_listener.on_click(button: self)
        }
        event.window.is_dirty = true
    }
}

proc (^Button).on_click(self) {
    // Nothing to do
}

proc (^Button).on_layout(self, anon rect: Rect) {
    self.super.on_layout(rect)
}

proc (^Button).on_render(self, anon renderer: ^Renderer, anon window: ^Window) {
    let button_font = font.fixed_size

    if window.pressed_widget == self {
        renderer.set_draw_color(Color(red: 0x17, green: 0x17, blue: 0x17, alpha: 255))
    } else if window.hovered_widget == self {
        renderer.set_draw_color(Color(red: 0x27, green: 0x27, blue: 0x27, alpha: 255))
    } else {
        renderer.set_draw_color(Color(red: 0x1f, green: 0x1f, blue: 0x1f, alpha: 255))
    }
    renderer.fill_rect(Rect(left: self.bounds.left + 1, top: self.bounds.top + 1, right: self.bounds.right - 1, bottom: self.bounds.bottom - 1))

    renderer.set_draw_color(Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_line(x1: self.bounds.left, y1: self.bounds.top, x2: self.bounds.right - 1, y2: self.bounds.top)
    renderer.draw_line(x1: self.bounds.left, y1: self.bounds.top + 1, x2: self.bounds.left, y2: self.bounds.bottom - 1)

    renderer.set_draw_color(Color(red: 0x07, green: 0x07, blue: 0x07, alpha: 255))
    renderer.draw_line(x1: self.bounds.left + 1, y1: self.bounds.bottom, x2: self.bounds.right, y2: self.bounds.bottom)
    renderer.draw_line(x1: self.bounds.right, y1: self.bounds.top + 1, x2: self.bounds.right, y2: self.bounds.bottom - 1)

    if self.label_size.width == 0 {
        self.label_size = button_font.measure_text(self.label)
    }

    renderer.set_draw_color(Color(red: 0xcf, green: 0xcf, blue: 0xcf, alpha: 255))
    renderer.draw_text(self.label, x: (self.bounds.left + self.bounds.right - self.label_size.width) / 2, y: self.bounds.top + (self.bounds.height() - button_font.height) / 2)
}
