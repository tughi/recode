type Button = struct {
    label: str
}

proc (^Button).layout(self, view: ^View) {
    // TODO: Layout logic for the button
}

proc (^Button).render(self, view: ^View, renderer: ^Renderer) {
    let button_font = font.fixed_size

    renderer.set_draw_color(Color(red: 0x1f, green: 0x1f, blue: 0x1f, alpha: 255))
    // if self.is_pressed {
    //     renderer.set_draw_color(Color(red: 0x17, green: 0x17, blue: 0x17, alpha: 255))
    // } else if self.is_hovered {
    //     renderer.set_draw_color(Color(red: 0x27, green: 0x27, blue: 0x27, alpha: 255))
    // } else {
    //     renderer.set_draw_color(Color(red: 0x1f, green: 0x1f, blue: 0x1f, alpha: 255))
    // }
    renderer.fill_rect(Rect(x: view.bounds.x + 1, y: view.bounds.y + 1, width: view.bounds.width - 2, height: view.bounds.height - 2))

    // Draw top-left border
    renderer.set_draw_color(Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_line(x1: view.bounds.x, y1: view.bounds.y, x2: view.bounds.x + view.bounds.width - 1, y2: view.bounds.y)
    renderer.draw_line(x1: view.bounds.x, y1: view.bounds.y + 1, x2: view.bounds.x, y2: view.bounds.y + view.bounds.height - 1)

    // Draw bottom-right border
    renderer.set_draw_color(Color(red: 0x07, green: 0x07, blue: 0x07, alpha: 255))
    renderer.draw_line(x1: view.bounds.x + 1, y1: view.bounds.y + view.bounds.height - 1, x2: view.bounds.x + view.bounds.width - 1, y2: view.bounds.y + view.bounds.height - 1)
    renderer.draw_line(x1: view.bounds.x + view.bounds.width - 1, y1: view.bounds.y + 1, x2: view.bounds.x + view.bounds.width - 1, y2: view.bounds.y + view.bounds.height - 1)

    // Draw button label
    renderer.set_draw_color(Color(red: 0xcf, green: 0xcf, blue: 0xcf, alpha: 255))
    // if self.is_pressed {
    //     renderer.set_draw_color(Color(red: 0xaf, green: 0xaf, blue: 0xaf, alpha: 255))
    // } else {
    //     renderer.set_draw_color(Color(red: 0xcf, green: 0xcf, blue: 0xcf, alpha: 255))
    // }
    renderer.draw_text(self.label, x: view.bounds.x, y: view.bounds.y)
}

type Button_Factory = struct {
    label: str
}

proc (^Button_Factory).create(self) -> Widget !> allocator.Out_Of_Memory {
    let button = allocator.alloc(size: type_size(Button), alignment: type_alignment(Button)).as(^Button)
    button.label = self.label
    return button
}

proc (^Context).button(gui, id: str, label: str) -> ^View !> allocator.Out_Of_Memory {
    let widget_factory = Button_Factory(label: label)
    let widget = gui.use_widget(id, factory: widget_factory)

    let view = gui.view(id: id, widget: widget)
    return view
}
