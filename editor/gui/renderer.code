import font

type Renderer = trait {
    proc clear(self)
    proc draw_line(self, x1: i32, y1: i32, x2: i32, y2: i32)
    proc draw_point(self, x: i32, y: i32)
    proc draw_rect(self, anon rect: Rect)
    proc fill_rect(self, anon rect: Rect)
    proc present(self)
    proc set_clip_rect(self, anon rect: Rect)
    proc set_draw_color(self, anon color: Color)
}

proc (^Renderer).draw_text(self, anon text: str, x: i32, y: i32) {
    let left = x
    let top = y
    let glyphs = font.fixed_size.glyphs
    let text_data = text.data()
    let index = 0usize
    while index < text.length {
        let code_point = text_data[index]
        if code_point == '\n' {
            left = x
            top = top + font.fixed_size.height
        } else {
            let glyph = glyphs[code_point]
            let glyph_mask = glyph.mask
            if glyph_mask != null {
                let glyph_index = 0
                while glyph_index < glyph.width * glyph.height {
                    if glyph_mask[glyph_index] != 0 {
                        self.draw_point(
                            x: left + (glyph_index % glyph.width)
                            y: top + (glyph_index / glyph.width)
                        )
                    }
                    glyph_index = glyph_index + 1
                }
            }
            left = left + glyph.width
        }
        index = index + 1
    }
}
