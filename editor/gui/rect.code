import gui

proc (^gui.Rect).width(self) -> i32 {
    return self.right - self.left + 1
}

proc (^gui.Rect).height(self) -> i32 {
    return self.bottom - self.top + 1
}

proc (^gui.Rect).contains(self, x: i32, y: i32) -> bool {
    return x >= self.left and x <= self.right and y >= self.top and y <= self.bottom
}

proc (^gui.Rect).set(self, left: i32, top: i32, right: i32, bottom: i32) {
    self.left = left
    self.top = top
    self.right = right
    self.bottom = bottom
}

proc (^gui.Rect).set_from_rect(self, anon rect: gui.Rect) {
    self.set(left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom)
}

proc (^gui.Rect).set_location(self, left: i32, top: i32) {
    self.right = self.right - self.left + left
    self.bottom = self.bottom - self.top + top
    self.left = left
    self.top = top
}

proc (^gui.Rect).set_size(self, width: i32, height: i32) {
    if width < 1 {
        self.right = self.left
    } else {
        self.right = self.left + width - 1
    }
    if height < 1 {
        self.bottom = self.top
    } else {
        self.bottom = self.top + height - 1
    }
}

proc (^gui.Rect).intersect(self, rect: gui.Rect) {
    let left = self.left
    if rect.left > left {
        left = rect.left
    }
    let right = self.right
    if rect.right < right {
        right = rect.right
    }
    if left > right {
        right = left
    }
    let top = self.top
    if rect.top > top {
        top = rect.top
    }
    let bottom = self.bottom
    if rect.bottom < bottom {
        bottom = rect.bottom
    }
    if top > bottom {
        bottom = top
    }
    self.set(left: left, top: top, right: right, bottom: bottom)
}

proc (^gui.Rect).intersects(self, rect: gui.Rect) -> bool {
    if self.left > rect.right or self.top > rect.bottom or self.right < rect.left or self.bottom < rect.top {
        return false
    }
    return true
}
