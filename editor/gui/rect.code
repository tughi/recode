type Rect = struct {
    x: i32
    y: i32
    width: i32
    height: i32
}

proc (^Rect).contains(self, x: i32, y: i32) -> bool {
    let dx = x - self.x
    let dy = y - self.y
    return dx >= 0 and dx < self.width and dy >= 0 and dy < self.height
}

proc (^Rect).set(self, x: i32, y: i32, width: i32, height: i32) {
    self.x = x
    self.y = y
    self.width = width
    self.height = height
}

proc (^Rect).set_from_rect(self, anon rect: Rect) {
    self.set(x: rect.x, y: rect.y, width: rect.width, height: rect.height)
}

proc (^Rect).set_location(self, x: i32, y: i32) {
    self.x = x
    self.y = y
}

proc (^Rect).set_size(self, width: i32, height: i32) {
    if width < 1 {
        self.width = 0
    } else {
        self.width = width
    }
    if height < 1 {
        self.height = 0
    } else {
        self.height = height
    }
}

proc (^Rect).intersects(self, rect: Rect) -> bool {
    if self.x > rect.x + rect.width - 1 {
        // after
        return false
    }
    if self.y > rect.y + rect.height - 1 {
        // below
        return false
    }
    if self.x + self.width - 1 < rect.x {
        // before
        return false
    }
    if self.y + self.height - 1 < rect.y {
        // above
        return false
    }
    return true
}
