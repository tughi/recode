type Rect = struct {
    left: i32
    top: i32
    right: i32
    bottom: i32
}

proc (^Rect).width(self) -> i32 {
    return self.right - self.left + 1
}

proc (^Rect).height(self) -> i32 {
    return self.bottom - self.top + 1
}

proc (^Rect).contains(self, x: i32, y: i32) -> bool {
    return x >= self.left and x <= self.right and y >= self.top and y <= self.bottom
}

proc (^Rect).set(self, left: i32, top: i32, right: i32, bottom: i32) {
    self.left = left
    self.top = top
    self.right = right
    self.bottom = bottom
}

proc (^Rect).set_from_rect(self, rect: Rect) {
    self.set(rect.left, rect.top, rect.right, rect.bottom)
}

proc (^Rect).set_location(self, left: i32, top: i32) {
    self.right = self.right - self.left + left
    self.bottom = self.bottom - self.top + top
    self.left = left
    self.top = top
}

proc (^Rect).set_size(self, width: i32, height: i32) {
    if width < 1 {
        self.right = self.left
    } else {
        self.right = self.left + width - 1
    }
    if height < 1 {
        self.bottom = self.top
    } else {
        self.bottom = self.top + height - 1
    }
}

proc (^Rect).intersect(self, rect: Rect) {
    let left = max(self.left, rect.left)
    let right = min(self.right, rect.right)
    if left > right {
        right = left
    }
    let top = max(self.top, rect.top)
    let bottom = min(self.bottom, rect.bottom)
    if top > bottom {
        bottom = top
    }
    self.set(left, top, right, bottom)
}

proc (^Rect).intersects(self, rect: Rect) -> bool {
    if self.left > rect.right or self.top > rect.bottom or self.right < rect.left or self.bottom < rect.top {
        return false
    }
    return true
}
