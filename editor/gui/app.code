import collections.list
import errors
import os
import sdl

let ready = false
let windows: list.List<^Window>

proc init() !> errors.Error {
    if ready {
        raise errors.Error(message: "GUI app was already initialized")
    }

    os.init()

    windows.init()

    if sdl.init(0x20) != 0 {
        raise errors.Error(message: "Failed to initialize SDL")
    }

    ready = true

    return
}

proc run() -> i32 {
    let event = sdl.Event()
    let running = true
    while running {
        while sdl.poll_event(^event) != 0 {
            if event.type == 0x100 { \ SDL_QUIT
                os.stdout.write_string("Quit event (").write_unsigned(event.type.as(u64)).write_string(")").end_line()
                running = false
            } else if event.type == 0x200 { \ SDL_WINDOWEVENT
                let window_event = (^event).as(^sdl.Window_Event)
                os.stdout.write_string("Window Event (").write_unsigned(event.type.as(u64)).write_string("): ").write_unsigned(window_event.event.as(u64)).end_line()
            } else if event.type == 0x300 { \ SDL_KEYDOWN
                let key_event = (^event).as(^sdl.Keyboard_Event)
                os.stdout.write_string("Key Down (").write_unsigned(event.type.as(u64)).write_string("): key=").write_unsigned(key_event.key.scan_code.as(u64)).end_line()
            } else if event.type == 0x301 { \ SDL_KEYUP
                let key_event = (^event).as(^sdl.Keyboard_Event)
                os.stdout.write_string("Key Up (").write_unsigned(event.type.as(u64)).write_string("): key=").write_unsigned(key_event.key.scan_code.as(u64)).end_line()
            } else if event.type == 0x400 { \ SDL_MOUSEMOTION
                let mouse_event = (^event).as(^sdl.Mouse_Motion_Event)
                os.stdout.write_string("Mouse Motion (").write_unsigned(event.type.as(u64)).write_string("): x=").write_signed(mouse_event.x.as(i64)).write_string(", y=").write_signed(mouse_event.y.as(i64)).end_line()
            } else if event.type == 0x401 { \ SDL_MOUSEBUTTONDOWN
                let mouse_button_event = (^event).as(^sdl.Mouse_Button_Event)
                os.stdout.write_string("Mouse Button Down (").write_unsigned(event.type.as(u64)).write_string("): button=").write_unsigned(mouse_button_event.button.as(u64)).write_string(", state=").write_unsigned(mouse_button_event.state.as(u64)).end_line()
            } else if event.type == 0x402 { \ SDL_MOUSEBUTTONUP
                let mouse_button_event = (^event).as(^sdl.Mouse_Button_Event)
                os.stdout.write_string("Mouse Button Up (").write_unsigned(event.type.as(u64)).write_string("): button=").write_unsigned(mouse_button_event.button.as(u64)).write_string(", state=").write_unsigned(mouse_button_event.state.as(u64)).end_line()
            } else if event.type == 0x403 { \ SDL_MOUSEWHEEL
                let mouse_wheel_event = (^event).as(^sdl.Mouse_Wheel_Event)
                os.stdout.write_string("Mouse Wheel (").write_unsigned(event.type.as(u64)).write_string("): x=").write_signed(mouse_wheel_event.x.as(i64)).write_string(", y=").write_signed(mouse_wheel_event.y.as(i64)).write_string(", direction=").write_unsigned(mouse_wheel_event.direction.as(u64)).end_line()
            } else {
                os.stdout.write_string("Unsupported event (").write_unsigned(event.type.as(u64)).write_string(")").end_line()
            }
        }
        \ Update the main window here if needed
    }

    sdl.quit()
    return 0
}

type Window = struct {
    sdl_window: ^sdl.Window
}

proc (^str).data(self) -> [^]u8 {
    return self.as(^String).data
}

proc create_window(title: str, width: i32, height: i32) -> ^Window !> errors.Error {
    if not ready {
        raise errors.Error(message: "GUI app was not initialized")
    }

    let sdl_window = sdl.create_window(title.data(), 0x2fff0001, 0x2fff0001, width, height, 0)
    if sdl_window == null {
        raise errors.Error(message: "Failed to create SDL window")
    }

    let window = alloc Window(sdl_window: sdl_window)
    windows.append(window)
    return window
}
