import collections.list
import errors
import io
import os
import sdl

let ready = false
let windows: list.List<^Window>

proc init() !> errors.Error {
    if ready {
        raise errors.Error(message: "GUI app was already initialized")
    }

    os.init()

    windows.init()

    if sdl.init(0x20) != 0 {
        raise errors.Error(message: "Failed to initialize SDL")
    }

    ready = true

    return
}

proc run() -> i32 {
    let event = sdl.Event()
    let running = true
    while running {
        while sdl.poll_event(^event) != 0 {
            if event.type == 0x100 { \ SDL_QUIT
                os.stdout.write("Quit event (").write(io.Hex<u32>(value: event.type)).write(')').end_line()
                running = false
            } else if event.type == 0x200 { \ SDL_WINDOWEVENT
                let window_event = (^event).as(^sdl.Window_Event)
                os.stdout.write("Window Event (").write(io.Hex<u32>(value: window_event.type)).write("): ").write(io.Hex<u8>(value: window_event.event)).end_line()
            } else if event.type == 0x300 { \ SDL_KEYDOWN
                let key_event = (^event).as(^sdl.Keyboard_Event)
                os.stdout.write("Key Down (").write(io.Hex<u32>(value: key_event.type)).write("): key=").write(io.Hex<u32>(value: key_event.key.scan_code)).end_line()
            } else if event.type == 0x301 { \ SDL_KEYUP
                let key_event = (^event).as(^sdl.Keyboard_Event)
                os.stdout.write("Key Up (").write(io.Hex<u32>(value: key_event.type)).write("): key=").write(io.Hex<u32>(value: key_event.key.scan_code)).end_line()
            } else if event.type == 0x400 { \ SDL_MOUSEMOTION
                let mouse_event = (^event).as(^sdl.Mouse_Motion_Event)
                os.stdout.write("Mouse Motion (").write(io.Hex<u32>(value: mouse_event.type)).write("): x=").write(mouse_event.x).write(", y=").write(mouse_event.y).end_line()
            } else if event.type == 0x401 { \ SDL_MOUSEBUTTONDOWN
                let mouse_button_event = (^event).as(^sdl.Mouse_Button_Event)
                os.stdout.write("Mouse Button Down (").write(io.Hex<u32>(value: mouse_button_event.type)).write("): button=").write(mouse_button_event.button).write(", state=").write(io.Hex<u8>(value: mouse_button_event.state)).end_line()
            } else if event.type == 0x402 { \ SDL_MOUSEBUTTONUP
                let mouse_button_event = (^event).as(^sdl.Mouse_Button_Event)
                os.stdout.write("Mouse Button Up (").write(io.Hex<u32>(value: mouse_button_event.type)).write("): button=").write(mouse_button_event.button).write(", state=").write(io.Hex<u8>(value: mouse_button_event.state)).end_line()
            } else if event.type == 0x403 { \ SDL_MOUSEWHEEL
                let mouse_wheel_event = (^event).as(^sdl.Mouse_Wheel_Event)
                os.stdout.write("Mouse Wheel (").write(io.Hex<u32>(value: mouse_wheel_event.type)).write("): x=").write(mouse_wheel_event.x).write(", y=").write(mouse_wheel_event.y).write(", direction=").write(io.Hex<u8>(value: mouse_wheel_event.direction)).end_line()
            } else {
                os.stdout.write("Unsupported event (").write(io.Hex<u32>(value: event.type)).write(')').end_line()
            }
        }
        \ Update the main window here if needed
    }

    sdl.quit()
    return 0
}

type Window = struct {
    sdl_window: ^sdl.Window
}

proc (^str).data(self) -> [^]u8 {
    return self.as(^String).data
}

proc create_window(title: str, width: i32, height: i32) -> ^Window !> errors.Error {
    if not ready {
        raise errors.Error(message: "GUI app was not initialized")
    }

    let sdl_window = sdl.create_window(title.data(), 0x2fff0001, 0x2fff0001, width, height, 0)
    if sdl_window == null {
        raise errors.Error(message: "Failed to create SDL window")
    }

    let window = alloc Window(sdl_window: sdl_window)
    windows.append(window)
    return window
}
