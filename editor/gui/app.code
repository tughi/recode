import errors

type App = trait {
    proc create_window(self, title: str, width: i32, height: i32) -> App_Window !> errors.Error
    proc init(self) !> errors.Error
    proc run(self) -> i32
}

type App_Window = trait {
    proc handle_event(self, anon event: Event)
    proc render(self)
    proc set_content(self, anon content: ^Widget)
}
