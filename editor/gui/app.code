import errors
import gui
import gui.sdl_renderer
import io
import os
import sdl

let ready = false
let first_window: ^Window
let last_window: ^Window

proc init() !> errors.Error {
    if ready {
        raise errors.Error(message: "GUI app was already initialized")
    }

    os.init()

    first_window = null
    last_window = null

    if sdl.init(0x20) != 0 {
        raise errors.Error(message: "Failed to initialize SDL")
    }

    ready = true

    return
}

proc run() -> i32 {
    let running = true
    while running {
        let window = first_window
        while window != null {
            // if window.must_draw {
            window.draw()
            // }
            window = window.next
        }

        let event: sdl.Event
        while sdl.poll_event(^event) != 0 {
            window = first_window
            while window != null {
                if window.sdl_window_id == event.window_id {
                    break
                }
                window = window.next
            }

            if event.type == 0x100 { // SDL_QUIT
                running = false
            } else if event.type == 0x200 { // SDL_WINDOWEVENT
                window.on_window_event((^event).as(^sdl.Window_Event))
            } else if event.type == 0x300 { // SDL_KEYDOWN
                window.on_key_down_event((^event).as(^sdl.Keyboard_Event))
            } else if event.type == 0x301 { // SDL_KEYUP
                window.on_key_up_event((^event).as(^sdl.Keyboard_Event))
            } else if event.type == 0x400 { // SDL_MOUSEMOTION
                window.on_mouse_motion_event((^event).as(^sdl.Mouse_Motion_Event))
            } else if event.type == 0x401 { // SDL_MOUSEBUTTONDOWN
                window.on_mouse_button_down_event((^event).as(^sdl.Mouse_Button_Event))
            } else if event.type == 0x402 { // SDL_MOUSEBUTTONUP
                window.on_mouse_button_up_event((^event).as(^sdl.Mouse_Button_Event))
            } else if event.type == 0x403 { // SDL_MOUSEWHEEL
                window.on_mouse_wheel_event((^event).as(^sdl.Mouse_Wheel_Event))
            } else {
                os.stdout.write("Unsupported event (").write_hex(event.type).write(')').end_line()
            }
        }
    }

    sdl.quit()
    return 0
}

type Window = struct {
    sdl_window: ^sdl.Window
    sdl_window_id: u32
    renderer: ^gui.Renderer
    widget: ^gui.Widget
    must_draw: bool
    next: ^Window
}

proc (^str).data(self) -> [^]u8 {
    return self.as(^String).data
}

proc create_window(title: str, width: i32, height: i32) -> ^Window !> errors.Error {
    if not ready {
        raise errors.Error(message: "GUI app was not initialized")
    }

    let sdl_window = sdl.create_window(title.data(), 0x2fff0001, 0x2fff0001, width, height, 0)
    if sdl_window == null {
        raise errors.Error(message: "Failed to create SDL window")
    }

    let sdl_window_id = sdl.get_window_id(sdl_window)
    if sdl_window_id == 0 {
        raise errors.Error(message: "Failed to get SDL window ID")
    }

    let sdl_renderer = sdl.create_renderer(sdl_window, -1, 0)
    if sdl_renderer == null {
        raise errors.Error(message: "Failed to create SDL renderer")
    }

    let window = alloc Window(
        sdl_window: sdl_window
        sdl_window_id: sdl_window_id
        renderer: alloc gui.Renderer(sdl_renderer)
        widget: null
        must_draw: true
        next: null
    )

    if first_window == null {
        first_window = window
    } else {
        last_window.next = window
    }
    last_window = window

    return window
}

proc (^Window).draw(self) {
    self.widget.draw(renderer: self.renderer)
    self.renderer.present()
}

proc (^Window).on_window_event(self, anon event: ^sdl.Window_Event) {
    os.stdout.write("Window Event (").write_hex(event.type).write("): ").write_hex(event.event).end_line()
}

proc (^Window).on_key_down_event(self, anon event: ^sdl.Keyboard_Event) {
    os.stdout.write("Key Down (").write_hex(event.type).write("): key=").write_hex(event.key.scan_code).end_line()
}

proc (^Window).on_key_up_event(self, anon event: ^sdl.Keyboard_Event) {
    os.stdout.write("Key Up (").write_hex(event.type).write("): key=").write_hex(event.key.scan_code).end_line()
}

proc (^Window).on_mouse_motion_event(self, anon sdl_event: ^sdl.Mouse_Motion_Event) {
    os.stdout.write("Mouse Motion (").write_hex(sdl_event.type).write("): x=").write(sdl_event.x).write(", y=").write(sdl_event.y).end_line()
    let gui_event: gui.Event = gui.MouseMotionEvent(x: sdl_event.x, y: sdl_event.y)
    self.widget.handle_event(^gui_event)
}

proc (^Window).on_mouse_button_down_event(self, anon event: ^sdl.Mouse_Button_Event) {
    os.stdout.write("Mouse Button Down (").write_hex(event.type).write("): x=").write(event.x).write(", y=").write(event.y).write(", button=").write_hex(event.button).end_line()
}

proc (^Window).on_mouse_button_up_event(self, anon event: ^sdl.Mouse_Button_Event) {
    os.stdout.write("Mouse Button Up (").write_hex(event.type).write("): x=").write(event.x).write(", y=").write(event.y).write(", button=").write_hex(event.button).end_line()
}

proc (^Window).on_mouse_wheel_event(self, anon event: ^sdl.Mouse_Wheel_Event) {
    os.stdout.write("Mouse Wheel (").write_hex(event.type).write("): x=").write(event.x).write(", y=").write(event.y).write(", direction=").write_hex(event.direction).end_line()
}
