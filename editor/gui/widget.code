import allocator

proc (^Builder).widget(gui, id: str) -> ^Widget !> allocator.Out_Of_Memory {
    let widget = gui.frame_allocator.alloc(size: type_size(Widget), alignment: type_alignment(Widget)).as(^Widget)
    widget.^ = Widget(
        id: id
        id_hash: gui.hash(id)
        behavior: widget
    )

    let shadow = gui.shadow_widget
    while shadow != null {
        if shadow.id_hash == widget.id_hash {
            widget.is_hovered = shadow.is_hovered
            widget.is_pressed = shadow.is_pressed
            widget.was_clicked = shadow.was_clicked
            break
        }
        shadow = shadow.next()
    }

    if gui.last_widget != null {
        gui.last_widget.next_sibling = widget
        widget.prev_sibling = gui.last_widget
    }
    gui.last_widget = widget
    if gui.parent_widget != null {
        if gui.parent_widget.first_child == null {
            gui.parent_widget.first_child = widget
        }
        widget.parent = gui.parent_widget
        widget.parent.last_child = widget
    }
    return widget
}

proc (^Builder).hash(self, anon string: str) -> u64 {
    let hash = string.hash()
    if self.parent_widget != null {
        hash = hash * self.parent_widget.id_hash
    }
    return hash
}

type Widget = struct {
    id: str
    id_hash: u64

    parent: ^Widget
    first_child: ^Widget
    last_child: ^Widget
    prev_sibling: ^Widget
    next_sibling: ^Widget

    bounds: Rect
    preferred_size: Size

    text: str
    text_size: Size

    is_hovered: bool
    is_pressed: bool
    was_clicked: bool

    behavior: Widget_Behavior
}

proc (^Widget).next(self) -> ^Widget {
    if self.first_child != null {
        return self.first_child
    }
    let widget = self
    while widget != null and widget.next_sibling == null {
        widget = widget.parent
    }
    if widget != null {
        return widget.next_sibling
    }
    return null.as(^Widget)
}

type Widget_Behavior = trait {
    // proc on_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event)
    // proc on_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event)
    // proc on_mouse_motion_event(self, anon event: Mouse_Motion_Event)
    // proc on_key_up_event(self, anon event: Key_Up_Event)
    proc on_layout(self, anon bounds: Rect)
    proc on_render(self, anon renderer: ^Renderer, anon window: ^Window)
}

