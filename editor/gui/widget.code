type Widget = struct {
    behavior: Widget_Behavior
    bounds: Rect
}

proc (^Widget).handle_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event) {
    self.behavior.on_mouse_button_down_event(event)
}

proc (^Widget).on_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event) {
    // Nothing to do
}

proc (^Widget).handle_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event) {
    self.behavior.on_mouse_button_up_event(event)
}

proc (^Widget).on_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event) {
    // Nothing to do
}

proc (^Widget).handle_mouse_motion_event(self, anon event: Mouse_Motion_Event) {
    self.behavior.on_mouse_motion_event(event)
}

proc (^Widget).on_mouse_motion_event(self, anon event: Mouse_Motion_Event) {
    if self.bounds.contains(x: event.x, y: event.y) {
        event.window.hovered_widget = self
    }
}

proc (^Widget).handle_key_up_event(self, anon event: Key_Up_Event) {
    self.behavior.on_key_up_event(event)
}

proc (^Widget).on_key_up_event(self, anon event: Key_Up_Event) {
    // Nothing to do
}

proc (^Widget).layout(self, anon bounds: Rect) {
    self.behavior.on_layout(bounds)
}

proc (^Widget).on_layout(self, anon bounds: Rect) {
    self.bounds = bounds
}

proc (^Widget).render(self, anon renderer: ^Renderer, anon window: ^Window) {
    self.behavior.on_render(renderer, window)
}

type Widget_Behavior = trait {
    proc on_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event)
    proc on_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event)
    proc on_mouse_motion_event(self, anon event: Mouse_Motion_Event)
    proc on_key_up_event(self, anon event: Key_Up_Event)
    proc on_layout(self, anon bounds: Rect)
    proc on_render(self, anon renderer: ^Renderer, anon window: ^Window)
}

