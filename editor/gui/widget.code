proc (^Widget).layout(self, anon bounds: Rect) {
    self.behavior.on_layout(bounds)
}

proc (^Widget).on_layout(self, anon bounds: Rect) {
    self.bounds = bounds
}

proc (^Widget).render(self, anon renderer: ^Renderer, anon window: ^Window) {
    self.was_clicked = false
    self.behavior.on_render(renderer, window)
}

proc (^Widget).on_render(self, anon renderer: ^Renderer, anon window: ^Window) {
}
