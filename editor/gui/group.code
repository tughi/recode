import allocator

type Group = struct {
    _: u8 // TODO: Allow empty structs
}

proc (^Group).layout(self, view: ^View) {
    // TODO: Layout logic for the group goes here
}

proc (^Group).render(self, view: ^View, renderer: ^Renderer) {
    let child = view.first_child
    while child != null {
        child.render(renderer: renderer)
        child = child.next_sibling
    }
}

proc (^Context).group(gui, id: str, layout_factory: Widget_Factory) -> ^View !> allocator.Out_Of_Memory {
    let widget = gui.use_widget(id, factory: layout_factory)

    let view = gui.view(id: id, widget: widget)
    gui.parent_view = view
    gui.last_view = null
    return view
}

proc (^Context).end_group(gui) {
    if gui.parent_view != null {
        let view = gui.parent_view
        gui.last_view = view
        gui.parent_view = view.parent
    }
}
