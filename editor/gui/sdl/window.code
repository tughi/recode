import gui
import sdl

type Window = struct {
    super: gui.Window
    sdl_window: ^sdl.Window
    sdl_window_id: u32
    must_draw: bool
    next_window: ^Window
}

proc (^Window).set_content(self, anon content: ^gui.Widget) {
    self.content = content
    let bounds = gui.Rect(left: 0, top: 0, right: self.width - 1, bottom: self.height - 1)
    content.layout(bounds)
    self.is_dirty = true
}
