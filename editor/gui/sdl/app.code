import errors
import os
import sdl

type App = struct {
    ready: bool
    first_window: ^Window
    last_window: ^Window
}

proc (^App).init(self) !> errors.Error {
    if self.ready {
        raise errors.Error(message: "GUI app was already initialized")
    }

    self.first_window = null
    self.last_window = null

    if sdl.init(sdl.INIT_VIDEO) != 0 {
        raise errors.Error(message: "Failed to initialize SDL")
    }

    self.ready = true

    return
}

proc (^App).run(self) -> i32 {
    let running = true
    while running {
        let window = self.first_window
        while window != null {
            if window.is_dirty {
                window.render()
            }
            window = window.next_window
        }

        let event: sdl.Event
        while sdl.poll_event(^event) != 0 {
            window = self.first_window
            while window != null {
                if window.sdl_window_id == event.window_id {
                    break
                }
                window = window.next_window
            }

            if event.type == sdl.EVENT_TYPE_QUIT {
                running = false
            } else if event.type == sdl.EVENT_TYPE_WINDOW {
                window.on_window_event((^event).as(^sdl.Window_Event))
            } else if event.type == sdl.EVENT_TYPE_KEY_DOWN {
                window.on_key_down_event((^event).as(^sdl.Keyboard_Event))
            } else if event.type == sdl.EVENT_TYPE_KEY_UP {
                window.on_key_up_event((^event).as(^sdl.Keyboard_Event))
            } else if event.type == sdl.EVENT_TYPE_MOUSE_MOTION {
                let mouse_motion_event = (^event).as(^sdl.Mouse_Motion_Event)
                window.handle_event(gui.Mouse_Motion_Event(
                    window: window
                    x: mouse_motion_event.x
                    y: mouse_motion_event.y
                ))
            } else if event.type == sdl.EVENT_TYPE_MOUSE_BUTTON_DOWN {
                window.on_mouse_button_down_event((^event).as(^sdl.Mouse_Button_Event))
            } else if event.type == sdl.EVENT_TYPE_MOUSE_BUTTON_UP {
                window.on_mouse_button_up_event((^event).as(^sdl.Mouse_Button_Event))
            } else if event.type == sdl.EVENT_TYPE_MOUSE_WHEEL {
                window.on_mouse_wheel_event((^event).as(^sdl.Mouse_Wheel_Event))
            } else {
                os.stdout.write("Unsupported event (").write_hex(event.type).write(')').end_line()
            }
        }
    }

    sdl.quit()
    return 0
}

proc (^str).data(self) -> [^]u8 {
    return self.as(^String).data
}

proc (^App).create_window(self, title: str, width: i32, height: i32) -> gui.App_Window !> errors.Error {
    if not self.ready {
        raise errors.Error(message: "GUI app was not initialized")
    }

    let sdl_window = sdl.create_window(title.data(), 0x2fff0001, 0x2fff0001, width, height, 0)
    if sdl_window == null {
        raise errors.Error(message: "Failed to create SDL window")
    }

    let sdl_window_id = sdl.get_window_id(sdl_window)
    if sdl_window_id == 0 {
        raise errors.Error(message: "Failed to get SDL window ID")
    }

    let sdl_renderer = sdl.create_renderer(sdl_window, -1, 0)
    if sdl_renderer == null {
        raise errors.Error(message: "Failed to create SDL renderer")
    }

    let window = alloc Window(
        super: gui.Window(
            width: width
            height: height
            renderer: sdl_renderer
            content: null
        )
        sdl_window: sdl_window
        sdl_window_id: sdl_window_id
        next_window: null
    )

    if self.first_window == null {
        self.first_window = window
    } else {
        self.last_window.next_window = window
    }
    self.last_window = window

    return window
}
