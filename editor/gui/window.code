import os

type Window = struct {
    width: i32
    height: i32
    renderer: Renderer
    content: Composer
    is_dirty: bool
}

proc (^Window).handle_mouse_button_down_event(self, anon event: Mouse_Button_Down_Event) {
    os.stderr.write("Mouse button down at (").write(event.x).write(", ").write(event.y).write(")").end_line()
}

proc (^Window).handle_mouse_button_up_event(self, anon event: Mouse_Button_Up_Event) {
    os.stderr.write("Mouse button up at (").write(event.x).write(", ").write(event.y).write(")").end_line()
}

proc (^Window).handle_mouse_motion_event(self, anon event: Mouse_Motion_Event) {
    os.stderr.write("Mouse motion at (").write(event.x).write(", ").write(event.y).write(")").end_line()
}

proc (^Window).handle_key_up_event(self, anon event: Key_Up_Event) {
    os.stderr.write("Key up: ").write(event.key_code).end_line()
}

proc (^Window).render(self) {
    self.renderer.set_draw_color(Color(red: 0x17, green: 0x17, blue: 0x17, alpha: 0xFF))
    self.renderer.clear()

    self.content.reset()

    let scene = try self.content.compose() else {
        os.stderr.write("Failed to compose content").end_line()
        os.exit(1)
    }

    scene.layout(bounds: Rect(x: 0, y: 0, width: self.width, height: self.height))

    scene.render(renderer: ^self.renderer)

    self.renderer.present()
    self.is_dirty = false
}
