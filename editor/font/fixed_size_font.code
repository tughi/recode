import allocator
import errors
import io
import os

let fixed_size: Fixed_Size_Font

type Fixed_Size_Font = struct {
    super: Font
}

proc (^Fixed_Size_Font).init(self) !> allocator.Out_Of_Memory {
    fixed_size = Fixed_Size_Font(
        super: Font(
            glyphs: allocator.alloc(size: (type_size(^Glyph)) * 256, alignment: type_alignment(^Glyph)).as([^]^Glyph)
            max_width: 7
            height: 15
            base_line: 12
            spacing: 2
        )
    )
    let index = 0usize
    while index < 256 {
        fixed_size.glyphs[index] = allocator.alloc(size: type_size(Glyph), alignment: type_alignment(Glyph)).as(^Glyph)
        fixed_size.glyphs[index].^ = Glyph(
            mask: null
            width: 7
            height: 15
        )
        index = index + 1
    }

    let helper: Fixed_Size_Font_Helper
    helper.init_glyphs()

    return
}

type Save_Fixed_Font_Error = variant {
    allocator.Out_Of_Memory
    errors.Error
}

proc (^Fixed_Size_Font).save(self) !> Save_Fixed_Font_Error {
    let file = try os.open_file("editor/font/fixed_size_font_glyphs.code", "w") else {
        raise error
    }

    let file_writer: io.Writer = file

    file_writer.write("import allocator").end_line()
    file_writer.end_line()
    file_writer.write("proc (^Fixed_Size_Font_Helper).init_glyphs(self) !> allocator.Out_Of_Memory {").end_line()

    let index = 0
    let needs_newline = false
    while index < 256 {
        let glyph = fixed_size.glyphs[index]
        if glyph.mask != null {
            if needs_newline {
                file_writer.end_line()
            }
            file_writer.write("    self.select(").write_hex(index).write(")").end_line()
            let row = 0
            while row < glyph.height {
                file_writer.write("    self.mask(\"")
                let col = 0
                while col < glyph.width {
                    if glyph.mask[row * glyph.width + col] == 0xFF {
                        file_writer.write("FF")
                    } else {
                        file_writer.write("  ")
                    }
                    col = col + 1
                }
                file_writer.write("\")").end_line()
                row = row + 1
            }
            needs_newline = true
        }
        index = index + 1
    }

    file_writer.end_line()
    file_writer.write("    return").end_line()
    file_writer.write("}").end_line()

    try file.close() else {
        raise error
    }

    return
}

type Fixed_Size_Font_Helper = struct {
    code_point: u8
    mask_index: i32
}

proc (^Fixed_Size_Font_Helper).select(self, anon code_point: u8) !> allocator.Out_Of_Memory {
    self.code_point = code_point
    self.mask_index = 0
    let glyph = fixed_size.glyphs[self.code_point]
    if glyph.mask == null {
        glyph.mask = allocator.alloc(size: type_size(u8) * (glyph.width * glyph.height).as(usize), alignment: type_alignment(u8)).as([^]u8)
    }
    return
}

proc (^Fixed_Size_Font_Helper).mask(self, anon mask_line: str) {
    let glyph = fixed_size.glyphs[self.code_point]
    let mask_line_data = mask_line.data()
    let index = 0usize
    while index < mask_line.length {
        if mask_line_data[index] == 'F' {
            glyph.mask[self.mask_index] = 0xFF
        } else {
            glyph.mask[self.mask_index] = 0x00
        }
        self.mask_index = self.mask_index + 1
        index = index + 2
    }
}
