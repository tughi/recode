type Window = external

proc create_window(anon title: [^]u8, anon x: i32, anon y: i32, anon w: i32, anon h: i32, anon flags: u32) -> ^Window = external "SDL_CreateWindow"

proc get_window_id(anon window: ^Window) -> u32 = external "SDL_GetWindowID"

proc destroy_window(anon window: ^Window) = external "SDL_DestroyWindow"
