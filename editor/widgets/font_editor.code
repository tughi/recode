import allocator
import errors
import gui
import os

proc create_font_editor() -> ^Font_Editor !> allocator.Out_Of_Memory {
    let font_editor = allocator.alloc(size: type_size(Font_Editor), alignment: type_alignment(Font_Editor)).as(^Font_Editor)
    font_editor.^ = Font_Editor()
    font_editor.behavior = font_editor
    return font_editor
}

type Font_Editor = struct {
    super: gui.Layout
    glyph_editor: ^Glyph_Editor
    save_button: ^gui.Button
    glyph_chooser: ^Glyph_Chooser
    preview_text_box: ^gui.Text_Box
}

proc (^Font_Editor).init(self) !> allocator.Out_Of_Memory {
    self.glyph_editor = create_glyph_editor()
    self.add_child(self.glyph_editor)

    let save_button_click_listener = allocator.alloc(size: type_size(Editor_Save_Action), alignment: type_alignment(Editor_Save_Action)).as(^Editor_Save_Action)
    save_button_click_listener.^ = Editor_Save_Action(editor: self)
    self.save_button = gui.create_button(label: "Save", click_listener: save_button_click_listener)
    self.add_child(self.save_button)

    let glyph_chooser_click_listener = allocator.alloc(size: type_size(Editor_Change_Glyph_Action), alignment: type_alignment(Editor_Change_Glyph_Action)).as(^Editor_Change_Glyph_Action)
    glyph_chooser_click_listener.^ = Editor_Change_Glyph_Action(editor: self)
    self.glyph_chooser = create_glyph_chooser(glyph_click_listener: glyph_chooser_click_listener)
    self.add_child(self.glyph_chooser)

    self.preview_text_box = gui.create_text_box(content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\nincididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis\nnostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\nDuis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu\nfugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in\nculpa qui officia deserunt mollit anim id est laborum.")
    self.add_child(self.preview_text_box)

    return
}

const MARGIN = 16
const BUTTON_HEIGHT = 32

proc (^Font_Editor).on_layout(self, anon bounds: gui.Rect) {
    self.super.on_layout(bounds)

    let child_bounds = gui.Rect(
        left: bounds.left + MARGIN
        top: bounds.top + MARGIN
        right: bounds.left + MARGIN + (MARGIN / 3 * 4 + 1) * self.glyph_editor.font.max_width
        bottom: bounds.top + MARGIN + (MARGIN / 3 * 4 + 1) * self.glyph_editor.font.height
    )
    self.glyph_editor.layout(child_bounds)

    child_bounds.set(
        left: child_bounds.left
        top: child_bounds.bottom + MARGIN
        right: child_bounds.right
        bottom: child_bounds.bottom + MARGIN + BUTTON_HEIGHT
    )
    self.save_button.layout(child_bounds)

    child_bounds.set(
        left: child_bounds.right + MARGIN
        top: bounds.top + MARGIN
        right: bounds.right - MARGIN
        bottom: bounds.top + MARGIN
    )
    self.glyph_chooser.layout(child_bounds)

    child_bounds.set(
        left: child_bounds.left
        top: self.glyph_chooser.bounds.bottom + MARGIN
        right: child_bounds.right
        bottom: bounds.bottom - MARGIN
    )
    self.preview_text_box.layout(child_bounds)
}

proc (^Font_Editor).on_key_up_event(self, anon event: gui.Key_Up_Event) {
    let key_code = event.key_code
    if key_code >= '!'.as(u32) and key_code <= '~'.as(u32) {
        self.glyph_editor.glyph = font.fixed_size.glyphs[key_code]
    }
    event.window.is_dirty = true
}

type Editor_Save_Action = struct {
    editor: ^Font_Editor
}

proc (^Editor_Save_Action).on_click(self, button: ^gui.Button) {
    try font.fixed_size.save() else {
        switch error {
            is allocator.Out_Of_Memory as save_error {
                os.stdout.write(save_error.message).end_line()
            }
            is errors.Error as save_error {
                os.stdout.write(save_error.message).end_line()
            }
            is nil {
                // ignored
            }
        }
    }
}

type Editor_Change_Glyph_Action = struct {
    editor: ^Font_Editor
}

proc (^Editor_Change_Glyph_Action).on_click(self, button: ^gui.Button) {
    self.editor.glyph_editor.glyph = font.fixed_size.glyphs[button.label.data()[0]]
}
