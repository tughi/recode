import errors
import gui
import string

type Glyph_Chooser = struct {
    super: gui.Layout
}

proc create_glyph_chooser(glyph_click_listener: gui.Button_Click_Listener) -> ^Glyph_Chooser !> errors.Error {
    let layout = alloc Glyph_Chooser()
    layout.behavior = layout

    let code_point = ' '
    while code_point <= '~' {
        let label_builder = string.make_builder_with_data_size(2)
        label_builder.write_char(code_point)
        let button = gui.create_button(label: label_builder.build(), click_listener: glyph_click_listener)
        layout.add_child(button)
        code_point = code_point + 1
    }

    return layout
}

proc (^Glyph_Chooser).on_layout(self, anon bounds: gui.Rect) {
    let child_index = 0usize
    let child_bounds = gui.Rect(
        left: bounds.left
        top: bounds.top
        right: bounds.left + BUTTON_HEIGHT
        bottom: bounds.top + BUTTON_HEIGHT
    )
    loop {
        self.children.items[child_index].layout(child_bounds)
        child_index = child_index + 1
        if child_index >= self.children.length {
            break
        }
        child_bounds.set_location(
            left: child_bounds.right + 1
            top: child_bounds.top
        )
        if child_bounds.right > bounds.right {
            child_bounds.set_location(
                left: bounds.left
                top: child_bounds.bottom + 1
            )
        }
    }

    // Update the bounds to fit all children
    self.super.on_layout(gui.Rect(
        left: bounds.left
        top: bounds.top
        right: bounds.right
        bottom: child_bounds.bottom
    ))
}
