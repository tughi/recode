import font
import gui
import libc

type Glyph_Editor = struct {
    super: gui.Widget
    mouse_button: u8
    hovered_column: i32
    hovered_row: i32
    glyph: ^font.Glyph
}

proc create_glyph_editor() -> ^Glyph_Editor {
    let glyph_editor = alloc Glyph_Editor(
        glyph: alloc font.Glyph(
            width: 9
            height: 18
            mask: libc.malloc(9 * 18).as([^]u8)
        )
    )
    glyph_editor.behavior = gui.Widget_Behavior(glyph_editor)
    return glyph_editor
}

proc (^Glyph_Editor).on_handle_event(self, event: gui.Event) {
    self.super.on_handle_event(event)

    switch event {
        is gui.Mouse_Motion_Event as mouse_move_event {
            self.on_mouse_action(mouse_x: mouse_move_event.x, mouse_y: mouse_move_event.y, window: mouse_move_event.window)
        }
        is gui.Mouse_Button_Down_Event as mouse_button_event {
            self.mouse_button = mouse_button_event.button
            self.on_mouse_action(mouse_x: mouse_button_event.x, mouse_y: mouse_button_event.y, window: mouse_button_event.window)
        }
        is gui.Mouse_Button_Up_Event as mouse_button_event {
            self.mouse_button = 0
            self.on_mouse_action(mouse_x: mouse_button_event.x, mouse_y: mouse_button_event.y, window: mouse_button_event.window)
        }
        else {
            // Do nothing
        }
    }
}

proc (^Glyph_Editor).on_mouse_action(self, mouse_x: i32, mouse_y: i32, window: ^gui.Window) {
    let pixels_bounds = gui.Rect(
        left: self.bounds.left + 1
        top: self.bounds.top + 1
        right: self.bounds.right - 1
        bottom: self.bounds.bottom - 1
    )
    if pixels_bounds.contains(x: mouse_x, y: mouse_y) {
        let old_column = self.hovered_column
        let old_row = self.hovered_row
        self.hovered_column = (mouse_x - self.bounds.left) / (GLYPH_EDITOR_PIXEL_SIZE + 1)
        self.hovered_row = (mouse_y - self.bounds.top) / (GLYPH_EDITOR_PIXEL_SIZE + 1)

        if self.mouse_button == 1 {
            let index = self.hovered_row * self.glyph.width + self.hovered_column
            if self.glyph.mask[index] == 0 {
                self.glyph.mask[index] = 255
                window.is_dirty = true
            }
        } else if self.mouse_button == 3 {
            let index = self.hovered_row * self.glyph.width + self.hovered_column
            if self.glyph.mask[index] != 0 {
                self.glyph.mask[index] = 0
                window.is_dirty = true
            }
        } else {
            window.is_dirty = old_column != self.hovered_column or old_row != self.hovered_row
        }
    }
}

proc (^Glyph_Editor).on_render(self, anon renderer: ^gui.Renderer, anon window: ^gui.Window) {
    // Draw the background

    renderer.set_draw_color(gui.Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_rect(self.bounds)

    let left = self.bounds.left + 1 + GLYPH_EDITOR_PIXEL_SIZE
    let top = self.bounds.top + 1
    let right = self.bounds.right - 1
    let bottom = self.bounds.bottom - 1
    while left < right {
        renderer.draw_line(x1: left, y1: top, x2: left, y2: bottom)
        left = left + GLYPH_EDITOR_PIXEL_SIZE + 1
    }

    left = self.bounds.left + 1
    top = self.bounds.top + 1 + GLYPH_EDITOR_PIXEL_SIZE
    right = self.bounds.right - 1
    bottom = self.bounds.bottom - 1
    while top < bottom {
        if top == self.bounds.top + (GLYPH_EDITOR_PIXEL_SIZE + 1) * 13 {
            renderer.set_draw_color(gui.Color(red: 0xff, green: 0, blue: 0, alpha: 255))
            renderer.draw_line(x1: left, y1: top, x2: right, y2: top)
            renderer.set_draw_color(gui.Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
        } else {
            renderer.draw_line(x1: left, y1: top, x2: right, y2: top)
        }
        top = top + GLYPH_EDITOR_PIXEL_SIZE + 1
    }

    // Draw the glyph

    renderer.set_draw_color(gui.Color(red: 0x7f, green: 0x7f, blue: 0x7f, alpha: 255))

    let index = 0
    while index < self.glyph.width * self.glyph.height {
        if self.glyph.mask[index] != 0 {
            let pixel_left = self.bounds.left + (index % self.glyph.width) * (GLYPH_EDITOR_PIXEL_SIZE + 1)
            let pixel_top = self.bounds.top + (index / self.glyph.width) * (GLYPH_EDITOR_PIXEL_SIZE + 1)
            renderer.fill_rect(gui.Rect(
                left: pixel_left + 1
                top: pixel_top + 1
                right: pixel_left + GLYPH_EDITOR_PIXEL_SIZE
                bottom: pixel_top + GLYPH_EDITOR_PIXEL_SIZE
            ))
        }
        index = index + 1
    }

    if window.hovered_widget == self {
        // Highlight the hovered pixel

        renderer.set_draw_color(gui.Color(red: 0xff, green: 0, blue: 0, alpha: 255))

        let pixel_left = self.bounds.left + (GLYPH_EDITOR_PIXEL_SIZE + 1) * self.hovered_column
        let pixel_top = self.bounds.top + (GLYPH_EDITOR_PIXEL_SIZE + 1) * self.hovered_row
        renderer.draw_rect(gui.Rect(
            left: pixel_left
            top: pixel_top
            right: pixel_left + GLYPH_EDITOR_PIXEL_SIZE + 1
            bottom: pixel_top + GLYPH_EDITOR_PIXEL_SIZE + 1
        ))
    }
}
