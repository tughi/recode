import allocator
import libc

type List<T> = struct {
    items: [^]T
    capacity: usize
    length: usize
}

// proc new<T>() -> ^List<T> {
//     let list = alloc List<T>()
//     list.init()
//     return list
// }

proc (^List<T>).init<T>(self) {
    self.items = null
    self.capacity = 0
    self.length = 0
}

proc (^List<T>).append<T>(self, anon item: T) !> allocator.Out_Of_Memory {
    if self.length >= self.capacity {
        let new_capacity = self.capacity + self.capacity / 2
        if new_capacity == 0 {
            new_capacity = 10
        }
        let item_size = type_size(T)
        let new_items = libc.realloc(self.items.as(^Any), new_capacity * item_size)
        if new_items == null {
            raise allocator.Out_Of_Memory(message: "Failed to allocate memory for list items")
        }
        self.items = new_items.as([^]T)
        self.capacity = new_capacity
    }
    self.items[self.length] = item
    self.length = self.length + 1
    return
}
