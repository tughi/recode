import allocator
import gui
import string

proc (^Builder).glyph_chooser(gui, id: str) -> ^gui.Widget !> allocator.Out_Of_Memory {
    let widget = gui.group(id: id)
    widget.behavior = widget.as(^Glyph_Chooser)
    defer gui.end_group()

    let old_selected_glyph = gui.state.selected_glyph
    let old_selected_glyph_widget: ^gui.Widget = null
    let new_selected_glyph_widget: ^gui.Widget = null

    let glyph = ' '
    while glyph <= '~' {
        let glyph_name_builder = string.make_builder_with_data_size(2)
        glyph_name_builder.write_char(glyph)
        let glyph_name = glyph_name_builder.build()
        let glyph_button = gui.button(id: glyph_name, label: glyph_name)
        if glyph_button.was_clicked {
            gui.state.selected_glyph = glyph
            new_selected_glyph_widget = glyph_button
        }
        if glyph == old_selected_glyph {
            old_selected_glyph_widget = glyph_button
        }
        glyph = glyph + 1
    }

    if old_selected_glyph_widget != null {
        if new_selected_glyph_widget != null and new_selected_glyph_widget != old_selected_glyph_widget {
            new_selected_glyph_widget.is_pressed = true
            old_selected_glyph_widget.is_pressed = false
        } else {
            old_selected_glyph_widget.is_pressed = true
        }
    }

    return widget
}

type Glyph_Chooser = struct {
    super: gui.Group
}

proc (^Glyph_Chooser).on_layout(self, anon bounds: gui.Rect) {
    let child = self.first_child
    let child_bounds = gui.Rect(
        left: bounds.left
        top: bounds.top
        right: bounds.left + child.preferred_size.width - 1
        bottom: bounds.top + child.preferred_size.height - 1
    )
    while child != null {
        child.layout(child_bounds)
        child_bounds.set_location(left: child_bounds.right + 1, top: child_bounds.top)
        if child_bounds.right > bounds.right {
            child_bounds.set_location(left: bounds.left, top: child_bounds.bottom + 1)
        }
        child = child.next_sibling
    }

    self.bounds = gui.Rect(
        left: bounds.left
        top: bounds.top
        right: bounds.right
        bottom: child_bounds.bottom
    )
}
