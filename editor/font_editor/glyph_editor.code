import allocator
import gui

proc (^Builder).glyph_editor(gui, id: str) -> ^gui.Widget !> allocator.Out_Of_Memory {
    let widget = gui.group(id: id)
    widget.behavior = widget.as(^Glyph_Editor)
    defer gui.end_group()

    let state = gui.state
    let glyph = state.selected_glyph

    return widget
}

type Glyph_Editor = struct {
    super: gui.Group
}

proc (^Glyph_Editor).on_render(self, anon renderer: ^gui.Renderer, anon window: ^gui.Window) {
    renderer.set_draw_color(gui.Color(red: 0x3f, green: 0x3f, blue: 0x3f, alpha: 255))
    renderer.draw_rect(self.bounds)
}
