import allocator
import errors
import font
import font_editor
import gui
import gui.sdl
import os

proc main() -> i32 {
    try allocator.default_allocator.reserve(size: 1024 * 1024) else { // 1MB
        os.stderr.write("Failed to reserve memory: ").write(error.message).end_line()
        return 1
    }

    os.init()

    try font.init() else {
        os.stderr.write("Failed to initialize the font: ").write(error.message).end_line()
        return 1
    }

    let app: gui.App = sdl.App()

    try app.init() else {
        os.stderr.write("Failed to initialize the app: ").write(error.message).end_line()
        return 1
    }

    let font_editor = font_editor.Font_Editor(
        selected_glyph: 65
    )
    try font_editor.views_allocator.reserve(size: 1024 * 16) else { // 16KB
        os.stderr.write("Failed to reserve memory for font editor views: ").write(error.message).end_line()
        return 1
    }

    let window = try app.create_window(title: "Editor", width: 1024, height: 768, content: font_editor) else {
        os.stderr.write("Failed to create the window: ").write(error.message).end_line()
        return 1
    }

    return app.run()
}
