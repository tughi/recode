import allocator
import errors
import font
import gui
import gui.sdl
import os
import widgets

proc main() -> i32 {
    try allocator.default_allocator.reserve(size: 1024 * 1024) else { // 1MB
        os.stderr.write("Failed to reserve memory: ").write(error.message).end_line()
        return 1
    }

    os.init()

    try font.init() else {
        os.stderr.write("Failed to initialize the font: ").write(error.message).end_line()
        return 1
    }

    let app: gui.App = sdl.App()

    try app.init() else {
        os.stderr.write("Failed to initialize the app: ").write(error.message).end_line()
        return 1
    }

    let window = try app.create_window(title: "Editor", width: 1024, height: 768) else {
        os.stderr.write("Failed to create the window: ").write(error.message).end_line()
        return 1
    }

    let font_editor = try widgets.create_font_editor() else {
        os.stderr.write("Failed to create the font editor: ").write(error.message).end_line()
        return 1
    }
    try font_editor.init() else {
        os.stderr.write("Failed to initialize the font editor layout: ").write(error.message).end_line()
        return 1
    }

    window.set_content(font_editor)

    return app.run()
}
