import errors
import font
import gui
import gui.sdl
import os
import widgets

proc main() -> i32 {
    os.init()

    font.init()

    let app: gui.App = sdl.App()

    try app.init() else {
        os.stderr.write_string("Failed to initialize app: ").write_string(error.message).end_line()
        return 1
    }

    let window = try app.create_window(title: "Editor", width: 1024, height: 768) else {
        os.stderr.write_string("Failed to create window: ").write_string(error.message).end_line()
        return 1
    }

    let font_editor = widgets.create_font_editor()
    try font_editor.init() else {
        os.stderr.write_string("Failed to initialize editor layout: ").write_string(error.message).end_line()
        return 1
    }

    window.set_content(font_editor)

    return app.run()
}
