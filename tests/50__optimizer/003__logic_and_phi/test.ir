$test.main(): i32 {
@1:
  %1: bool = const true
  %2: bool = const false
  %3: bool = call $test.both %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: i32 = const 0
  ret %5
}

$test.both(%a: bool, %b: bool): bool {
@1:
  br %a @2 @3
@2:
  jmp @3
@3:
  %1: bool = phi @1 %a @2 %b
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
