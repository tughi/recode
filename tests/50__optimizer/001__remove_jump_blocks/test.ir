$test.main(): i32 {
@1:
  %1: i32 = const 7
  %2: i32 = call $test.empty_arm %1
  %3: i32 = const 5
  %4: i32 = call $test.countdown %3
  %5: i32 = add %2 %4
  %6: i32 = call $test.trivial_loop
  %7: i32 = add %5 %6
  ret %7
}

$test.countdown(%n: i32): i32 {
@1:
  %i.ptr: [i32] = alloc i32
  store %i.ptr %n
  jmp @2
@2:
  %i.1: i32 = load %i.ptr
  %1: i32 = const 0
  %2: bool = cmp_le %i.1 %1
  br %2 @4 @5
@4:
  jmp @3
@5:
  %i.2: i32 = load %i.ptr
  %3: i32 = const 1
  %4: i32 = sub %i.2 %3
  store %i.ptr %4
  jmp @2
@3:
  %i.3: i32 = load %i.ptr
  ret %i.3
}

$test.empty_arm(%n: i32): i32 {
@1:
  %1: i32 = const 0
  %2: bool = cmp_gt %n %1
  br %2 @2 @3
@2:
  jmp @3
@3:
  ret %n
}

$test.trivial_loop(): i32 {
@1:
  jmp @2
@2:
  jmp @3
@3:
  %1: i32 = const 3
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
