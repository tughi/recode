type test.Point = struct {
  x: i32
  y: i32
}

$([test.Point]).get_x(%self): i32 {
@1:
  %1: [i32] = offset %self .x
  %2: i32 = load %1
  ret %2
}

$test.main(): i32 {
@1:
  %point.ptr: [test.Point] = alloc test.Point
  %1: i32 = const 42
  %2: i32 = const 0
  %3: test.Point = struct .x %1 .y %2
  store %point.ptr %3
  %get_point_x.ptr: [[proc ([test.Point]): i32]] = alloc [proc ([test.Point]): i32]
  store %get_point_x.ptr $([test.Point]).get_x
  %get_point_x.1: [proc ([test.Point]): i32] = load %get_point_x.ptr
  %4: i32 = call %get_point_x.1 %point.ptr
  %5: i32 = const 42
  %6: i32 = sub %4 %5
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
