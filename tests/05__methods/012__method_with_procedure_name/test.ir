type test.Number = struct {
  value: i32
}

$([test.Number]).get(%self, %value: i32): i32 {
@1:
  %1: [i32] = offset %self .value
  %2: i32 = load %1
  %3: i32 = add %2 %value
  ret %3
}

$test.get(%value: i32): i32 {
@1:
  ret %value
}

$test.main(): i32 {
@1:
  %number.ptr: [test.Number] = alloc test.Number
  %1: i32 = const 2
  %2: test.Number = struct .value %1
  store %number.ptr %2
  %3: i32 = const 40
  %4: i32 = call $test.get %3
  %5: i32 = const 2
  %6: i32 = call $([test.Number]).get %number.ptr %5
  %7: i32 = add %4 %6
  %8: i32 = const 44
  %9: i32 = sub %7 %8
  ret %9
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
