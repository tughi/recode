type test.Point = struct {
  x: i32
  y: i32
}

$(test.Point).get_x(%self): i32 {
@1:
  %1.ptr: [test.Point] = alloc test.Point
  store %1.ptr %self
  %2: [i32] = offset %1.ptr .x
  %3: i32 = load %2
  ret %3
}

$test.main(): i32 {
@1:
  %point.ptr: [test.Point] = alloc test.Point
  %1: i32 = const 42
  %2: test.Point = struct .x %1
  store %point.ptr %2
  %get_point_x.ptr: [[proc (test.Point): i32]] = alloc [proc (test.Point): i32]
  store %get_point_x.ptr $(test.Point).get_x
  %get_point_x.1: [proc (test.Point): i32] = load %get_point_x.ptr
  %point.1: test.Point = load %point.ptr
  %3: i32 = call %get_point_x.1 %point.1
  %4: i32 = const 42
  %5: i32 = sub %3 %4
  ret %5
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
