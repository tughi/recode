$(i32).get_value(%self): i32 {
@1:
  ret %self
}

$test.main(): i32 {
@1:
  %f.ptr: [[proc (i32): i32]] = alloc [proc (i32): i32]
  store %f.ptr $(i32).get_value
  %f.1: [proc (i32): i32] = load %f.ptr
  %1: i32 = const 42
  %2: i32 = call %f.1 %1
  %3: i32 = const 42
  %4: i32 = sub %2 %3
  ret %4
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
