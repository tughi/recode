proc main() -> i32 {
    stdout.write(char: '4').write(char: '2').write(char: '\n')
    return 0
}

proc (^FILE).write(self, char ch: u8) -> ^FILE {
    fputc(ch.as(i32), stdout)
    return self
}

type FILE = external
let stdout: ^FILE = external "__stdoutp"
proc fputc(anon c: i32, anon stream: ^FILE) -> i32 = external
