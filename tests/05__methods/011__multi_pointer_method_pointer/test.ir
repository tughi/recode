$([*]i32).first(%self): i32 {
@1:
  %1: i32 = const 0
  %2: [i32] = offset %self %1
  %3: i32 = load %2
  ret %3
}

$test.main(): i32 {
@1:
  %forty_two.ptr: [i32] = alloc i32
  %1: i32 = const 42
  store %forty_two.ptr %1
  %multi_pointer.ptr: [[*]i32] = alloc [*]i32
  %2: [*]i32 = cast %forty_two.ptr
  store %multi_pointer.ptr %2
  %get_first_i32.ptr: [[proc ([*]i32): i32]] = alloc [proc ([*]i32): i32]
  store %get_first_i32.ptr $([*]i32).first
  %get_first_i32.1: [proc ([*]i32): i32] = load %get_first_i32.ptr
  %multi_pointer.1: [*]i32 = load %multi_pointer.ptr
  %3: i32 = call %get_first_i32.1 %multi_pointer.1
  %4: i32 = const 42
  %5: i32 = sub %3 %4
  ret %5
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
