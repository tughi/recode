$([*]u8).length(%self): i32 {
@1:
  %length.ptr: [i32] = alloc i32
  %1: i32 = const 0
  store %length.ptr %1
  jmp @2
@2:
  %length.1: i32 = load %length.ptr
  %2: [u8] = offset %self %length.1
  %3: u8 = load %2
  %4: u8 = const 0
  %5: bool = cmp_ne %3 %4
  br %5 @3 @4
@3:
  %length.2: i32 = load %length.ptr
  %6: i32 = const 1
  %7: i32 = add %length.2 %6
  store %length.ptr %7
  jmp @2
@4:
  %length.3: i32 = load %length.ptr
  ret %length.3
}

$test.main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = const 2
  %2: bool = cmp_ne %argc %1
  br %2 @2 @3
@2:
  %3: i32 = const 1
  ret %3
@3:
  %4: i32 = const 1
  %5: [[*]u8] = offset %argv %4
  %6: [*]u8 = load %5
  %7: i32 = call $([*]u8).length %6
  %8: i32 = const 4
  %9: bool = cmp_ne %7 %8
  br %9 @4 @5
@4:
  %10: i32 = const 2
  ret %10
@5:
  %11: i32 = const 0
  ret %11
}

$main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = call $test.main %argc %argv
  ret %1
}
