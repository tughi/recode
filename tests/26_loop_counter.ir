; exit: 5

; mutable loop counter via alloc

$main(): i32 {
@1:
  %counter.ptr: [i32] = alloc i32
  %0: i32 = const 0
  store %counter.ptr %0
  jmp @2
@2:
  %counter.0: i32 = load %counter.ptr
  %1: i32 = const 5
  %2: bool = cmp_ge %counter.0 %1
  br %2 @4 @3
@3:
  %3: i32 = const 1
  %counter.1: i32 = add %counter.0 %3
  store %counter.ptr %counter.1
  jmp @2
@4:
  %counter: i32 = load %counter.ptr
  ret %counter
}
