$test.main(): i32 {
@1:
  %d.ptr: [i32] = alloc i32
  %1: i32 = const 2
  store %d.ptr %1
  %d.1: i32 = load %d.ptr
  %2: i32 = const 2
  %3: bool = cmp_eq %d.1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 0
  ret %4
@3:
  %5: i32 = const 1
  ret %5
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
