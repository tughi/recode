type String = struct {
  data: [*]u8
  length: usize
}

$str_1: [*]u8 = "Up"

$str_2: [*]u8 = "Down"

$test.main(): i32 {
@1:
  %d.ptr: [i32] = alloc i32
  %1: i32 = const 1
  store %d.ptr %1
  %d.1: i32 = load %d.ptr
  %2: String = call $test.Direction.name %d.1
  %3.ptr: [String] = alloc String
  store %3.ptr %2
  %4: [usize] = offset %3.ptr .length
  %5: usize = load %4
  %6: usize = const 4
  %7: bool = cmp_ne %5 %6
  br %7 @2 @3
@2:
  %8: i32 = const 1
  ret %8
@3:
  %9: i32 = const 0
  %10: String = call $test.Direction.name %9
  %11.ptr: [String] = alloc String
  store %11.ptr %10
  %12: [usize] = offset %11.ptr .length
  %13: usize = load %12
  %14: usize = const 2
  %15: bool = cmp_ne %13 %14
  br %15 @4 @5
@4:
  %16: i32 = const 2
  ret %16
@5:
  %17: i32 = const 0
  ret %17
}

$test.Direction.name(%value: i32): String {
@1:
  brx %value @3 @4 @2
@3:
  %1: usize = const 2
  %2: String = struct .data $str_1 .length %1
  ret %2
@4:
  %3: usize = const 4
  %4: String = struct .data $str_2 .length %3
  ret %4
@2:
  %5: [*]u8 = const null
  %6: usize = const 0
  %7: String = struct .data %5 .length %6
  ret %7
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
