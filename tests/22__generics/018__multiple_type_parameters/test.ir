type String = struct {
  data: [*]u8
  length: usize
}

type test.Pair<String, i32> = struct {
  key: String
  value: i32
}

type test.Pair<i32, String> = struct {
  key: i32
  value: String
}

$str_1: [*]u8 = "answer"

$test.main(): i32 {
@1:
  %pair.ptr: [test.Pair<String, i32>] = alloc test.Pair<String, i32>
  %1: usize = const 6
  %2: String = struct .data $str_1 .length %1
  %3: i32 = const 42
  %4: test.Pair<String, i32> = struct .key %2 .value %3
  store %pair.ptr %4
  %swapped.ptr: [test.Pair<i32, String>] = alloc test.Pair<i32, String>
  %5: [i32] = offset %pair.ptr .value
  %6: i32 = load %5
  %7: [String] = offset %pair.ptr .key
  %8: String = load %7
  %9: test.Pair<i32, String> = struct .key %6 .value %8
  store %swapped.ptr %9
  %10: [i32] = offset %swapped.ptr .key
  %11: i32 = load %10
  %12: i32 = const 42
  %13: i32 = sub %11 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
