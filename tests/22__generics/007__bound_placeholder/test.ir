$test.pair<u8>(%a: u8, %b: u8): u8 {
@1:
  %1: u8 = add %a %b
  ret %1
}

$test.main(): i32 {
@1:
  %1: u8 = const 40
  %2: u8 = const 2
  %3: u8 = call $test.pair<u8> %1 %2
  %4: i32 = cast %3
  %5: i32 = const 42
  %6: i32 = sub %4 %5
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
