type test.Box<i32> = struct {
  value: i32
}

type test.Box<test.Box<i32>> = struct {
  value: test.Box<i32>
}

$test.unwrap<test.Box<i32>>(%box: test.Box<test.Box<i32>>): test.Box<i32> {
@1:
  %1.ptr: [test.Box<test.Box<i32>>] = alloc test.Box<test.Box<i32>>
  store %1.ptr %box
  %2: [test.Box<i32>] = offset %1.ptr .value
  %3: test.Box<i32> = load %2
  ret %3
}

$test.unwrap<i32>(%box: test.Box<i32>): i32 {
@1:
  %1.ptr: [test.Box<i32>] = alloc test.Box<i32>
  store %1.ptr %box
  %2: [i32] = offset %1.ptr .value
  %3: i32 = load %2
  ret %3
}

$test.main(): i32 {
@1:
  %box.ptr: [test.Box<test.Box<i32>>] = alloc test.Box<test.Box<i32>>
  %1: i32 = const 42
  %2: test.Box<i32> = struct .value %1
  %3: test.Box<test.Box<i32>> = struct .value %2
  store %box.ptr %3
  %box.1: test.Box<test.Box<i32>> = load %box.ptr
  %4: test.Box<i32> = call $test.unwrap<test.Box<i32>> %box.1
  %5: i32 = call $test.unwrap<i32> %4
  %6: i32 = const 42
  %7: i32 = sub %5 %6
  ret %7
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
