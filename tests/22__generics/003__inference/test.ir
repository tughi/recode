type test.Foo = struct {
  value: i32
}

$test.identity<i32>(%value: i32): i32 {
@1:
  ret %value
}

$test.wrap<test.Foo>(%value: test.Foo): test.Foo {
@1:
  ret %value
}

$test.main(): i32 {
@1:
  %foo.ptr: [test.Foo] = alloc test.Foo
  %1: i32 = const 42
  %2: test.Foo = struct .value %1
  %3: test.Foo = call $test.wrap<test.Foo> %2
  store %foo.ptr %3
  %4: [i32] = offset %foo.ptr .value
  %5: i32 = load %4
  %6: i32 = call $test.identity<i32> %5
  %7: i32 = const 42
  %8: i32 = sub %6 %7
  ret %8
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
