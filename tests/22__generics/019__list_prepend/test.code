proc malloc(size: usize) -> ^Any = external

type List<T> = struct {
    first: ^Item<T>
}

type Item<T> = struct {
    data: T
    next: ^Item<T>
}

proc (^List<T>).prepend<T>(self, data: T) {
    let item = malloc(type_size(Item<T>)).as(^Item<T>)
    item.^ = Item<T>(data: data, next: self.first)
    self.first = item
}

proc main() -> i32 {
    let list = List<i32>(first: null)
    list.prepend(40)
    list.prepend(2)
    return list.first.data + list.first.next.data - 42
}
