type test.List<i32> = struct {
  first: [test.Item<i32>]
}

type test.Item<i32> = struct {
  data: i32
  next: [test.Item<i32>]
}

$malloc: [proc (usize): [Any]] = external

$([test.List<i32>]).prepend<i32>(%self, %data: i32) {
@1:
  %item.ptr: [[test.Item<i32>]] = alloc [test.Item<i32>]
  %1: usize = const 16
  %2: [Any] = call $malloc %1
  %3: [test.Item<i32>] = cast %2
  store %item.ptr %3
  %item.1: [test.Item<i32>] = load %item.ptr
  %4: [[test.Item<i32>]] = offset %self .first
  %5: [test.Item<i32>] = load %4
  %6: test.Item<i32> = struct .data %data .next %5
  store %item.1 %6
  %7: [[test.Item<i32>]] = offset %self .first
  %item.2: [test.Item<i32>] = load %item.ptr
  store %7 %item.2
  ret
}

$test.main(): i32 {
@1:
  %list.ptr: [test.List<i32>] = alloc test.List<i32>
  %1: [test.Item<i32>] = const null
  %2: test.List<i32> = struct .first %1
  store %list.ptr %2
  %3: i32 = const 40
  call $([test.List<i32>]).prepend<i32> %list.ptr %3
  %4: i32 = const 2
  call $([test.List<i32>]).prepend<i32> %list.ptr %4
  %5: [[test.Item<i32>]] = offset %list.ptr .first
  %6: [test.Item<i32>] = load %5
  %7: [i32] = offset %6 .data
  %8: i32 = load %7
  %9: [[test.Item<i32>]] = offset %list.ptr .first
  %10: [test.Item<i32>] = load %9
  %11: [[test.Item<i32>]] = offset %10 .next
  %12: [test.Item<i32>] = load %11
  %13: [i32] = offset %12 .data
  %14: i32 = load %13
  %15: i32 = add %8 %14
  %16: i32 = const 42
  %17: i32 = sub %15 %16
  ret %17
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
