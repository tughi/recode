type test.Box = struct {
  value: i32
}

$([test.Box]).put<i32>(%self, %item: i32): i32 {
@1:
  %1: [i32] = offset %self .value
  %2: [i32] = offset %self .value
  %3: i32 = load %2
  %4: i32 = const 1
  %5: i32 = add %3 %4
  store %1 %5
  ret %item
}

$test.deref<i32>(%pointer: [i32]): i32 {
@1:
  %1: i32 = load %pointer
  ret %1
}

$test.main(): i32 {
@1:
  %box.ptr: [test.Box] = alloc test.Box
  %1: i32 = const 0
  %2: test.Box = struct .value %1
  store %box.ptr %2
  %3: i32 = const 7
  %4: i32 = call $([test.Box]).put<i32> %box.ptr %3
  %value.ptr: [i32] = alloc i32
  %5: i32 = const 5
  store %value.ptr %5
  %6: i32 = call $test.deref<i32> %value.ptr
  %7: [i32] = offset %box.ptr .value
  %8: i32 = load %7
  %9: i32 = add %6 %8
  %10: i32 = const 6
  %11: i32 = sub %9 %10
  ret %11
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
