type Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %point.ptr: [Point] = alloc Point
  %1: i32 = const 16
  %2: i32 = const 32
  %3: Point = struct Point .x %1 .y %2
  store %point.ptr %3
  %4: [i32] = offset %point.ptr Point.x
  %5: i32 = load %4
  %6: i32 = const 16
  %7: i32 = sub %5 %6
  ret %7
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
