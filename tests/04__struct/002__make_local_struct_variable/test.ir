type test.Line = struct {
  p1: test.Point
  p2: test.Point
}

type test.Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %line.ptr: [test.Line] = alloc test.Line
  %1: i32 = const 16
  %2: i32 = const 32
  %3: test.Point = struct test.Point .x %1 .y %2
  %4: i32 = const 48
  %5: i32 = const 64
  %6: test.Point = struct test.Point .x %4 .y %5
  %7: test.Line = struct test.Line .p1 %3 .p2 %6
  store %line.ptr %7
  %8: i32 = const 0
  ret %8
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
