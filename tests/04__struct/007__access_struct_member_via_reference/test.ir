type Line = struct {
  p1: Point
  p2: Point
}

type Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %line.ptr: [Line] = alloc Line
  %1: i32 = const 16
  %2: i32 = const 32
  %3: Point = struct Point .x %1 .y %2
  %4: i32 = const 48
  %5: i32 = const 64
  %6: Point = struct Point .x %4 .y %5
  %7: Line = struct Line .p1 %3 .p2 %6
  store %line.ptr %7
  %line_reference.ptr: [[Line]] = alloc [Line]
  store %line_reference.ptr %line.ptr
  %line_reference.1: [Line] = load %line_reference.ptr
  %8: [Point] = offset %line_reference.1 Line.p2
  %9: [i32] = offset %8 Point.y
  %10: i32 = load %9
  %11: i32 = const 64
  %12: i32 = sub %10 %11
  ret %12
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
