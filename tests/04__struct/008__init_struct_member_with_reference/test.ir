type test.Number = struct {
  value: i32
  next: [test.Number]
}

$test.main(): i32 {
@1:
  %third.ptr: [test.Number] = alloc test.Number
  %1: i32 = const 43
  %2: test.Number = struct test.Number .value %1
  store %third.ptr %2
  %second.ptr: [test.Number] = alloc test.Number
  %3: i32 = const 42
  %4: test.Number = struct test.Number .value %3 .next %third.ptr
  store %second.ptr %4
  %first.ptr: [test.Number] = alloc test.Number
  %5: i32 = const 41
  %6: test.Number = struct test.Number .value %5 .next %second.ptr
  store %first.ptr %6
  %second_value.ptr: [i32] = alloc i32
  %7: [[test.Number]] = offset %first.ptr test.Number.next
  %8: [test.Number] = load %7
  %9: [i32] = offset %8 test.Number.value
  %10: i32 = load %9
  store %second_value.ptr %10
  %second_value_ref.ptr: [[i32]] = alloc [i32]
  %11: [[test.Number]] = offset %first.ptr test.Number.next
  %12: [test.Number] = load %11
  %13: [i32] = offset %12 test.Number.value
  store %second_value_ref.ptr %13
  %second_value.1: i32 = load %second_value.ptr
  %14: i32 = const 42
  %15: bool = cmp_ne %second_value.1 %14
  br %15 @2 @3
@2:
  %16: i32 = const 1
  ret %16
@3:
  %second_value_ref.1: [i32] = load %second_value_ref.ptr
  %17: i32 = load %second_value_ref.1
  %18: i32 = const 42
  %19: bool = cmp_ne %17 %18
  br %19 @4 @5
@4:
  %20: i32 = const 2
  ret %20
@5:
  %21: i32 = const 0
  ret %21
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
