type test.Number = struct {
  value: i32
  next: [test.Number]
}

$test.main(): i32 {
@1:
  %third.ptr: [test.Number] = alloc test.Number
  %1: i32 = const 43
  %2: [test.Number] = const null
  %3: test.Number = struct .value %1 .next %2
  store %third.ptr %3
  %second.ptr: [test.Number] = alloc test.Number
  %4: i32 = const 42
  %5: test.Number = struct .value %4 .next %third.ptr
  store %second.ptr %5
  %first.ptr: [test.Number] = alloc test.Number
  %6: i32 = const 41
  %7: test.Number = struct .value %6 .next %second.ptr
  store %first.ptr %7
  %second_value.ptr: [i32] = alloc i32
  %8: [[test.Number]] = offset %first.ptr .next
  %9: [test.Number] = load %8
  %10: [i32] = offset %9 .value
  %11: i32 = load %10
  store %second_value.ptr %11
  %second_value_ref.ptr: [[i32]] = alloc [i32]
  %12: [[test.Number]] = offset %first.ptr .next
  %13: [test.Number] = load %12
  %14: [i32] = offset %13 .value
  store %second_value_ref.ptr %14
  %second_value.1: i32 = load %second_value.ptr
  %15: i32 = const 42
  %16: bool = cmp_ne %second_value.1 %15
  br %16 @2 @3
@2:
  %17: i32 = const 1
  ret %17
@3:
  %second_value_ref.1: [i32] = load %second_value_ref.ptr
  %18: i32 = load %second_value_ref.1
  %19: i32 = const 42
  %20: bool = cmp_ne %18 %19
  br %20 @4 @5
@4:
  %21: i32 = const 2
  ret %21
@5:
  %22: i32 = const 0
  ret %22
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
