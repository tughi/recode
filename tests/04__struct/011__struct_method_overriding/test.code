package test

struct Number {
    value: i32
}

proc ^Number.get_value(self) -> i32 {
    return self.value
}

proc ^Number.set_value(self, anon value: i32) {
    self.value = value
}

struct Boolean {
    value: bool
}

proc ^Boolean.get_value(self) -> bool {
    return self.value
}

proc main() -> i32 {
    let number = Number(value: 0)

    number.set_value(42)

    return number.get_value() - 42
}
