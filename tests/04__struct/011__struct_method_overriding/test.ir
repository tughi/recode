type test.Number = struct {
  value: i32
}

type test.Boolean = struct {
  value: bool
}

$([test.Number]).get_value(%self): i32 {
@1:
  %1: [i32] = offset %self test.Number.value
  %2: i32 = load %1
  ret %2
}

$([test.Number]).set_value+anon(%self, %value: i32) {
@1:
  %1: [i32] = offset %self test.Number.value
  store %1 %value
  ret
}

$([test.Boolean]).get_value(%self): bool {
@1:
  %1: [bool] = offset %self test.Boolean.value
  %2: bool = load %1
  ret %2
}

$test.main(): i32 {
@1:
  %number.ptr: [test.Number] = alloc test.Number
  %1: i32 = const 0
  %2: test.Number = struct test.Number .value %1
  store %number.ptr %2
  %3: i32 = const 42
  call $([test.Number]).set_value+anon %number.ptr %3
  %4: i32 = call $([test.Number]).get_value %number.ptr
  %5: i32 = const 42
  %6: i32 = sub %4 %5
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
