package test

struct Point {
    x: i32
    y: i32
}

struct Line {
    p1: Point
    p2: Point
}

proc main() -> i32 {
    let line = alloc Line(
        p1: Point(x: 16, y: 32)
        p2: Point(x: 48, y: 64)
    )
    return line.p1.x + line.p1.y + line.p2.x + line.p2.y - 160
}

proc malloc(anon size: u64) -> ^Any = external
