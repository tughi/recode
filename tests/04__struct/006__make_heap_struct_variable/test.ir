type Line = struct {
  p1: Point
  p2: Point
}

type Point = struct {
  x: i32
  y: i32
}

$malloc: [proc (usize): [Any]] = external

$test.main(): i32 {
@1:
  %line.ptr: [[Line]] = alloc [Line]
  %1: usize = const 16
  %2: [Any] = call $malloc %1
  %3: [Line] = cast %2
  %4: i32 = const 16
  %5: i32 = const 32
  %6: Point = struct Point .x %4 .y %5
  %7: i32 = const 48
  %8: i32 = const 64
  %9: Point = struct Point .x %7 .y %8
  %10: Line = struct Line .p1 %6 .p2 %9
  store %3 %10
  store %line.ptr %3
  %line.1: [Line] = load %line.ptr
  %11: [Point] = offset %line.1 Line.p1
  %12: [i32] = offset %11 Point.x
  %13: i32 = load %12
  %line.2: [Line] = load %line.ptr
  %14: [Point] = offset %line.2 Line.p1
  %15: [i32] = offset %14 Point.y
  %16: i32 = load %15
  %17: i32 = add %13 %16
  %line.3: [Line] = load %line.ptr
  %18: [Point] = offset %line.3 Line.p2
  %19: [i32] = offset %18 Point.x
  %20: i32 = load %19
  %21: i32 = add %17 %20
  %line.4: [Line] = load %line.ptr
  %22: [Point] = offset %line.4 Line.p2
  %23: [i32] = offset %22 Point.y
  %24: i32 = load %23
  %25: i32 = add %21 %24
  %26: i32 = const 160
  %27: i32 = sub %25 %26
  ret %27
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
