type test.Line = struct {
  p1: test.Point
  p2: test.Point
}

type test.Point = struct {
  x: i32
  y: i32
}

$malloc: [proc (usize): [Any]] = external

$test.main(): i32 {
@1:
  %line.ptr: [[test.Line]] = alloc [test.Line]
  %1: usize = const 16
  %2: [Any] = call $malloc %1
  %3: [test.Line] = cast %2
  %4: i32 = const 16
  %5: i32 = const 32
  %6: test.Point = struct .x %4 .y %5
  %7: i32 = const 48
  %8: i32 = const 64
  %9: test.Point = struct .x %7 .y %8
  %10: test.Line = struct .p1 %6 .p2 %9
  store %3 %10
  store %line.ptr %3
  %line.1: [test.Line] = load %line.ptr
  %11: [test.Point] = offset %line.1 .p1
  %12: [i32] = offset %11 .x
  %13: i32 = load %12
  %line.2: [test.Line] = load %line.ptr
  %14: [test.Point] = offset %line.2 .p1
  %15: [i32] = offset %14 .y
  %16: i32 = load %15
  %17: i32 = add %13 %16
  %line.3: [test.Line] = load %line.ptr
  %18: [test.Point] = offset %line.3 .p2
  %19: [i32] = offset %18 .x
  %20: i32 = load %19
  %21: i32 = add %17 %20
  %line.4: [test.Line] = load %line.ptr
  %22: [test.Point] = offset %line.4 .p2
  %23: [i32] = offset %22 .y
  %24: i32 = load %23
  %25: i32 = add %21 %24
  %26: i32 = const 160
  %27: i32 = sub %25 %26
  ret %27
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
