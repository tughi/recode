type test.Function = struct {
  run: [proc (): i32]
}

$test.forty_two(): i32 {
@1:
  %1: i32 = const 42
  ret %1
}

$test.main(): i32 {
@1:
  %procedure.ptr: [test.Function] = alloc test.Function
  %1: test.Function = struct test.Function .run $test.forty_two
  store %procedure.ptr %1
  %2: [[proc (): i32]] = offset %procedure.ptr test.Function.run
  %3: [proc (): i32] = load %2
  %4: i32 = call %3
  %5: i32 = const 42
  %6: i32 = sub %4 %5
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
