$test.main(): i32 {
@1:
  %d.ptr: [i32] = alloc i32
  %1: i32 = const 1
  store %d.ptr %1
  %result.ptr: [i32] = alloc i32
  %2: i32 = const 0
  store %result.ptr %2
  %d.1: i32 = load %d.ptr
  %3: i32 = const 0
  %4: bool = cmp_eq %d.1 %3
  br %4 @3 @4
@3:
  jmp @2
@4:
  %5: i32 = const 1
  %6: bool = cmp_eq %d.1 %5
  br %6 @5 @6
@5:
  %7: i32 = const 1
  store %result.ptr %7
  jmp @2
@6:
  %8: i32 = const 2
  %9: bool = cmp_eq %d.1 %8
  br %9 @7 @8
@8:
  %10: i32 = const 3
  %11: bool = cmp_eq %d.1 %10
  br %11 @7 @9
@7:
  %12: i32 = const 2
  store %result.ptr %12
  jmp @2
@9:
  jmp @2
@2:
  %result.1: i32 = load %result.ptr
  %13: i32 = const 1
  %14: i32 = sub %result.1 %13
  ret %14
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
