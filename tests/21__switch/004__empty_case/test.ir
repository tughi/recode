$test.main(): i32 {
@1:
  %d.ptr: [i32] = alloc i32
  %1: i32 = const 1
  store %d.ptr %1
  %result.ptr: [i32] = alloc i32
  %2: i32 = const 0
  store %result.ptr %2
  %d.1: i32 = load %d.ptr
  brx %d.1 @3 @4 @5 @5 @2
@3:
  jmp @2
@4:
  %3: i32 = const 1
  store %result.ptr %3
  jmp @2
@5:
  %4: i32 = const 2
  store %result.ptr %4
  jmp @2
@2:
  %result.1: i32 = load %result.ptr
  %5: i32 = const 1
  %6: i32 = sub %result.1 %5
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
