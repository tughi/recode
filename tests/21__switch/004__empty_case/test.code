type Direction = enum {
    NORTH
    EAST
    SOUTH
    WEST
}

proc main() -> i32 {
    let d = Direction.EAST
    let result = 0
    switch d {
        case .NORTH {
        }
        case .EAST {
            result = 1
        }
        case .SOUTH or .WEST {
            result = 2
        }
    }
    return result - 1
}
