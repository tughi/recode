$test.score(%direction: i32): i32 {
@1:
  %result.ptr: [i32] = alloc i32
  %1: i32 = const 0
  store %result.ptr %1
  brx %direction @4 @3 @3 @3 @3
@4:
  %2: i32 = const 10
  store %result.ptr %2
  jmp @2
@3:
  %3: i32 = const 20
  store %result.ptr %3
  jmp @2
@2:
  %result.1: i32 = load %result.ptr
  ret %result.1
}

$test.main(): i32 {
@1:
  %1: i32 = const 0
  %2: i32 = call $test.score %1
  %3: i32 = const 2
  %4: i32 = mul %2 %3
  %5: i32 = const 3
  %6: i32 = call $test.score %5
  %7: i32 = add %4 %6
  %8: i32 = const 40
  %9: i32 = sub %7 %8
  ret %9
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
