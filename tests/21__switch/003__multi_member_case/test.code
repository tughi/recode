type Direction = enum {
    NORTH
    EAST
    SOUTH
    WEST
}

proc axis(direction: Direction) -> i32 {
    switch direction {
        case .NORTH or .SOUTH {
            return 1
        }
        case .EAST or .WEST {
            return 2
        }
    }
    return 0
}

proc main() -> i32 {
    return axis(Direction.NORTH) * axis(Direction.SOUTH) * axis(Direction.EAST) * axis(Direction.WEST) - 4
}
