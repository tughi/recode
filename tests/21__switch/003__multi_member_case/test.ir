$test.axis(%direction: i32): i32 {
@1:
  brx %direction @3 @4 @3 @4 @2
@3:
  %1: i32 = const 1
  ret %1
@4:
  %2: i32 = const 2
  ret %2
@2:
  %3: i32 = const 0
  ret %3
}

$test.main(): i32 {
@1:
  %1: i32 = const 0
  %2: i32 = call $test.axis %1
  %3: i32 = const 2
  %4: i32 = call $test.axis %3
  %5: i32 = mul %2 %4
  %6: i32 = const 1
  %7: i32 = call $test.axis %6
  %8: i32 = mul %5 %7
  %9: i32 = const 3
  %10: i32 = call $test.axis %9
  %11: i32 = mul %8 %10
  %12: i32 = const 4
  %13: i32 = sub %11 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
