$test.main(): i32 {
@1:
  %d.ptr: [i32] = alloc i32
  %1: i32 = const 1
  store %d.ptr %1
  %count.ptr: [i32] = alloc i32
  %2: i32 = const 0
  store %count.ptr %2
  jmp @2
@2:
  %count.1: i32 = load %count.ptr
  %3: i32 = const 10
  %4: bool = cmp_lt %count.1 %3
  br %4 @3 @4
@3:
  %d.1: i32 = load %d.ptr
  %5: i32 = const 0
  %6: bool = cmp_eq %d.1 %5
  br %6 @6 @7
@6:
  %count.2: i32 = load %count.ptr
  %7: i32 = const 2
  %8: i32 = add %count.2 %7
  store %count.ptr %8
  jmp @5
@7:
  %9: i32 = const 1
  %10: bool = cmp_eq %d.1 %9
  br %10 @8 @9
@8:
  jmp @4
@9:
  jmp @5
@5:
  %count.3: i32 = load %count.ptr
  %11: i32 = const 1
  %12: i32 = add %count.3 %11
  store %count.ptr %12
  jmp @2
@4:
  %count.4: i32 = load %count.ptr
  ret %count.4
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
