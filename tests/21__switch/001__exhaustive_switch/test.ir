$test.steps(%direction: i32): i32 {
@1:
  %1: i32 = const 0
  %2: bool = cmp_eq %direction %1
  br %2 @3 @4
@3:
  %3: i32 = const 1
  ret %3
@4:
  %4: i32 = const 1
  %5: bool = cmp_eq %direction %4
  br %5 @5 @6
@5:
  %6: i32 = const 2
  ret %6
@6:
  %7: i32 = const 2
  %8: bool = cmp_eq %direction %7
  br %8 @7 @8
@7:
  %9: i32 = const 3
  ret %9
@8:
  %10: i32 = const 3
  %11: bool = cmp_eq %direction %10
  br %11 @9 @10
@9:
  %12: i32 = const 4
  ret %12
@10:
  jmp @2
@2:
  %13: i32 = const 0
  ret %13
}

$test.main(): i32 {
@1:
  %1: i32 = const 0
  %2: i32 = call $test.steps %1
  %3: i32 = const 1000
  %4: i32 = mul %2 %3
  %5: i32 = const 1
  %6: i32 = call $test.steps %5
  %7: i32 = const 100
  %8: i32 = mul %6 %7
  %9: i32 = add %4 %8
  %10: i32 = const 2
  %11: i32 = call $test.steps %10
  %12: i32 = const 10
  %13: i32 = mul %11 %12
  %14: i32 = add %9 %13
  %15: i32 = const 3
  %16: i32 = call $test.steps %15
  %17: i32 = add %14 %16
  %18: i32 = const 1234
  %19: i32 = sub %17 %18
  ret %19
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
