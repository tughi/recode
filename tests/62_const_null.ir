; exit: 0

; const null produces a zero pointer for [T] and [*]T types

$main(): i32 {
@1:
  %p1: [i32] = const null
  %p2: [i32] = const null
  %m1: [*]u8 = const null
  %m2: [*]u8 = const null
  %0: bool = cmp_eq %p1 %p2
  %1: bool = cmp_eq %m1 %m2
  br %0 @2 @4
@2:
  br %1 @3 @4
@3:
  %2: i32 = const 0
  ret %2
@4:
  %3: i32 = const 1
  ret %3
}
