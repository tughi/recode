package test

type Integer = union {
    i8
    i32
}

type Value = union {
    bool
    Integer
}

proc main() -> i32 {
    let value: Value = Integer(42)

    switch value {
        is Integer {
            return 0
        }
        else {
            return 1
        }
        else {
            return 2
        }
    }
}
