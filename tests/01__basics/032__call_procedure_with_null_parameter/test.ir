$test.main(): i32 {
@1:
  %1: [i32] = const null
  %2: i32 = call $test.deref__anon %1
  ret %2
}

$test.deref__anon(%ptr: [i32]): i32 {
@1:
  %1: [i32] = const null
  %2: bool = cmp_eq %ptr %1
  br %2 @2 @3
@2:
  %3: i32 = const 0
  ret %3
@3:
  %4: i32 = load %ptr
  ret %4
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
