$test.main(): i32 {
@1:
  %1: i32 = const 255
  %2: u8 = call $test.cast %1
  %3: u8 = const 255
  %4: bool = cmp_ne %2 %3
  br %4 @2 @3
@2:
  %5: i32 = const 1
  ret %5
@3:
  %6: i32 = const 1
  %7: i32 = neg %6
  %8: u8 = call $test.cast %7
  %9: u8 = const 255
  %10: bool = cmp_ne %8 %9
  br %10 @4 @5
@4:
  %11: i32 = const 2
  ret %11
@5:
  %12: i32 = const 255
  %13: i32 = neg %12
  %14: u8 = call $test.cast %13
  %15: u8 = const 1
  %16: bool = cmp_ne %14 %15
  br %16 @6 @7
@6:
  %17: i32 = const 3
  ret %17
@7:
  %18: i32 = const 0
  ret %18
}

$test.cast(%value: i32): u8 {
@1:
  %1: u8 = cast %value
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
