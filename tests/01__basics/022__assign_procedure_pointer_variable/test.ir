$main() {
@1:
  [ ]
  %procedure_pointer.ptr: ptr<ptr<proc (value: i32) -> i32>> = alloc ptr<proc (value: i32) -> i32>
  [ %procedure_pointer.ptr ]
  %1: ptr<proc (value: i32) -> i32> = address $echo__value
  [ %procedure_pointer.ptr %1 ]
  store %procedure_pointer.ptr %1
  [ ]
  ret
  [ ]
}

$echo__value(%value: i32): i32 {
@1:
  [ %value ]
  %value.ptr: ptr<i32> = alloc i32
  [ %value.ptr %value ]
  store %value.ptr %value
  [ %value.ptr ]
  %value.1: i32 = load %value.ptr
  [ %value.1 ]
  ret %value.1
  [ ]
}
