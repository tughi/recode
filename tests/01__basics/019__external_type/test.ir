type FILE = opaque

$stdout: [[FILE]] = external

$fputc: [proc (i32, [FILE]): i32] = external

$main(): i32 {
@1:
  %1: i32 = const 52
  %2: [FILE] = load $stdout
  %3: i32 = call $fputc %1 %2
  %4: i32 = const 50
  %5: [FILE] = load $stdout
  %6: i32 = call $fputc %4 %5
  %7: i32 = const 10
  %8: [FILE] = load $stdout
  %9: i32 = call $fputc %7 %8
  %10: i32 = const 0
  ret %10
}
