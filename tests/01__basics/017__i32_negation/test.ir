$test.main(): i32 {
@1:
  %value.ptr: [i32] = alloc i32
  %1: i32 = const 42
  store %value.ptr %1
  %value.1: i32 = load %value.ptr
  %2: i32 = const 1
  %3: i32 = neg %2
  %4: i32 = mul %value.1 %3
  %value.2: i32 = load %value.ptr
  %5: i32 = neg %value.2
  %6: bool = cmp_ne %4 %5
  br %6 @2 @3
@2:
  %7: i32 = const 1
  ret %7
@3:
  %8: i32 = const 0
  ret %8
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
