$test.main(): i32 {
@1:
  %echo_pointer.ptr: [[proc (i32): i32]] = alloc [proc (i32): i32]
  store %echo_pointer.ptr $test.echo__value
  %echo_pointer.1: [proc (i32): i32] = load %echo_pointer.ptr
  %1: i32 = const 42
  %2: i32 = call %echo_pointer.1 %1
  %3: i32 = const 42
  %4: i32 = sub %2 %3
  ret %4
}

$test.echo__value(%value: i32): i32 {
@1:
  ret %value
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
