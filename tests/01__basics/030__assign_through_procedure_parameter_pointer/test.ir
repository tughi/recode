$test.main(): i32 {
@1:
  %x.ptr: [i32] = alloc i32
  %1: i32 = const 0
  store %x.ptr %1
  %2: i32 = const 42
  call $test.set+pointer+value %x.ptr %2
  %x.1: i32 = load %x.ptr
  %3: i32 = const 42
  %4: i32 = sub %x.1 %3
  ret %4
}

$test.set+pointer+value(%pointer: [i32], %value: i32) {
@1:
  store %pointer %value
  ret
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
