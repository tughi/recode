$main(): i32 {
@1:
  %t.ptr: [bool] = alloc bool
  %1: bool = const true
  %2: bool = call $echo__anon %1
  store %t.ptr %2
  %f.ptr: [bool] = alloc bool
  %3: bool = const false
  %4: bool = call $echo__anon %3
  store %f.ptr %4
  %t.1: bool = load %t.ptr
  br %t.1 @3 @2
@2:
  %f.1: bool = load %f.ptr
  jmp @3
@3:
  %5: bool = phi @1 %t.1 @2 %f.1
  br %5 @4 @5
@4:
  jmp @6
@5:
  %6: i32 = const 1
  ret %6
@6:
  %f.2: bool = load %f.ptr
  br %f.2 @8 @7
@7:
  %t.2: bool = load %t.ptr
  jmp @8
@8:
  %7: bool = phi @6 %f.2 @7 %t.2
  br %7 @9 @10
@9:
  jmp @11
@10:
  %8: i32 = const 2
  ret %8
@11:
  %t.3: bool = load %t.ptr
  br %t.3 @13 @12
@12:
  %t.4: bool = load %t.ptr
  jmp @13
@13:
  %9: bool = phi @11 %t.3 @12 %t.4
  br %9 @14 @15
@14:
  jmp @16
@15:
  %10: i32 = const 3
  ret %10
@16:
  %f.3: bool = load %f.ptr
  br %f.3 @18 @17
@17:
  %f.4: bool = load %f.ptr
  jmp @18
@18:
  %11: bool = phi @16 %f.3 @17 %f.4
  br %11 @19 @20
@19:
  %12: i32 = const 4
  ret %12
@20:
  %f.5: bool = load %f.ptr
  br %f.5 @22 @21
@21:
  %f.6: bool = load %f.ptr
  jmp @22
@22:
  %13: bool = phi @20 %f.5 @21 %f.6
  br %13 @24 @23
@23:
  %f.7: bool = load %f.ptr
  br %f.7 @26 @25
@25:
  %f.8: bool = load %f.ptr
  jmp @26
@26:
  %14: bool = phi @23 %f.7 @25 %f.8
  jmp @24
@24:
  %15: bool = phi @22 %13 @26 %14
  br %15 @27 @28
@27:
  %16: i32 = const 5
  ret %16
@28:
  %17: i32 = const 0
  ret %17
}

$echo__anon(%v: bool): bool {
@1:
  ret %v
}
