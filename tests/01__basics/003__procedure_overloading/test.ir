$test.main(): i32 {
@1:
  %1: i32 = call $test.fallback
  %2: i32 = const 42
  %3: i32 = call $test.fallback__value %2
  %4: i32 = sub %1 %3
  ret %4
}

$test.fallback(): i32 {
@1:
  %1: i32 = const 42
  ret %1
}

$test.fallback__value(%value: i32): i32 {
@1:
  ret %value
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
