proc main() -> i32 {
    return sub(
        mul(
            add(
                div(42, 10)
                2
            )
            add(
                mod(42, 10)
                5
            )
        )
        42
    )
}

proc add(v1: i32, v2: i32) -> i32 {
    return v1 + v2
}

proc sub(v1: i32, v2: i32) -> i32 {
    return v1 - v2
}

proc mul(v1: i32, v2: i32) -> i32 {
    return v1 * v2
}

proc div(v1: i32, v2: i32) -> i32 {
    return v1 / v2
}

proc mod(v1: i32, v2: i32) -> i32 {
    return v1 % v2
}
