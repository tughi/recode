package test

proc main() -> i32 {
    return sub(
        mul(
            add(
                div(42, 10)
                2
            )
            add(
                mod(42, 10)
                5
            )
        )
        42
    )
}

proc add(anon v1: i32, anon v2: i32) -> i32 {
    return v1 + v2
}

proc sub(anon v1: i32, anon v2: i32) -> i32 {
    return v1 - v2
}

proc mul(anon v1: i32, anon v2: i32) -> i32 {
    return v1 * v2
}

proc div(anon v1: i32, anon v2: i32) -> i32 {
    return v1 / v2
}

proc mod(anon v1: i32, anon v2: i32) -> i32 {
    return v1 // v2
}
