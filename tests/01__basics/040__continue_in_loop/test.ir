$test.main(): i32 {
@1:
  %i.ptr: [i32] = alloc i32
  %1: i32 = const 0
  store %i.ptr %1
  %sum.ptr: [i32] = alloc i32
  %2: i32 = const 0
  store %sum.ptr %2
  jmp @2
@2:
  %i.1: i32 = load %i.ptr
  %3: i32 = const 1
  %4: i32 = add %i.1 %3
  store %i.ptr %4
  %i.2: i32 = load %i.ptr
  %5: i32 = const 10
  %6: bool = cmp_gt %i.2 %5
  br %6 @4 @5
@4:
  jmp @3
@5:
  %i.3: i32 = load %i.ptr
  %7: i32 = const 2
  %8: i32 = mod %i.3 %7
  %9: i32 = const 0
  %10: bool = cmp_eq %8 %9
  br %10 @6 @7
@6:
  jmp @2
@7:
  %sum.1: i32 = load %sum.ptr
  %i.4: i32 = load %i.ptr
  %11: i32 = add %sum.1 %i.4
  store %sum.ptr %11
  jmp @2
@3:
  %sum.2: i32 = load %sum.ptr
  %12: i32 = const 25
  %13: i32 = sub %sum.2 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
