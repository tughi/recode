$test.main(): i32 {
@1:
  %min.ptr: [u8] = alloc u8
  %1: u8 = const 0
  store %min.ptr %1
  %max.ptr: [u8] = alloc u8
  %2: u8 = const 255
  store %max.ptr %2
  %errors.ptr: [i32] = alloc i32
  %3: i32 = const 8
  store %errors.ptr %3
  %4: u8 = call $test.forty_two
  %5: u8 = const 42
  %6: bool = cmp_eq %4 %5
  br %6 @2 @3
@2:
  %errors.1: i32 = load %errors.ptr
  %7: i32 = const 1
  %8: i32 = sub %errors.1 %7
  store %errors.ptr %8
  jmp @3
@3:
  %9: u8 = call $test.forty_two
  %10: u8 = const 42
  %11: bool = cmp_ne %9 %10
  br %11 @4 @5
@4:
  jmp @6
@5:
  %errors.2: i32 = load %errors.ptr
  %12: i32 = const 1
  %13: i32 = sub %errors.2 %12
  store %errors.ptr %13
  jmp @6
@6:
  %14: u8 = call $test.forty_two
  %max.1: u8 = load %max.ptr
  %15: bool = cmp_lt %14 %max.1
  br %15 @7 @8
@7:
  %errors.3: i32 = load %errors.ptr
  %16: i32 = const 1
  %17: i32 = sub %errors.3 %16
  store %errors.ptr %17
  jmp @8
@8:
  %18: u8 = call $test.forty_two
  %min.1: u8 = load %min.ptr
  %19: bool = cmp_lt %18 %min.1
  br %19 @9 @10
@9:
  jmp @11
@10:
  %errors.4: i32 = load %errors.ptr
  %20: i32 = const 1
  %21: i32 = sub %errors.4 %20
  store %errors.ptr %21
  jmp @11
@11:
  %22: u8 = call $test.forty_two
  %23: u8 = const 42
  %24: bool = cmp_le %22 %23
  br %24 @12 @13
@12:
  %errors.5: i32 = load %errors.ptr
  %25: i32 = const 1
  %26: i32 = sub %errors.5 %25
  store %errors.ptr %26
  jmp @13
@13:
  %27: u8 = call $test.forty_two
  %max.2: u8 = load %max.ptr
  %28: bool = cmp_lt %27 %max.2
  br %28 @14 @15
@14:
  %errors.6: i32 = load %errors.ptr
  %29: i32 = const 1
  %30: i32 = sub %errors.6 %29
  store %errors.ptr %30
  jmp @15
@15:
  %31: u8 = call $test.forty_two
  %min.2: u8 = load %min.ptr
  %32: bool = cmp_lt %31 %min.2
  br %32 @16 @17
@16:
  jmp @18
@17:
  %errors.7: i32 = load %errors.ptr
  %33: i32 = const 1
  %34: i32 = sub %errors.7 %33
  store %errors.ptr %34
  jmp @18
@18:
  %35: u8 = call $test.forty_two
  %36: u8 = const 42
  %37: bool = cmp_ge %35 %36
  br %37 @19 @20
@19:
  %errors.8: i32 = load %errors.ptr
  %38: i32 = const 1
  %39: i32 = sub %errors.8 %38
  store %errors.ptr %39
  jmp @20
@20:
  %errors.9: i32 = load %errors.ptr
  ret %errors.9
}

$test.forty_two(): u8 {
@1:
  %1: u8 = const 42
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
