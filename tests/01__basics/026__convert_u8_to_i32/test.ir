$test.main(): i32 {
@1:
  %1: u8 = const 255
  %2: i32 = call $test.cast__anon %1
  %3: i32 = const 255
  %4: bool = cmp_ne %2 %3
  br %4 @2 @3
@2:
  %5: i32 = const 1
  ret %5
@3:
  %6: u8 = const 0
  %7: i32 = call $test.cast__anon %6
  %8: i32 = const 0
  %9: bool = cmp_ne %7 %8
  br %9 @4 @5
@4:
  %10: i32 = const 2
  ret %10
@5:
  %11: i32 = const 0
  ret %11
}

$test.cast__anon(%value: u8): i32 {
@1:
  %1: i32 = cast %value
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
