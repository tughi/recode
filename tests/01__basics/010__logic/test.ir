$test.main(): i32 {
@1:
  %t.ptr: [bool] = alloc bool
  %1: bool = const true
  %2: bool = call $test.echo+anon %1
  store %t.ptr %2
  %f.ptr: [bool] = alloc bool
  %3: bool = const false
  %4: bool = call $test.echo+anon %3
  store %f.ptr %4
  %t.1: bool = load %t.ptr
  br %t.1 @2 @3
@2:
  %f.1: bool = load %f.ptr
  jmp @3
@3:
  %5: bool = phi @1 %t.1 @2 %f.1
  br %5 @5 @4
@4:
  %f.2: bool = load %f.ptr
  br %f.2 @6 @7
@6:
  %t.2: bool = load %t.ptr
  jmp @7
@7:
  %6: bool = phi @4 %f.2 @6 %t.2
  jmp @5
@5:
  %7: bool = phi @3 %5 @7 %6
  br %7 @9 @8
@8:
  %t.3: bool = load %t.ptr
  br %t.3 @11 @10
@10:
  %f.3: bool = load %f.ptr
  jmp @11
@11:
  %8: bool = phi @8 %t.3 @10 %f.3
  br %8 @12 @13
@12:
  %f.4: bool = load %f.ptr
  br %f.4 @15 @14
@14:
  %t.4: bool = load %t.ptr
  jmp @15
@15:
  %9: bool = phi @12 %f.4 @14 %t.4
  jmp @13
@13:
  %10: bool = phi @11 %8 @15 %9
  %11: bool = not %10
  jmp @9
@9:
  %12: bool = phi @5 %7 @13 %11
  br %12 @16 @17
@16:
  %13: i32 = const 1
  ret %13
@17:
  %14: i32 = const 0
  ret %14
}

$test.echo+anon(%v: bool): bool {
@1:
  ret %v
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
