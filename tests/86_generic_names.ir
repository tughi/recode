; exit: 42

; global names may carry generic type arguments, folded into the nominal name:
; the full spelling (one space after each comma, none elsewhere) is the symbol

$test.identity<i32>(%value: i32): i32 {
@1:
  ret %value
}

$test.pick<i32, u8>(%first: i32, %second: u8): i32 {
@1:
  ret %first
}

$main(): i32 {
@1:
  %1: i32 = const 40
  %2: i32 = call $test.identity<i32> %1
  %3: u8 = const 7
  %4: i32 = call $test.pick<i32, u8> %2 %3
  %5: i32 = const 2
  %6: i32 = add %4 %5
  ret %6
}
