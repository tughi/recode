type i32__opt = struct {
  tag: i32
  value: i32
}

$test.find+anon+anon(%value: i32, %target: i32): i32__opt {
@1:
  %1: bool = cmp_eq %value %target
  br %1 @2 @3
@2:
  %2.ptr: [i32__opt] = alloc i32__opt
  %3: [i32] = offset %2.ptr .tag
  %4: i32 = const 1
  store %3 %4
  %5: [i32] = offset %2.ptr .value
  store %5 %value
  %6: i32__opt = load %2.ptr
  ret %6
@3:
  %7.ptr: [i32__opt] = alloc i32__opt
  %8: [i32] = offset %7.ptr .tag
  %9: i32 = const 0
  store %8 %9
  %10: i32__opt = load %7.ptr
  ret %10
}

$test.main(): i32 {
@1:
  %found.ptr: [i32__opt] = alloc i32__opt
  %1: i32 = const 42
  %2: i32 = const 42
  %3: i32__opt = call $test.find+anon+anon %1 %2
  store %found.ptr %3
  %not_found.ptr: [i32__opt] = alloc i32__opt
  %4: i32 = const 1
  %5: i32 = const 2
  %6: i32__opt = call $test.find+anon+anon %4 %5
  store %not_found.ptr %6
  %7: [i32] = offset %found.ptr .tag
  %8: i32 = load %7
  %9: i32 = const 1
  %10: bool = cmp_eq %8 %9
  br %10 @2 @3
@2:
  %11: [i32] = offset %found.ptr .value
  %12: i32 = load %11
  %13: i32 = const 42
  %14: bool = cmp_ne %12 %13
  br %14 @5 @6
@5:
  %15: i32 = const 1
  ret %15
@6:
  jmp @4
@3:
  %16: i32 = const 2
  ret %16
@4:
  %17: [i32] = offset %not_found.ptr .tag
  %18: i32 = load %17
  %19: i32 = const 0
  %20: bool = cmp_eq %18 %19
  br %20 @7 @8
@7:
  jmp @9
@8:
  %21: i32 = const 3
  ret %21
@9:
  %22: i32 = const 0
  ret %22
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
