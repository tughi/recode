type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: i32__opt = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 1
  %11: bool = cmp_eq %9 %10
  br %11 @3 @4
@3:
  %12: [[1]u32] = offset %value.ptr .value
  %13: [i32] = cast %12
  %14: i32 = load %13
  %15: i32 = const 42
  %16: bool = cmp_ne %14 %15
  br %16 @5 @6
@5:
  %17: i32 = const 1
  ret %17
@6:
  jmp @2
@4:
  %18: i32 = const 0
  %19: bool = cmp_eq %9 %18
  br %19 @7 @8
@7:
  %20: i32 = const 2
  ret %20
@8:
  jmp @2
@2:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %21.ptr: [i32__opt] = alloc i32__opt
  %22: [i32] = offset %21.ptr .tag
  %23: i32 = const 0
  store %22 %23
  %24: i32__opt = load %21.ptr
  store %empty.ptr %24
  %25: [i32] = offset %empty.ptr .tag
  %26: i32 = load %25
  %27: i32 = const 1
  %28: bool = cmp_eq %26 %27
  br %28 @10 @11
@10:
  %29: i32 = const 3
  ret %29
@11:
  %30: i32 = const 0
  %31: bool = cmp_eq %26 %30
  br %31 @12 @13
@12:
  jmp @9
@13:
  jmp @9
@9:
  %32: i32 = const 0
  ret %32
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
