type i32__opt = struct {
  tag: i32
  value: i32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 42
  %5: [i32] = offset %1.ptr .value
  store %5 %4
  %6: i32__opt = load %1.ptr
  store %value.ptr %6
  %7: [i32] = offset %value.ptr .tag
  %8: i32 = load %7
  %9: i32 = const 1
  %10: bool = cmp_eq %8 %9
  br %10 @3 @4
@3:
  %11: [i32] = offset %value.ptr .value
  %12: i32 = load %11
  %13: i32 = const 42
  %14: bool = cmp_ne %12 %13
  br %14 @5 @6
@5:
  %15: i32 = const 1
  ret %15
@6:
  jmp @2
@4:
  %16: i32 = const 0
  %17: bool = cmp_eq %8 %16
  br %17 @7 @8
@7:
  %18: i32 = const 2
  ret %18
@8:
  jmp @2
@2:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %19.ptr: [i32__opt] = alloc i32__opt
  %20: [i32] = offset %19.ptr .tag
  %21: i32 = const 0
  store %20 %21
  %22: i32__opt = load %19.ptr
  store %empty.ptr %22
  %23: [i32] = offset %empty.ptr .tag
  %24: i32 = load %23
  %25: i32 = const 1
  %26: bool = cmp_eq %24 %25
  br %26 @10 @11
@10:
  %27: i32 = const 3
  ret %27
@11:
  %28: i32 = const 0
  %29: bool = cmp_eq %24 %28
  br %29 @12 @13
@12:
  jmp @9
@13:
  jmp @9
@9:
  %30: i32 = const 0
  ret %30
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
