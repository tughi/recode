type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: i32__opt = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 1
  %11: bool = cmp_eq %9 %10
  br %11 @3 @4
@3:
  %12: [[1]u32] = offset %value.ptr .value
  %number.ptr: [i32] = cast %12
  %number.1: i32 = load %number.ptr
  %14: i32 = const 42
  %15: bool = cmp_ne %number.1 %14
  br %15 @5 @6
@5:
  %16: i32 = const 1
  ret %16
@6:
  jmp @2
@4:
  %17: i32 = const 0
  %18: bool = cmp_eq %9 %17
  br %18 @7 @8
@7:
  %19: i32 = const 2
  ret %19
@8:
  jmp @2
@2:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %20.ptr: [i32__opt] = alloc i32__opt
  %21: [i32] = offset %20.ptr .tag
  %22: i32 = const 0
  store %21 %22
  %23: i32__opt = load %20.ptr
  store %empty.ptr %23
  %24: [i32] = offset %empty.ptr .tag
  %25: i32 = load %24
  %26: i32 = const 1
  %27: bool = cmp_eq %25 %26
  br %27 @10 @11
@10:
  %28: i32 = const 3
  ret %28
@11:
  %29: i32 = const 0
  %30: bool = cmp_eq %25 %29
  br %30 @12 @13
@12:
  jmp @9
@13:
  jmp @9
@9:
  %31: i32 = const 0
  ret %31
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
