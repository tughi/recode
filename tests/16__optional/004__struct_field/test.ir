type test.Person = struct {
  name: String
  age: i32__opt
}

type String = struct {
  data: [*]u8
  length: usize
}

type i32__opt = struct {
  tag: i32
  value: i32
}

$str_1: [*]u8 = "Alice"

$str_2: [*]u8 = "Bob"

$test.main(): i32 {
@1:
  %p.ptr: [test.Person] = alloc test.Person
  %1: usize = const 5
  %2: String = struct .data $str_1 .length %1
  %3.ptr: [i32__opt] = alloc i32__opt
  %4: [i32] = offset %3.ptr .tag
  %5: i32 = const 1
  store %4 %5
  %6: i32 = const 30
  %7: [i32] = offset %3.ptr .value
  store %7 %6
  %8: i32__opt = load %3.ptr
  %9: test.Person = struct .name %2 .age %8
  store %p.ptr %9
  %q.ptr: [test.Person] = alloc test.Person
  %10: usize = const 3
  %11: String = struct .data $str_2 .length %10
  %12.ptr: [i32__opt] = alloc i32__opt
  %13: [i32] = offset %12.ptr .tag
  %14: i32 = const 0
  store %13 %14
  %15: i32__opt = load %12.ptr
  %16: test.Person = struct .name %11 .age %15
  store %q.ptr %16
  %p_age.ptr: [i32__opt] = alloc i32__opt
  %17: [i32__opt] = offset %p.ptr .age
  %18: i32__opt = load %17
  store %p_age.ptr %18
  %19: [i32] = offset %p_age.ptr .tag
  %20: i32 = load %19
  %21: i32 = const 1
  %22: bool = cmp_eq %20 %21
  br %22 @2 @3
@2:
  %23: [i32] = offset %p_age.ptr .value
  %24: i32 = load %23
  %25: i32 = const 30
  %26: bool = cmp_ne %24 %25
  br %26 @5 @6
@5:
  %27: i32 = const 1
  ret %27
@6:
  jmp @4
@3:
  %28: i32 = const 2
  ret %28
@4:
  %q_age.ptr: [i32__opt] = alloc i32__opt
  %29: [i32__opt] = offset %q.ptr .age
  %30: i32__opt = load %29
  store %q_age.ptr %30
  %31: [i32] = offset %q_age.ptr .tag
  %32: i32 = load %31
  %33: i32 = const 0
  %34: bool = cmp_eq %32 %33
  br %34 @7 @8
@7:
  jmp @9
@8:
  %35: i32 = const 3
  ret %35
@9:
  %36: i32 = const 0
  ret %36
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
