type test.Person = struct {
  name: String
  age: i32__opt
}

type String = struct {
  data: [*]u8
  length: usize
}

type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$str_1: [*]u8 = "Alice"

$str_2: [*]u8 = "Bob"

$test.main(): i32 {
@1:
  %p.ptr: [test.Person] = alloc test.Person
  %1: usize = const 5
  %2: String = struct .data $str_1 .length %1
  %3.ptr: [i32__opt] = alloc i32__opt
  %4: [i32] = offset %3.ptr .tag
  %5: i32 = const 1
  store %4 %5
  %6: i32 = const 30
  %7: [[1]u32] = offset %3.ptr .value
  %8: [i32] = cast %7
  store %8 %6
  %9: i32__opt = load %3.ptr
  %10: test.Person = struct .name %2 .age %9
  store %p.ptr %10
  %q.ptr: [test.Person] = alloc test.Person
  %11: usize = const 3
  %12: String = struct .data $str_2 .length %11
  %13.ptr: [i32__opt] = alloc i32__opt
  %14: [i32] = offset %13.ptr .tag
  %15: i32 = const 0
  store %14 %15
  %16: i32__opt = load %13.ptr
  %17: test.Person = struct .name %12 .age %16
  store %q.ptr %17
  %p_age.ptr: [i32__opt] = alloc i32__opt
  %18: [i32__opt] = offset %p.ptr .age
  %19: i32__opt = load %18
  store %p_age.ptr %19
  %20: [i32] = offset %p_age.ptr .tag
  %21: i32 = load %20
  %22: i32 = const 1
  %23: bool = cmp_eq %21 %22
  %24: [[1]u32] = offset %p_age.ptr .value
  %age.ptr: [i32] = cast %24
  br %23 @2 @3
@2:
  %age.1: i32 = load %age.ptr
  %26: i32 = const 30
  %27: bool = cmp_ne %age.1 %26
  br %27 @5 @6
@5:
  %28: i32 = const 1
  ret %28
@6:
  jmp @4
@3:
  %29: i32 = const 2
  ret %29
@4:
  %q_age.ptr: [i32__opt] = alloc i32__opt
  %30: [i32__opt] = offset %q.ptr .age
  %31: i32__opt = load %30
  store %q_age.ptr %31
  %32: [i32] = offset %q_age.ptr .tag
  %33: i32 = load %32
  %34: i32 = const 0
  %35: bool = cmp_eq %33 %34
  br %35 @7 @8
@7:
  jmp @9
@8:
  %36: i32 = const 3
  ret %36
@9:
  %37: i32 = const 0
  ret %37
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
