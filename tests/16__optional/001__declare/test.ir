type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %has_value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: i32__opt = load %1.ptr
  store %has_value.ptr %7
  %no_value.ptr: [i32__opt] = alloc i32__opt
  %8.ptr: [i32__opt] = alloc i32__opt
  %9: [i32] = offset %8.ptr .tag
  %10: i32 = const 0
  store %9 %10
  %11: i32__opt = load %8.ptr
  store %no_value.ptr %11
  %12: [i32] = offset %has_value.ptr .tag
  %13: i32 = load %12
  %14: i32 = const 1
  %15: bool = cmp_eq %13 %14
  br %15 @2 @3
@2:
  %16: [i32] = offset %no_value.ptr .tag
  %17: i32 = load %16
  %18: i32 = const 0
  %19: bool = cmp_eq %17 %18
  br %19 @4 @5
@4:
  %20: [[1]u32] = offset %has_value.ptr .value
  %21: [i32] = cast %20
  %22: i32 = load %21
  %23: i32 = const 42
  %24: i32 = sub %22 %23
  ret %24
@5:
  jmp @3
@3:
  %25: i32 = const 1
  ret %25
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
