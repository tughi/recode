type source.Item__opt = struct {
  tag: i32
  value: [1]u32
}

type source.Item = struct {
  value: i32
}

$test.main(): i32 {
@1:
  %has_item.ptr: [source.Item__opt] = alloc source.Item__opt
  %1.ptr: [source.Item__opt] = alloc source.Item__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 42
  %5: source.Item = struct .value %4
  %6: [[1]u32] = offset %1.ptr .value
  %7: [source.Item] = cast %6
  store %7 %5
  %8: source.Item__opt = load %1.ptr
  store %has_item.ptr %8
  %no_item.ptr: [source.Item__opt] = alloc source.Item__opt
  %9.ptr: [source.Item__opt] = alloc source.Item__opt
  %10: [i32] = offset %9.ptr .tag
  %11: i32 = const 0
  store %10 %11
  %12: source.Item__opt = load %9.ptr
  store %no_item.ptr %12
  %13: [i32] = offset %has_item.ptr .tag
  %14: i32 = load %13
  %15: i32 = const 1
  %16: bool = cmp_eq %14 %15
  %17: [[1]u32] = offset %has_item.ptr .value
  %item.ptr: [source.Item] = cast %17
  br %16 @2 @3
@2:
  %19: [i32] = offset %no_item.ptr .tag
  %20: i32 = load %19
  %21: i32 = const 0
  %22: bool = cmp_eq %20 %21
  br %22 @4 @5
@4:
  %23: [i32] = offset %item.ptr .value
  %24: i32 = load %23
  %25: i32 = const 42
  %26: i32 = sub %24 %25
  ret %26
@5:
  jmp @3
@3:
  %27: i32 = const 1
  ret %27
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
