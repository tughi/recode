type i32__opt = struct {
  tag: i32
  value: i32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 99
  %5: [i32] = offset %1.ptr .value
  store %5 %4
  %6: i32__opt = load %1.ptr
  store %value.ptr %6
  %7: [i32] = offset %value.ptr .tag
  %8: i32 = load %7
  %9: i32 = const 1
  %10: bool = cmp_eq %8 %9
  br %10 @2 @3
@2:
  %11: [i32] = offset %value.ptr .value
  %12: i32 = load %11
  %13: i32 = const 99
  %14: bool = cmp_ne %12 %13
  br %14 @5 @6
@5:
  %15: i32 = const 1
  ret %15
@6:
  jmp @4
@3:
  %16: i32 = const 2
  ret %16
@4:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %17.ptr: [i32__opt] = alloc i32__opt
  %18: [i32] = offset %17.ptr .tag
  %19: i32 = const 0
  store %18 %19
  %20: i32__opt = load %17.ptr
  store %empty.ptr %20
  %21: [i32] = offset %empty.ptr .tag
  %22: i32 = load %21
  %23: i32 = const 1
  %24: bool = cmp_eq %22 %23
  br %24 @7 @8
@7:
  %25: i32 = const 3
  ret %25
@8:
  %26: [i32] = offset %empty.ptr .tag
  %27: i32 = load %26
  %28: i32 = const 0
  %29: bool = cmp_eq %27 %28
  br %29 @9 @10
@9:
  jmp @11
@10:
  %30: i32 = const 4
  ret %30
@11:
  %31: i32 = const 0
  ret %31
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
