type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 99
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: i32__opt = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 1
  %11: bool = cmp_eq %9 %10
  br %11 @2 @3
@2:
  %12: [[1]u32] = offset %value.ptr .value
  %13: [i32] = cast %12
  %14: i32 = load %13
  %15: i32 = const 99
  %16: bool = cmp_ne %14 %15
  br %16 @5 @6
@5:
  %17: i32 = const 1
  ret %17
@6:
  jmp @4
@3:
  %18: i32 = const 2
  ret %18
@4:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %19.ptr: [i32__opt] = alloc i32__opt
  %20: [i32] = offset %19.ptr .tag
  %21: i32 = const 0
  store %20 %21
  %22: i32__opt = load %19.ptr
  store %empty.ptr %22
  %23: [i32] = offset %empty.ptr .tag
  %24: i32 = load %23
  %25: i32 = const 1
  %26: bool = cmp_eq %24 %25
  br %26 @7 @8
@7:
  %27: i32 = const 3
  ret %27
@8:
  %28: [i32] = offset %empty.ptr .tag
  %29: i32 = load %28
  %30: i32 = const 0
  %31: bool = cmp_eq %29 %30
  br %31 @9 @10
@9:
  jmp @11
@10:
  %32: i32 = const 4
  ret %32
@11:
  %33: i32 = const 0
  ret %33
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
