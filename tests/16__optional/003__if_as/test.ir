type i32__opt = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [i32__opt] = alloc i32__opt
  %1.ptr: [i32__opt] = alloc i32__opt
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 1
  store %2 %3
  %4: i32 = const 99
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: i32__opt = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 1
  %11: bool = cmp_eq %9 %10
  %12: [[1]u32] = offset %value.ptr .value
  %number.ptr: [i32] = cast %12
  br %11 @2 @3
@2:
  %number.1: i32 = load %number.ptr
  %14: i32 = const 99
  %15: bool = cmp_ne %number.1 %14
  br %15 @5 @6
@5:
  %16: i32 = const 1
  ret %16
@6:
  jmp @4
@3:
  %17: i32 = const 2
  ret %17
@4:
  %empty.ptr: [i32__opt] = alloc i32__opt
  %18.ptr: [i32__opt] = alloc i32__opt
  %19: [i32] = offset %18.ptr .tag
  %20: i32 = const 0
  store %19 %20
  %21: i32__opt = load %18.ptr
  store %empty.ptr %21
  %22: [i32] = offset %empty.ptr .tag
  %23: i32 = load %22
  %24: i32 = const 1
  %25: bool = cmp_eq %23 %24
  br %25 @7 @8
@7:
  %26: i32 = const 3
  ret %26
@8:
  %27: [i32] = offset %empty.ptr .tag
  %28: i32 = load %27
  %29: i32 = const 0
  %30: bool = cmp_eq %28 %29
  br %30 @9 @10
@9:
  jmp @11
@10:
  %31: i32 = const 4
  ret %31
@11:
  %32: i32 = const 0
  ret %32
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
