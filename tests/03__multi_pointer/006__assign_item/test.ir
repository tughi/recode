$malloc: [proc (usize): [Any]] = external

$test.main(): i32 {
@1:
  %array.ptr: [[*]i32] = alloc [*]i32
  %1: usize = const 32
  %2: [Any] = call $malloc %1
  %3: [*]i32 = cast %2
  store %array.ptr %3
  %array.1: [*]i32 = load %array.ptr
  %4: i32 = const 3
  %5: [i32] = offset %array.1 %4
  %6: i32 = const 42
  store %5 %6
  %array.2: [*]i32 = load %array.ptr
  %7: i32 = const 3
  %8: [i32] = offset %array.2 %7
  %9: i32 = load %8
  %10: i32 = const 42
  %11: i32 = sub %9 %10
  ret %11
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
