$test.main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %arg.ptr: [[*]u8] = alloc [*]u8
  %1: i32 = const 0
  %2: [[*]u8] = offset %argv %1
  %3: [*]u8 = load %2
  store %arg.ptr %3
  %ch.ptr: [u8] = alloc u8
  %arg.1: [*]u8 = load %arg.ptr
  %4: i32 = const 0
  %5: [u8] = offset %arg.1 %4
  %6: u8 = load %5
  store %ch.ptr %6
  %ch.1: u8 = load %ch.ptr
  %7: u8 = const 'b'
  %8: bool = cmp_ne %ch.1 %7
  br %8 @2 @3
@2:
  %9: i32 = const 1
  ret %9
@3:
  %10: i32 = const 0
  ret %10
}

$main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = call $test.main %argc %argv
  ret %1
}
