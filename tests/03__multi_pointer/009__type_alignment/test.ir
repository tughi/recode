$test.main(): i32 {
@1:
  %1: usize = const 1
  %2: usize = const 1
  %3: bool = cmp_ne %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: usize = const 2
  %6: usize = const 2
  %7: bool = cmp_ne %5 %6
  br %7 @4 @5
@4:
  %8: i32 = const 2
  ret %8
@5:
  %9: usize = const 8
  %10: usize = const 8
  %11: bool = cmp_ne %9 %10
  br %11 @6 @7
@6:
  %12: i32 = const 3
  ret %12
@7:
  %13: i32 = const 0
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
