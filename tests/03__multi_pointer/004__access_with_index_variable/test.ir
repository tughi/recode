$test.main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = const 2
  %2: bool = cmp_lt %argc %1
  br %2 @2 @3
@2:
  %3: i32 = const 1
  ret %3
@3:
  %i.ptr: [i32] = alloc i32
  %4: i32 = const 1
  store %i.ptr %4
  %i.1: i32 = load %i.ptr
  %5: [[*]u8] = offset %argv %i.1
  %6: [*]u8 = load %5
  %i.2: i32 = load %i.ptr
  %7: [u8] = offset %6 %i.2
  %8: u8 = load %7
  %9: u8 = const '0'
  %10: bool = cmp_ne %8 %9
  br %10 @4 @5
@4:
  %11: i32 = const 2
  ret %11
@5:
  %12: i32 = const 0
  ret %12
}

$main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %1: i32 = call $test.main %argc %argv
  ret %1
}
