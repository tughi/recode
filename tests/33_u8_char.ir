; character literals and cast u8 to i32

; output: Hi\n

type File = opaque

$stdout: [[File]] = external

$main(): i32 {
@1:
  %1: [File] = load $stdout
  %2: u8 = const 'H'
  %3: i32 = call $write_char %1 %2
  %4: u8 = const 105 ; 'i'
  %5: i32 = call $write_char %1 %4
  %6: u8 = const '\n'
  %7: i32 = call $write_char %1 %6
  %8: i32 = const 0
  ret %8
}

$write_char(%file: [File], %char: u8): i32 {
@1:
  %1: i32 = cast %char
  %2: i32 = call $fputc %1 %file
  ret %2
}

$fputc: [proc (i32, [File]): i32] = external
