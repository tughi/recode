type test.Vehicle = struct {
  wheels: i32
}

type test.Sports_Car = struct {
  super: test.Car
  turbo: bool
}

type test.Car = struct {
  super: test.Vehicle
}

$malloc: [proc (usize): [Any]] = external

$test.main(): i32 {
@1:
  %my_vehicle.ptr: [[test.Vehicle]] = alloc [test.Vehicle]
  %1: usize = const 8
  %2: [Any] = call $malloc %1
  %3: [test.Sports_Car] = cast %2
  %4: i32 = const 4
  %5: test.Vehicle = struct .wheels %4
  %6: test.Car = struct .super %5
  %7: bool = const true
  %8: test.Sports_Car = struct .super %6 .turbo %7
  store %3 %8
  %9: [test.Vehicle] = cast %3
  store %my_vehicle.ptr %9
  %my_vehicle.1: [test.Vehicle] = load %my_vehicle.ptr
  %10: [i32] = offset %my_vehicle.1 .wheels
  %11: i32 = load %10
  %12: i32 = const 4
  %13: i32 = sub %11 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
