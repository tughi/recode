type test.Sports_Car = struct {
  super: test.Car
  turbo: bool
}

type test.Car = struct {
  super: test.Vehicle
}

type test.Vehicle = struct {
  wheels: i32
}

$test.main(): i32 {
@1:
  %sports_car.ptr: [test.Sports_Car] = alloc test.Sports_Car
  %1: i32 = const 4
  %2: test.Vehicle = struct .wheels %1
  %3: test.Car = struct .super %2
  %4: bool = const true
  %5: test.Sports_Car = struct .super %3 .turbo %4
  store %sports_car.ptr %5
  %my_vehicle.ptr: [[test.Vehicle]] = alloc [test.Vehicle]
  %6: [test.Vehicle] = cast %sports_car.ptr
  store %my_vehicle.ptr %6
  %my_vehicle.1: [test.Vehicle] = load %my_vehicle.ptr
  %7: [i32] = offset %my_vehicle.1 .wheels
  %8: i32 = load %7
  %9: i32 = const 4
  %10: i32 = sub %8 %9
  ret %10
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
