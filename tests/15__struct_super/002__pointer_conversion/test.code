type Vehicle = struct {
    wheels: i32
}

type Car = struct {
    super: Vehicle
}

type Sports_Car = struct {
    super: Car
    turbo: bool
}

proc main() -> i32 {
    let sports_car = Sports_Car(super: Car(super: Vehicle(wheels: 4)), turbo: true)
    let my_vehicle: ^Vehicle = ^sports_car
    return my_vehicle.wheels - 4
}
