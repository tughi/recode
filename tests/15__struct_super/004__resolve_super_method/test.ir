type test.Vehicle = struct {
  wheels: i32
}

type test.Sports_Car = struct {
  super: test.Car
  turbo: bool
}

type test.Car = struct {
  super: test.Vehicle
}

$([test.Vehicle]).get_wheels(%self): i32 {
@1:
  %1: [i32] = offset %self .wheels
  %2: i32 = load %1
  ret %2
}

$test.main(): i32 {
@1:
  %sports_car.ptr: [test.Sports_Car] = alloc test.Sports_Car
  %1: i32 = const 4
  %2: test.Vehicle = struct .wheels %1
  %3: test.Car = struct .super %2
  %4: bool = const true
  %5: test.Sports_Car = struct .super %3 .turbo %4
  store %sports_car.ptr %5
  %6: [test.Vehicle] = cast %sports_car.ptr
  %7: i32 = call $([test.Vehicle]).get_wheels %6
  %8: i32 = const 4
  %9: i32 = sub %7 %8
  ret %9
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
