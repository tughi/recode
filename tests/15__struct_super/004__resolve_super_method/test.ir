type test.Vehicle = struct {
  wheels: i32
}

type test.Sports_Car = struct {
  super: test.Car
  turbo: bool
}

type test.Car = struct {
  super: test.Vehicle
}

$malloc: [proc (usize): [Any]] = external

$([test.Vehicle]).get_wheels(%self): i32 {
@1:
  %1: [i32] = offset %self .wheels
  %2: i32 = load %1
  ret %2
}

$test.main(): i32 {
@1:
  %my_vehicle.ptr: [[test.Sports_Car]] = alloc [test.Sports_Car]
  %1: usize = const 8
  %2: [Any] = call $malloc %1
  %3: [test.Sports_Car] = cast %2
  %4: i32 = const 4
  %5: test.Vehicle = struct .wheels %4
  %6: test.Car = struct .super %5
  %7: bool = const true
  %8: test.Sports_Car = struct .super %6 .turbo %7
  store %3 %8
  store %my_vehicle.ptr %3
  %my_vehicle.1: [test.Sports_Car] = load %my_vehicle.ptr
  %9: [test.Vehicle] = cast %my_vehicle.1
  %10: i32 = call $([test.Vehicle]).get_wheels %9
  %11: i32 = const 4
  %12: i32 = sub %10 %11
  ret %12
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
