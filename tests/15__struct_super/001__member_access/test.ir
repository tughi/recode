type test.Sports_Car = struct {
  super: test.Car
}

type test.Car = struct {
  super: test.Vehicle
}

type test.Vehicle = struct {
  wheels: i32
}

$test.main(): i32 {
@1:
  %my_car.ptr: [test.Sports_Car] = alloc test.Sports_Car
  %1: i32 = const 4
  %2: test.Vehicle = struct .wheels %1
  %3: test.Car = struct .super %2
  %4: test.Sports_Car = struct .super %3
  store %my_car.ptr %4
  %5: [test.Car] = offset %my_car.ptr .super
  %6: [test.Vehicle] = offset %5 .super
  %7: [i32] = offset %6 .wheels
  %8: i32 = load %7
  %9: i32 = const 4
  %10: i32 = sub %8 %9
  ret %10
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
