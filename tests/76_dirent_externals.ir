; exit: 0

type DIR = opaque
type DIR_ENTRY = opaque

$closedir: [proc ([DIR]): i32] = external
$get_dirent_name: [proc ([DIR_ENTRY]): [*]u8] = external
$opendir: [proc ([*]u8): [DIR]] = external
$readdir: [proc ([DIR]): [DIR_ENTRY]] = external

$dot: [*]u8 = "."

$main(): i32 {
@0:
  %0: [DIR] = call $opendir $dot
  %1: [DIR] = const null
  %2: bool = cmp_ne %0 %1
  br %2 @1 @2

@1:
  %3: [DIR_ENTRY] = call $readdir %0
  %4: i32 = call $closedir %0
  ret %4

@2:
  %5: i32 = const 1
  ret %5
}
