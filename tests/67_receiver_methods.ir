; exit: 42

; receiver procedures: `$( <type> ).<member>` attaches a method to a type, so the
; same member name on different receivers names distinct procedures (a namespace).
; the receiver parameter is written without a type and defaults to the receiver.

type code.ast.Number = struct {
  value: i32
}

type code.ast.Doubler = struct {
  value: i32
}

$([code.ast.Number]).get(%self): i32 {
@1:
  %0: [i32] = offset %self .value
  %1: i32 = load %0
  ret %1
}

$([code.ast.Doubler]).get(%self): i32 {
@1:
  %0: [i32] = offset %self .value
  %1: i32 = load %0
  %2: i32 = const 2
  %3: i32 = mul %1 %2
  ret %3
}

$main(): i32 {
@1:
  %n: [code.ast.Number] = alloc code.ast.Number
  %0: [i32] = offset %n .value
  %1: i32 = const 20
  store %0 %1
  %d: [code.ast.Doubler] = alloc code.ast.Doubler
  %2: [i32] = offset %d .value
  %3: i32 = const 11
  store %2 %3
  %4: i32 = call $([code.ast.Number]).get %n
  %5: i32 = call $([code.ast.Doubler]).get %d
  %6: i32 = add %4 %5
  ret %6
}
