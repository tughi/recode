type test.Data<i8> = struct {
  value: i8
}

type test.Data<isize> = struct {
  value: isize
}

$test.main(): i32 {
@1:
  %1: usize = const 1
  %2: usize = const 1
  %3: bool = cmp_ne %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: usize = const 8
  %6: usize = const 8
  %7: bool = cmp_ne %5 %6
  br %7 @4 @5
@4:
  %8: i32 = const 1
  ret %8
@5:
  %9: i32 = const 0
  ret %9
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
