type collections.List<i32, u32> = struct {
  first_item: [collections.List_Item<i32>]
  last_item: [collections.List_Item<i32>]
  length: u32
}

type collections.List_Item<i32> = struct {
  data: i32
  next: [collections.List_Item<i32>]
}

$test.main(): i32 {
@1:
  %list.ptr: [collections.List<i32, u32>] = alloc collections.List<i32, u32>
  %1: collections.List<i32, u32> = struct
  store %list.ptr %1
  %2: i32 = const 0
  ret %2
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
