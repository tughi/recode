type test.Square = struct {
  side: i32
}

type test.Circle = struct {
  radius: i32
}

type test.Shape = struct {
  self: [Any]
  area: [proc ([Any]): i32]
}

$malloc: [proc (usize): [Any]] = external

$([test.Square]).area(%self): i32 {
@1:
  %1: [i32] = offset %self test.Square.side
  %2: i32 = load %1
  %3: [i32] = offset %self test.Square.side
  %4: i32 = load %3
  %5: i32 = mul %2 %4
  ret %5
}

$([test.Circle]).area(%self): i32 {
@1:
  %1: i32 = const 312
  %2: [i32] = offset %self test.Circle.radius
  %3: i32 = load %2
  %4: i32 = mul %1 %3
  %5: [i32] = offset %self test.Circle.radius
  %6: i32 = load %5
  %7: i32 = mul %4 %6
  %8: i32 = const 100
  %9: i32 = div %7 %8
  ret %9
}

$test.main(): i32 {
@1:
  %square.ptr: [[test.Square]] = alloc [test.Square]
  %1: usize = const 4
  %2: [Any] = call $malloc %1
  %3: [test.Square] = cast %2
  %4: i32 = const 10
  %5: test.Square = struct test.Square .side %4
  store %3 %5
  store %square.ptr %3
  %square_shape.ptr: [[test.Shape]] = alloc [test.Shape]
  %6: usize = const 16
  %7: [Any] = call $malloc %6
  %8: [test.Shape] = cast %7
  %square.1: [test.Square] = load %square.ptr
  %9: [Any] = cast %square.1
  %10: [proc ([Any]): i32] = cast $([test.Square]).area
  %11: test.Shape = struct test.Shape .self %9 .area %10
  store %8 %11
  store %square_shape.ptr %8
  %circle.ptr: [[test.Circle]] = alloc [test.Circle]
  %12: usize = const 4
  %13: [Any] = call $malloc %12
  %14: [test.Circle] = cast %13
  %15: i32 = const 10
  %16: test.Circle = struct test.Circle .radius %15
  store %14 %16
  store %circle.ptr %14
  %circle_shape.ptr: [[test.Shape]] = alloc [test.Shape]
  %17: usize = const 16
  %18: [Any] = call $malloc %17
  %19: [test.Shape] = cast %18
  %circle.1: [test.Circle] = load %circle.ptr
  %20: [Any] = cast %circle.1
  %21: [proc ([Any]): i32] = cast $([test.Circle]).area
  %22: test.Shape = struct test.Shape .self %20 .area %21
  store %19 %22
  store %circle_shape.ptr %19
  %square_shape.1: [test.Shape] = load %square_shape.ptr
  %23: [[proc ([Any]): i32]] = offset %square_shape.1 test.Shape.area
  %24: [proc ([Any]): i32] = load %23
  %square_shape.2: [test.Shape] = load %square_shape.ptr
  %25: [[Any]] = offset %square_shape.2 test.Shape.self
  %26: [Any] = load %25
  %27: i32 = call %24 %26
  %28: i32 = const 100
  %29: bool = cmp_ne %27 %28
  br %29 @2 @3
@2:
  %30: i32 = const 1
  ret %30
@3:
  %circle_shape.1: [test.Shape] = load %circle_shape.ptr
  %31: [[proc ([Any]): i32]] = offset %circle_shape.1 test.Shape.area
  %32: [proc ([Any]): i32] = load %31
  %circle_shape.2: [test.Shape] = load %circle_shape.ptr
  %33: [[Any]] = offset %circle_shape.2 test.Shape.self
  %34: [Any] = load %33
  %35: i32 = call %32 %34
  %36: i32 = const 312
  %37: bool = cmp_ne %35 %36
  br %37 @4 @5
@4:
  %38: i32 = const 2
  ret %38
@5:
  %39: i32 = const 0
  ret %39
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
