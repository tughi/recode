type test.Dog = struct {
  age: i32
}

type test.Animal = struct {
  self: [Any]
  legs: [proc ([Any]): i32]
}

$([test.Dog]).legs(%self): i32 {
@1:
  %1: i32 = const 4
  ret %1
}

$test.main(): i32 {
@1:
  %dog.ptr: [test.Dog] = alloc test.Dog
  %1: i32 = const 10
  %2: test.Dog = struct test.Dog .age %1
  store %dog.ptr %2
  %animal.ptr: [test.Animal] = alloc test.Animal
  %3: [Any] = cast %dog.ptr
  %4: [proc ([Any]): i32] = cast $([test.Dog]).legs
  %5: test.Animal = struct test.Animal .self %3 .legs %4
  store %animal.ptr %5
  %6: i32 = const 0
  ret %6
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
