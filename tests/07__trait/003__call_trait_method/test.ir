type test.Square = struct {
  side: i32
}

type test.Circle = struct {
  radius: i32
}

type test.Shape = struct {
  self: [Any]
  area: [proc ([Any]): i32]
}

$([test.Square]).area(%self): i32 {
@1:
  %1: [i32] = offset %self .side
  %2: i32 = load %1
  %3: [i32] = offset %self .side
  %4: i32 = load %3
  %5: i32 = mul %2 %4
  ret %5
}

$([test.Circle]).area(%self): i32 {
@1:
  %1: i32 = const 312
  %2: [i32] = offset %self .radius
  %3: i32 = load %2
  %4: i32 = mul %1 %3
  %5: [i32] = offset %self .radius
  %6: i32 = load %5
  %7: i32 = mul %4 %6
  %8: i32 = const 100
  %9: i32 = div %7 %8
  ret %9
}

$test.main(): i32 {
@1:
  %square.ptr: [test.Square] = alloc test.Square
  %1: i32 = const 10
  %2: test.Square = struct .side %1
  store %square.ptr %2
  %square_shape.ptr: [test.Shape] = alloc test.Shape
  %3: [Any] = cast %square.ptr
  %4: [proc ([Any]): i32] = cast $([test.Square]).area
  %5: test.Shape = struct .self %3 .area %4
  store %square_shape.ptr %5
  %circle.ptr: [test.Circle] = alloc test.Circle
  %6: i32 = const 10
  %7: test.Circle = struct .radius %6
  store %circle.ptr %7
  %circle_shape.ptr: [test.Shape] = alloc test.Shape
  %8: [Any] = cast %circle.ptr
  %9: [proc ([Any]): i32] = cast $([test.Circle]).area
  %10: test.Shape = struct .self %8 .area %9
  store %circle_shape.ptr %10
  %11: [[proc ([Any]): i32]] = offset %square_shape.ptr .area
  %12: [proc ([Any]): i32] = load %11
  %13: [[Any]] = offset %square_shape.ptr .self
  %14: [Any] = load %13
  %15: i32 = call %12 %14
  %16: i32 = const 100
  %17: bool = cmp_ne %15 %16
  br %17 @2 @3
@2:
  %18: i32 = const 1
  ret %18
@3:
  %19: [[proc ([Any]): i32]] = offset %circle_shape.ptr .area
  %20: [proc ([Any]): i32] = load %19
  %21: [[Any]] = offset %circle_shape.ptr .self
  %22: [Any] = load %21
  %23: i32 = call %20 %22
  %24: i32 = const 312
  %25: bool = cmp_ne %23 %24
  br %25 @4 @5
@4:
  %26: i32 = const 2
  ret %26
@5:
  %27: i32 = const 0
  ret %27
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
