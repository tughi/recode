type Shape = trait {
    proc area(self) -> i32
}

type Square = struct {
    side: i32
}

proc (^Square).area(self) -> i32 {
    return self.side * self.side
}

type Circle = struct {
    radius: i32
}

proc (^Circle).area(self) -> i32 {
    return 312 * self.radius * self.radius / 100
}

proc main() -> i32 {
    let square = Square(side: 10)
    let square_shape = Shape(^square)
    let circle = Circle(radius: 10)
    let circle_shape = Shape(^circle)

    if square_shape.area() != 100 {
        return 1
    }

    if circle_shape.area() != 312 {
        return 2
    }

    return 0
}
