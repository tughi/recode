type test.Number = struct {
  value: i32
}

type test.Writer = struct {
  self: [Any]
  write_char: [proc ([Any], u8)]
}

type test.Writable = struct {
  self: [Any]
  write_to: [proc ([Any], [test.Writer])]
}

type FILE = opaque

$stdout: [[FILE]] = external

$fputc: [proc (i32, [FILE]): i32] = external

$test.main(): i32 {
@1:
  %out.ptr: [test.Writer] = alloc test.Writer
  %1: [FILE] = load $stdout
  %2: [Any] = cast %1
  %3: [proc ([Any], u8)] = cast $([FILE]).write_char+anon
  %4: test.Writer = struct .self %2 .write_char %3
  store %out.ptr %4
  %5: i32 = const 42
  %6: test.Number = struct .value %5
  %7.ptr: [test.Number] = alloc test.Number
  store %7.ptr %6
  %8: [Any] = cast %7.ptr
  %9: [proc ([Any], [test.Writer])] = cast $([test.Number]).write_to+anon
  %10: test.Writable = struct .self %8 .write_to %9
  %11: [test.Writer] = call $([test.Writer]).write+anon %out.ptr %10
  %12: [test.Writer] = call $([test.Writer]).end_line %11
  %13: i32 = const 42
  %14.ptr: [i32] = alloc i32
  store %14.ptr %13
  %15: [Any] = cast %14.ptr
  %16: [proc ([Any], [test.Writer])] = cast $([i32]).write_to+anon
  %17: test.Writable = struct .self %15 .write_to %16
  %18: [test.Writer] = call $([test.Writer]).write+anon %out.ptr %17
  %19: [test.Writer] = call $([test.Writer]).end_line %18
  %20: i32 = const 0
  ret %20
}

$([test.Number]).write_to+anon(%self, %writer: [test.Writer]) {
@1:
  %1: [i32] = offset %self .value
  call $([i32]).write_to+anon %1 %writer
  ret
}

$([i32]).write_to+anon(%self, %writer: [test.Writer]) {
@1:
  %number.ptr: [i32] = alloc i32
  %1: i32 = load %self
  store %number.ptr %1
  %number.1: i32 = load %number.ptr
  %2: i32 = const 0
  %3: bool = cmp_lt %number.1 %2
  br %3 @2 @3
@2:
  %4: [[proc ([Any], u8)]] = offset %writer .write_char
  %5: [proc ([Any], u8)] = load %4
  %6: [[Any]] = offset %writer .self
  %7: [Any] = load %6
  %8: u8 = const '-'
  call %5 %7 %8
  %number.2: i32 = load %number.ptr
  %9: i32 = neg %number.2
  store %number.ptr %9
  jmp @3
@3:
  %number.3: i32 = load %number.ptr
  %10: i32 = const 10
  %11: bool = cmp_ge %number.3 %10
  br %11 @4 @5
@4:
  %factor.ptr: [i32] = alloc i32
  %number.4: i32 = load %number.ptr
  %12: i32 = const 10
  %13: i32 = div %number.4 %12
  store %factor.ptr %13
  call $([i32]).write_to+anon %factor.ptr %writer
  jmp @5
@5:
  %14: [[proc ([Any], u8)]] = offset %writer .write_char
  %15: [proc ([Any], u8)] = load %14
  %16: [[Any]] = offset %writer .self
  %17: [Any] = load %16
  %number.5: i32 = load %number.ptr
  %18: i32 = const 10
  %19: i32 = mod %number.5 %18
  %20: u8 = cast %19
  %21: u8 = const '0'
  %22: u8 = add %20 %21
  call %15 %17 %22
  ret
}

$([test.Writer]).end_line(%self): [test.Writer] {
@1:
  %1: [[proc ([Any], u8)]] = offset %self .write_char
  %2: [proc ([Any], u8)] = load %1
  %3: [[Any]] = offset %self .self
  %4: [Any] = load %3
  %5: u8 = const '\n'
  call %2 %4 %5
  ret %self
}

$([test.Writer]).write+anon(%self, %writable: test.Writable): [test.Writer] {
@1:
  %1.ptr: [test.Writable] = alloc test.Writable
  store %1.ptr %writable
  %2: [[proc ([Any], [test.Writer])]] = offset %1.ptr .write_to
  %3: [proc ([Any], [test.Writer])] = load %2
  %4.ptr: [test.Writable] = alloc test.Writable
  store %4.ptr %writable
  %5: [[Any]] = offset %4.ptr .self
  %6: [Any] = load %5
  call %3 %6 %self
  ret %self
}

$([FILE]).write_char+anon(%self, %c: u8) {
@1:
  %1: i32 = cast %c
  %2: i32 = call $fputc %1 %self
  ret
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
