proc main() -> i32 {
    let out: Writer = stdout

    // let number = Number(value: 42)
    // let writable_number = Writable(^number)
    // out.write(writable_number).end_line()
    out.write(Number(value: 42)).end_line() // This should do the same as the commented code

    // let number = 42
    // let writable_number = Writable(^number)
    // out.write(writable_number).end_line()
    out.write(42).end_line() // This should write the number 42 directly

    return 0
}

type Number = struct {
    value: i32
}

proc (^Number).write_to(self, anon writer: ^Writer) {
    self.value.write_to(writer)
}

proc (^i32).write_to(self, anon writer: ^Writer) {
    let number = self.^
    if number < 0 {
        writer.write_char('-')
        number = -number
    }
    if number >= 10 {
        let factor = number / 10
        factor.write_to(writer)
    }
    writer.write_char((number % 10).as(u8) + '0')
}

// Writer

type Writer = trait {
    proc write_char(self, anon c: u8)
}

proc (^Writer).end_line(self) -> ^Writer {
    self.write_char('\n')
    return self
}

// Writable

type Writable = trait {
    proc write_to(self, anon writer: ^Writer)
}

proc (^Writer).write(self, anon writable: Writable) -> ^Writer {
    writable.write_to(self)
    return self
}

// LibC

type FILE = external

let stdout: ^FILE = external

proc fputc(anon c: i32, anon file: ^FILE) -> i32 = external

proc (^FILE).write_char(self, anon c: u8) {
    fputc(c.as(i32), self)
}
