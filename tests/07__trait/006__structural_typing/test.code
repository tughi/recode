proc main() -> i32 {
    let out: Writer = stdout

    \ let message = "Hello, World!"
    \ let writable_message = Writable(^message)
    \ out.write(writable_message).end_line()
    out.write("Hello, World!").end_line() \ This should do the same as the commented code

    \ let number = 42
    \ let writable_number = Writable(^number)
    \ out.write(writable_number).end_line()
    out.write(42).end_line() \ This should write the number 42 directly

    return 0
}

proc (^i32).write_to(self, anon writer: ^Writer) {
    let number = self.^
    if number < 0 {
        writer.write_char('-')
        number = -number
    }
    if number >= 10 {
        let factor = number / 10
        factor.write_to(writer)
    }
    writer.write_char((number // 10).as(u8) + '0')
}

proc (^str).write_to(self, anon writer: ^Writer) {
    let string = self.as(^String)
    let index = 0usize
    while index < string.length {
        writer.write_char(string.data[index])
        index = index + 1
    }
}

\ Writer

type Writer = trait {
    proc write_char(self, anon c: u8)
}

proc (^Writer).end_line(self) -> ^Writer {
    self.write_char('\n')
    return self
}

\ Writable

type Writable = trait {
    proc write_to(self, anon writer: ^Writer)
}

proc (^Writer).write(self, anon writable: Writable) -> ^Writer {
    writable.write_to(self)
    return self
}

\ LibC

type FILE = external

let stdout: ^FILE = external "__stdoutp"

proc fputc(anon c: i32, anon file: ^FILE) -> i32 = external

proc (^FILE).write_char(self, anon c: u8) {
    fputc(c.as(i32), self)
}
