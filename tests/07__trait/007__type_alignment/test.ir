type test.Input_Stream = struct {
  self: [Any]
  read: [proc ([Any]): u8]
}

$test.main(): i32 {
@1:
  %1: usize = const 8
  %2: usize = const 8
  %3: bool = cmp_ne %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: i32 = const 0
  ret %5
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
