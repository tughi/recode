; exit: 59

; and/or/xor/shl/shr instructions, arithmetic vs logical shr

$main(): i32 {
@1:
  %1: i32 = const 12
  %2: i32 = const 10
  %3: i32 = and %1 %2       ; 8
  %4: i32 = or %1 %2        ; 14
  %5: i32 = xor %1 %2       ; 6
  %6: i32 = const 1
  %7: i32 = const 4
  %8: i32 = shl %6 %7       ; 16
  %9: i32 = const -16
  %10: i32 = const 2
  %11: i32 = shr %9 %10     ; -4 (arithmetic)
  %12: u8 = const 240u8
  %13: u8 = const 4u8
  %14: u8 = shr %12 %13     ; 15 (logical)
  %15: i32 = cast %14
  %16: i32 = add %3 %4      ; 22
  %17: i32 = add %16 %5     ; 28
  %18: i32 = add %17 %8     ; 44
  %19: i32 = add %18 %11    ; 40
  %20: i32 = add %19 %7     ; 44
  %21: i32 = add %20 %15    ; 59
  ret %21
}
