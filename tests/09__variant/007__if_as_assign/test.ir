type test.Value = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 2
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: test.Value = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 2
  %11: bool = cmp_eq %9 %10
  %12: [[1]u32] = offset %value.ptr .value
  %number.ptr: [i32] = cast %12
  br %11 @2 @3
@2:
  %14: i32 = const 0
  store %number.ptr %14
  jmp @3
@3:
  %15: [i32] = offset %value.ptr .tag
  %16: i32 = load %15
  %17: i32 = const 2
  %18: bool = cmp_eq %16 %17
  %19: [[1]u32] = offset %value.ptr .value
  %number.2.ptr: [i32] = cast %19
  br %18 @4 @5
@4:
  %number.2.1: i32 = load %number.2.ptr
  ret %number.2.1
@5:
  %21: i32 = const 1
  ret %21
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
