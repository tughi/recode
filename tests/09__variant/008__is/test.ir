type test.Value = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 2
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: test.Value = load %1.ptr
  store %value.ptr %7
  %8: [i32] = offset %value.ptr .tag
  %9: i32 = load %8
  %10: i32 = const 2
  %11: bool = cmp_eq %9 %10
  br %11 @2 @3
@2:
  %12: i32 = const 0
  ret %12
@3:
  %13: i32 = const 1
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
