type test.Data = struct {
  tag: i32
  value: [1]u8
}

type test.More_Data = struct {
  tag: i32
  value: [1]u64
}

$test.main(): i32 {
@1:
  %1: usize = const 4
  %2: usize = const 4
  %3: bool = cmp_ne %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: usize = const 8
  %6: usize = const 8
  %7: bool = cmp_ne %5 %6
  br %7 @4 @5
@4:
  %8: i32 = const 2
  ret %8
@5:
  %9: i32 = const 0
  ret %9
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
