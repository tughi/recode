type test.Item = struct {
  value: test.Value
}

type test.Value = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %item.ptr: [test.Item] = alloc test.Item
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 2
  store %2 %3
  %4: i32 = const 42
  %5: [[1]u32] = offset %1.ptr .value
  %6: [i32] = cast %5
  store %6 %4
  %7: test.Value = load %1.ptr
  %8: test.Item = struct .value %7
  store %item.ptr %8
  %9: [test.Value] = offset %item.ptr .value
  %10: [i32] = offset %9 .tag
  %11: i32 = load %10
  %12: i32 = const 2
  %13: bool = cmp_eq %11 %12
  %14: [[1]u32] = offset %9 .value
  %integer.ptr: [i32] = cast %14
  br %13 @2 @3
@2:
  %integer.1: i32 = load %integer.ptr
  %16: i32 = const 42
  %17: i32 = sub %integer.1 %16
  ret %17
@3:
  %18: i32 = const 1
  ret %18
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
