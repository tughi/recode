type test.Value = struct {
  tag: i32
  value: [2]u32
}

type test.Integer = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 2
  store %2 %3
  %4.ptr: [test.Integer] = alloc test.Integer
  %5: [i32] = offset %4.ptr .tag
  %6: i32 = const 2
  store %5 %6
  %7: i32 = const 256
  %8: [[1]u32] = offset %4.ptr .value
  %9: [i32] = cast %8
  store %9 %7
  %10: test.Integer = load %4.ptr
  %11: [[2]u32] = offset %1.ptr .value
  %12: [test.Integer] = cast %11
  store %12 %10
  %13: test.Value = load %1.ptr
  store %value.ptr %13
  %14.ptr: [test.Value] = alloc test.Value
  %15: [i32] = offset %14.ptr .tag
  %16: i32 = const 2
  store %15 %16
  %17.ptr: [test.Integer] = alloc test.Integer
  %18: [i32] = offset %17.ptr .tag
  %19: i32 = const 2
  store %18 %19
  %20: i32 = const 42
  %21: [[1]u32] = offset %17.ptr .value
  %22: [i32] = cast %21
  store %22 %20
  %23: test.Integer = load %17.ptr
  %24: [[2]u32] = offset %14.ptr .value
  %25: [test.Integer] = cast %24
  store %25 %23
  %26: test.Value = load %14.ptr
  store %value.ptr %26
  %27: i32 = const 0
  ret %27
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
