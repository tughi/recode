type test.Value = struct {
  tag: i32
  value: [2]u32
}

type test.Integer = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 2
  store %2 %3
  %4.ptr: [test.Integer] = alloc test.Integer
  %5: [i32] = offset %4.ptr .tag
  %6: i32 = const 2
  store %5 %6
  %7: i32 = const 42
  %8: [[1]u32] = offset %4.ptr .value
  %9: [i32] = cast %8
  store %9 %7
  %10: test.Integer = load %4.ptr
  %11: [[2]u32] = offset %1.ptr .value
  %12: [test.Integer] = cast %11
  store %12 %10
  %13: test.Value = load %1.ptr
  store %value.ptr %13
  jmp @2
@2:
  %14: [i32] = offset %value.ptr .tag
  %15: i32 = load %14
  %16: i32 = const 1
  %17: bool = cmp_eq %15 %16
  br %17 @5 @6
@5:
  %18: i32 = const 1
  ret %18
@6:
  %19: i32 = const 2
  %20: bool = cmp_eq %15 %19
  br %20 @7 @8
@7:
  %21: [[2]u32] = offset %value.ptr .value
  %integer.ptr: [test.Integer] = cast %21
  %23: [i32] = offset %integer.ptr .tag
  %24: i32 = load %23
  %25: i32 = const 1
  %26: bool = cmp_eq %24 %25
  br %26 @10 @11
@10:
  %27: i32 = const 2
  ret %27
@11:
  %28: i32 = const 2
  %29: bool = cmp_eq %24 %28
  br %29 @12 @13
@12:
  %30: [[1]u32] = offset %integer.ptr .value
  %integer_value.ptr: [i32] = cast %30
  %integer_value.1: i32 = load %integer_value.ptr
  %32: i32 = const 42
  %33: bool = cmp_ne %integer_value.1 %32
  br %33 @14 @15
@14:
  %34: i32 = const 3
  ret %34
@15:
  jmp @3
@13:
  %35: i32 = const 0
  %36: bool = cmp_eq %24 %35
  br %36 @16 @17
@16:
  %37: i32 = const 4
  ret %37
@17:
  jmp @9
@9:
  jmp @4
@8:
  %38: i32 = const 0
  %39: bool = cmp_eq %15 %38
  br %39 @18 @19
@18:
  %40: i32 = const 5
  ret %40
@19:
  jmp @4
@4:
  %41: i32 = const 6
  ret %41
@3:
  %42: i32 = const 0
  ret %42
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
