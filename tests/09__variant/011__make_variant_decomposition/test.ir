type test.Expression = struct {
  tag: i32
  value: [1]u64
}

type test.Addition = struct {
  left: test.Expression
  right: test.Expression
}

type test.Subtraction = struct {
  left: test.Expression
  right: test.Expression
}

$exit: [proc (i32)] = external

$malloc: [proc (usize): [Any]] = external

$test.evaluate+expression(%expression: test.Expression): i32 {
@1:
  %1.ptr: [test.Expression] = alloc test.Expression
  store %1.ptr %expression
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = load %2
  %4: i32 = const 1
  %5: bool = cmp_eq %3 %4
  br %5 @3 @4
@3:
  %6: [[1]u64] = offset %1.ptr .value
  %value.ptr: [i32] = cast %6
  %value.1: i32 = load %value.ptr
  ret %value.1
@4:
  %8: i32 = const 2
  %9: bool = cmp_eq %3 %8
  br %9 @5 @6
@5:
  %10: [[1]u64] = offset %1.ptr .value
  %addition.ptr: [[test.Addition]] = cast %10
  %addition.1: [test.Addition] = load %addition.ptr
  %12: [test.Expression] = offset %addition.1 .left
  %13: test.Expression = load %12
  %14: i32 = call $test.evaluate+expression %13
  %addition.2: [test.Addition] = load %addition.ptr
  %15: [test.Expression] = offset %addition.2 .right
  %16: test.Expression = load %15
  %17: i32 = call $test.evaluate+expression %16
  %18: i32 = add %14 %17
  ret %18
@6:
  %19: i32 = const 3
  %20: bool = cmp_eq %3 %19
  br %20 @7 @8
@7:
  %21: [[1]u64] = offset %1.ptr .value
  %subtraction.ptr: [[test.Subtraction]] = cast %21
  %subtraction.1: [test.Subtraction] = load %subtraction.ptr
  %23: [test.Expression] = offset %subtraction.1 .left
  %24: test.Expression = load %23
  %25: i32 = call $test.evaluate+expression %24
  %subtraction.2: [test.Subtraction] = load %subtraction.ptr
  %26: [test.Expression] = offset %subtraction.2 .right
  %27: test.Expression = load %26
  %28: i32 = call $test.evaluate+expression %27
  %29: i32 = sub %25 %28
  ret %29
@8:
  jmp @2
@2:
  %30: i32 = const 1
  call $exit %30
}

$test.main(): i32 {
@1:
  %1.ptr: [test.Expression] = alloc test.Expression
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 3
  store %2 %3
  %4: usize = const 32
  %5: [Any] = call $malloc %4
  %6: [test.Subtraction] = cast %5
  %7.ptr: [test.Expression] = alloc test.Expression
  %8: [i32] = offset %7.ptr .tag
  %9: i32 = const 1
  store %8 %9
  %10: i32 = const 42
  %11: [[1]u64] = offset %7.ptr .value
  %12: [i32] = cast %11
  store %12 %10
  %13: test.Expression = load %7.ptr
  %14.ptr: [test.Expression] = alloc test.Expression
  %15: [i32] = offset %14.ptr .tag
  %16: i32 = const 2
  store %15 %16
  %17: usize = const 32
  %18: [Any] = call $malloc %17
  %19: [test.Addition] = cast %18
  %20.ptr: [test.Expression] = alloc test.Expression
  %21: [i32] = offset %20.ptr .tag
  %22: i32 = const 1
  store %21 %22
  %23: i32 = const 21
  %24: [[1]u64] = offset %20.ptr .value
  %25: [i32] = cast %24
  store %25 %23
  %26: test.Expression = load %20.ptr
  %27.ptr: [test.Expression] = alloc test.Expression
  %28: [i32] = offset %27.ptr .tag
  %29: i32 = const 1
  store %28 %29
  %30: i32 = const 21
  %31: [[1]u64] = offset %27.ptr .value
  %32: [i32] = cast %31
  store %32 %30
  %33: test.Expression = load %27.ptr
  %34: test.Addition = struct .left %26 .right %33
  store %19 %34
  %35: [[1]u64] = offset %14.ptr .value
  %36: [[test.Addition]] = cast %35
  store %36 %19
  %37: test.Expression = load %14.ptr
  %38: test.Subtraction = struct .left %13 .right %37
  store %6 %38
  %39: [[1]u64] = offset %1.ptr .value
  %40: [[test.Subtraction]] = cast %39
  store %40 %6
  %41: test.Expression = load %1.ptr
  %42: i32 = call $test.evaluate+expression %41
  ret %42
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
