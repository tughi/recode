type test.Value = struct {
  tag: i32
  value: [1]u32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr .tag
  %3: i32 = const 0
  store %2 %3
  %4: test.Value = load %1.ptr
  store %value.ptr %4
  %5: [i32] = offset %value.ptr .tag
  %6: i32 = load %5
  %7: i32 = const 0
  %8: bool = cmp_ne %6 %7
  br %8 @2 @3
@2:
  %9: i32 = const 1
  ret %9
@3:
  %10.ptr: [test.Value] = alloc test.Value
  %11: [i32] = offset %10.ptr .tag
  %12: i32 = const 2
  store %11 %12
  %13: i32 = const 42
  %14: [[1]u32] = offset %10.ptr .value
  %15: [i32] = cast %14
  store %15 %13
  %16: test.Value = load %10.ptr
  store %value.ptr %16
  %17: [i32] = offset %value.ptr .tag
  %18: i32 = load %17
  %19: i32 = const 0
  %20: bool = cmp_eq %18 %19
  br %20 @4 @5
@4:
  %21: i32 = const 2
  ret %21
@5:
  %22: i32 = const 0
  ret %22
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
