type test.Value = struct {
  tag: i32
  value: i32
}

$test.main(): i32 {
@1:
  %value.ptr: [test.Value] = alloc test.Value
  %1.ptr: [test.Value] = alloc test.Value
  %2: [i32] = offset %1.ptr test.Value.tag
  %3: i32 = const 2
  store %2 %3
  %4: i32 = const 42
  %5: [i32] = offset %1.ptr test.Value.value
  store %5 %4
  %6: test.Value = load %1.ptr
  store %value.ptr %6
  %7: [i32] = offset %value.ptr test.Value.tag
  %8: i32 = load %7
  %9: i32 = const 2
  %10: bool = cmp_eq %8 %9
  br %10 @2 @3
@2:
  %11: [i32] = offset %value.ptr test.Value.value
  %12: i32 = load %11
  %13: i32 = const 42
  %14: i32 = sub %12 %13
  ret %14
@3:
  %15: i32 = const 1
  ret %15
@4:
  %16: i32 = const 2
  ret %16
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
