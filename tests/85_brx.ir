; exit: 0

; indexed branch: in-range values jump to the label at that position,
; out-of-range values (negative or past the table) jump to the last label

$select(%value: i32): i32 {
@1:
  brx %value @2 @3 @4 @5
@2:
  %1: i32 = const 10
  ret %1
@3:
  %2: i32 = const 20
  ret %2
@4:
  %3: i32 = const 30
  ret %3
@5:
  %4: i32 = const 99
  ret %4
}

$main(): i32 {
@1:
  %v0: i32 = const 0
  %r0: i32 = call $select %v0
  %e0: i32 = const 10
  %d0: i32 = sub %r0 %e0

  %v1: i32 = const 1
  %r1: i32 = call $select %v1
  %e1: i32 = const 20
  %d1: i32 = sub %r1 %e1

  %v2: i32 = const 2
  %r2: i32 = call $select %v2
  %e2: i32 = const 30
  %d2: i32 = sub %r2 %e2

  %v3: i32 = const 3
  %r3: i32 = call $select %v3
  %e3: i32 = const 99
  %d3: i32 = sub %r3 %e3

  %v4: i32 = const -1
  %r4: i32 = call $select %v4
  %e4: i32 = const 99
  %d4: i32 = sub %r4 %e4

  %s1: i32 = add %d0 %d1
  %s2: i32 = add %s1 %d2
  %s3: i32 = add %s2 %d3
  %s4: i32 = add %s3 %d4
  ret %s4
}
