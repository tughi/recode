$main(): i32 {
@1:
  %value.ptr: [i32] = alloc i32
  %1: i32 = const 42
  store %value.ptr %1
  %any.ptr: [[Any]] = alloc [Any]
  %2: [Any] = cast %value.ptr
  store %any.ptr %2
  %any.1: [Any] = load %any.ptr
  %3: [i32] = cast %any.1
  %4: i32 = load %3
  %5: i32 = const 42
  %6: i32 = sub %4 %5
  ret %6
}
