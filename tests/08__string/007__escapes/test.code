type FILE = external

let stdout: ^FILE = external

proc fputc(char: i32, file: ^FILE) -> i32 = external

proc main() -> i32 {
    let text = "\"quoted\"\t\\backslash\\ \e?\n"
    if text.length != 24 {
        return 1
    }
    let text_copy = text
    let data = (^text_copy).as(^String).data
    let index: usize = 0
    while index < text.length {
        fputc(data[index].as(i32), stdout)
        index = index + 1
    }
    return 0
}
