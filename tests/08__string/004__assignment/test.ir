type String = struct {
  data: [*]u8
  length: usize
}

$str_1: [*]u8 = "I am a string!"

$str_2: [*]u8 = "I am a different string!"

$str_3: [*]u8 = "I am an even more different string!"

$test.main(): i32 {
@1:
  %message.ptr: [String] = alloc String
  %1: usize = const 14
  %2: String = struct String .data $str_1 .length %1
  store %message.ptr %2
  %3: [usize] = offset %message.ptr String.length
  %4: usize = load %3
  %5: usize = const 14
  %6: bool = cmp_ne %4 %5
  br %6 @2 @3
@2:
  %7: i32 = const 1
  ret %7
@3:
  %8: usize = const 24
  %9: String = struct String .data $str_2 .length %8
  store %message.ptr %9
  %10: [usize] = offset %message.ptr String.length
  %11: usize = load %10
  %12: usize = const 24
  %13: bool = cmp_ne %11 %12
  br %13 @4 @5
@4:
  %14: i32 = const 2
  ret %14
@5:
  %message_ptr.ptr: [[String]] = alloc [String]
  store %message_ptr.ptr %message.ptr
  %message_ptr.1: [String] = load %message_ptr.ptr
  %15: usize = const 35
  %16: String = struct String .data $str_3 .length %15
  store %message_ptr.1 %16
  %17: [usize] = offset %message.ptr String.length
  %18: usize = load %17
  %19: usize = const 35
  %20: bool = cmp_ne %18 %19
  br %20 @6 @7
@6:
  %21: i32 = const 3
  ret %21
@7:
  %22: i32 = const 0
  ret %22
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
