import calculator.source
import io

const NODE_NUMBER = 2
const NODE_ADDITION = 3
const NODE_DIVISION = 4
const NODE_MULTIPLICATION = 5
const NODE_SUBTRACTION = 6

type Number = struct {
    super: source.Node
    value: i32
}

type Addition = struct {
    super: source.Node
    left: ^source.Node
    right: ^source.Node
}

type Division = struct {
    super: source.Node
    left: ^source.Node
    right: ^source.Node
}

type Multiplication = struct {
    super: source.Node
    left: ^source.Node
    right: ^source.Node
}

type Subtraction = struct {
    super: source.Node
    left: ^source.Node
    right: ^source.Node
}

proc (^io.Writer).write_expression(self, node: ^source.Node) -> ^io.Writer {
    if node == null {
        return self.write_string("Nil!")
    }
    if node.kind == NODE_NUMBER {
        let number = node.as(^Number)
        return self.write_signed(number.value)
    } else if node.kind == NODE_ADDITION {
        let addition = node.as(^Addition)
        return self.write_string("(").write_expression(addition.left).write_string(" + ").write_expression(addition.right).write_string(")")
    } else if node.kind == NODE_DIVISION {
        let division = node.as(^Division)
        return self.write_string("(").write_expression(division.left).write_string(" / ").write_expression(division.right).write_string(")")
    } else if node.kind == NODE_MULTIPLICATION {
        let multiplication = node.as(^Multiplication)
        return self.write_string("(").write_expression(multiplication.left).write_string(" * ").write_expression(multiplication.right).write_string(")")
    } else if node.kind == NODE_SUBTRACTION {
        let subtraction = node.as(^Subtraction)
        return self.write_string("(").write_expression(subtraction.left).write_string(" - ").write_expression(subtraction.right).write_string(")")
    } else if node.kind == source.NODE_ERROR {
        let error = node.as(^source.Error)
        return self.write_string("Error: ").write_string(error.message)
    }
    return self
}
