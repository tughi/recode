import calculator.expression
import calculator.source
import calculator.tokenizer
import libc

type Parser = struct {
    tokenizer: tokenizer.Tokenizer
}

proc (^Parser).parse_expression(self) -> ^source.Node {
    return self.parse_additive_expression()
}

proc (^Parser).parse_additive_expression(self) -> ^source.Node {
    let parsed_expression = self.parse_multiplicative_expression()
    loop {
        let token = self.tokenizer.peek_token()
        if token.kind == tokenizer.NODE_PLUS {
            self.tokenizer.next_token()
            let other_expression = self.parse_multiplicative_expression()
            let addition = libc.malloc(type_size(expression.Addition)).as(^expression.Addition)
            addition.^ = expression.Addition(
                super: source.Node(kind: expression.NODE_ADDITION, span: source.Span(start: parsed_expression.span.start, end: other_expression.span.end))
                left: parsed_expression
                right: other_expression
            )
            parsed_expression = addition
        } else if token.kind == tokenizer.NODE_MINUS {
            self.tokenizer.next_token()
            let other_expression = self.parse_multiplicative_expression()
            let subtraction = libc.malloc(type_size(expression.Subtraction)).as(^expression.Subtraction)
            subtraction.^ = expression.Subtraction(
                super: source.Node(kind: expression.NODE_SUBTRACTION, span: source.Span(start: parsed_expression.span.start, end: other_expression.span.end))
                left: parsed_expression
                right: other_expression
            )
            parsed_expression = subtraction
        } else {
            break
        }
    }
    return parsed_expression
}

proc (^Parser).parse_multiplicative_expression(self) -> ^source.Node {
    let parsed_expression = self.parse_primary_expression()
    loop {
        let token = self.tokenizer.peek_token()
        if token.kind == tokenizer.NODE_MULTIPLY {
            self.tokenizer.next_token()
            let other_expression = self.parse_primary_expression()
            let multiplication = libc.malloc(type_size(expression.Multiplication)).as(^expression.Multiplication)
            multiplication.^ = expression.Multiplication(
                super: source.Node(kind: expression.NODE_MULTIPLICATION, span: source.Span(start: parsed_expression.span.start, end: other_expression.span.end))
                left: parsed_expression
                right: other_expression
            )
            parsed_expression = multiplication
        } else if token.kind == tokenizer.NODE_DIVIDE {
            self.tokenizer.next_token()
            let other_expression = self.parse_primary_expression()
            let division = libc.malloc(type_size(expression.Division)).as(^expression.Division)
            division.^ = expression.Division(
                super: source.Node(kind: expression.NODE_DIVISION, span: source.Span(start: parsed_expression.span.start, end: other_expression.span.end))
                left: parsed_expression
                right: other_expression
            )
            parsed_expression = division
        } else {
            break
        }
    }
    return parsed_expression
}

proc (^Parser).parse_primary_expression(self) -> ^source.Node {
    let token = self.tokenizer.next_token()
    if token.kind == expression.NODE_NUMBER {
        return token
    }
    let error = libc.malloc(type_size(source.Error)).as(^source.Error)
    error.^ = source.Error(
        super: source.Node(kind: source.NODE_ERROR, span: token.span)
        message: "Expected number"
    )
    return error
}
