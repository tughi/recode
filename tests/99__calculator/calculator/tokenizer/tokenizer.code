import calculator.expression
import calculator.source
import libc

type Tokenizer = struct {
    data: [^]u8
    index: i32

    current_token: ^source.Node
}

proc (^Tokenizer).peek_token(self) -> ^source.Node {
    if self.current_token == null {
        self.current_token = self.scan_token()
    }
    return self.current_token
}

proc (^Tokenizer).next_token(self) -> ^source.Node {
    let token = self.peek_token()
    self.current_token = null
    return token
}

proc (^Tokenizer).scan_token(self) -> ^source.Node {
    while self.data[self.index] == ' ' {
        self.index = self.index + 1
    }
    let ch = self.data[self.index]
    if ch == 0 {
        let stop = libc.malloc(type_size(Stop)).as(^Stop)
        stop.^ = Stop(super: source.Node(kind: NODE_STOP, span: source.Span(start: self.index, end: self.index)))
        return stop
    }
    if ch >= '0' and ch <= '9' {
        return self.scan_number_token()
    }
    self.index = self.index + 1
    if ch == '+' {
        let plus = libc.malloc(type_size(Plus)).as(^Plus)
        plus.^ = Plus(super: source.Node(kind: NODE_PLUS, span: source.Span(start: self.index - 1, end: self.index)))
        return plus
    }
    if ch == '-' {
        let minus = libc.malloc(type_size(Minus)).as(^Minus)
        minus.^ = Minus(super: source.Node(kind: NODE_MINUS, span: source.Span(start: self.index - 1, end: self.index)))
        return minus
    }
    if ch == '*' {
        let multiply = libc.malloc(type_size(Multiply)).as(^Multiply)
        multiply.^ = Multiply(super: source.Node(kind: NODE_MULTIPLY, span: source.Span(start: self.index - 1, end: self.index)))
        return multiply
    }
    if ch == '/' {
        let divide = libc.malloc(type_size(Divide)).as(^Divide)
        divide.^ = Divide(super: source.Node(kind: NODE_DIVIDE, span: source.Span(start: self.index - 1, end: self.index)))
        return divide
    }
    let error = libc.malloc(type_size(source.Error)).as(^source.Error)
    error.^ = source.Error(
        super: source.Node(kind: source.NODE_ERROR, span: source.Span(start: self.index - 1, end: self.index))
        message: "Unexpected character"
    )
    return error
}

proc (^Tokenizer).scan_number_token(self) -> ^source.Node {
    let start = self.index
    let value = 0
    loop {
        let c = self.data[self.index]
        if c < '0' or c > '9' {
            break
        }
        value = value * 10 + (c - '0').as(i32)
        self.index = self.index + 1
    }
    let number = libc.malloc(type_size(expression.Number)).as(^expression.Number)
    number.^ = expression.Number(
        super: source.Node(kind: expression.NODE_NUMBER, span: source.Span(start: start, end: self.index))
        value: value
    )
    return number
}
