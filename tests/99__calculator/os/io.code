import io
import libc

let stdout: ^io.Writer
let stderr: ^io.Writer

proc init() {
    stdout = libc.malloc(type_size(io.Writer)).as(^io.Writer)
    stdout.^ = io.Writer(object: libc.stdout.as(^Any), write_char: file_write_char)
    stderr = libc.malloc(type_size(io.Writer)).as(^io.Writer)
    stderr.^ = io.Writer(object: libc.stderr.as(^Any), write_char: file_write_char)
}

proc file_write_char(object: ^Any, c: u8) {
    libc.fputc(c.as(i32), object.as(^libc.FILE))
}
