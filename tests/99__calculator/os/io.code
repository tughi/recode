import io
import libc

let stdout: ^io.Writer
let stderr: ^io.Writer

proc init() {
    stdout = alloc io.Writer(object: libc.stdout.as(^Any), write_char: file_write_char)
    stderr = alloc io.Writer(object: libc.stderr.as(^Any), write_char: file_write_char)
}

proc file_write_char(object: ^Any, c: u8) {
    libc.fputc(c.as(i32), object.as(^libc.FILE))
}
