type FILE = external

let external __stdinp: ^FILE
let external __stdoutp: ^FILE
let external __stderrp: ^FILE

proc fputc(anon c: i32, anon file: ^FILE) -> i32 = external

proc malloc(anon size: u64) -> ^Any = external
proc realloc(anon block: ^Any, anon size: u64) -> ^Any = external

proc exit(anon code: i32) = external
