type source.Span = struct {
  start: i32
  end: i32
}

$test.main(): i32 {
@1:
  %span.ptr: [source.Span] = alloc source.Span
  %1: i32 = const 0
  %2: i32 = const 42
  %3: source.Span = struct source.Span .start %1 .end %2
  store %span.ptr %3
  %4: [i32] = offset %span.ptr source.Span.end
  %5: i32 = load %4
  %6: i32 = const 42
  %7: i32 = sub %5 %6
  ret %7
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
