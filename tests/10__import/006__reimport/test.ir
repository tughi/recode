type io.Writer = struct {
  self: [Any]
  write_char: [proc ([Any], i32): i32]
}

type FILE = opaque

$stdout: [[FILE]] = external

$fputc: [proc (i32, [FILE]): i32] = external

$test.main(): i32 {
@1:
  %stdout.ptr: [io.Writer] = alloc io.Writer
  %1: [FILE] = load $stdout
  %2: [Any] = cast %1
  %3: [proc ([Any], i32): i32] = cast $([FILE]).write_char+anon
  %4: io.Writer = struct .self %2 .write_char %3
  store %stdout.ptr %4
  %5: i32 = const 52
  %6: [io.Writer] = call $([io.Writer]).write+char %stdout.ptr %5
  %7: i32 = const 50
  %8: [io.Writer] = call $([io.Writer]).write+char %6 %7
  %9: i32 = const 10
  %10: [io.Writer] = call $([io.Writer]).write+char %8 %9
  %11: i32 = const 0
  ret %11
}

$([io.Writer]).write+char(%writer, %c: i32): [io.Writer] {
@1:
  %1: [[proc ([Any], i32): i32]] = offset %writer .write_char
  %2: [proc ([Any], i32): i32] = load %1
  %3: [[Any]] = offset %writer .self
  %4: [Any] = load %3
  %5: i32 = call %2 %4 %c
  ret %writer
}

$([FILE]).write_char+anon(%file, %c: i32): i32 {
@1:
  %1: i32 = call $fputc %c %file
  ret %1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
