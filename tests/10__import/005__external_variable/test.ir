type FILE = opaque

$stdout: [[FILE]] = external

$fputc: [proc (i32, [FILE]): i32] = external

$test.main(): i32 {
@1:
  %1: u8 = const '4'
  %2: i32 = cast %1
  %3: [FILE] = load $stdout
  %4: i32 = call $fputc %2 %3
  %5: u8 = const '2'
  %6: i32 = cast %5
  %7: [FILE] = load $stdout
  %8: i32 = call $fputc %6 %7
  %9: u8 = const '\n'
  %10: i32 = cast %9
  %11: [FILE] = load $stdout
  %12: i32 = call $fputc %10 %11
  %13: i32 = const 0
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
