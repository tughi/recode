$test.main(): i32 {
@1:
  %1: i32 = call $test.return_forty_two
  %2: i32 = const 42
  %3: bool = cmp_ne %1 %2
  br %3 @2 @3
@2:
  %4: i32 = const 1
  ret %4
@3:
  %5: i32 = const 0
  ret %5
}

$test.return_forty_two(): i32 {
@1:
  %value.ptr: [i32] = alloc i32
  %1: i32 = const 0
  store %value.ptr %1
  %2: i32 = const 13
  store %value.ptr %2
  %3: i32 = const 42
  store %value.ptr %3
  %value.1: i32 = load %value.ptr
  ret %value.1
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
