$test.main(): i32 {
@1:
  %repeat.ptr: [bool] = alloc bool
  %1: bool = const true
  store %repeat.ptr %1
  jmp @2
@2:
  %repeat.1: bool = load %repeat.ptr
  br %repeat.1 @3 @4
@3:
  jmp @5
@5:
  %2: bool = const true
  store %repeat.ptr %2
  %3: bool = const false
  store %repeat.ptr %3
  jmp @6
@6:
  jmp @2
@4:
  %4: i32 = const 0
  ret %4
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
