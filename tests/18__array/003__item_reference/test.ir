$test.main(): i32 {
@1:
  %array.ptr: [[4]i32] = alloc [4]i32
  %1: i32 = const 2
  %2: [i32] = offset %array.ptr %1
  %3: i32 = const 40
  store %2 %3
  %item_ref.ptr: [[i32]] = alloc [i32]
  %4: i32 = const 2
  %5: [i32] = offset %array.ptr %4
  store %item_ref.ptr %5
  %item_ref.1: [i32] = load %item_ref.ptr
  %item_ref.2: [i32] = load %item_ref.ptr
  %6: i32 = load %item_ref.2
  %7: i32 = const 2
  %8: i32 = add %6 %7
  store %item_ref.1 %8
  %9: i32 = const 2
  %10: [i32] = offset %array.ptr %9
  %11: i32 = load %10
  %12: i32 = const 42
  %13: i32 = sub %11 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
