$test.main(): i32 {
@1:
  %array.ptr: [[4]i32] = alloc [4]i32
  %1: i32 = const 3
  %2: [i32] = offset %array.ptr %1
  %3: i32 = const 42
  store %2 %3
  %4: i32 = const 3
  %5: [i32] = offset %array.ptr %4
  %6: i32 = load %5
  %7: i32 = const 42
  %8: i32 = sub %6 %7
  ret %8
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
