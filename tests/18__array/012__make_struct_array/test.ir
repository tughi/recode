type test.Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %points.ptr: [[2]test.Point] = alloc [2]test.Point
  %1.ptr: [[2]test.Point] = alloc [2]test.Point
  %2: i32 = const 1
  %3: i32 = const 2
  %4: test.Point = struct .x %2 .y %3
  %5: i32 = const 0
  %6: [test.Point] = offset %1.ptr %5
  store %6 %4
  %7: i32 = const 3
  %8: i32 = const 4
  %9: test.Point = struct .x %7 .y %8
  %10: i32 = const 1
  %11: [test.Point] = offset %1.ptr %10
  store %11 %9
  %12: [2]test.Point = load %1.ptr
  store %points.ptr %12
  %13: i32 = const 0
  %14: [test.Point] = offset %points.ptr %13
  %15: [i32] = offset %14 .x
  %16: i32 = load %15
  %17: i32 = const 0
  %18: [test.Point] = offset %points.ptr %17
  %19: [i32] = offset %18 .y
  %20: i32 = load %19
  %21: i32 = add %16 %20
  %22: i32 = const 1
  %23: [test.Point] = offset %points.ptr %22
  %24: [i32] = offset %23 .x
  %25: i32 = load %24
  %26: i32 = add %21 %25
  %27: i32 = const 1
  %28: [test.Point] = offset %points.ptr %27
  %29: [i32] = offset %28 .y
  %30: i32 = load %29
  %31: i32 = add %26 %30
  %32: i32 = const 10
  %33: i32 = sub %31 %32
  ret %33
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
