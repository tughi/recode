$test.main(): i32 {
@1:
  %source.ptr: [[4]i32] = alloc [4]i32
  %1: i32 = const 2
  %2: [i32] = offset %source.ptr %1
  %3: i32 = const 42
  store %2 %3
  %copy.ptr: [[4]i32] = alloc [4]i32
  %source.1: [4]i32 = load %source.ptr
  store %copy.ptr %source.1
  %4: i32 = const 2
  %5: [i32] = offset %source.ptr %4
  %6: i32 = const 13
  store %5 %6
  %7: i32 = const 2
  %8: [i32] = offset %copy.ptr %7
  %9: i32 = load %8
  %10: i32 = const 42
  %11: i32 = sub %9 %10
  ret %11
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
