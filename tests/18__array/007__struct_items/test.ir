type test.Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %points.ptr: [[2]test.Point] = alloc [2]test.Point
  %1: i32 = const 1
  %2: [test.Point] = offset %points.ptr %1
  %3: [i32] = offset %2 .x
  %4: i32 = const 40
  store %3 %4
  %5: i32 = const 1
  %6: [test.Point] = offset %points.ptr %5
  %7: [i32] = offset %6 .y
  %8: i32 = const 2
  store %7 %8
  %9: i32 = const 1
  %10: [test.Point] = offset %points.ptr %9
  %11: [i32] = offset %10 .x
  %12: i32 = load %11
  %13: i32 = const 1
  %14: [test.Point] = offset %points.ptr %13
  %15: [i32] = offset %14 .y
  %16: i32 = load %15
  %17: i32 = add %12 %16
  %18: i32 = const 42
  %19: i32 = sub %17 %18
  ret %19
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
