$test.main(): i32 {
@1:
  %matrix.ptr: [[2][3]i32] = alloc [2][3]i32
  %1: i32 = const 1
  %2: [[3]i32] = offset %matrix.ptr %1
  %3: i32 = const 2
  %4: [i32] = offset %2 %3
  %5: i32 = const 42
  store %4 %5
  %6: i32 = const 1
  %7: [[3]i32] = offset %matrix.ptr %6
  %8: i32 = const 2
  %9: [i32] = offset %7 %8
  %10: i32 = load %9
  %11: i32 = const 42
  %12: i32 = sub %10 %11
  ret %12
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
