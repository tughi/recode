type test.Path = struct {
  points: [4]test.Point
}

type test.Point = struct {
  x: i32
  y: i32
}

$test.main(): i32 {
@1:
  %path.ptr: [test.Path] = alloc test.Path
  %1: [[4]test.Point] = offset %path.ptr .points
  %2: i32 = const 0
  %3: [test.Point] = offset %1 %2
  %4: i32 = const 42
  %5: i32 = const 7
  %6: test.Point = struct .x %4 .y %5
  store %3 %6
  %7: [[4]test.Point] = offset %path.ptr .points
  %8: i32 = const 0
  %9: [test.Point] = offset %7 %8
  %10: [i32] = offset %9 .y
  %11: i32 = load %10
  %12: i32 = const 7
  %13: i32 = sub %11 %12
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
