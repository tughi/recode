; global variables without initializers are automatically zeroed

type test.Number = struct {
  negative: bool
  value: u64
}

$test.number: [test.Number]

$test.main(): i32 {
@1:
  %1: [u64] = offset $test.number .value
  %2: u64 = load %1
  %3: i32 = cast %2
  ret %3
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
