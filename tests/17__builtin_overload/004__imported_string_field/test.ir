type token.String = struct {
  value: String
}

type String = struct {
  data: [*]u8
  length: usize
}

type ast.Node = struct {
  text: [token.String]
}

$str_1: [*]u8 = "hi"

$test.main(): i32 {
@1:
  %name.ptr: [token.String] = alloc token.String
  %1: usize = const 2
  %2: String = struct .data $str_1 .length %1
  %3: token.String = struct .value %2
  store %name.ptr %3
  %node.ptr: [ast.Node] = alloc ast.Node
  %4: ast.Node = struct .text %name.ptr
  store %node.ptr %4
  %5: [[token.String]] = offset %node.ptr .text
  %6: [token.String] = load %5
  %7: [String] = offset %6 .value
  %8: [usize] = offset %7 .length
  %9: usize = load %8
  %10: usize = const 2
  %11: bool = cmp_eq %9 %10
  br %11 @2 @3
@2:
  %12: i32 = const 0
  ret %12
@3:
  %13: i32 = const 1
  ret %13
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
