type test.i32 = struct {
  value: i32
}

$test.main(): i32 {
@1:
  %wrapped.ptr: [test.i32] = alloc test.i32
  %1: i32 = const 0
  %2: test.i32 = struct .value %1
  store %wrapped.ptr %2
  %3: [i32] = offset %wrapped.ptr .value
  %4: i32 = load %3
  ret %4
}

$main(): i32 {
@1:
  %1: i32 = call $test.main
  ret %1
}
