package test

proc main() -> i32 {
    __stdoutp.write(char: '4').write(char: '2').write(char: '\n')
    return 0
}

proc ^FILE.write(self, char ch: u8) -> ^FILE {
    fputc(ch.as(i32), __stdoutp)
    return self
}

type FILE = external
let external __stdoutp: ^FILE
proc fputc(anon c: i32, anon stream: ^FILE) -> i32 = external
