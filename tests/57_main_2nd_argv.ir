; args: 42
; exit: 2

$main(%argc: i32, %argv: [*][*]u8): i32 {
@1:
  %0: i32 = const 2
  %1: bool = cmp_eq %argc %0
  br %1 @3 @2
@2:
  %2: i32 = const 1
  ret %2
@3:
  %3: i32 = const 1
  %4: [[*]u8] = offset %argv %3
  %5: [*]u8 = load %4
  %6: i32 = const 0
  %7: [u8] = offset %5 %6
  %8: u8 = load %7
  %9: [u8] = offset %5 %3
  %10: u8 = load %9
  %11: u8 = sub %8 %10
  %12: i32 = cast %11
  ret %12
}
