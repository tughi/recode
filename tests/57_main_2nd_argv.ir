; args: 42
; exit: 2

$main(%argc: i32, %argv: ptr<ptr<u8>>): i32 {
@1:
  %0: i32 = const 2
  %1: bool = cmp_eq %argc %0
  br %1 @3 @2
@2:
  %2: i32 = const 1
  ret %2
@3:
  %3: i32 = const 1
  %4: ptr<ptr<u8>> = offset %argv %3
  %5: ptr<u8> = load %4
  %6: u8 = load %5
  %7: ptr<u8> = offset %5 %3
  %8: u8 = load %7
  %9: u8 = sub %6 %8
  %10: i32 = cast %9
  ret %10
}
