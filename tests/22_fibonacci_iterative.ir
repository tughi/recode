; proc fib(n: i32) -> i32 {
;   let a = 0
;   let b = 1
;   let i = 0
;   while i < n {
;     let sum = a + b
;     a = b
;     b = sum
;     i = i + 1
;   }
;   return a
; }

$fib(%n: i32): i32 {
@1:
  %a.0: i32 = const 0
  %b.0: i32 = const 1
  %i.0: i32 = const 0
  jmp @2
@2:
  %a.1: i32 = phi @1 %a.0 @3 %b.1
  %b.1: i32 = phi @1 %b.0 @3 %sum.1
  %i.1: i32 = phi @1 %i.0 @3 %i.2
  %1: bool = cmp_lt %i.1 %n
  br %1 @3 @4
@3:
  %sum.1: i32 = add %a.1 %b.1
  %2: i32 = const 1
  %i.2: i32 = add %i.1 %2
  jmp @2
@4:
  ret %a.1
}

$main(): i32 {
@1:
  %1: i32 = const 13
  %2: i32 = call $fib %1
  ret %2
}
