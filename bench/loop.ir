; exit: 0

; tight loop benchmark — many jumps, no calls

$main(): i32 {
@1:
  %1: i64 = const 0
  %2: i64 = const 200000000
  jmp @2
@2:
  %i.1: i64 = phi @1 %1 @3 %i.2
  %3: bool = cmp_lt %i.1 %2
  br %3 @3 @4
@3:
  %4: i64 = const 1
  %i.2: i64 = add %i.1 %4
  jmp @2
@4:
  %5: i32 = const 0
  ret %5
}
